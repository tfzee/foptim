; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; a byval argument is a copy in the stack argument area, the callee gets the
; address of that copy, the caller pushes the qwords of the object

%struct.S = type { i64, i64, i64 }
%struct.T = type { [20 x i8] }
%struct.A = type { i64, i64, i64 }

declare i64 @ext_s(i32, ptr byval(%struct.S) align 8, i32)
declare i64 @ext_t(ptr byval(%struct.T) align 8, i64)
declare i64 @ext_a(i64, i64, i64, i64, i64, i64, i64, ptr byval(%struct.A) align 16, i64)

define i64 @callee_s(i32 %p1, ptr byval(%struct.S) align 8 %s, i32 %p2) {
; CHECK: func callee_s ($2: i32, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rcx: i64, [$rbp + 16]: i64, )
; CHECK-NEXT:    $rdx: i64 = $rcx: i64
; CHECK-NEXT:    $rdx: i64 += 16: i64
; CHECK-NEXT:    $rax: i64 = [$rcx]: i64
; CHECK-NEXT:    $rax: i64 += [$rdx]: i64
; CHECK-NEXT:    $rdx: i64 = 7: i64
; CHECK-NEXT:    [$rcx]: i64 = $rdx: i64
; CHECK-NEXT:    ret($rax: i64, )
  %pa = getelementptr inbounds %struct.S, ptr %s, i32 0, i32 0
  %a = load i64, ptr %pa
  %pc = getelementptr inbounds %struct.S, ptr %s, i32 0, i32 2
  %c = load i64, ptr %pc
  %r = add i64 %a, %c
  store i64 7, ptr %pa
  ret i64 %r
}

define i64 @caller_s(ptr %p) {
; CHECK: func caller_s ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push([$rdi + 16]: i64, )
; CHECK-NEXT:    push([$rdi + 8]: i64, )
; CHECK-NEXT:    push([$rdi + 0]: i64, )
; CHECK-NEXT:    $edi: i32 = 1: i32
; CHECK-NEXT:    $esi: i32 = 2: i32
; CHECK-NEXT:    call(ext_s, )
; CHECK-NEXT:    $rsp: i64 += 24: i32
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    ret($rax: i64, )
  %r = call i64 @ext_s(i32 1, ptr byval(%struct.S) align 8 %p, i32 2)
  ret i64 %r
}

define i64 @callee_t(ptr byval(%struct.T) align 8 %t, i64 %k) {
; CHECK: func callee_t ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rax: i64, [$rbp + 16]: i64, )
; CHECK-NEXT:    $al: i32 = [$rax + 19]: i8
; CHECK-NEXT:    mov_zx($rax: i64, $al: i8, )
; CHECK-NEXT:    $rax: i64 += $rdi: i64
; CHECK-NEXT:    ret($rax: i64, )
  %p = getelementptr inbounds %struct.T, ptr %t, i32 0, i32 0, i32 19
  %b = load i8, ptr %p
  %e = zext i8 %b to i64
  %r = add i64 %e, %k
  ret i64 %r
}

define i64 @caller_t(ptr %p, i64 %k) {
; CHECK: func caller_t ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = [$rdi + 12]: i64
; CHECK-NEXT:    shr2($rax: i64, 32: i8, )
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($rax: i64, )
; CHECK-NEXT:    push([$rdi + 8]: i64, )
; CHECK-NEXT:    push([$rdi + 0]: i64, )
; CHECK-NEXT:    $rdi: i64 = $rsi: i64
; CHECK-NEXT:    call(ext_t, )
; CHECK-NEXT:    $rsp: i64 += 24: i32
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    ret($rax: i64, )
  %r = call i64 @ext_t(ptr byval(%struct.T) align 8 %p, i64 %k)
  ret i64 %r
}

; 16 byte alignment, an odd slot index gets a padding slot
define i64 @callee_a(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, i64 %g, ptr byval(%struct.A) align 16 %s, i64 %k) {
; CHECK: func callee_a ($2: i64, $3: i64, $4: i64, $5: i64, $6: i64, $7: i64, $8: i64, $9: i64, $10: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r11: i64 = [$rbp + 56]: i64
; CHECK-NEXT:    lea($rax: i64, [$rbp + 32]: i64, )
; CHECK-NEXT:    $r10: i64 = [$rbp + 16]: i64
; CHECK-NEXT:    $rax: i64 += 16: i64
; CHECK-NEXT:    $rax: i64 = [$rax]: i64
; CHECK-NEXT:    $rax: i64 += $r11: i64
; CHECK-NEXT:    ret($rax: i64, )
  %pc = getelementptr inbounds %struct.A, ptr %s, i32 0, i32 2
  %x = load i64, ptr %pc
  %r = add i64 %x, %k
  ret i64 %r
}

define i64 @caller_a(ptr %p) {
; CHECK: func caller_a ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    push(8: i64, )
; CHECK-NEXT:    push([$rdi + 16]: i64, )
; CHECK-NEXT:    push([$rdi + 8]: i64, )
; CHECK-NEXT:    push([$rdi + 0]: i64, )
; CHECK-NEXT:    push(0: i64, )
; CHECK-NEXT:    push(7: i64, )
; CHECK-NEXT:    $rdi: i64 = 1: i64
; CHECK-NEXT:    $rsi: i64 = 2: i64
; CHECK-NEXT:    $rdx: i64 = 3: i64
; CHECK-NEXT:    $rcx: i64 = 4: i64
; CHECK-NEXT:    $r8: i64 = 5: i64
; CHECK-NEXT:    $r9: i64 = 6: i64
; CHECK-NEXT:    call(ext_a, )
; CHECK-NEXT:    $rsp: i64 += 48: i32
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-EMPTY:
; CHECK-NEXT:ext_s
; CHECK-NEXT:ext_t
; CHECK-NEXT:ext_a
  %r = call i64 @ext_a(i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, ptr byval(%struct.A) align 16 %p, i64 8)
  ret i64 %r
}
