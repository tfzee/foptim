; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir | FileCheck %s

; there is no 8 bit cmov, the abs is done on the sign extended value
define i8 @abs_i8(i8 %x) {
; CHECK: func abs_i8 ($2: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_sx($ecx: i32, $ldi: i8, )
; CHECK-NEXT:    abs($eax: i32, $ecx: i32, )
; CHECK-NEXT:    ret($al: i8, )
  %c = icmp slt i8 %x, 0
  %n = sub i8 0, %x
  %r = select i1 %c, i8 %n, i8 %x
  ret i8 %r
}
