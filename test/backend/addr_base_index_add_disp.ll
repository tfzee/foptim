; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; base + (index + constant) is one address with a displacement

define i8 @load_disp(ptr %p, i64 %i) {
; CHECK: func load_disp ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi + $rsi + 5]: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %j = add i64 %i, 5
  %a = getelementptr inbounds i8, ptr %p, i64 %j
  %v = load i8, ptr %a
  ret i8 %v
}

define void @store_disp(ptr %p, i64 %i, i8 %v) {
; CHECK: func store_disp ($2: i64, $3: i64, $4: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi + $rsi + 7]: i8 = $dl: i8
; CHECK-NEXT:    ret()
  %j = add i64 %i, 7
  %a = getelementptr inbounds i8, ptr %p, i64 %j
  store i8 %v, ptr %a
  ret void
}

; the displacement does not fit 32 bits, so the add stays
define i8 @load_big_disp(ptr %p, i64 %i) {
; CHECK: func load_big_disp ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = 8589934592: i64
; CHECK-NEXT:    $rsi: i64 += $rax: i64
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi + $rsi]: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %j = add i64 %i, 8589934592
  %a = getelementptr inbounds i8, ptr %p, i64 %j
  %v = load i8, ptr %a
  ret i8 %v
}

; a 32 bit index add wraps before it is extended, it must stay an add
define i8 @load_i32_index(ptr %p, i32 %i) {
; CHECK: func load_i32_index ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $esi: i32 += 5: i32
; CHECK-NEXT:    mov_zx($rax: i64, $esi: i32, )
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi + $rax]: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %j = add i32 %i, 5
  %k = zext i32 %j to i64
  %a = getelementptr inbounds i8, ptr %p, i64 %k
  %v = load i8, ptr %a
  ret i8 %v
}
