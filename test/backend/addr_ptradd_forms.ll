; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; Addressing modes of loads and stores through pointer adds: base + index +
; displacement, label + displacement, base + displacement and base + index.

@g = global [64 x i32] zeroinitializer, align 16
@e = external global [64 x i32]

define i32 @load_base_index_disp(ptr %x, i64 %y) {
; CHECK: func load_base_index_disp ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [$rdi + $rsi + 24]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %a = getelementptr i8, ptr %x, i64 %y
  %b = getelementptr i8, ptr %a, i64 24
  %v = load i32, ptr %b
  ret i32 %v
}

define i32 @load_base_disp_index(ptr %x, i64 %y) {
; CHECK: func load_base_disp_index ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [$rdi + $rsi + 24]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %a = getelementptr i8, ptr %x, i64 24
  %b = getelementptr i8, ptr %a, i64 %y
  %v = load i32, ptr %b
  ret i32 %v
}

define void @store_base_index_disp(ptr %x, i64 %y, i32 %v) {
; CHECK: func store_base_index_disp ($2: i64, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi + $rsi + 24]: i32 = $edx: i32
; CHECK-NEXT:    ret()
  %a = getelementptr i8, ptr %x, i64 %y
  %b = getelementptr i8, ptr %a, i64 24
  store i32 %v, ptr %b
  ret void
}

define void @store_base_disp_index(ptr %x, i64 %y, i32 %v) {
; CHECK: func store_base_disp_index ($2: i64, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi + $rsi + 24]: i32 = $edx: i32
; CHECK-NEXT:    ret()
  %a = getelementptr i8, ptr %x, i64 24
  %b = getelementptr i8, ptr %a, i64 %y
  store i32 %v, ptr %b
  ret void
}

define i32 @load_label_disp() {
; CHECK: func load_label_disp ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [g + 20]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %p = getelementptr i8, ptr @g, i64 20
  %v = load i32, ptr %p
  ret i32 %v
}

define void @store_label_disp(i32 %v) {
; CHECK: func store_label_disp ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [g + 20]: i32 = $edi: i32
; CHECK-NEXT:    ret()
  %p = getelementptr i8, ptr @g, i64 20
  store i32 %v, ptr %p
  ret void
}

define i32 @load_extern_disp() {
; CHECK: func load_extern_disp ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = [e]: i64
; CHECK-NEXT:    $eax: i32 = [$rax + 20]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %p = getelementptr i8, ptr @e, i64 20
  %v = load i32, ptr %p
  ret i32 %v
}

define i32 @load_base_disp(ptr %x) {
; CHECK: func load_base_disp ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [$rdi + 12]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %p = getelementptr i8, ptr %x, i64 12
  %v = load i32, ptr %p
  ret i32 %v
}

define void @store_base_disp(ptr %x, i32 %v) {
; CHECK: func store_base_disp ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi + 12]: i32 = $esi: i32
; CHECK-NEXT:    ret()
  %p = getelementptr i8, ptr %x, i64 12
