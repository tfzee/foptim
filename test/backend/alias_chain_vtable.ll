; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; a global initializer that points at an alias of an alias of a function (the D1 / D2 destructor aliases of a class
; with a base class end up like this in a vtable), the loader used to abort on it

@vtable = global [1 x ptr] [ptr @dtor_complete]
@dtor_complete = unnamed_addr alias void (ptr), ptr @dtor_base_object
@dtor_base_object = unnamed_addr alias void (ptr), ptr @dtor_base

define void @dtor_base(ptr %p) {
; CHECK: func dtor_base ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 = 0: i32
; CHECK-NEXT:    ret()
  store i32 0, ptr %p, align 4
  ret void
}

define void @call_slot(ptr %p) {
; CHECK: func call_slot ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = $rdi: i64
; CHECK-NEXT:    $rax: i64 = [vtable]: i64
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($rax: i64, )
; CHECK-NEXT:    $rdi: i64 = $rcx: i64
; CHECK-NEXT:    call($rax: i64, )
; CHECK-NEXT:    pop($rax: i64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    ret()
  %f = load ptr, ptr @vtable, align 8
  call void %f(ptr %p)
  ret void
}
