; a constant new value needs a register, cmpxchg has no immediate form
define i1 @cas_const_new(ptr %p, i32 %e) {
; CHECK: func cas_const_new ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ecx: i32 = 7: i32
; CHECK-NEXT:    $eax: i32 = $esi: i32
; CHECK-NEXT:    LockCmpXchg3([$rdi]: i32, $ecx: i32, $eax: i32, )
; CHECK-NEXT:    icmp_eq($al: i8, $eax: i32, $esi: i32, )
; CHECK-NEXT:    ret($al: i8, )
  %r = cmpxchg ptr %p, i32 %e, i32 7 seq_cst seq_cst
  %ok = extractvalue { i32, i1 } %r, 1
  ret i1 %ok
}

; a global as address
@g = global i64 0
define i64 @cas_global(i64 %e, i64 %n) {
; CHECK: func cas_global ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    lea($rcx: i64, [g]: i64, )
; CHECK-NEXT:    LockCmpXchg3([$rcx]: i64, $rsi: i64, $rax: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  %r = cmpxchg ptr @g, i64 %e, i64 %n seq_cst seq_cst
  %o = extractvalue { i64, i1 } %r, 0
  ret i64 %o
}
