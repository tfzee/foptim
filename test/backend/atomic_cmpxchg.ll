; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; cmpxchg selects lock cmpxchg with the expected value moved into rax. The success
; flag is the compare of the old value with the expected one.

define i8 @cas_old_i8(ptr %p, i8 %e, i8 %n) {
; CHECK: func cas_old_i8 ($2: i64, $3: i8, $4: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $al: i8 = $lsi: i8
; CHECK-NEXT:    LockCmpXchg3([$rdi]: i8, $dl: i8, $al: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %r = cmpxchg ptr %p, i8 %e, i8 %n seq_cst seq_cst
  %o = extractvalue { i8, i1 } %r, 0
  ret i8 %o
}

define i1 @cas_ok_i8(ptr %p, i8 %e, i8 %n) {
; CHECK: func cas_ok_i8 ($2: i64, $3: i8, $4: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $al: i8 = $lsi: i8
; CHECK-NEXT:    LockCmpXchg3([$rdi]: i8, $dl: i8, $al: i8, )
; CHECK-NEXT:    icmp_eq($al: i8, $al: i8, $lsi: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %r = cmpxchg ptr %p, i8 %e, i8 %n seq_cst seq_cst
  %ok = extractvalue { i8, i1 } %r, 1
  ret i1 %ok
}

