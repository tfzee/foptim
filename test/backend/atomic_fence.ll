; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Only a seq_cst fence needs an instruction on x86, the weaker ones are compiler barriers.

define void @fence_acquire(ptr %p) {
; CHECK: func fence_acquire ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 = 1: i32
; CHECK-NEXT:    ret()
  store i32 1, ptr %p
  fence acquire
  ret void
}

define void @fence_release(ptr %p) {
; CHECK: func fence_release ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 = 1: i32
; CHECK-NEXT:    ret()
  store i32 1, ptr %p
  fence release
  ret void
}

define void @fence_acq_rel(ptr %p) {
; CHECK: func fence_acq_rel ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 = 1: i32
; CHECK-NEXT:    ret()
  store i32 1, ptr %p
  fence acq_rel
  ret void
}

define i32 @fence_seq_cst(ptr %p, ptr %q) {
; CHECK: func fence_seq_cst ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 = 1: i32
; CHECK-NEXT:    mfence()
; CHECK-NEXT:    $eax: i32 = [$rsi]: i32
; CHECK-NEXT:    ret($eax: i32, )
  store i32 1, ptr %p
  fence seq_cst
  %v = load i32, ptr %q
  ret i32 %v
}
