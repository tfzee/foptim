define i8 @and_used_i8(ptr %p, i8 %v) {
; CHECK: func and_used_i8 ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8l: i8 = $lsi: i8
; CHECK-NEXT:    $cl: i32 = [$rdi]: i8
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    $lsi: i8 = $cl: i8
; CHECK-NEXT:    $dl: i8 = $cl: i8
; CHECK-NEXT:    land2($dl: i8, $r8l: i8, )
; CHECK-NEXT:    $al: i8 = $cl: i8
; CHECK-NEXT:    LockCmpXchg3([$rdi]: i8, $dl: i8, $al: i8, )
; CHECK-NEXT:    cjmp_int_eq($al: i8, $cl: i8, ) -> 3
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    $cl: i8 = $al: i8
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  3:
; CHECK-NEXT:    $al: i8 = $lsi: i8
; CHECK-NEXT:    ret($al: i8, )
  %r = atomicrmw and ptr %p, i8 %v seq_cst
  ret i8 %r
}

