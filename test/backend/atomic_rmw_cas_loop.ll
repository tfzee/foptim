; the result is unused: nand and max still need the loop, and does not
define void @nand_unused(ptr %p, i32 %v) {
; CHECK: func nand_unused ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ecx: i32 = [$rdi]: i32
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    $edx: i32 = $ecx: i32
; CHECK-NEXT:    land2($edx: i32, $esi: i32, )
; CHECK-NEXT:    $edx: i32 ^= -1: i32
; CHECK-NEXT:    $eax: i32 = $ecx: i32
; CHECK-NEXT:    LockCmpXchg3([$rdi]: i32, $edx: i32, $eax: i32, )
; CHECK-NEXT:    cjmp_int_eq($eax: i32, $ecx: i32, ) -> 3
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    $ecx: i32 = $eax: i32
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  3:
; CHECK-NEXT:    ret()
  %r = atomicrmw nand ptr %p, i32 %v seq_cst
  ret void
}
