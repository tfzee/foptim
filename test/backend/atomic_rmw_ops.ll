; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; atomicrmw ops with one x86 instruction. With a used result add and sub are
; lock xadd (sub negates first), xchg is xchg, without a user they are lock ops with
; an immediate where it fits.

define i8 @add_used_i8(ptr %p, i8 %v) {
; CHECK: func add_used_i8 ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $al: i8 = $lsi: i8
; CHECK-NEXT:    LockXAdd2([$rdi]: i8, $al: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %r = atomicrmw add ptr %p, i8 %v seq_cst
  ret i8 %r
}

define i8 @sub_used_i8(ptr %p, i8 %v) {
; CHECK: func sub_used_i8 ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $al: i8 = $lsi: i8
; CHECK-NEXT:    neg1($al: i8, )
; CHECK-NEXT:    LockXAdd2([$rdi]: i8, $al: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %r = atomicrmw sub ptr %p, i8 %v seq_cst
  ret i8 %r
}

