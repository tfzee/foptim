; The loop vectorizer turns the fill into a broadcast of a 16 x i32 vector.
define void @fill(ptr noalias %p, i64 %n, i32 %v) {
; CHECK: func fill ($2: i64, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8: i64 = 1: i64
; CHECK-NEXT:    cmov_slt($r8: i64, $rsi: i64, $r8: i64, $rsi: i64, )
; CHECK-NEXT:    $rcx: i64 = $r8: i64
; CHECK-NEXT:    land2($rcx: i64, -16: i64, )
; CHECK-NEXT:    $mm0: f32 = $edx: i32
; CHECK-NEXT:    vbroadcast($zmm0: i32x16, $mm0: f32, )
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, 0: i64, ) -> 5
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    [$rdi + $rax *4]: i32x16 = $zmm0: i32x16
; CHECK-NEXT:    $rax: i64 += 16: i64
; CHECK-NEXT:    cjmp_int_ne($rax: i64, $rcx: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 3
; CHECK-NEXT:  3:
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, $r8: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    [$rdi + $rax *4]: i32 = $edx: i32
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_eq($rax: i64, $rsi: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  7:
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %g = getelementptr inbounds i32, ptr %p, i64 %i
  store i32 %v, ptr %g, align 4
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp eq i64 %i.next, %n
  br i1 %c, label %exit, label %loop
exit:
  ret void
}
