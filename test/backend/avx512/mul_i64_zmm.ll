; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs --cconffile %S/avx512.toml | FileCheck %s
; RUN: %foffcc %s %t.o --cconffile %S/avx512.toml
; vpmullq only exists as evex, so it needs the k0 operand (also on ymm). The sum
; loop reduces its vectors through the extract halves.
define void @mul(ptr noalias %a, ptr noalias %b, i64 %n) {
; CHECK: func mul ($2: i64, $3: i64, $4: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8: i64 = 1: i64
; CHECK-NEXT:    cmov_slt($r8: i64, $rdx: i64, $r8: i64, $rdx: i64, )
; CHECK-NEXT:    $rcx: i64 = $r8: i64
; CHECK-NEXT:    land2($rcx: i64, -8: i64, )
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, 0: i64, ) -> 5
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    $zmm0: i64x8 = [$rdi + $rax *8]: i64x8
; CHECK-NEXT:    $zmm0: i64x8 = $zmm0: i64x8 * [$rsi + $rax *8]: i64x8
; CHECK-NEXT:    [$rdi + $rax *8]: i64x8 = $zmm0: i64x8
; CHECK-NEXT:    $rax: i64 += 8: i64
; CHECK-NEXT:    cjmp_int_ne($rax: i64, $rcx: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 3
; CHECK-NEXT:  3:
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, $r8: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    $rcx: i64 = [$rdi + $rax *8]: i64
; CHECK-NEXT:    $rcx: i64 *= [$rsi + $rax *8]: i64
; CHECK-NEXT:    [$rdi + $rax *8]: i64 = $rcx: i64
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_eq($rax: i64, $rdx: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  7:
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %pa = getelementptr i64, ptr %a, i64 %i
  %x = load i64, ptr %pa
  %pb = getelementptr i64, ptr %b, i64 %i
  %y = load i64, ptr %pb
  %r = mul i64 %x, %y
  store i64 %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1
  %c = icmp eq i64 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret void
}

define i64 @sum(ptr noalias %a, i64 %n) {
; CHECK: func sum ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8: i64 = 1: i64
; CHECK-NEXT:    cmov_slt($r8: i64, $rsi: i64, $r8: i64, $rsi: i64, )
; CHECK-NEXT:    $rdx: i64 = $r8: i64
; CHECK-NEXT:    land2($rdx: i64, -4: i64, )
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    clear $rcx: i64
; CHECK-NEXT:    cjmp_int_eq($rdx: i64, 0: i64, ) -> 5
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    clear $ymm0: i64x4
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    $ymm0: i64x4 = $ymm0: i64x4 + [$rdi + $rax *8]: i64x4
; CHECK-NEXT:    $rax: i64 += 4: i64
; CHECK-NEXT:    cjmp_int_ne($rax: i64, $rdx: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 3
; CHECK-NEXT:  3:
; CHECK-NEXT:    vextract128($xmm1: i64x2, $ymm0: i64x4, 1: i8, )
; CHECK-NEXT:    $xmm0: i64x2 = $xmm1: i64x2 + $xmm0: i64x2
; CHECK-NEXT:    vpshuf($xmm1: i32x4, $xmm0: i32x4, 238: i8, )
; CHECK-NEXT:    $xmm0: i64x2 = $xmm0: i64x2 + $xmm1: i64x2
; CHECK-NEXT:    vpextr($rcx: i64, $xmm0: i64x2, 0: i8, )
; CHECK-NEXT:    cjmp_int_eq($rdx: i64, $r8: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    $rcx: i64 += [$rdi + $rax *8]: i64
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_eq($rax: i64, $rsi: i64, ) -> 7
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  7:
; CHECK-NEXT:    $rax: i64 = $rcx: i64
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret($rax: i64, )
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %s = phi i64 [ 0, %entry ], [ %s1, %loop ]
  %pa = getelementptr i64, ptr %a, i64 %i
  %x = load i64, ptr %pa
  %s1 = add i64 %s, %x
  %i1 = add nuw nsw i64 %i, 1
  %c = icmp eq i64 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret i64 %s1
}
