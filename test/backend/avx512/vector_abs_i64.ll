; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs --cconffile %S/avx512.toml | FileCheck %s

; with avx512vl the 64 bit abs is a single vpabsq
define void @abs_v4i64(ptr %d, ptr %s) {
; CHECK: func abs_v4i64 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i64x4 = [$rsi]: i64x4
; CHECK-NEXT:    vpabs($ymm0: i64x4, $ymm0: i64x4, )
; CHECK-NEXT:    [$rdi]: i64x4 = $ymm0: i64x4
; CHECK-NEXT:    ret()
  %v = load <4 x i64>, ptr %s, align 32
  %a = call <4 x i64> @llvm.abs.v4i64(<4 x i64> %v, i1 false)
  store <4 x i64> %a, ptr %d, align 32
  ret void
}

declare <4 x i64> @llvm.abs.v4i64(<4 x i64>, i1)
