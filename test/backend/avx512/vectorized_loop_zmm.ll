; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs --cconffile %S/avx512.toml | FileCheck %s
; RUN: %foffcc %s %t.o --cconffile %S/avx512.toml
; With avx512f the loop vectorizer picks a vector factor of 16 (zmm) and the backend encodes the vector fadd.

define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, i64 %n) {
; CHECK: func f ($2: i64, $3: i64, $4: i64, $5: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8: i64 = $rcx: i64
; CHECK-NEXT:    $r9: i64 = 1: i64
; CHECK-NEXT:    cmov_slt($r9: i64, $r8: i64, $r9: i64, $r8: i64, )
; CHECK-NEXT:    cjmp_int_sgt($r8: i64, 0: i64, ) -> 3
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    $mm0: f32 = [$rsi + $rax *4]: f32
; CHECK-NEXT:    $mm0: f32 = $mm0: f32 + [$rdx + $rax *4]: f32
; CHECK-NEXT:    [$rdi + $rax *4]: f32 = $mm0: f32
; CHECK-NEXT:    $rcx: i64 = $rax: i64
; CHECK-NEXT:    $rcx: i64 += 1: i64
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_slt($rcx: i64, $r8: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  3:
; CHECK-NEXT:    $rcx: i64 = $r9: i64
; CHECK-NEXT:    land2($rcx: i64, -16: i64, )
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, 0: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    $zmm0: f32x16 = [$rsi + $rax *4]: f32x16
; CHECK-NEXT:    $zmm0: f32x16 = $zmm0: f32x16 + [$rdx + $rax *4]: f32x16
; CHECK-NEXT:    [$rdi + $rax *4]: f32x16 = $zmm0: f32x16
; CHECK-NEXT:    $rax: i64 += 16: i64
; CHECK-NEXT:    cjmp_int_ne($rax: i64, $rcx: i64, ) -> 5
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, $r9: i64, ) -> 1
; CHECK-NEXT:    jmp() -> 7
; CHECK-NEXT:  7:
; CHECK-NEXT:    jmp() -> 2
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %pb = getelementptr float, ptr %b, i64 %i
  %x = load float, ptr %pb
  %pc = getelementptr float, ptr %c, i64 %i
  %y = load float, ptr %pc
  %r = fadd float %x, %y
  %pa = getelementptr float, ptr %a, i64 %i
  store float %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
