; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; pext of a register, with a mask in a register and with a constant mask
; (which has no immediate form).

declare i32 @llvm.x86.bmi.pext.32(i32, i32)
declare i64 @llvm.x86.bmi.pext.64(i64, i64)

define i32 @pext32(i32 %a, i32 %m) {
; CHECK: func pext32 ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    pext($eax: i32, $edi: i32, $esi: i32, )
; CHECK-NEXT:    ret($eax: i32, )
  %r = call i32 @llvm.x86.bmi.pext.32(i32 %a, i32 %m)
  ret i32 %r
}

define i64 @pext64_const(i64 %a) {
; CHECK: func pext64_const ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = 1099511629856: i64
; CHECK-NEXT:    pext($rax: i64, $rdi: i64, $rax: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  %r = call i64 @llvm.x86.bmi.pext.64(i64 %a, i64 1099511629856)
  ret i64 %r
}
