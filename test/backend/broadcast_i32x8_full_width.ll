; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; the broadcast of a scalar into a ymm register has to fill both 128 bit
; halves (vpshufd alone only fills the lower one)
define void @fill(ptr noalias %p, i32 %x, i32 %n) {
; CHECK: func fill ($2: i64, $3: i32, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $r8d: i32 = $edx: i32
; CHECK-NEXT:    $r9d: i32 = 1: i32
; CHECK-NEXT:    cmov_slt($r9d: i32, $r8d: i32, $r9d: i32, $r8d: i32, )
; CHECK-NEXT:    cjmp_int_sgt($r8d: i32, 0: i32, ) -> 3
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    mov_sx($rax: i64, $ecx: i32, )
; CHECK-NEXT:    [$rdi + $rax *4]: i32 = $esi: i32
; CHECK-NEXT:    $eax: i32 = $ecx: i32
; CHECK-NEXT:    $eax: i32 += 1: i32
; CHECK-NEXT:    $ecx: i32 += 1: i32
; CHECK-NEXT:    cjmp_int_slt($eax: i32, $r8d: i32, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  3:
; CHECK-NEXT:    $edx: i32 = $r9d: i32
; CHECK-NEXT:    land2($edx: i32, -8: i32, )
; CHECK-NEXT:    $mm0: f32 = $esi: i32
; CHECK-NEXT:    vbroadcast($ymm0: i32x8, $mm0: f32, )
; CHECK-NEXT:    clear $ecx: i32
; CHECK-NEXT:    cjmp_int_eq($edx: i32, 0: i32, ) -> 2
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    clear $eax: i32
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    mov_sx($rcx: i64, $eax: i32, )
; CHECK-NEXT:    [$rdi + $rcx *4]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    $ecx: i32 = $eax: i32
; CHECK-NEXT:    $ecx: i32 += 8: i32
; CHECK-NEXT:    $eax: i32 += 8: i32
; CHECK-NEXT:    cjmp_int_ne($ecx: i32, $edx: i32, ) -> 5
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    cjmp_int_eq($edx: i32, $r9d: i32, ) -> 1
; CHECK-NEXT:    jmp() -> 7
; CHECK-NEXT:  7:
; CHECK-NEXT:    jmp() -> 2
entry:
  br label %cond
cond:
  %i = phi i32 [ 0, %entry ], [ %inc, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %end
body:
  %idx = sext i32 %i to i64
  %q = getelementptr inbounds i32, ptr %p, i64 %idx
  store i32 %x, ptr %q
  %inc = add i32 %i, 1
  br label %cond
end:
  ret void
}
