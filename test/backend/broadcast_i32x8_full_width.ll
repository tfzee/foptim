; the broadcast of a scalar into a ymm register has to fill both 128 bit
; halves (vpshufd alone only fills the lower one)
define void @fill(ptr noalias %p, i32 %x, i32 %n) {
; CHECK: func fill ($2: i64, $3: i32, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edx: i32
; CHECK-NEXT:    mov_sx($rdx: i64, $eax: i32, )
; CHECK-NEXT:    $r8: i64 = 1: i64
; CHECK-NEXT:    cmov_slt($r8: i64, $rdx: i64, $r8: i64, $rdx: i64, )
; CHECK-NEXT:    cjmp_int_sgt($eax: i32, 0: i32, ) -> 3
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    [$rdi + $rax *4]: i32 = $esi: i32
; CHECK-NEXT:    $rcx: i64 = $rax: i64
; CHECK-NEXT:    $rcx: i64 += 1: i64
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_slt($rcx: i64, $rdx: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  3:
; CHECK-NEXT:    $rcx: i64 = $r8: i64
; CHECK-NEXT:    land2($rcx: i64, -8: i64, )
; CHECK-NEXT:    $mm0: f32 = $esi: i32
; CHECK-NEXT:    vbroadcast($ymm0: i32x8, $mm0: f32, )
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, 0: i64, ) -> 2
; CHECK-NEXT:    jmp() -> 4
; CHECK-NEXT:  4:
; CHECK-NEXT:    clear $rax: i64
; CHECK-NEXT:    jmp() -> 5
; CHECK-NEXT:  5:
; CHECK-NEXT:    [$rdi + $rax *4]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    $rax: i64 += 8: i64
; CHECK-NEXT:    cjmp_int_ne($rax: i64, $rcx: i64, ) -> 5
; CHECK-NEXT:    jmp() -> 6
; CHECK-NEXT:  6:
; CHECK-NEXT:    cjmp_int_eq($rcx: i64, $r8: i64, ) -> 1
; CHECK-NEXT:    jmp() -> 7
; CHECK-NEXT:  7:
; CHECK-NEXT:    jmp() -> 2
entry:
  br label %cond
cond:
  %i = phi i32 [ 0, %entry ], [ %inc, %body ]
