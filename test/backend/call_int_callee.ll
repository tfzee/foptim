; a call through a non function constant (SQLITE_TRANSIENT is -1) must not crash the matcher
define void @call_minus_one(ptr %p, i1 %c) {
; CHECK: func call_minus_one ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    cjmp($lsi: i8, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    $rcx: i64 = -1: i64
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($rcx: i64, )
; CHECK-NEXT:    $rdi: i64 = $rax: i64
; CHECK-NEXT:    call($rcx: i64, )
; CHECK-NEXT:    pop($rcx: i64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    ret()
entry:
  br i1 %c, label %a, label %b
a:
  call void inttoptr (i64 -1 to ptr)(ptr %p)
  ret void
b:
  ret void
}
