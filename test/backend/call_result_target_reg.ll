; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; The register of an indirect call target is still alive at the call. It must not be
; saved and restored behind the call when the result is copied into that register.

declare i8 @fa(ptr)
declare i8 @fb(ptr)

define i32 @f(ptr %s, i32 %x) {
; CHECK: func f ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    $ebx: i32 = $esi: i32
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    $dl: i32 = [$rax]: i8
; CHECK-NEXT:    lea($rsi: i64, [fa]: i64, )
; CHECK-NEXT:    lea($rcx: i64, [fb]: i64, )
; CHECK-NEXT:    cmov_ne($rcx: i64, $rsi: i64, $dl: i8, 0: i8, )
; CHECK-NEXT:    $rdi: i64 = $rax: i64
; CHECK-NEXT:    call($rcx: i64, )
; CHECK-NEXT:    $cl: i8 = $al: i8
; CHECK-NEXT:    $edx: i32 = -4: i32
; CHECK-NEXT:    cmov_ne($ebx: i32, $edx: i32, $cl: i8, 0: i8, )
; CHECK-NEXT:    $eax: i32 = $ebx: i32
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret($eax: i32, )
; CHECK-EMPTY:
; CHECK-NEXT:fa
; CHECK-NEXT:fb
entry:
  %m = load i8, ptr %s
  %c = icmp ne i8 %m, 0
  %fn = select i1 %c, ptr @fa, ptr @fb
  %r = call i8 %fn(ptr %s)
  %nz = icmp ne i8 %r, 0
  %v = select i1 %nz, i32 -4, i32 %x
  ret i32 %v
}
