; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Two floats live across a call are saved with 8 byte pushes each, the stack
; stays 16 byte aligned at the call so no extra padding is added.
declare void @g(i32)

define float @f(float %a, float %b, i32 %x) {
; CHECK: func f ($2: f32, $3: f32, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($rdi: i64, )
; CHECK-NEXT:    push($mm0: f32, )
; CHECK-NEXT:    push($mm1: f32, )
; CHECK-NEXT:    call(g, )
; CHECK-NEXT:    pop($mm1: f32, )
; CHECK-NEXT:    pop($mm0: f32, )
; CHECK-NEXT:    pop($rdi: i64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    push($mm0: f32, )
; CHECK-NEXT:    push($mm1: f32, )
; CHECK-NEXT:    call(g, )
; CHECK-NEXT:    pop($mm1: f32, )
; CHECK-NEXT:    pop($mm0: f32, )
; CHECK-NEXT:    $mm0: f32 = $mm0: f32 + $mm1: f32
; CHECK-NEXT:    ret($mm0: f32, )
; CHECK-EMPTY:
; CHECK-NEXT:g
  call void @g(i32 %x)
  call void @g(i32 %x)
  %r = fadd float %a, %b
  ret float %r
}
