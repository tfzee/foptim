; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; An alloca with a runtime size rounds the size up to 16 and moves rsp, the
; return gives the stack back from the copy of rsp taken at the function start
; (the pops of the saved registers run after it). The element count of an
; alloca is part of its size. The first function also has a constant alloca.

declare void @use(ptr, ptr)

define i64 @dyn(i64 %n) {
; CHECK: func dyn ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    $rbx: i64 = $rsp: i64
; CHECK-NEXT:    $rsp: i64 -= 16: i64
; CHECK-NEXT:    $rsi: i64 = $rsp: i64
; CHECK-NEXT:    $rdi: i64 += 15: i64
; CHECK-NEXT:    shr2($rdi: i64, 4: i8, )
; CHECK-NEXT:    shl2($rdi: i64, 4: i8, )
; CHECK-NEXT:    $rsp: i64 -= $rdi: i64
; CHECK-NEXT:    $rdi: i64 = $rsp: i64
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($rdi: i64, )
; CHECK-NEXT:    call(use, )
; CHECK-NEXT:    pop($rdi: i64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    $al: i32 = [$rdi + 1]: i8
; CHECK-NEXT:    mov_zx($rax: i64, $al: i8, )
; CHECK-NEXT:    $rsp: i64 = $rbx: i64
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret($rax: i64, )
entry:
  %fixed = alloca i32, i64 4, align 16
  %vla = alloca i8, i64 %n, align 16
  call void @use(ptr %vla, ptr %fixed)
  %p = getelementptr i8, ptr %vla, i64 1
  %v = load i8, ptr %p
  %r = zext i8 %v to i64
  ret i64 %r
}

define void @loop(i64 %n) {
; CHECK: func loop ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    push($r13: i64, )
; CHECK-NEXT:    push($r12: i64, )
; CHECK-NEXT:    $r12: i64 = $rdi: i64
; CHECK-NEXT:    $r13: i64 = $rsp: i64
; CHECK-NEXT:    clear $rbx: i64
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    $rax: i64 = $rbx: i64
; CHECK-NEXT:    $rax: i64 += 15: i64
; CHECK-NEXT:    shr2($rax: i64, 4: i8, )
; CHECK-NEXT:    shl2($rax: i64, 4: i8, )
; CHECK-NEXT:    $rsp: i64 -= $rax: i64
; CHECK-NEXT:    $rsi: i64 = $rsp: i64
; CHECK-NEXT:    $rdi: i64 = $rsi: i64
; CHECK-NEXT:    call(use, )
; CHECK-NEXT:    $rax: i64 = $rbx: i64
; CHECK-NEXT:    $rax: i64 += 1: i64
; CHECK-NEXT:    $rbx: i64 += 1: i64
; CHECK-NEXT:    cjmp_int_slt($rax: i64, $r12: i64, ) -> 1
; CHECK-NEXT:    jmp() -> 2
; CHECK-NEXT:  2:
; CHECK-NEXT:    $rsp: i64 = $r13: i64
; CHECK-NEXT:    pop($r12: i64, )
; CHECK-NEXT:    pop($r13: i64, )
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret()
; CHECK-EMPTY:
; CHECK-NEXT:use
entry:
  br label %body
body:
  %i = phi i64 [ 0, %entry ], [ %i.next, %body ]
  %a = alloca i8, i64 %i, align 16
  call void @use(ptr %a, ptr %a)
  %i.next = add i64 %i, 1
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %body, label %exit
exit:
  ret void
}
