; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; loads and stores of an extern global go through the GOT slot, the access keeps its own width
@g32 = external global i32, align 4
@g8 = external global i8, align 1

define i32 @load32() {
; CHECK: func load32 ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = [g32]: i64
; CHECK-NEXT:    $eax: i32 = [$rax]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %v = load i32, ptr @g32, align 4
  ret i32 %v
}

define void @store8(i8 %x) {
; CHECK: func store8 ($2: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = [g8]: i64
; CHECK-NEXT:    [$rax]: i8 = $ldi: i8
; CHECK-NEXT:    ret()
  store i8 %x, ptr @g8, align 1
  ret void
}
