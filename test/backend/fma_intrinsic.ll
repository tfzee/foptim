; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; llvm.fma keeps its single rounding, so it must not become a mul and an add

declare double @llvm.fma.f64(double, double, double)
declare float @llvm.fma.f32(float, float, float)
declare <4 x float> @llvm.fma.v4f32(<4 x float>, <4 x float>, <4 x float>)
declare <4 x double> @llvm.fma.v4f64(<4 x double>, <4 x double>, <4 x double>)

define double @fma_f64(double %a, double %b, double %c) {
; CHECK: func fma_f64 ($2: f64, $3: f64, $4: f64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm3: f64 = $mm2: f64
; CHECK-NEXT:    $mm2: f64 = $mm1: f64
; CHECK-NEXT:    ffmadd231($mm3: f64, $mm0: f64, $mm2: f64, )
; CHECK-NEXT:    $mm0: f64 = $mm3: f64
; CHECK-NEXT:    ret($mm0: f64, )
  %r = call double @llvm.fma.f64(double %a, double %b, double %c)
  ret double %r
}

define float @fma_f32(float %a, float %b, float %c) {
; CHECK: func fma_f32 ($2: f32, $3: f32, $4: f32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm3: f32 = $mm2: f32
; CHECK-NEXT:    $mm2: f32 = $mm1: f32
; CHECK-NEXT:    ffmadd231($mm3: f32, $mm0: f32, $mm2: f32, )
; CHECK-NEXT:    $mm0: f32 = $mm3: f32
; CHECK-NEXT:    ret($mm0: f32, )
  %r = call float @llvm.fma.f32(float %a, float %b, float %c)
  ret float %r
}

define <4 x float> @fma_v4f32(<4 x float> %a, <4 x float> %b, <4 x float> %c) {
; CHECK: func fma_v4f32 ($2: f32x4, $3: f32x4, $4: f32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm3: f32x4 = $xmm2: f32x4
; CHECK-NEXT:    $xmm2: f32x4 = $xmm1: f32x4
; CHECK-NEXT:    ffmadd231($xmm3: f32x4, $xmm0: f32x4, $xmm2: f32x4, )
; CHECK-NEXT:    $xmm0: f32x4 = $xmm3: f32x4
; CHECK-NEXT:    ret($xmm0: f32x4, )
  %r = call <4 x float> @llvm.fma.v4f32(<4 x float> %a, <4 x float> %b, <4 x float> %c)
  ret <4 x float> %r
}

define <4 x double> @fma_v4f64(<4 x double> %a, <4 x double> %b, <4 x double> %c) {
; CHECK: func fma_v4f64 ($2: f64x4, $3: f64x4, $4: f64x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm3: f64x4 = $ymm2: f64x4
; CHECK-NEXT:    $ymm2: f64x4 = $ymm1: f64x4
; CHECK-NEXT:    ffmadd231($ymm3: f64x4, $ymm0: f64x4, $ymm2: f64x4, )
; CHECK-NEXT:    $ymm0: f64x4 = $ymm3: f64x4
; CHECK-NEXT:    ret($ymm0: f64x4, )
  %r = call <4 x double> @llvm.fma.v4f64(<4 x double> %a, <4 x double> %b, <4 x double> %c)
  ret <4 x double> %r
}

define double @fma_const(double %c) {
; CHECK: func fma_const ($2: f64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = 3d
; CHECK-NEXT:    $mm1: f64 = $rax: i64
; CHECK-NEXT:    $rax: i64 = 5d
; CHECK-NEXT:    $mm2: f64 = $rax: i64
; CHECK-NEXT:    ffmadd231($mm0: f64, $mm1: f64, $mm2: f64, )
; CHECK-NEXT:    ret($mm0: f64, )
  %r = call double @llvm.fma.f64(double 3.0, double 5.0, double %c)
  ret double %r
}
