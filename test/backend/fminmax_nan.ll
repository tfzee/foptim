; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; minnum / maxnum: a NaN operand loses against a number, the hardware min / max returns its second operand
; instead, so the second operand is checked for NaN and the first one taken in that case.

declare float @llvm.minnum.f32(float, float)
declare double @llvm.maxnum.f64(double, double)
declare <4 x float> @llvm.minnum.v4f32(<4 x float>, <4 x float>)

define float @fmin_f32(float %a, float %b) {
; CHECK: func fmin_f32 ($2: f32, $3: f32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    fMin($mm2: f32, $mm0: f32, $mm1: f32, )
; CHECK-NEXT:    vcmp($xmm1: i32x4, $mm1: f32, $mm1: f32, 3: i8, )
; CHECK-NEXT:    vblendv($mm0: f32, $mm2: f32, $mm0: f32, $xmm1: i32x4, )
; CHECK-NEXT:    ret($mm0: f32, )
  %r = call float @llvm.minnum.f32(float %a, float %b)
  ret float %r
}

define double @fmax_f64(double %a, double %b) {
; CHECK: func fmax_f64 ($2: f64, $3: f64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    fMax($mm2: f64, $mm0: f64, $mm1: f64, )
; CHECK-NEXT:    vcmp($xmm1: i64x2, $mm1: f64, $mm1: f64, 3: i8, )
; CHECK-NEXT:    vblendv($mm0: f64, $mm2: f64, $mm0: f64, $xmm1: i64x2, )
; CHECK-NEXT:    ret($mm0: f64, )
  %r = call double @llvm.maxnum.f64(double %a, double %b)
  ret double %r
}

define <4 x float> @fmin_v4f32(<4 x float> %a, <4 x float> %b) {
; CHECK: func fmin_v4f32 ($2: f32x4, $3: f32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    fMin($xmm2: f32x4, $xmm0: f32x4, $xmm1: f32x4, )
; CHECK-NEXT:    vcmp($xmm1: f32x4, $xmm1: f32x4, $xmm1: f32x4, 3: i8, )
; CHECK-NEXT:    vblendv($xmm0: f32x4, $xmm2: f32x4, $xmm0: f32x4, $xmm1: f32x4, )
; CHECK-NEXT:    ret($xmm0: f32x4, )
  %r = call <4 x float> @llvm.minnum.v4f32(<4 x float> %a, <4 x float> %b)
  ret <4 x float> %r
}
