; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Loads are folded into the memory operand of their single user, also when the
; load is the first operand of a commutative op, and read modify write stores.

define double @fmul_fadd(ptr %a, ptr %b, double %c) {
; CHECK: func fmul_fadd ($2: i64, $3: i64, $4: f64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm1: f64 = [$rdi + 8]: f64
; CHECK-NEXT:    $mm1: f64 = $mm1: f64 * [$rsi + 16]: f64
; CHECK-NEXT:    $mm1: f64 = $mm1: f64 + $mm0: f64
; CHECK-NEXT:    $mm0: f64 = $mm1: f64
; CHECK-NEXT:    ret($mm0: f64, )
  %p = getelementptr inbounds double, ptr %a, i64 1
  %x = load double, ptr %p
  %q = getelementptr inbounds double, ptr %b, i64 2
  %y = load double, ptr %q
  %m = fmul double %x, %y
  %r = fadd double %m, %c
  ret double %r
}

define i64 @add_load_first(ptr %p, i64 %v) {
; CHECK: func add_load_first ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rsi: i64
; CHECK-NEXT:    $rax: i64 += [$rdi]: i64
; CHECK-NEXT:    ret($rax: i64, )
  %x = load i64, ptr %p
  %s = add i64 %x, %v
  ret i64 %s
}

define i32 @sub_load(ptr %p, i32 %v) {
; CHECK: func sub_load ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $esi: i32
; CHECK-NEXT:    $eax: i32 -= [$rdi]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %x = load i32, ptr %p
  %s = sub i32 %v, %x
  ret i32 %s
}

define i32 @and_or_xor(ptr %p, i32 %a) {
; CHECK: func and_or_xor ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $esi: i32
; CHECK-NEXT:    land2($eax: i32, [$rdi]: i32, )
; CHECK-NEXT:    lor2($eax: i32, [$rdi + 4]: i32, )
; CHECK-NEXT:    $eax: i32 ^= [$rdi + 8]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %x = load i32, ptr %p
  %s = and i32 %x, %a
  %q = getelementptr inbounds i32, ptr %p, i64 1
  %y = load i32, ptr %q
  %t = or i32 %y, %s
  %r = getelementptr inbounds i32, ptr %p, i64 2
  %z = load i32, ptr %r
  %u = xor i32 %t, %z
  ret i32 %u
}

define <4 x i32> @vand_load(ptr %p, <4 x i32> %a) {
; CHECK: func vand_load ($2: i64, $3: i32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vAnd($xmm0: i32x4, $xmm0: i32x4, [$rdi]: i32x4, )
; CHECK-NEXT:    ret($xmm0: i32x4, )
  %x = load <4 x i32>, ptr %p
  %s = and <4 x i32> %x, %a
  ret <4 x i32> %s
}

define void @rmw_add32(ptr %p, i32 %v) {
; CHECK: func rmw_add32 ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i32 += $esi: i32
; CHECK-NEXT:    ret()
  %x = load i32, ptr %p
  %s = add i32 %x, %v
  store i32 %s, ptr %p
  ret void
}

define void @rmw_xor8(ptr %p, i8 %v) {
; CHECK: func rmw_xor8 ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi]: i8 ^= $lsi: i8
; CHECK-NEXT:    ret()
  %x = load i8, ptr %p
  %s = xor i8 %v, %x
  store i8 %s, ptr %p
  ret void
}

define void @rmw_sub_imm_indexed(ptr %p, i64 %i) {
; CHECK: func rmw_sub_imm_indexed ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    [$rdi + $rsi *8]: i64 -= 5: i64
; CHECK-NEXT:    ret()
  %q = getelementptr inbounds i64, ptr %p, i64 %i
  %x = load i64, ptr %q
  %s = sub i64 %x, 5
  store i64 %s, ptr %q
  ret void
}

; a store between the load and its user must keep the load in front of it
define i32 @store_between(ptr %p, ptr %q, i32 %a) {
; CHECK: func store_between ($2: i64, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [$rdi]: i32
; CHECK-NEXT:    [$rsi]: i32 = 1: i32
; CHECK-NEXT:    $eax: i32 += $edx: i32
; CHECK-NEXT:    ret($eax: i32, )
  %x = load i32, ptr %p
  store i32 1, ptr %q
  %s = add i32 %a, %x
  ret i32 %s
}

; the load has another user, the stored value is not an rmw of the same address
define void @no_rmw(ptr %p, ptr %q, i32 %v) {
; CHECK: func no_rmw ($2: i64, $3: i64, $4: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edx: i32
; CHECK-NEXT:    $eax: i32 += [$rdi]: i32
; CHECK-NEXT:    [$rsi]: i32 = $eax: i32
; CHECK-NEXT:    ret()
  %x = load i32, ptr %p
  %s = add i32 %x, %v
  store i32 %s, ptr %q
  ret void
}

define i32 @volatile_load(ptr %p, i32 %v) {
; CHECK: func volatile_load ($2: i64, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = [$rdi]: i32
; CHECK-NEXT:    $eax: i32 += $esi: i32
; CHECK-NEXT:    ret($eax: i32, )
  %x = load volatile i32, ptr %p
  %s = add i32 %v, %x
  ret i32 %s
}
