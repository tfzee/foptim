; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir | FileCheck %s

; The frame address is a copy of rbp. A leaf function would otherwise get no
; prologue, reading rbp gives it the full one that sets rbp up.

declare ptr @llvm.frameaddress.p0(i32)

define i64 @frame() {
; CHECK: func frame ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rbp: i64
; CHECK-NEXT:    ret($rax: i64, )
  %f = call ptr @llvm.frameaddress.p0(i32 0)
  %i = ptrtoint ptr %f to i64
  ret i64 %i
}
