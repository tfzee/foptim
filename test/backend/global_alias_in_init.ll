; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; a global initializer may point at an alias (C1 / D1 constructor aliases in vtables)
@impl_alias = alias void (), ptr @impl
@vtable = constant { [2 x ptr] } { [2 x ptr] [ptr @impl_alias, ptr @impl] }

define void @impl() {
; CHECK: func impl ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    ret()
  ret void
}

define ptr @get() {
; CHECK: func get ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rax: i64, [vtable]: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  ret ptr @vtable
}
@gepd = constant ptr getelementptr inbounds (i8, ptr @impl_alias, i64 8)
