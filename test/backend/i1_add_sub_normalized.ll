; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; i1 values are kept as 0 or 1 in a byte register. A plain add / sub of two i1
; left 2 or 0xff in it and the branch then tested the whole byte, so the
; arithmetic has to be an xor.


define i64 @f(i64 %x, i64 %y, i64 %z) {
; CHECK: func f ($2: i64, $3: i64, $4: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdx: i64
; CHECK-NEXT:    itrunc($dl: i8, $rdi: i64, )
; CHECK-NEXT:    land2($dl: i8, 1: i8, )
; CHECK-NEXT:    itrunc($cl: i8, $rsi: i64, )
; CHECK-NEXT:    land2($cl: i8, 1: i8, )
; CHECK-NEXT:    itrunc($al: i8, $rax: i64, )
; CHECK-NEXT:    land2($al: i8, 1: i8, )
; CHECK-NEXT:    $dl: i8 ^= $cl: i8
; CHECK-NEXT:    $cl: i8 = $dl: i8
; CHECK-NEXT:    $cl: i8 ^= $al: i8
; CHECK-NEXT:    $rax: i64 = 2: i64
; CHECK-NEXT:    $rdx: i64 = 1: i64
; CHECK-NEXT:    cmov($rax: i64, $cl: i8, $rdx: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  %a = trunc i64 %x to i1
  %b = trunc i64 %y to i1
  %c = trunc i64 %z to i1
  %s = add i1 %a, %b
  %d = sub i1 %s, %c
  br i1 %d, label %t, label %e
t:
  ret i64 1
e:
  ret i64 2
}
