; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Compare flavors with a constant that does not fit a 32 bit immediate have to
; move the constant into a register first (the encoder cannot emit cmp r64,
; imm64).

define i1 @ult(i64 %x) {
; CHECK: func ult ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = 4294967296: i64
; CHECK-NEXT:    icmp_ult($al: i8, $rdi: i64, $rax: i64, )
; CHECK-NEXT:    ret($al: i8, )
  %c = icmp ult i64 %x, 4294967296
  ret i1 %c
}

