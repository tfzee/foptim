; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Inline asm is matched to asm_in / inline_asm / asm_out, the operand constraints
; are printed below the function. Register assignment of the operands is not
; implemented yet, so the registers in these CHECKs will change with it.

define void @pause() {
; CHECK: func pause ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    ret()
; CHECK-NEXT:  asm 0: "pause" sideeffect
  call void asm sideeffect "pause", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

define void @barrier() {
; CHECK: func barrier ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    ret()
; CHECK-NEXT:  asm 0: "" sideeffect memory
  call void asm sideeffect "", "~{memory},~{dirflag},~{fpsr},~{flags}"()
  ret void
}

define i64 @tied(i64 %a) {
; CHECK: func tied ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = $rdi: i64
; CHECK-NEXT:    asm_in($rcx: i64, 1: i32, )
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($rcx: i64, 0: i32, )
; CHECK-NEXT:    $rax: i64 = $rcx: i64
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-NEXT:  asm 0: "bswapq $0"
; CHECK-NEXT:    0: out reg tied 1
; CHECK-NEXT:    1: in reg
  %r = call i64 asm "bswapq $0", "=r,0,~{dirflag},~{fpsr},~{flags}"(i64 %a)
  ret i64 %r
}

define { i32, i32 } @rdtsc_like() {
; CHECK: func rdtsc_like ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($eax: i32, 0: i32, )
; CHECK-NEXT:    asm_out($edx: i32, 1: i32, )
; CHECK-NEXT:    ret($eax: i32, $edx: i32, )
; CHECK-NEXT:  asm 0: "rdtsc" sideeffect
; CHECK-NEXT:    0: out ax
; CHECK-NEXT:    1: out dx
  %r = call { i32, i32 } asm sideeffect "rdtsc", "={ax},={dx},~{dirflag},~{fpsr},~{flags}"()
  ret { i32, i32 } %r
}

define i64 @imm(i64 %a) {
; CHECK: func imm ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = $rdi: i64
; CHECK-NEXT:    asm_in($rcx: i64, 1: i32, )
; CHECK-NEXT:    asm_in(7: i64, 2: i32, )
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($rcx: i64, 0: i32, )
; CHECK-NEXT:    $rax: i64 = $rcx: i64
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-NEXT:  asm 0: "addq $2, $0"
; CHECK-NEXT:    0: out reg tied 1
; CHECK-NEXT:    1: in reg
; CHECK-NEXT:    2: in imm
  %r = call i64 asm "addq $2, $0", "=r,0,i,~{dirflag},~{fpsr},~{flags}"(i64 %a, i64 7)
  ret i64 %r
}
