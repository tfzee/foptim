; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Operands are pinned to registers like call arguments: a fixed register
; operand, an unpinned one that avoids the fixed and clobbered registers, values
; that live across the asm stay out of the clobbered registers.

define i64 @live_across_clobber(i64 %a, i64 %b, i64 %c) {
; CHECK: func live_across_clobber ($2: i64, $3: i64, $4: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    push($r13: i64, )
; CHECK-NEXT:    push($r12: i64, )
; CHECK-NEXT:    $r13: i64 = $rdx: i64
; CHECK-NEXT:    $r12: i64 = $rsi: i64
; CHECK-NEXT:    $rbx: i64 = $rdi: i64
; CHECK-NEXT:    asm_in($rbx: i64, 1: i32, )
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($rax: i64, 0: i32, )
; CHECK-NEXT:    asm_out($rcx: i64, 2: i32, )
; CHECK-NEXT:    asm_out($rdx: i64, 3: i32, )
; CHECK-NEXT:    asm_out($rsi: i64, 4: i32, )
; CHECK-NEXT:    asm_out($rdi: i64, 5: i32, )
; CHECK-NEXT:    asm_out($r8: i64, 6: i32, )
; CHECK-NEXT:    asm_out($r9: i64, 7: i32, )
; CHECK-NEXT:    asm_out($r10: i64, 8: i32, )
; CHECK-NEXT:    asm_out($r11: i64, 9: i32, )
; CHECK-NEXT:    $rax: i64 += $r12: i64
; CHECK-NEXT:    $rax: i64 += $r13: i64
; CHECK-NEXT:    pop($r12: i64, )
; CHECK-NEXT:    pop($r13: i64, )
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-NEXT:  asm 0: "xchg $0, $1" sideeffect
; CHECK-NEXT:    0: out reg
; CHECK-NEXT:    1: in reg
; CHECK-NEXT:    2: clobber rcx
; CHECK-NEXT:    3: clobber rdx
; CHECK-NEXT:    4: clobber rsi
; CHECK-NEXT:    5: clobber rdi
; CHECK-NEXT:    6: clobber r8
; CHECK-NEXT:    7: clobber r9
; CHECK-NEXT:    8: clobber r10
; CHECK-NEXT:    9: clobber r11
  %r = call i64 asm sideeffect "xchg $0, $1", "=r,r,~{rcx},~{rdx},~{rsi},~{rdi},~{r8},~{r9},~{r10},~{r11},~{dirflag},~{fpsr},~{flags}"(i64 %a)
  %s = add i64 %r, %b
  %t = add i64 %s, %c
  ret i64 %t
}

define i64 @mul_fixed(i64 %a, i64 %b) {
; CHECK: func mul_fixed ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = $rsi: i64
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    asm_in($rcx: i64, 2: i32, )
; CHECK-NEXT:    asm_in($rax: i64, 3: i32, )
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($rax: i64, 0: i32, )
; CHECK-NEXT:    asm_out($rdx: i64, 1: i32, )
; CHECK-NEXT:    $rax: i64 ^= $rdx: i64
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-NEXT:  asm 0: "mulq $2"
; CHECK-NEXT:    0: out ax tied 3
; CHECK-NEXT:    1: out dx
; CHECK-NEXT:    2: in reg
; CHECK-NEXT:    3: in reg
  %r = call { i64, i64 } asm "mulq $2", "={ax},={dx},r,0,~{dirflag},~{fpsr},~{flags}"(i64 %b, i64 %a)
  %lo = extractvalue { i64, i64 } %r, 0
  %hi = extractvalue { i64, i64 } %r, 1
  %x = xor i64 %lo, %hi
  ret i64 %x
}

define i64 @early_clobber(i64 %a, i64 %b) {
; CHECK: func early_clobber ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rdx: i64 = $rdi: i64
; CHECK-NEXT:    asm_in($rdx: i64, 1: i32, )
; CHECK-NEXT:    inline_asm(0: i32, )
; CHECK-NEXT:    asm_out($rcx: i64, 0: i32, )
; CHECK-NEXT:    $rax: i64 = $rcx: i64
; CHECK-NEXT:    $rax: i64 += $rsi: i64
; CHECK-NEXT:    ret($rax: i64, )
; CHECK-NEXT:  asm 0: "movq $1, $0"
; CHECK-NEXT:    0: out reg early
; CHECK-NEXT:    1: in reg
  %r = call i64 asm "movq $1, $0", "=&r,r,~{dirflag},~{fpsr},~{flags}"(i64 %a)
  %s = add i64 %r, %b
  ret i64 %s
}
