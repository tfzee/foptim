; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; (x + c) + y becomes a single three operand lea, also for a negative constant

define ptr @pos(ptr %x, i64 %y) {
; CHECK: func pos ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rax: i64, [$rdi + $rsi + 16]: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  %a = getelementptr i8, ptr %x, i64 16
  %b = getelementptr i8, ptr %a, i64 %y
  ret ptr %b
}

define ptr @neg(ptr %x, i64 %y) {
; CHECK: func neg ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rax: i64, [$rdi + $rsi + -24]: i64, )
; CHECK-NEXT:    ret($rax: i64, )
  %a = getelementptr i8, ptr %x, i64 -24
  %b = getelementptr i8, ptr %a, i64 %y
  ret ptr %b
}

; a displacement that does not fit 32 bits stays an add
define ptr @big(ptr %x, i64 %y) {
; CHECK: func big ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    $rcx: i64 = 8589934592: i64
; CHECK-NEXT:    $rax: i64 += $rcx: i64
; CHECK-NEXT:    $rax: i64 += $rsi: i64
; CHECK-NEXT:    ret($rax: i64, )
  %a = getelementptr i8, ptr %x, i64 8589934592
  %b = getelementptr i8, ptr %a, i64 %y
  ret ptr %b
}
