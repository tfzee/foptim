; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; Narrow loads must zero extend into a 32 bit register (movzx), a plain
; mov al, [m] merges into the old register value and chains loop iterations.
; A zero extension of the loaded value is fused into the load, unless the
; narrow value has other users.
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

define i8 @load_i8(ptr %p) {
; CHECK: func load_i8 ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi]: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %v = load i8, ptr %p
  ret i8 %v
}

define i32 @load_i16_zext(ptr %p) {
; CHECK: func load_i16_zext ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi]: i16, )
; CHECK-NEXT:    ret($eax: i32, )
  %v = load i16, ptr %p
  %z = zext i16 %v to i32
  ret i32 %z
}

define i64 @load_i8_zext64(ptr %p) {
; CHECK: func load_i8_zext64 ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($rax: i64, [$rdi]: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %v = load i8, ptr %p
  %z = zext i8 %v to i64
  ret i64 %z
}

define i64 @load_i8_two_users(ptr %p, ptr %q) {
; CHECK: func load_i8_two_users ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($eax: i32, [$rdi]: i8, )
; CHECK-NEXT:    [$rsi]: i8 = $al: i8
; CHECK-NEXT:    mov_zx($rax: i64, $al: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %v = load i8, ptr %p
  store i8 %v, ptr %q
  %z = zext i8 %v to i64
  ret i64 %z
}
