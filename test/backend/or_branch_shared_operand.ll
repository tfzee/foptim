; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; `br (a | b)` is selected as `or a, b; jnz`, which overwrites a. When a (here the compare %e) is used again by a
; later branch the overwritten register was read stale (stockfish: `moveCount == 1 || value > alpha` twice).
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

declare void @sink(i32)

define i32 @f(i32 %mc, i32 %v, i32 %a, i32 %w) {
; CHECK: func f ($2: i32, $3: i32, $4: i32, $5: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    icmp_eq($bl: i8, $edi: i32, 1: i32, )
; CHECK-NEXT:    icmp_sgt($al: i8, $esi: i32, $edx: i32, )
; CHECK-NEXT:    cjmp_or($al: i8, $bl: i8, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    icmp_sgt($al: i8, $ecx: i32, $edx: i32, )
; CHECK-NEXT:    lor2($bl: i8, $al: i8, )
; CHECK-NEXT:    $eax: i32 = 20: i32
; CHECK-NEXT:    $ecx: i32 = 10: i32
; CHECK-NEXT:    cmov($eax: i32, $bl: i8, $ecx: i32, )
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret($eax: i32, )
; CHECK-NEXT:  2:
; CHECK-NEXT:    push($rcx: i64, )
; CHECK-NEXT:    push($rdx: i64, )
; CHECK-NEXT:    $edi: i32 = 1: i32
; CHECK-NEXT:    call(sink, )
; CHECK-NEXT:    pop($rdx: i64, )
; CHECK-NEXT:    pop($rcx: i64, )
; CHECK-NEXT:    jmp() -> 1
; CHECK-EMPTY:
; CHECK-NEXT:sink
entry:
  %e = icmp eq i32 %mc, 1
  %g = icmp sgt i32 %v, %a
  %o = or i1 %e, %g
  br i1 %o, label %t1, label %n1
t1:
  call void @sink(i32 1)
  br label %n1
n1:
  %h = icmp sgt i32 %w, %a
  %o2 = or i1 %e, %h
  br i1 %o2, label %t2, label %n2
t2:
  ret i32 10
n2:
  ret i32 20
}
