; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; The signed overflow intrinsics and usub are lowered to plain arithmetic in
; FIR, no call to an llvm.* symbol is left.

declare { i32, i1 } @llvm.sadd.with.overflow.i32(i32, i32)
declare { i32, i1 } @llvm.ssub.with.overflow.i32(i32, i32)
declare { i32, i1 } @llvm.smul.with.overflow.i32(i32, i32)
declare { i64, i1 } @llvm.usub.with.overflow.i64(i64, i64)

define i1 @sadd_flag(i32 %a, i32 %b) {
; CHECK: func sadd_flag ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ecx: i32 = $edi: i32
; CHECK-NEXT:    $ecx: i32 += $esi: i32
; CHECK-NEXT:    $eax: i32 = $ecx: i32
; CHECK-NEXT:    $eax: i32 ^= $edi: i32
; CHECK-NEXT:    $ecx: i32 ^= $esi: i32
; CHECK-NEXT:    land2($eax: i32, $ecx: i32, )
; CHECK-NEXT:    icmp_slt($al: i8, $eax: i32, 0: i32, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i32, i1 } @llvm.sadd.with.overflow.i32(i32 %a, i32 %b)
  %o = extractvalue { i32, i1 } %r, 1
  ret i1 %o
}

define i1 @ssub_flag(i32 %a, i32 %b) {
; CHECK: func ssub_flag ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    $eax: i32 -= $esi: i32
; CHECK-NEXT:    $eax: i32 ^= $edi: i32
; CHECK-NEXT:    $edi: i32 ^= $esi: i32
; CHECK-NEXT:    land2($eax: i32, $edi: i32, )
; CHECK-NEXT:    icmp_slt($al: i8, $eax: i32, 0: i32, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i32, i1 } @llvm.ssub.with.overflow.i32(i32 %a, i32 %b)
  %o = extractvalue { i32, i1 } %r, 1
  ret i1 %o
}

define i1 @smul_flag(i32 %a, i32 %b) {
; CHECK: func smul_flag ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_sx($rax: i64, $edi: i32, )
; CHECK-NEXT:    mov_sx($rcx: i64, $esi: i32, )
; CHECK-NEXT:    $rax: i64 *= $rcx: i64
; CHECK-NEXT:    $edi: i32 *= $esi: i32
; CHECK-NEXT:    mov_sx($rcx: i64, $edi: i32, )
; CHECK-NEXT:    icmp_ne($al: i8, $rcx: i64, $rax: i64, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i32, i1 } @llvm.smul.with.overflow.i32(i32 %a, i32 %b)
  %o = extractvalue { i32, i1 } %r, 1
  ret i1 %o
}

define i1 @usub_flag(i64 %a, i64 %b) {
; CHECK: func usub_flag ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    icmp_ult($al: i8, $rdi: i64, $rsi: i64, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i64, i1 } @llvm.usub.with.overflow.i64(i64 %a, i64 %b)
  %o = extractvalue { i64, i1 } %r, 1
  ret i1 %o
}
