; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; The unsigned add and mul overflow intrinsics are lowered in FIR to plain
; arithmetic and compares, no call is left.

declare { i32, i1 } @llvm.uadd.with.overflow.i32(i32, i32)
declare { i64, i1 } @llvm.umul.with.overflow.i64(i64, i64)

define i32 @uadd_value_and_flag(i32 %a, i32 %b) {
; CHECK: func uadd_value_and_flag ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    $eax: i32 += $esi: i32
; CHECK-NEXT:    not1($edi: i32, )
; CHECK-NEXT:    icmp_ugt($cl: i8, $esi: i32, $edi: i32, )
; CHECK-NEXT:    mov_zx($ecx: i32, $cl: i8, )
; CHECK-NEXT:    $eax: i32 += $ecx: i32
; CHECK-NEXT:    ret($eax: i32, )
  %r = call { i32, i1 } @llvm.uadd.with.overflow.i32(i32 %a, i32 %b)
  %v = extractvalue { i32, i1 } %r, 0
  %o = extractvalue { i32, i1 } %r, 1
  %z = zext i1 %o to i32
  %s = add i32 %v, %z
  ret i32 %s
}

define i1 @uadd_flag_only(i32 %a, i32 %b) {
; CHECK: func uadd_flag_only ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    not1($edi: i32, )
; CHECK-NEXT:    icmp_ugt($al: i8, $esi: i32, $edi: i32, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i32, i1 } @llvm.uadd.with.overflow.i32(i32 %a, i32 %b)
  %o = extractvalue { i32, i1 } %r, 1
  ret i1 %o
}

define i1 @umul_flag_only(i64 %a, i64 %b) {
; CHECK: func umul_flag_only ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    $rax: i64 *= $rsi: i64
; CHECK-NEXT:    $rcx: i64 = $rdi: i64
; CHECK-NEXT:    $rdx: i64 = 1: i64
; CHECK-NEXT:    cmov_eq($rcx: i64, $rdx: i64, $rdi: i64, 0: i64, )
; CHECK-NEXT:    udiv($rax: i64, $rdx: i64, $rax: i64, $rcx: i64, )
; CHECK-NEXT:    icmp_ne($al: i8, $rax: i64, $rsi: i64, )
; CHECK-NEXT:    icmp_ne($cl: i8, $rdi: i64, 0: i64, )
; CHECK-NEXT:    land2($al: i8, $cl: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %r = call { i64, i1 } @llvm.umul.with.overflow.i64(i64 %a, i64 %b)
  %o = extractvalue { i64, i1 } %r, 1
  ret i1 %o
}
