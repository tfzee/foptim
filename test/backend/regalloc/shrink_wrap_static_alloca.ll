entry:
  %buf = alloca [16 x i8], align 8
  %c = icmp eq i64 %a, 0
  br i1 %c, label %done, label %slow

slow:
  call void @use(ptr %buf)
  %b = load i64, ptr %p
  %x = call i64 @work(i64 %b)
  %y = call i64 @work(i64 %x)
