; The entry must not move rsp into a callee saved register either (the copy
; cannot be sunk behind the pushes).
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

declare i64 @work(i64)
declare void @use(ptr)

define i64 @early_exit(i64 %a, ptr %p) {
