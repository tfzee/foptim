; CHECK-NEXT:    call(use, )
; CHECK-NEXT:    pop($rsi: i64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    $rbx: i64 = [$rsi]: i64
; CHECK-NEXT:    $rdi: i64 = [$rsi]: i64
; CHECK-NEXT:    call(work, )
