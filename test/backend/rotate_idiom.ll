; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; (x >> c) | (x << (bits - c)) and the + combined form must become a single
; rol/ror, not a shift/shift/or chain.

define i32 @rotr_i32(i32 %x) {
; CHECK: func rotr_i32 ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    ror2($eax: i32, 5: i8, )
; CHECK-NEXT:    ret($eax: i32, )
  %a = lshr i32 %x, 5
  %b = shl i32 %x, 27
  %c = or i32 %a, %b
  ret i32 %c
}

define i32 @rotl_i32(i32 %x) {
; CHECK: func rotl_i32 ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    rol2($eax: i32, 5: i8, )
; CHECK-NEXT:    ret($eax: i32, )
  %a = shl i32 %x, 5
  %b = lshr i32 %x, 27
  %c = or i32 %a, %b
  ret i32 %c
}

define i32 @rotr_i32_add(i32 %x) {
; CHECK: func rotr_i32_add ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    ror2($eax: i32, 5: i8, )
; CHECK-NEXT:    ret($eax: i32, )
  %a = lshr i32 %x, 5
  %b = shl i32 %x, 27
  %c = add i32 %a, %b
  ret i32 %c
}

define i8 @rotl_i8(i8 %x) {
; CHECK: func rotl_i8 ($2: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $al: i8 = $ldi: i8
; CHECK-NEXT:    rol2($al: i8, 3: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %a = shl i8 %x, 3
  %b = lshr i8 %x, 5
  %c = or i8 %a, %b
  ret i8 %c
}

define i64 @rotr_i64(i64 %x) {
; CHECK: func rotr_i64 ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    ror2($rax: i64, 5: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %a = lshr i64 %x, 5
  %b = shl i64 %x, 59
  %c = or i64 %a, %b
  ret i64 %c
}

; shift amounts that do not sum to the bit width are not a rotate
define i32 @not_a_rotate(i32 %x) {
; CHECK: func not_a_rotate ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ecx: i32 = $edi: i32
; CHECK-NEXT:    $eax: i32 = $ecx: i32
; CHECK-NEXT:    shr2($eax: i32, 5: i32, )
; CHECK-NEXT:    shl2($ecx: i32, 6: i32, )
; CHECK-NEXT:    lor2($eax: i32, $ecx: i32, )
; CHECK-NEXT:    ret($eax: i32, )
  %a = lshr i32 %x, 5
  %b = shl i32 %x, 6
  %c = or i32 %a, %b
  ret i32 %c
}
