; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; x86 shifts only use the low 6 bits of the count of a 64 bit operand (5 for 32
; bit), so a mask that keeps them and the zext of a narrower count are not
; needed, and the count moves into cl as a plain byte move. A mask that cuts
; more bits than the hardware does stays.

define i64 @shr64_masked_zext(i64 %v, i8 %c) {
; CHECK: func shr64_masked_zext ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $cl: i8 = $lsi: i8
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    shr2($rax: i64, $cl: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %z = zext i8 %c to i64
  %m = and i64 %z, 63
  %r = lshr i64 %v, %m
  ret i64 %r
}

define i32 @shl32_masked(i32 %v, i32 %c) {
; CHECK: func shl32_masked ($2: i32, $3: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $eax: i32 = $edi: i32
; CHECK-NEXT:    itrunc($cl: i8, $esi: i32, )
; CHECK-NEXT:    shl2($eax: i32, $cl: i8, )
; CHECK-NEXT:    ret($eax: i32, )
  %m = and i32 %c, 31
  %r = shl i32 %v, %m
  ret i32 %r
}

define i64 @shr64_mask_cuts_more(i64 %v, i64 %c) {
; CHECK: func shr64_mask_cuts_more ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    land2($rsi: i64, 15: i64, )
; CHECK-NEXT:    itrunc($cl: i8, $rsi: i64, )
; CHECK-NEXT:    shr2($rax: i64, $cl: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %m = and i64 %c, 15
  %r = lshr i64 %v, %m
  ret i64 %r
}

define i64 @sar64_wide_count(i64 %v, i64 %c) {
; CHECK: func sar64_wide_count ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = $rdi: i64
; CHECK-NEXT:    itrunc($cl: i8, $rsi: i64, )
; CHECK-NEXT:    sar2($rax: i64, $cl: i8, )
; CHECK-NEXT:    ret($rax: i64, )
  %r = ashr i64 %v, %c
  ret i64 %r
}
