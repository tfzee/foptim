; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; A shufflevector that narrows a 256 bit vector to its low or its high 128 bit half (castsi256_si128 / extracti128
; in C). The lane numbers count the elements of the source, the high half used to be read as the second operand
; and came out as a zeroed register.
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define <2 x i64> @high64(<4 x i64> %v) {
; CHECK: func high64 ($2: i64x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vextract128($xmm0: i64x2, $ymm0: i64x4, 1: i8, )
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret($xmm0: i64x2, )
  %s = shufflevector <4 x i64> %v, <4 x i64> poison, <2 x i32> <i32 2, i32 3>
  ret <2 x i64> %s
}

define <2 x i64> @low64(<4 x i64> %v) {
; CHECK: func low64 ($2: i64x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm0: i64x2 = $ymm0: i64x4
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret($xmm0: i64x2, )
  %s = shufflevector <4 x i64> %v, <4 x i64> poison, <2 x i32> <i32 0, i32 1>
  ret <2 x i64> %s
}

define <4 x i32> @high32(<8 x i32> %v) {
; CHECK: func high32 ($2: i32x8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vextract128($xmm0: i32x4, $ymm0: i32x8, 1: i8, )
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret($xmm0: i32x4, )
  %s = shufflevector <8 x i32> %v, <8 x i32> poison, <4 x i32> <i32 4, i32 5, i32 6, i32 7>
  ret <4 x i32> %s
}
