; CHECK-NEXT:    cjmp_int_sgt($edi: i32, 0: i32, ) -> 4
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    cjmp_int_sgt($esi: i32, 0: i32, ) -> 4
