; CHECK-NEXT:  2:
; CHECK-NEXT:    cjmp_int_eq($edx: i32, 3: i32, ) -> 4
; CHECK-NEXT:    jmp() -> 3
; CHECK-NEXT:  3:
; CHECK-NEXT:    $eax: i32 = 7: i32
