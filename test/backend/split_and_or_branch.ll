target triple = "x86_64-unknown-linux-gnu"

; Function Attrs: nounwind sspstrong uwtable
define i32 @f(i32 noundef %0, i32 noundef %1, ptr noundef %2) #0 {
; CHECK: func f ($2: i32, $3: i32, $4: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    cjmp_int_sgt($edi: i32, 0: i32, ) -> 3
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    clear $eax: i32
; CHECK-NEXT:    ret($eax: i32, )
; CHECK-NEXT:  2:
; CHECK-NEXT:    $eax: i32 = [$rdx]: i32
; CHECK-NEXT:    ret($eax: i32, )
; CHECK-NEXT:  3:
; CHECK-NEXT:    cjmp_int_sgt($esi: i32, 0: i32, ) -> 2
; CHECK-NEXT:    jmp() -> 1
  %4 = alloca i32, align 4
  %5 = alloca i32, align 4
  %6 = alloca i32, align 4
  %7 = alloca ptr, align 8
  store i32 %0, ptr %5, align 4, !tbaa !6
  store i32 %1, ptr %6, align 4, !tbaa !6
  store ptr %2, ptr %7, align 8, !tbaa !10
  %8 = load i32, ptr %5, align 4, !tbaa !6
  %9 = icmp sgt i32 %8, 0
  br i1 %9, label %10, label %17

10:                                               ; preds = %3
  %11 = load i32, ptr %6, align 4, !tbaa !6
  %12 = icmp sgt i32 %11, 0
  br i1 %12, label %13, label %17

13:                                               ; preds = %10
  %14 = load ptr, ptr %7, align 8, !tbaa !10
  %15 = getelementptr inbounds i32, ptr %14, i64 0
  %16 = load i32, ptr %15, align 4, !tbaa !6
  store i32 %16, ptr %4, align 4
  br label %18

17:                                               ; preds = %10, %3
  store i32 0, ptr %4, align 4
  br label %18

18:                                               ; preds = %17, %13
  %19 = load i32, ptr %4, align 4
  ret i32 %19
}

; Function Attrs: nounwind sspstrong uwtable
define i32 @g(i32 noundef %0, i32 noundef %1, i32 noundef %2, ptr noundef %3) #0 {
; CHECK: func g ($2: i32, $3: i32, $4: i32, $5: i64, )
