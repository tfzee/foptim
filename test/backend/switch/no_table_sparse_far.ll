; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Few cases spread over a huge range, a table would be gigabytes.

@g0 = global i32 0
@g1 = global i32 0
@g2 = global i32 0
@g3 = global i32 0
@g4 = global i32 0
define void @f(i32 %v) {
; CHECK: func f ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    lea($rdx: i64, [g0]: i64, )
; CHECK-NEXT:    $eax: i32 = 10: i32
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 0: i32, ) -> 5
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 1000: i32, ) -> 2
; CHECK-NEXT:    $ecx: i32 = 70000: i32
; CHECK-NEXT:    cjmp_int_eq($edi: i32, $ecx: i32, ) -> 3
; CHECK-NEXT:    $ecx: i32 = 5000000: i32
; CHECK-NEXT:    cjmp_int_eq($edi: i32, $ecx: i32, ) -> 4
; CHECK-NEXT:    $ecx: i32 = 1000000000: i32
; CHECK-NEXT:    cjmp_int_eq($edi: i32, $ecx: i32, ) -> 6
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    [g1]: i32 = 21: i32
; CHECK-NEXT:    [g1]: i32 = 22: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  3:
; CHECK-NEXT:    [g2]: i32 = 32: i32
; CHECK-NEXT:    [g2]: i32 = 33: i32
; CHECK-NEXT:    [g2]: i32 = 34: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  4:
; CHECK-NEXT:    [g3]: i32 = 43: i32
; CHECK-NEXT:    [g3]: i32 = 44: i32
; CHECK-NEXT:    [g3]: i32 = 45: i32
; CHECK-NEXT:    [g3]: i32 = 46: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  5:
; CHECK-NEXT:    [$rdx]: i32 = $eax: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  6:
; CHECK-NEXT:    lea($rdx: i64, [g4]: i64, )
; CHECK-NEXT:    $eax: i32 = 54: i32
; CHECK-NEXT:    jmp() -> 5
entry:
  switch i32 %v, label %n [ i32 0, label %x0 i32 1000, label %x1 i32 70000, label %x2 i32 5000000, label %x3 i32 1000000000, label %x4 ]
x0:
  store volatile i32 10, ptr @g0
  ret void
x1:
  store volatile i32 21, ptr @g1
  store volatile i32 22, ptr @g1
  ret void
x2:
  store volatile i32 32, ptr @g2
  store volatile i32 33, ptr @g2
  store volatile i32 34, ptr @g2
  ret void
x3:
  store volatile i32 43, ptr @g3
  store volatile i32 44, ptr @g3
  store volatile i32 45, ptr @g3
  store volatile i32 46, ptr @g3
  ret void
x4:
  store volatile i32 54, ptr @g4
  ret void
n:
  ret void
}

