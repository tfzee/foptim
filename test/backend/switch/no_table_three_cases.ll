; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Dense but only three cases, below the minimum number of cases for a table.

@g0 = global i32 0
@g1 = global i32 0
@g2 = global i32 0
define void @f(i32 %v) {
; CHECK: func f ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 0: i32, ) -> 2
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 1: i32, ) -> 3
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 2: i32, ) -> 4
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    [g0]: i32 = 10: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  3:
; CHECK-NEXT:    [g1]: i32 = 21: i32
; CHECK-NEXT:    [g1]: i32 = 22: i32
; CHECK-NEXT:    ret()
; CHECK-NEXT:  4:
; CHECK-NEXT:    [g2]: i32 = 32: i32
; CHECK-NEXT:    [g2]: i32 = 33: i32
; CHECK-NEXT:    [g2]: i32 = 34: i32
; CHECK-NEXT:    ret()
entry:
  switch i32 %v, label %n [ i32 0, label %x0 i32 1, label %x1 i32 2, label %x2 ]
x0:
  store volatile i32 10, ptr @g0
  ret void
x1:
  store volatile i32 21, ptr @g1
  store volatile i32 22, ptr @g1
  ret void
x2:
  store volatile i32 32, ptr @g2
  store volatile i32 33, ptr @g2
  store volatile i32 34, ptr @g2
  ret void
n:
  ret void
}

; Same switch, but every target calls its own declared function (no definition) so the
; targets stay real branches the optimizer cannot merge or evaluate.

declare void @c0()
declare void @c1()
declare void @c2()
define void @f_calls(i32 %v) {
; CHECK: func f_calls ($2: i32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 0: i32, ) -> 2
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 1: i32, ) -> 3
; CHECK-NEXT:    cjmp_int_eq($edi: i32, 2: i32, ) -> 4
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    call(c0, )
; CHECK-NEXT:    ret()
; CHECK-NEXT:  3:
; CHECK-NEXT:    call(c1, )
; CHECK-NEXT:    call(c1, )
; CHECK-NEXT:    ret()
; CHECK-NEXT:  4:
; CHECK-NEXT:    call(c2, )
; CHECK-NEXT:    call(c2, )
; CHECK-NEXT:    call(c2, )
; CHECK-NEXT:    ret()
; CHECK-EMPTY:
; CHECK-NEXT:c0
; CHECK-NEXT:c1
; CHECK-NEXT:c2
entry:
  switch i32 %v, label %n [ i32 0, label %x0 i32 1, label %x1 i32 2, label %x2 ]
x0:
  call void @c0()
  ret void
x1:
  call void @c1()
  call void @c1()
  ret void
x2:
  call void @c2()
  call void @c2()
  call void @c2()
  ret void
n:
  ret void
}
