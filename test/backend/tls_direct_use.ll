; RUN: %foffcc %s --print-mir | FileCheck %s
; a thread local used without llvm.threadlocal.address (the init guard and the
; constructor call of a function local thread_local) goes through the thread pointer
@guard = thread_local global i8 0, align 1
@buf = thread_local global [64 x i8] zeroinitializer, align 64

declare void @ctor(ptr)

define void @init() {
; CHECK: func init ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rsp: i64 -= 8: i64
; CHECK-NEXT:    push($rbx: i64, )
; CHECK-NEXT:    $rax: i64 = guard
; CHECK-NEXT:    tls_base($rbx: i64, )
; CHECK-NEXT:    $rbx: i64 += $rax: i64
; CHECK-NEXT:    mov_zx($eax: i32, [$rbx]: i8, )
; CHECK-NEXT:    cjmp_int_eq($al: i8, 0: i8, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret()
; CHECK-NEXT:  2:
; CHECK-NEXT:    $rax: i64 = buf
; CHECK-NEXT:    tls_base($rdi: i64, )
; CHECK-NEXT:    $rdi: i64 += $rax: i64
; CHECK-NEXT:    call(ctor, )
; CHECK-NEXT:    [$rbx]: i8 = 1: i8
; CHECK-NEXT:    pop($rbx: i64, )
; CHECK-NEXT:    ret()
; CHECK-EMPTY:
; CHECK-NEXT:ctor
  %g = load i8, ptr @guard, align 1
  %c = icmp eq i8 %g, 0
  br i1 %c, label %do, label %end
do:
  call void @ctor(ptr @buf)
  store i8 1, ptr @guard, align 1
  br label %end
end:
  ret void
}
