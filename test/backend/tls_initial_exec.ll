; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; thread local defined elsewhere: the offset is read from the GOT (initial exec)
@ext = external thread_local global i32
declare ptr @llvm.threadlocal.address.p0(ptr)

define i32 @get() {
; CHECK: func get ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = [ext]: i64
; CHECK-NEXT:    tls_base($rax: i64, )
; CHECK-NEXT:    $rax: i64 += $rcx: i64
; CHECK-NEXT:    $eax: i32 = [$rax]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %a = call ptr @llvm.threadlocal.address.p0(ptr @ext)
  %x = load i32, ptr %a
  ret i32 %x
}
