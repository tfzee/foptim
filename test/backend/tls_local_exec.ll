; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; thread local of this module: offset from the thread pointer (local exec)
@tl = thread_local global i32 5
@tz = thread_local global i64 0
declare ptr @llvm.threadlocal.address.p0(ptr)

define i32 @get() {
; CHECK: func get ()
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rcx: i64 = tl
; CHECK-NEXT:    tls_base($rax: i64, )
; CHECK-NEXT:    $rax: i64 += $rcx: i64
; CHECK-NEXT:    $eax: i32 = [$rax]: i32
; CHECK-NEXT:    ret($eax: i32, )
  %a = call ptr @llvm.threadlocal.address.p0(ptr @tl)
  %x = load i32, ptr %a
  ret i32 %x
}

define void @set(i64 %v) {
; CHECK: func set ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $rax: i64 = tz
; CHECK-NEXT:    tls_base($rcx: i64, )
; CHECK-NEXT:    $rcx: i64 += $rax: i64
; CHECK-NEXT:    [$rcx]: i64 = $rdi: i64
; CHECK-NEXT:    ret()
  %a = call ptr @llvm.threadlocal.address.p0(ptr @tz)
  store i64 %v, ptr %a
  ret void
}
