; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; the trunc to i1 only masks its byte to 0 / 1 for consumers that need it, an
; and with a compare result does not, a trunc whose other and operand is an
; unknown i1 argument keeps the mask

define i1 @and_with_cmp(i64 %x, i64 %y) {
; CHECK: func and_with_cmp ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    itrunc($al: i8, $rdi: i64, )
; CHECK-NEXT:    icmp_ult($cl: i8, $rsi: i64, 10: i64, )
; CHECK-NEXT:    land2($al: i8, $cl: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %b = trunc i64 %x to i1
  %c = icmp ult i64 %y, 10
  %r = and i1 %b, %c
  ret i1 %r
}

define i1 @and_with_arg(i64 %x, i1 %y) {
; CHECK: func and_with_arg ($2: i64, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    itrunc($al: i8, $rdi: i64, )
; CHECK-NEXT:    land2($al: i8, 1: i8, )
; CHECK-NEXT:    land2($al: i8, $lsi: i8, )
; CHECK-NEXT:    ret($al: i8, )
  %b = trunc i64 %x to i1
  %r = and i1 %b, %y
  ret i1 %r
}
