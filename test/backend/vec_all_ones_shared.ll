; CHECK-NEXT:    $ymm1: i32x8 = $ymm1: i32x8 ^ $ymm3: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + $ymm1: i32x8
; CHECK-NEXT:    ret($ymm0: i32x8, )
