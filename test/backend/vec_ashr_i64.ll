; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; 64 bit lane arithmetic shift has no avx2 instruction.
define <4 x i64> @vec_ashr_i64(<4 x i64> %x, <4 x i64> %n) {
; CHECK: func vec_ashr_i64 ($2: i64x4, $3: i64x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm3: i64x4 = $ymm1: i64x4
; CHECK-NEXT:    vpcmpeq($ymm2: i64x4, $ymm2: i64x4, $ymm2: i64x4, )
; CHECK-NEXT:    $ymm1: i64x4 = $ymm0: i64x4 ^ $ymm2: i64x4
; CHECK-NEXT:    vShr($ymm4: i64x4, $ymm0: i64x4, $ymm3: i64x4, )
; CHECK-NEXT:    vShr($ymm1: i64x4, $ymm1: i64x4, $ymm3: i64x4, )
; CHECK-NEXT:    $ymm1: i64x4 = $ymm1: i64x4 ^ $ymm2: i64x4
; CHECK-NEXT:    vblendv($ymm0: i64x4, $ymm4: i64x4, $ymm1: i64x4, $ymm0: i64x4, )
; CHECK-NEXT:    ret($ymm0: i64x4, )
  %r = ashr <4 x i64> %x, %n
  ret <4 x i64> %r
}
