; CHECK: func i8_lane5 ($2: i8x16, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpextr($eax: i32, $xmm0: i8x16, 5: i8, )
; CHECK-NEXT:    itrunc($al: i8, $eax: i32, )
; CHECK-NEXT:    ret($al: i8, )
