; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; byte and word vectors: elementwise ops

define void @add_i8x32(ptr noalias %a, ptr noalias %b) {
; CHECK: func add_i8x32 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i8x32 = [$rdi]: i8x32
; CHECK-NEXT:    $ymm0: i8x32 = $ymm0: i8x32 + [$rsi]: i8x32
; CHECK-NEXT:    [$rdi]: i8x32 = $ymm0: i8x32
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <32 x i8>, ptr %a
  %y = load <32 x i8>, ptr %b
  %z = add <32 x i8> %x, %y
  store <32 x i8> %z, ptr %a
  ret void
}

define void @sub_mul_i16x16(ptr noalias %a, ptr noalias %b) {
; CHECK: func sub_mul_i16x16 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm1: i16x16 = [$rdi]: i16x16
; CHECK-NEXT:    $ymm0: i16x16 = [$rsi]: i16x16
; CHECK-NEXT:    $ymm0: i16x16 = $ymm1: i16x16 - $ymm0: i16x16
; CHECK-NEXT:    $ymm0: i16x16 = $ymm0: i16x16 * [$rsi]: i16x16
; CHECK-NEXT:    [$rdi]: i16x16 = $ymm0: i16x16
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <16 x i16>, ptr %a
  %y = load <16 x i16>, ptr %b
  %z = sub <16 x i16> %x, %y
  %w = mul <16 x i16> %z, %y
  store <16 x i16> %w, ptr %a
  ret void
}
