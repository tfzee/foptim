; insertelement for every element width and for the upper half of 256 bit vectors.

define <16 x i8> @i8_lane5(<16 x i8> %v, i8 %x) {
; CHECK: func i8_lane5 ($2: i8x16, $3: i8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    mov_zx($eax: i32, $ldi: i8, )
; CHECK-NEXT:    vpinsr($xmm0: i8x16, $xmm0: i8x16, $eax: i32, 5: i8, )
; CHECK-NEXT:    ret($xmm0: i8x16, )
  %w = insertelement <16 x i8> %v, i8 %x, i32 5
  ret <16 x i8> %w
}

