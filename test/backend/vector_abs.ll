; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s

; vpabsd exists since avx
define void @abs_v8i32(ptr %d, ptr %s) {
; CHECK: func abs_v8i32 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rsi]: i32x8
; CHECK-NEXT:    vpabs($ymm0: i32x8, $ymm0: i32x8, )
; CHECK-NEXT:    [$rdi]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %v = load <8 x i32>, ptr %s, align 32
  %a = call <8 x i32> @llvm.abs.v8i32(<8 x i32> %v, i1 false)
  store <8 x i32> %a, ptr %d, align 32
  ret void
}

define void @abs_v4i32(ptr %d, ptr %s) {
; CHECK: func abs_v4i32 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm0: i32x4 = [$rsi]: i32x4
; CHECK-NEXT:    vpabs($xmm0: i32x4, $xmm0: i32x4, )
; CHECK-NEXT:    [$rdi]: i32x4 = $xmm0: i32x4
; CHECK-NEXT:    ret()
  %v = load <4 x i32>, ptr %s, align 16
  %a = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %v, i1 false)
  store <4 x i32> %a, ptr %d, align 16
  ret void
}

declare <8 x i32> @llvm.abs.v8i32(<8 x i32>, i1)
declare <4 x i32> @llvm.abs.v4i32(<4 x i32>, i1)
