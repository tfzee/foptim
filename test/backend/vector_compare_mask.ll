; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm3: i32x4 = $xmm2: i32x4
; CHECK-NEXT:    clear $xmm2: i32x4
; CHECK-NEXT:    vpcmpgt($xmm0: i32x4, $xmm0: i32x4, $xmm2: i32x4, )
; CHECK-NEXT:    vblendv($xmm0: i32x4, $xmm3: i32x4, $xmm1: i32x4, $xmm0: i32x4, )
; CHECK-NEXT:    ret($xmm0: i32x4, )
  %m = icmp sgt <4 x i32> %a, zeroinitializer
  %r = select <4 x i1> %m, <4 x i32> %b, <4 x i32> %c
  ret <4 x i32> %r
}

