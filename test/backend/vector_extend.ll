; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Widening integer vector conversions load the narrow vector (partial xmm types) and extend it with vpmovzx / vpmovsx.

define void @zext_i8x8_i32x8(ptr %a, ptr %o) {
; CHECK: func zext_i8x8_i32x8 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm0: i8x8 = [$rdi]: i8x8
; CHECK-NEXT:    mov_zx($ymm0: i32x8, $mm0: i8x8, )
; CHECK-NEXT:    [$rsi]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <8 x i8>, ptr %a, align 1
  %r = zext <8 x i8> %x to <8 x i32>
  store <8 x i32> %r, ptr %o, align 1
  ret void
}

