; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir | FileCheck %s
; a vector floor is one vroundpd (the packed form has no operand that supplies the upper bits)

declare <2 x double> @llvm.floor.v2f64(<2 x double>)
define void @f(ptr %a, ptr %b) {
; CHECK: func f ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm0: f64x2 = [$rsi]: f64x2
; CHECK-NEXT:    vround($xmm0: f64x2, $xmm0: f64x2, $xmm0: f64x2, 1: i8, )
; CHECK-NEXT:    [$rdi]: f64x2 = $xmm0: f64x2
; CHECK-NEXT:    ret()
  %x = load <2 x double>, ptr %b
  %r = call <2 x double> @llvm.floor.v2f64(<2 x double> %x)
  store <2 x double> %r, ptr %a
  ret void
}
