; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; x86 has no vector integer division: 8 and 16 bit lanes are divided as f32 after widening to 32 bit, 32 bit lanes as f64
; in groups of four (unsigned ones moved into the signed range first), 64 bit lanes one by one

define void @sdiv_i8(ptr %p, ptr %q, ptr %o) {
; CHECK: func sdiv_i8 ($2: i64, $3: i64, $4: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm1: i8x8 = [$rdi]: i8x8
; CHECK-NEXT:    $mm2: i8x8 = [$rsi]: i8x8
; CHECK-NEXT:    mov_sx($ymm1: i32x8, $mm1: i8x8, )
; CHECK-NEXT:    mov_sx($ymm2: i32x8, $mm2: i8x8, )
; CHECK-NEXT:    SI2FL($ymm1: f32x8, $ymm1: i32x8, )
; CHECK-NEXT:    SI2FL($ymm2: f32x8, $ymm2: i32x8, )
; CHECK-NEXT:    $ymm1: f32x8 = $ymm1: f32x8 / $ymm2: f32x8
; CHECK-NEXT:    FL2SI($ymm1: i32x8, $ymm1: f32x8, )
; CHECK-NEXT:    vpcmpeq($ymm0: i32x8, $ymm0: i32x8, $ymm0: i32x8, )
; CHECK-NEXT:    psrl($ymm0: i32x8, $ymm0: i32x8, 24: i8, )
; CHECK-NEXT:    vAnd($ymm1: i32x8, $ymm1: i32x8, $ymm0: i32x8, )
; CHECK-NEXT:    vextract128($xmm0: i32x4, $ymm1: i32x8, 1: i8, )
; CHECK-NEXT:    vpack($xmm0: i16x8, $xmm1: i32x4, $xmm0: i32x4, )
; CHECK-NEXT:    vpack($mm0: i8x8, $xmm0: i16x8, $xmm0: i16x8, )
; CHECK-NEXT:    [$rdx]: i8x8 = $mm0: i8x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %a = load <8 x i8>, ptr %p
  %b = load <8 x i8>, ptr %q
  %r = sdiv <8 x i8> %a, %b
  store <8 x i8> %r, ptr %o
  ret void
}

