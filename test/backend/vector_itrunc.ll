; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Integer vector truncation: 64 to 32 bit picks the even dwords (vshufps), everything else masks the lanes and halves them with unsigned saturating packs.

define void @trunc_i64x2_i32(ptr %a, ptr %o) {
; CHECK: func trunc_i64x2_i32 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm0: i64x2 = [$rdi]: i64x2
; CHECK-NEXT:    vshufps($mm0: i32x2, $xmm0: i64x2, $xmm0: i64x2, 136: i8, )
; CHECK-NEXT:    [$rsi]: i32x2 = $mm0: i32x2
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <2 x i64>, ptr %a, align 1
  %r = trunc <2 x i64> %x to <2 x i32>
  store <2 x i32> %r, ptr %o, align 1
  ret void
}

