; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; zext of a byte and word compare mask to 0 / 1 lanes (vpabsb / vpabsw)

define <32 x i8> @b(<32 x i8> %x, <32 x i8> %y) {
; CHECK: func b ($2: i8x32, $3: i8x32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpcmpeq($ymm0: i8x32, $ymm0: i8x32, $ymm1: i8x32, )
; CHECK-NEXT:    vpabs($ymm0: i8x32, $ymm0: i8x32, )
; CHECK-NEXT:    ret($ymm0: i8x32, )
  %c = icmp eq <32 x i8> %x, %y
  %z = zext <32 x i1> %c to <32 x i8>
  ret <32 x i8> %z
}

define <16 x i16> @w(<16 x i16> %x, <16 x i16> %y) {
; CHECK: func w ($2: i16x16, $3: i16x16, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpcmpeq($ymm0: i16x16, $ymm0: i16x16, $ymm1: i16x16, )
; CHECK-NEXT:    vpabs($ymm0: i16x16, $ymm0: i16x16, )
; CHECK-NEXT:    ret($ymm0: i16x16, )
  %c = icmp eq <16 x i16> %x, %y
  %z = zext <16 x i1> %c to <16 x i16>
  ret <16 x i16> %z
}
