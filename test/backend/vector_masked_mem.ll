declare void @llvm.masked.store.v4i32.p0(<4 x i32>, ptr, i32, <4 x i1>)
declare <8 x float> @llvm.masked.load.v8f32.p0(ptr, i32, <8 x i1>, <8 x float>)
define void @f(ptr %a, ptr %b, <4 x i32> %t) {
; CHECK: func f ($2: i64, $3: i64, $4: i32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm1: i32x4 = $xmm0: i32x4
; CHECK-NEXT:    clear $xmm0: i32x4
; CHECK-NEXT:    vpcmpgt($xmm0: i32x4, $xmm1: i32x4, $xmm0: i32x4, )
; CHECK-NEXT:    vmaskload($xmm1: i32x4, $xmm0: i32x4, [$rsi]: i32x4, )
; CHECK-NEXT:    vmaskstore([$rdi]: i32x4, $xmm0: i32x4, $xmm1: i32x4, )
; CHECK-NEXT:    ret()
