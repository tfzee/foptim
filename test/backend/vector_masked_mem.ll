  %v = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr %b, i32 4, <4 x i1> %m, <4 x i32> zeroinitializer)
  call void @llvm.masked.store.v4i32.p0(<4 x i32> %v, ptr %a, i32 4, <4 x i1> %m)
  ret void
}
define <8 x float> @g(ptr %b, <8 x float> %t, <8 x float> %p) {
; CHECK: func g ($2: i64, $3: f32x8, $4: f32x8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm2: f32x8 = $ymm1: f32x8
; CHECK-NEXT:    clear $ymm1: f32x8
; CHECK-NEXT:    vcmp($ymm0: f32x8, $ymm0: f32x8, $ymm1: f32x8, 14: i8, )
; CHECK-NEXT:    vmaskload($ymm1: f32x8, $ymm0: f32x8, [$rdi]: f32x8, )
; CHECK-NEXT:    vblendv($ymm0: f32x8, $ymm2: f32x8, $ymm1: f32x8, $ymm0: f32x8, )
; CHECK-NEXT:    ret($ymm0: f32x8, )
