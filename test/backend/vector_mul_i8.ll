; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; There is no byte multiply: full vectors multiply the even bytes and the shifted
; down odd bytes as words, partial vectors are widened to a full xmm.
define <32 x i8> @mul_v32i8(<32 x i8> %a, <32 x i8> %b) {
; CHECK: func mul_v32i8 ($2: i8x32, $3: i8x32, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i16x16 = $ymm0: i8x32
; CHECK-NEXT:    $ymm1: i16x16 = $ymm1: i8x32
; CHECK-NEXT:    $ymm2: i16x16 = $ymm0: i16x16 * $ymm1: i16x16
; CHECK-NEXT:    vAnd($ymm2: i16x16, $ymm2: i16x16, [const_legalizeVec_mul_v32i8_4]: i16x16, )
; CHECK-NEXT:    psrl($ymm0: i16x16, $ymm0: i16x16, 8: i8, )
; CHECK-NEXT:    psrl($ymm1: i16x16, $ymm1: i16x16, 8: i8, )
; CHECK-NEXT:    $ymm0: i16x16 = $ymm0: i16x16 * $ymm1: i16x16
; CHECK-NEXT:    psll($ymm0: i16x16, $ymm0: i16x16, 8: i8, )
; CHECK-NEXT:    vOr($ymm0: i16x16, $ymm2: i16x16, $ymm0: i16x16, )
; CHECK-NEXT:    $ymm0: i8x32 = $ymm0: i16x16
; CHECK-NEXT:    ret($ymm0: i8x32, )
  %r = mul <32 x i8> %a, %b
  ret <32 x i8> %r
}
