; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Constant mask shuffles: one source is vpshufd, two sources with the low half
; from one and the high half from the other is vshufps.

define <4 x i32> @rev_i32x4(<4 x i32> %a) {
; CHECK: func rev_i32x4 ($2: i32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpshuf($xmm0: i32x4, $xmm0: i32x4, 27: i8, )
; CHECK-NEXT:    ret($xmm0: i32x4, )
  %r = shufflevector <4 x i32> %a, <4 x i32> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
  ret <4 x i32> %r
}

define <2 x i64> @swap_i64x2(<2 x i64> %a) {
; CHECK: func swap_i64x2 ($2: i64x2, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpshuf($xmm0: i32x4, $xmm0: i32x4, 78: i8, )
; CHECK-NEXT:    ret($xmm0: i64x2, )
  %r = shufflevector <2 x i64> %a, <2 x i64> poison, <2 x i32> <i32 1, i32 0>
  ret <2 x i64> %r
}

define <4 x float> @even_f32x4(<4 x float> %a, <4 x float> %b) {
; CHECK: func even_f32x4 ($2: f32x4, $3: f32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vshufps($xmm0: f32x4, $xmm0: f32x4, $xmm1: f32x4, 136: i8, )
; CHECK-NEXT:    ret($xmm0: f32x4, )
  %r = shufflevector <4 x float> %a, <4 x float> %b, <4 x i32> <i32 0, i32 2, i32 4, i32 6>
  ret <4 x float> %r
}

define <4 x i32> @swapped_halves_i32x4(<4 x i32> %a, <4 x i32> %b) {
; CHECK: func swapped_halves_i32x4 ($2: i32x4, $3: i32x4, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vshufps($xmm0: f32x4, $xmm1: f32x4, $xmm0: f32x4, 221: i8, )
; CHECK-NEXT:    ret($xmm0: i32x4, )
  %r = shufflevector <4 x i32> %a, <4 x i32> %b, <4 x i32> <i32 5, i32 7, i32 1, i32 3>
  ret <4 x i32> %r
}

define <8 x i32> @rev_in_lane_i32x8(<8 x i32> %a) {
; CHECK: func rev_in_lane_i32x8 ($2: i32x8, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpshuf($ymm0: i32x8, $ymm0: i32x8, 27: i8, )
; CHECK-NEXT:    ret($ymm0: i32x8, )
  %r = shufflevector <8 x i32> %a, <8 x i32> poison, <8 x i32> <i32 3, i32 2, i32 1, i32 0, i32 7, i32 6, i32 5, i32 4>
  ret <8 x i32> %r
}
