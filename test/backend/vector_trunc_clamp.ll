; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; trunc(smax(smin(x, 2^n - 1), 0)) of 16 / 32 bit lanes is a chain of unsigned
; saturating packs without the mask of a plain truncation. Other bounds keep
; the clamp and the mask.
declare <16 x i16> @llvm.smin.v16i16(<16 x i16>, <16 x i16>)
declare <16 x i16> @llvm.smax.v16i16(<16 x i16>, <16 x i16>)
declare <8 x i32> @llvm.smin.v8i32(<8 x i32>, <8 x i32>)
declare <8 x i32> @llvm.smax.v8i32(<8 x i32>, <8 x i32>)

define void @clamp_i16_to_i8(ptr noalias %d, ptr noalias %s) {
; CHECK: func clamp_i16_to_i8 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i16x16 = [$rsi]: i16x16
; CHECK-NEXT:    vextract128($xmm1: i16x8, $ymm0: i16x16, 1: i8, )
; CHECK-NEXT:    vpack($xmm0: i8x16, $xmm0: i16x8, $xmm1: i16x8, )
; CHECK-NEXT:    [$rdi]: i8x16 = $xmm0: i8x16
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <16 x i16>, ptr %s
  %a = call <16 x i16> @llvm.smin.v16i16(<16 x i16> %x, <16 x i16> splat (i16 255))
  %b = call <16 x i16> @llvm.smax.v16i16(<16 x i16> %a, <16 x i16> zeroinitializer)
  %t = trunc <16 x i16> %b to <16 x i8>
  store <16 x i8> %t, ptr %d
  ret void
}

define void @clamp_i32_to_i16(ptr noalias %d, ptr noalias %s) {
; CHECK: func clamp_i32_to_i16 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rsi]: i32x8
; CHECK-NEXT:    vextract128($xmm1: i32x4, $ymm0: i32x8, 1: i8, )
; CHECK-NEXT:    vpack($xmm0: i16x8, $xmm0: i32x4, $xmm1: i32x4, )
; CHECK-NEXT:    [$rdi]: i16x8 = $xmm0: i16x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <8 x i32>, ptr %s
  %a = call <8 x i32> @llvm.smin.v8i32(<8 x i32> %x, <8 x i32> splat (i32 65535))
  %b = call <8 x i32> @llvm.smax.v8i32(<8 x i32> %a, <8 x i32> zeroinitializer)
  %t = trunc <8 x i32> %b to <8 x i16>
  store <8 x i16> %t, ptr %d
  ret void
}

define void @clamp_i32_to_i8(ptr noalias %d, ptr noalias %s) {
; CHECK: func clamp_i32_to_i8 ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rsi]: i32x8
; CHECK-NEXT:    vextract128($xmm1: i32x4, $ymm0: i32x8, 1: i8, )
; CHECK-NEXT:    vpacks($xmm0: i16x8, $xmm0: i32x4, $xmm1: i32x4, )
; CHECK-NEXT:    vpack($mm0: i8x8, $xmm0: i16x8, $xmm0: i16x8, )
; CHECK-NEXT:    [$rdi]: i8x8 = $mm0: i8x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <8 x i32>, ptr %s
  %a = call <8 x i32> @llvm.smin.v8i32(<8 x i32> %x, <8 x i32> splat (i32 255))
  %b = call <8 x i32> @llvm.smax.v8i32(<8 x i32> %a, <8 x i32> zeroinitializer)
  %t = trunc <8 x i32> %b to <8 x i8>
  store <8 x i8> %t, ptr %d
  ret void
}

define void @clamp_other_bound(ptr noalias %d, ptr noalias %s) {
; CHECK: func clamp_other_bound ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm2: i16x16 = [$rsi]: i16x16
; CHECK-NEXT:    $ymm1: i16x16 = [const_legalizeVec_clamp_other_bound_2]: i16x16
; CHECK-NEXT:    vSMin($ymm2: i16x16, $ymm2: i16x16, $ymm1: i16x16, )
; CHECK-NEXT:    clear $ymm1: i16x16
; CHECK-NEXT:    vSMax($ymm1: i16x16, $ymm2: i16x16, $ymm1: i16x16, )
; CHECK-NEXT:    vpcmpeq($ymm0: i16x16, $ymm0: i16x16, $ymm0: i16x16, )
; CHECK-NEXT:    psrl($ymm0: i16x16, $ymm0: i16x16, 8: i8, )
; CHECK-NEXT:    vAnd($ymm1: i16x16, $ymm1: i16x16, $ymm0: i16x16, )
; CHECK-NEXT:    vextract128($xmm0: i16x8, $ymm1: i16x16, 1: i8, )
; CHECK-NEXT:    vpack($xmm0: i8x16, $xmm1: i16x8, $xmm0: i16x8, )
; CHECK-NEXT:    [$rdi]: i8x16 = $xmm0: i8x16
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %x = load <16 x i16>, ptr %s
  %a = call <16 x i16> @llvm.smin.v16i16(<16 x i16> %x, <16 x i16> splat (i16 100))
  %b = call <16 x i16> @llvm.smax.v16i16(<16 x i16> %a, <16 x i16> zeroinitializer)
  %t = trunc <16 x i16> %b to <16 x i8>
  store <16 x i8> %t, ptr %d
  ret void
}
