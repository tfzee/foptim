; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; Legacy SSE code runs slowly with dirty ymm uppers, so a function that touches
; ymm registers gets a vzeroupper in front of calls and returns, but not where
; a ymm value is passed or returned, where the state is already clean, and not
; in functions that only use xmm.

declare double @cos(double)
declare void @ext()
declare void @ext_vec(<8 x i32>)

; ymm op, then ret
define void @vzu_ret(ptr %p, ptr %q) {
; CHECK: func vzu_ret ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rdi]: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + [$rdi]: i32x8
; CHECK-NEXT:    [$rsi]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %v = load <8 x i32>, ptr %p
  %w = add <8 x i32> %v, %v
  store <8 x i32> %w, ptr %q
  ret void
}

; the call cleans the state, no second one in front of the ret
define void @vzu_call_ret(ptr %p, ptr %q) {
; CHECK: func vzu_call_ret ($2: i64, $3: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rdi]: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + [$rdi]: i32x8
; CHECK-NEXT:    [$rsi]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    call(ext, )
; CHECK-NEXT:    ret()
  %v = load <8 x i32>, ptr %p
  %w = add <8 x i32> %v, %v
  store <8 x i32> %w, ptr %q
  call void @ext()
  ret void
}

; a ymm result is not cleared
define <8 x i32> @vzu_ret_wide(ptr %p) {
; CHECK: func vzu_ret_wide ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rdi]: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + [$rdi]: i32x8
; CHECK-NEXT:    ret($ymm0: i32x8, )
  %v = load <8 x i32>, ptr %p
  %w = add <8 x i32> %v, %v
  ret <8 x i32> %w
}

; a ymm argument is not cleared
define void @vzu_call_wide_arg(ptr %p) {
; CHECK: func vzu_call_wide_arg ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $ymm0: i32x8 = [$rdi]: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + [$rdi]: i32x8
; CHECK-NEXT:    call(ext_vec, )
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    ret()
  %v = load <8 x i32>, ptr %p
  %w = add <8 x i32> %v, %v
  call void @ext_vec(<8 x i32> %w)
  ret void
}

define void @vzu_none(ptr %p) {
; CHECK: func vzu_none ($2: i64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $xmm0: i32x4 = [$rdi]: i32x4
; CHECK-NEXT:    $xmm0: i32x4 = $xmm0: i32x4 + [$rdi]: i32x4
; CHECK-NEXT:    [$rdi]: i32x4 = $xmm0: i32x4
; CHECK-NEXT:    call(ext, )
; CHECK-NEXT:    ret()
  %v = load <4 x i32>, ptr %p
  %w = add <4 x i32> %v, %v
  store <4 x i32> %w, ptr %p
  call void @ext()
  ret void
}

; the double kept across the call is saved as 8 bytes although xmm0 / xmm1
; hold ymm values in the other block
define double @save_width(ptr %p, ptr %q, i1 %c, double %x) {
; CHECK: func save_width ($2: i64, $3: i64, $4: i8, $5: f64, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    $mm1: f64 = $mm0: f64
; CHECK-NEXT:    cjmp($dl: i8, ) -> 2
; CHECK-NEXT:    jmp() -> 1
; CHECK-NEXT:  1:
; CHECK-NEXT:    $rsp: i64 -= 8: i32
; CHECK-NEXT:    push($mm1: f64, )
; CHECK-NEXT:    $mm0: f64 = $mm1: f64
; CHECK-NEXT:    vzeroupper()
; CHECK-NEXT:    call(cos, )
; CHECK-NEXT:    pop($mm1: f64, )
; CHECK-NEXT:    $rsp: i64 += 8: i32
; CHECK-NEXT:    $mm0: f64 = $mm0: f64 + $mm1: f64
; CHECK-NEXT:    ret($mm0: f64, )
; CHECK-NEXT:  2:
; CHECK-NEXT:    $ymm0: i32x8 = [$rdi]: i32x8
; CHECK-NEXT:    $ymm0: i32x8 = $ymm0: i32x8 + [$rdi]: i32x8
; CHECK-NEXT:    [$rsi]: i32x8 = $ymm0: i32x8
; CHECK-NEXT:    jmp() -> 1
; CHECK-EMPTY:
; CHECK-NEXT:cos
; CHECK-NEXT:ext
; CHECK-NEXT:ext_vec
entry:
  br i1 %c, label %vec, label %scalar
vec:
  %v = load <8 x i32>, ptr %p
  %w = add <8 x i32> %v, %v
  store <8 x i32> %w, ptr %q
  br label %scalar
scalar:
  %r = call double @cos(double %x)
  %s = fadd double %r, %x
  ret double %s
}
