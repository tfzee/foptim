; NOTE: Assertions have been autogenerated by utils/update_mir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-mir --no-reorder-funcs | FileCheck %s
; llvm.x86.* intrinsics that are an operation we have anyway are lowered to it,
; pclmulqdq to the Clmul intrinsic and pshufb to ByteShuffle (variable control).

declare <2 x i64> @llvm.x86.pclmulqdq(<2 x i64>, <2 x i64>, i8)
declare <16 x i8> @llvm.x86.ssse3.pshuf.b.128(<16 x i8>, <16 x i8>)

define <2 x i64> @clmul_lo_hi(<2 x i64> %a, <2 x i64> %b) {
; CHECK: func clmul_lo_hi ($2: i64x2, $3: i64x2, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpclmul($xmm0: i64x2, $xmm0: i64x2, $xmm1: i64x2, 16: i8, )
; CHECK-NEXT:    ret($xmm0: i64x2, )
  %r = call <2 x i64> @llvm.x86.pclmulqdq(<2 x i64> %a, <2 x i64> %b, i8 16)
  ret <2 x i64> %r
}

define <16 x i8> @pshufb_var(<16 x i8> %a, <16 x i8> %ctrl) {
; CHECK: func pshufb_var ($2: i8x16, $3: i8x16, )
; CHECK-NEXT:  0:
; CHECK-NEXT:    vpshufb($xmm0: i8x16, $xmm0: i8x16, $xmm1: i8x16, )
; CHECK-NEXT:    ret($xmm0: i8x16, )
  %r = call <16 x i8> @llvm.x86.ssse3.pshuf.b.128(<16 x i8> %a, <16 x i8> %ctrl)
  ret <16 x i8> %r
}
