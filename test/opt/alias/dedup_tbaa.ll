; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "FunctionDedupSame,Inline,SimplifyCFG,LVN,DCE" | FileCheck %s
;
; ld_a and ld_b have the same body and different type tags, so they are merged.
; The merged body must not keep the tag of one of them: after inlining it into
; g the load has to see the store of the other type and be forwarded.

define internal i32 @ld_a(ptr %p) {
; CHECK-LABEL: func ld_a<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

define internal i32 @ld_b(ptr %p) {
; CHECK-LABEL: func ld_b<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = load i32, ptr %p, align 4, !tbaa !11
  ret i32 %r
}

define i32 @g(ptr %p, i32 %x) {
; CHECK-LABEL: func g<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Store(%0, %1){} NUses:0
; CHECK-NEXT:    %3: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  store i32 %x, ptr %p, align 4, !tbaa !11
  %r = call i32 @ld_b(ptr %p)
  ret i32 %r
}

define i32 @h(ptr %p) {
; CHECK-LABEL: func h<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = call i32 @ld_a(ptr %p)
  ret i32 %r
}

!0 = !{!"Simple C/C++ TBAA"}
!1 = !{!"omnipotent char", !0, i64 0}
!2 = !{!"int", !1, i64 0}
!3 = !{!"float", !1, i64 0}
!10 = !{!2, !2, i64 0}
!11 = !{!3, !3, i64 0}
