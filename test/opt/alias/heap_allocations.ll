; NOTE: Assertions have been autogenerated by utils/update_dump_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --passes 'PrintAnalysis{show="provenance,accesses,alias"}' --print-fir 2>&1 | FileCheck %s
;
; Results of calls to functions with a noalias result are objects of their own
; under Heap. Two of them never alias, they may be null unless the result is
; nonnull too, and they are only disjoint from loaded pointers while they do
; not escape.
declare noalias ptr @malloc(i64)
declare noalias nonnull ptr @_Znwm(i64)
declare ptr @plain_alloc(i64)
declare { ptr, ptr } @pair_alloc()
declare void @take(ptr)

define i32 @two_mallocs(i64 %n) {
; CHECK-LABEL: accesses of two_mallocs
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] barrier_rw %2
; CHECK-NEXT:  [2] store %3 size=4 base=%0 offset=0
; CHECK-NEXT:  [3] store %4 size=4 base=%2 offset=0
; CHECK-NEXT:  [4] load %5 size=4 base=%0 offset=0
; CHECK-LABEL: provenance of two_mallocs
; CHECK-NEXT:  %0: heap maybe_null
; CHECK-NEXT:  %2: heap maybe_null
; CHECK-LABEL: alias of two_mallocs
; CHECK-NEXT:  2 3: No
; CHECK-NEXT:  2 4: Must
; CHECK-NEXT:  3 4: No
; CHECK-NEXT:  0 -> 2: none
; CHECK-NEXT:  0 -> 3: none
; CHECK-NEXT:  0 -> 4: none
; CHECK-NEXT:  1 -> 2: none
; CHECK-NEXT:  1 -> 3: none
; CHECK-NEXT:  1 -> 4: none
  %a = call ptr @malloc(i64 %n)
  %b = call ptr @malloc(i64 %n)
  store i32 1, ptr %a, align 4
  store i32 2, ptr %b, align 4
  %r = load i32, ptr %a, align 4
  ret i32 %r
}

define i32 @new_is_nonnull(i64 %n) {
; CHECK-LABEL: accesses of new_is_nonnull
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] barrier_rw %2
; CHECK-NEXT:  [2] store %3 size=4 base=%0 offset=0
; CHECK-NEXT:  [3] store %4 size=4 base=%2 offset=0
; CHECK-NEXT:  [4] load %5 size=4 base=%0 offset=0
; CHECK-LABEL: provenance of new_is_nonnull
; CHECK-NEXT:  %0: heap nonnull
; CHECK-NEXT:  %2: heap maybe_null
; CHECK-LABEL: alias of new_is_nonnull
; CHECK-NEXT:  2 3: No
; CHECK-NEXT:  2 4: Must
; CHECK-NEXT:  3 4: No
; CHECK-NEXT:  0 -> 2: none
; CHECK-NEXT:  0 -> 3: none
; CHECK-NEXT:  0 -> 4: none
; CHECK-NEXT:  1 -> 2: none
; CHECK-NEXT:  1 -> 3: none
; CHECK-NEXT:  1 -> 4: none
  %a = call ptr @_Znwm(i64 %n)
  %b = call ptr @malloc(i64 %n)
  store i32 1, ptr %a, align 4
  store i32 2, ptr %b, align 4
  %r = load i32, ptr %a, align 4
  ret i32 %r
}

; a heap object vs an argument and vs a pointer loaded from memory, it does
; not escape so the loaded pointer cannot point into it
define i32 @heap_vs_arg_and_load(ptr %p, ptr %q, i64 %n) {
; CHECK-LABEL: accesses of heap_vs_arg_and_load
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] load %2 size=8 base=%3 offset=0
; CHECK-NEXT:  [2] store %4 size=4 base=%0 offset=0
; CHECK-NEXT:  [3] store %5 size=4 base=%6 offset=0
; CHECK-NEXT:  [4] store %7 size=4 base=%2 offset=0
; CHECK-NEXT:  [5] load %8 size=4 base=%0 offset=0
; CHECK-LABEL: provenance of heap_vs_arg_and_load
; CHECK-NEXT:  %6: maybe_null
; CHECK-NEXT:  %3: maybe_null
; CHECK-NEXT:  %0: heap maybe_null
; CHECK-NEXT:  %2: maybe_null
; CHECK-LABEL: alias of heap_vs_arg_and_load
; CHECK-NEXT:  1 2: No
; CHECK-NEXT:  1 3: May
; CHECK-NEXT:  1 4: May
; CHECK-NEXT:  1 5: No
; CHECK-NEXT:  2 3: No
; CHECK-NEXT:  2 4: No
; CHECK-NEXT:  2 5: Must
; CHECK-NEXT:  3 4: May
; CHECK-NEXT:  3 5: No
; CHECK-NEXT:  4 5: No
; CHECK-NEXT:  0 -> 1: modref
; CHECK-NEXT:  0 -> 2: none
; CHECK-NEXT:  0 -> 3: modref
; CHECK-NEXT:  0 -> 4: modref
; CHECK-NEXT:  0 -> 5: none
  %a = call ptr @malloc(i64 %n)
  %l = load ptr, ptr %q, align 8
  store i32 1, ptr %a, align 4
  store i32 2, ptr %p, align 4
  store i32 3, ptr %l, align 4
  %r = load i32, ptr %a, align 4
  ret i32 %r
}

; once it escapes a loaded pointer may point into it, another heap object
; still does not
define i32 @escaped_heap(ptr %q, i64 %n) {
; CHECK-LABEL: accesses of escaped_heap
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] barrier_rw %2
; CHECK-NEXT:  [2] barrier_rw %3
; CHECK-NEXT:  [3] load %4 size=8 base=%5 offset=0
; CHECK-NEXT:  [4] store %6 size=4 base=%0 offset=0
; CHECK-NEXT:  [5] store %7 size=4 base=%4 offset=0
; CHECK-NEXT:  [6] store %8 size=4 base=%2 offset=0
; CHECK-NEXT:  [7] load %9 size=4 base=%0 offset=0
; CHECK-LABEL: provenance of escaped_heap
; CHECK-NEXT:  %5: maybe_null
; CHECK-NEXT:  %0: heap maybe_null escapes
; CHECK-NEXT:  %2: heap maybe_null
; CHECK-NEXT:  %4: maybe_null
; CHECK-LABEL: alias of escaped_heap
; CHECK-NEXT:  3 4: No
; CHECK-NEXT:  3 5: May
; CHECK-NEXT:  3 6: No
; CHECK-NEXT:  3 7: No
; CHECK-NEXT:  4 5: May
; CHECK-NEXT:  4 6: No
; CHECK-NEXT:  4 7: Must
; CHECK-NEXT:  5 6: No
; CHECK-NEXT:  5 7: May
; CHECK-NEXT:  6 7: No
; CHECK-NEXT:  0 -> 3: modref
; CHECK-NEXT:  0 -> 4: modref
; CHECK-NEXT:  0 -> 5: modref
; CHECK-NEXT:  0 -> 6: none
; CHECK-NEXT:  0 -> 7: modref
; CHECK-NEXT:  1 -> 3: modref
; CHECK-NEXT:  1 -> 4: modref
; CHECK-NEXT:  1 -> 5: modref
; CHECK-NEXT:  1 -> 6: none
; CHECK-NEXT:  1 -> 7: modref
; CHECK-NEXT:  2 -> 3: modref
; CHECK-NEXT:  2 -> 4: modref
; CHECK-NEXT:  2 -> 5: modref
; CHECK-NEXT:  2 -> 6: none
; CHECK-NEXT:  2 -> 7: modref
  %a = call ptr @malloc(i64 %n)
  %b = call ptr @malloc(i64 %n)
  call void @take(ptr %a)
  %l = load ptr, ptr %q, align 8
  store i32 1, ptr %a, align 4
  store i32 2, ptr %l, align 4
  store i32 3, ptr %b, align 4
  %r = load i32, ptr %a, align 4
  ret i32 %r
}

; a select with null still only points into the heap object, an access
; through null is undefined
define i32 @select_with_null(i1 %c, i64 %n) {
; CHECK-LABEL: accesses of select_with_null
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] barrier_rw %2
; CHECK-NEXT:  [2] store %3 size=4 base=%4 offset=0
; CHECK-NEXT:  [3] store %5 size=4 base=%2 offset=0
; CHECK-LABEL: provenance of select_with_null
; CHECK-NEXT:  %0: heap maybe_null
; CHECK-NEXT:  %2: heap maybe_null
; CHECK-NEXT:  %4: heap maybe_null
; CHECK-LABEL: alias of select_with_null
; CHECK-NEXT:  2 3: No
; CHECK-NEXT:  0 -> 2: none
; CHECK-NEXT:  0 -> 3: none
; CHECK-NEXT:  1 -> 2: none
; CHECK-NEXT:  1 -> 3: none
  %a = call ptr @malloc(i64 %n)
  %b = call ptr @malloc(i64 %n)
  %s = select i1 %c, ptr %a, ptr null
  store i32 1, ptr %s, align 4
  store i32 2, ptr %b, align 4
  ret i32 0
}

; no noalias on the result, or a result of a call with several results:
; nothing is known
define i32 @not_fresh(i64 %n) {
; CHECK-LABEL: accesses of not_fresh
; CHECK-NEXT:  [0] barrier_rw %0
; CHECK-NEXT:  [1] barrier_rw %2
; CHECK-NEXT:  [2] store %3 size=4 base=%0 offset=0
; CHECK-NEXT:  [3] store %4 size=4 base=%2.0 offset=0
; CHECK-NEXT:  [4] store %5 size=4 base=%2.1 offset=0
; CHECK-LABEL: provenance of not_fresh
; CHECK-NEXT:  %0: maybe_null
; CHECK-LABEL: alias of not_fresh
; CHECK-NEXT:  2 3: May
; CHECK-NEXT:  2 4: May
; CHECK-NEXT:  3 4: May
; CHECK-NEXT:  0 -> 2: modref
; CHECK-NEXT:  0 -> 3: modref
; CHECK-NEXT:  0 -> 4: modref
; CHECK-NEXT:  1 -> 2: modref
; CHECK-NEXT:  1 -> 3: modref
; CHECK-NEXT:  1 -> 4: modref
  %a = call ptr @plain_alloc(i64 %n)
  %pair = call { ptr, ptr } @pair_alloc()
  %b = extractvalue { ptr, ptr } %pair, 0
  store i32 1, ptr %a, align 4
  store i32 2, ptr %b, align 4
  %c = extractvalue { ptr, ptr } %pair, 1
  store i32 3, ptr %c, align 4
  ret i32 0
}
