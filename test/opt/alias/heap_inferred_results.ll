  %t = call { ptr, ptr } @wrap_twice(i64 %n)
  %t0 = extractvalue { ptr, ptr } %t, 0
  %t1 = extractvalue { ptr, ptr } %t, 1
  %f = call ptr @wrap_arg(ptr %q)
  store i32 1, ptr %a
  store i32 2, ptr %b
  store i32 3, ptr %d
  store i32 4, ptr %e
  store i32 5, ptr %t0
  store i32 6, ptr %t1
  store i32 7, ptr %f
  ret void
}
