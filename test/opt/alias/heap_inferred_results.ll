; CHECK-NEXT:  2 -> 8: modref
; CHECK-NEXT:  2 -> 9: modref
; CHECK-NEXT:  2 -> 10: modref
; CHECK-NEXT:  2 -> 11: modref
; CHECK-NEXT:  3 -> 5: none
; CHECK-NEXT:  3 -> 6: none
