; NOTE: Assertions have been autogenerated by utils/update_dump_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes 'FuncPropAnnotator,PrintAnalysis{show="provenance,alias"}' 2>&1 | FileCheck %s
;
; FuncPropAnnotator marks a pointer result noalias when every return passes
; null or the noalias result of a call that reaches nothing else, and nonnull
; when every returned value is nonnull. @user shows what the callers see: the
; results of the fresh wrappers are heap objects that do not alias each other,
; the others are plain call results.
;
;   @wrap_select  select(p != null, p, null), the shape of a checked malloc
;   @wrap_phi     two mallocs merged by a block argument
;   @wrap_new     operator new, noalias and nonnull
;   @wrap_stored  also stored into a global, so the caller may reach it another
;                 way, not fresh
;   @wrap_twice   returned as both results, they alias, not fresh
;   @wrap_arg     returns its argument, not fresh
@g = global ptr null
declare noalias ptr @malloc(i64)
declare noalias nonnull ptr @_Znwm(i64)

define ptr @wrap_select(i64 %n) {
; CHECK-LABEL: provenance of wrap_select
; CHECK-NEXT:  %0: heap maybe_null escapes
; CHECK-NEXT:  %1: heap maybe_null
; CHECK-LABEL: alias of wrap_select
  %p = call ptr @malloc(i64 %n)
  %ok = icmp ne ptr %p, null
  %r = select i1 %ok, ptr %p, ptr null
  ret ptr %r
}

define ptr @wrap_phi(i1 %c, i64 %n) {
; CHECK-LABEL: provenance of wrap_phi
; CHECK-NEXT:  %0: heap maybe_null escapes
; CHECK-NEXT:  %1: heap maybe_null escapes
; CHECK-LABEL: alias of wrap_phi
entry:
  br i1 %c, label %a, label %b
a:
  %p = call ptr @malloc(i64 %n)
  br label %join
b:
  %q = call ptr @malloc(i64 %n)
  br label %join
join:
  %r = phi ptr [ %p, %a ], [ %q, %b ]
  ret ptr %r
}

define ptr @wrap_new(i64 %n) {
; CHECK-LABEL: provenance of wrap_new
; CHECK-NEXT:  %0: heap nonnull escapes
; CHECK-LABEL: alias of wrap_new
  %p = call ptr @_Znwm(i64 %n)
  ret ptr %p
}

define ptr @wrap_stored(i64 %n) {
; CHECK-LABEL: provenance of wrap_stored
; CHECK-NEXT:  %0: heap maybe_null escapes
; CHECK-LABEL: alias of wrap_stored
; CHECK-NEXT:  0 -> 1: modref
  %p = call ptr @malloc(i64 %n)
  store ptr %p, ptr @g
  ret ptr %p
}

define { ptr, ptr } @wrap_twice(i64 %n) {
; CHECK-LABEL: provenance of wrap_twice
; CHECK-NEXT:  %0: heap maybe_null escapes
; CHECK-LABEL: alias of wrap_twice
  %p = call ptr @malloc(i64 %n)
  %r0 = insertvalue { ptr, ptr } poison, ptr %p, 0
  %r1 = insertvalue { ptr, ptr } %r0, ptr %p, 1
  ret { ptr, ptr } %r1
}

define ptr @wrap_arg(ptr %q) {
; CHECK-LABEL: provenance of wrap_arg
; CHECK-NEXT:  %0: maybe_null
; CHECK-LABEL: alias of wrap_arg
  ret ptr %q
}

define void @user(i1 %c, ptr %q, i64 %n) {
; CHECK-LABEL: provenance of user
; CHECK-NEXT:  %0: maybe_null
; CHECK-NEXT:  %1: heap maybe_null
; CHECK-NEXT:  %2: heap maybe_null
; CHECK-NEXT:  %3: heap nonnull
; CHECK-NEXT:  %4: maybe_null
