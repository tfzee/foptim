; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,DCE" | FileCheck %s
;
; Scopes only count inside one iteration. LVN forwards the second load in both
; functions, the walk stops at the loop header and never compares the store
; with an access of another iteration.
define i32 @same_block(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: func same_block<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: i32):
; CHECK-NEXT:    %6: i32 = Load(%0){} NUses:2
; CHECK-NEXT:    %7: i32 = Store(%1, %4){} NUses:0
; CHECK-NEXT:    %8: i32 = IntAdd(%6, %6){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%8, %5){} NUses:2
; CHECK-NEXT:    %10: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %2){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb1(%10, %9), bb2()>(%11){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: i32 = Return(%9){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s2, %loop ]
  %x = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  store i32 %i, ptr %b, align 4, !alias.scope !3, !noalias !1
  %y = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  %t = add i32 %x, %y
  %s2 = add i32 %s, %t
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %s2
}

define i32 @cross_block(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: func cross_block<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: i32):
; CHECK-NEXT:    %6: i32 = Load(%0){} NUses:2
; CHECK-NEXT:    %7: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i32 = Store(%1, %4){} NUses:0
; CHECK-NEXT:    %9: i32 = IntAdd(%6, %6){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%9, %5){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %2){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb3()>(%12){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %14: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %next ]
  %s = phi i32 [ 0, %entry ], [ %s2, %next ]
  %x = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  br label %next
next:
  store i32 %i, ptr %b, align 4, !alias.scope !3, !noalias !1
  %y = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  %t = add i32 %x, %y
  %s2 = add i32 %s, %t
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %s2
}

!0 = distinct !{!0, !"domain"}
!1 = !{!2}
!2 = distinct !{!2, !0, !"scope a"}
!3 = !{!4}
!4 = distinct !{!4, !0, !"scope b"}
