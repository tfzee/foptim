; CHECK-LABEL: func one_domain_enough<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4, !alias.scope !12
  store i32 2, ptr %b, align 4, !noalias !7
  %r = load i32, ptr %a, align 4, !alias.scope !12
  ret i32 %r
}

