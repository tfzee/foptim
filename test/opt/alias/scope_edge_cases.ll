; Edge cases of !alias.scope and !noalias. The load of %a is forwarded when the
; store to %b is provably apart from it.

; the load is in two scopes of one domain: the store has to exclude both
define i32 @union_needs_all_parts(ptr %a, ptr %b) {
; CHECK-LABEL: func union_needs_all_parts<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4, !alias.scope !1
  store i32 2, ptr %b, align 4, !noalias !10
  %r = load i32, ptr %a, align 4, !alias.scope !11
  ret i32 %r
}

define i32 @union_all_parts_excluded(ptr %a, ptr %b) {
; CHECK-LABEL: func union_all_parts_excluded<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4, !alias.scope !1
  store i32 2, ptr %b, align 4, !noalias !11
  %r = load i32, ptr %a, align 4, !alias.scope !11
  ret i32 %r
}

; a noalias list without a matching alias.scope on the other access says nothing
define i32 @noalias_without_scope(ptr %a, ptr %b) {
; CHECK-LABEL: func noalias_without_scope<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4
  store i32 2, ptr %b, align 4, !noalias !1
  %r = load i32, ptr %a, align 4
  ret i32 %r
}

; one domain is enough
