; An access in the scopes another access says it does not alias is apart from
; it.
define i32 @scoped(ptr %a, ptr %b) {
; CHECK-LABEL: func scoped<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4, !alias.scope !1, !noalias !3
  store i32 2, ptr %b, align 4, !alias.scope !3, !noalias !1
  %r = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  ret i32 %r
}

; the store to %b does not list the scope of %a in its noalias list
define i32 @one_sided(ptr %a, ptr %b) {
; CHECK-LABEL: func one_sided<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %a, align 4, !alias.scope !1, !noalias !3
  store i32 2, ptr %b, align 4
  %r = load i32, ptr %a, align 4, !alias.scope !1, !noalias !3
  ret i32 %r
}

