; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,DCE" | FileCheck %s
;
; Shapes of TBAA tags. Tags the loader does not understand must not crash or
; prove anything, the load stays. The old scalar tag and the constant flag are
; understood and the load is forwarded.

; the access type is a struct, not a scalar
define i32 @struct_access_type(ptr %p, ptr %q) {
; CHECK-LABEL: func struct_access_type<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !20
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !20
  ret i32 %r
}

; the base type does not lead to the access type
define i32 @base_without_access(ptr %p, ptr %q) {
; CHECK-LABEL: func base_without_access<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !21
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !21
  ret i32 %r
}

; the offset is outside of the struct
define i32 @offset_below_first_member(ptr %p, ptr %q) {
; CHECK-LABEL: func offset_below_first_member<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !22
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !22
  ret i32 %r
}

; a tag that is not a struct path tag at all
define i32 @not_a_tag(ptr %p, ptr %q) {
; CHECK-LABEL: func not_a_tag<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !23
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !23
  ret i32 %r
}

; the old scalar tag format (the type node itself is the tag)
define i32 @old_scalar_tag(ptr %p, ptr %q) {
; CHECK-LABEL: func old_scalar_tag<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !6
  store float 2.0, ptr %q, align 4, !tbaa !7
  %r = load i32, ptr %p, align 4, !tbaa !6
  ret i32 %r
}

; a tag with the constant flag
define i32 @constant_flag(ptr %p, ptr %q) {
; CHECK-LABEL: func constant_flag<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !24
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !24
  ret i32 %r
}

!0 = !{!"Simple C/C++ TBAA"}
!1 = !{!"omnipotent char", !0, i64 0}
!2 = !{!"int", !1, i64 0}
!3 = !{!"float", !1, i64 0}
!4 = !{!"S", !2, i64 0, !3, i64 4}
!5 = !{!"T", !3, i64 0}
!6 = !{!"int", !1, i64 0}
!7 = !{!"float", !1, i64 0}
!11 = !{!3, !3, i64 0}
!20 = !{!4, !4, i64 0}
!21 = !{!5, !2, i64 0}
!22 = !{!4, !2, i64 100}
!23 = !{i64 5}
!24 = !{!2, !2, i64 0, i64 1}
