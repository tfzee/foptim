; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,DCE" | FileCheck %s
;
; The TBAA type tree: siblings are apart, a type and its ancestors are not.
; The load is forwarded when the two types are apart.

; int and float are siblings
define i32 @int_float(ptr %p, ptr %q) {
; CHECK-LABEL: func int_float<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; the same type
define i32 @int_int(ptr %p, ptr %q) {
; CHECK-LABEL: func int_int<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store i32 2, ptr %q, align 4, !tbaa !10
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; char is above int
define i32 @int_char(ptr %p, ptr %q) {
; CHECK-LABEL: func int_char<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i8 = Store(%1, 2:i8){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store i8 2, ptr %q, align 1, !tbaa !13
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; and the other way around
define i8 @char_int(ptr %p, ptr %q) {
; CHECK-LABEL: func char_int<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i8 = Store(%0, 1:i8){} NUses:0
; CHECK-NEXT:    %3: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i8 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i8 1, ptr %p, align 1, !tbaa !13
  store i32 2, ptr %q, align 4, !tbaa !10
  %r = load i8, ptr %p, align 1, !tbaa !13
  ret i8 %r
}

; one level below char, int and long are siblings
define i32 @int_long(ptr %p, ptr %q) {
; CHECK-LABEL: func int_long<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: i64 = Store(%1, 2:i64){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store i64 2, ptr %q, align 8, !tbaa !12
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; two pointer types are siblings below "any pointer"
define ptr @ptr_int_ptr_float(ptr %p, ptr %q, ptr %v) {
; CHECK-LABEL: func ptr_int_ptr_float<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: ptr):
; CHECK-NEXT:    %3: ptr = Store(%0, %2){} NUses:0
; CHECK-NEXT:    %4: ptr = Store(%1, NULL){} NUses:0
; CHECK-NEXT:    %5: ptr = Return(%2){} NUses:0
; CHECK-NEXT:}
  store ptr %v, ptr %p, align 8, !tbaa !16
  store ptr null, ptr %q, align 8, !tbaa !15
  %r = load ptr, ptr %p, align 8, !tbaa !16
  ret ptr %r
}

; "any pointer" is the parent of "p1 int"
define ptr @anyptr_ptr_int(ptr %p, ptr %q, ptr %v) {
; CHECK-LABEL: func anyptr_ptr_int<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: ptr):
; CHECK-NEXT:    %3: ptr = Store(%0, %2){} NUses:0
; CHECK-NEXT:    %4: ptr = Store(%1, NULL){} NUses:0
; CHECK-NEXT:    %5: ptr = Load(%0){} NUses:1
; CHECK-NEXT:    %6: ptr = Return(%5){} NUses:0
; CHECK-NEXT:}
  store ptr %v, ptr %p, align 8, !tbaa !14
  store ptr null, ptr %q, align 8, !tbaa !16
  %r = load ptr, ptr %p, align 8, !tbaa !14
  ret ptr %r
}

; a pointer and an int are siblings below char
define ptr @ptr_int(ptr %p, ptr %q, ptr %v) {
; CHECK-LABEL: func ptr_int<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: ptr):
; CHECK-NEXT:    %3: ptr = Store(%0, %2){} NUses:0
; CHECK-NEXT:    %4: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %5: ptr = Return(%2){} NUses:0
; CHECK-NEXT:}
  store ptr %v, ptr %p, align 8, !tbaa !14
  store i32 2, ptr %q, align 4, !tbaa !10
  %r = load ptr, ptr %p, align 8, !tbaa !14
  ret ptr %r
}

; a second root child ("vtable pointer") is treated as below char as well
define i32 @int_vtable(ptr %p, ptr %q) {
; CHECK-LABEL: func int_vtable<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: ptr = Store(%1, NULL){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store ptr null, ptr %q, align 8, !tbaa !17
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; the same address with incompatible types is undefined, the second store is
; not seen as an overwrite of the first and the load of the first type
; forwards the first value
define i32 @same_address_punning(ptr %p) {
; CHECK-LABEL: func same_address_punning<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: f32 = Store(%0, 40000000:f32){} NUses:0
; CHECK-NEXT:    %2: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store float 2.0, ptr %p, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

; no tag on one of the accesses: unknown
define i32 @untagged_store(ptr %p, ptr %q) {
; CHECK-LABEL: func untagged_store<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store float 2.0, ptr %q, align 4
  %r = load i32, ptr %p, align 4, !tbaa !10
  ret i32 %r
}

define i32 @untagged_load(ptr %p, ptr %q) {
; CHECK-LABEL: func untagged_load<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: f32 = Store(%1, 40000000:f32){} NUses:0
; CHECK-NEXT:    %4: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p, align 4, !tbaa !10
  store float 2.0, ptr %q, align 4, !tbaa !11
  %r = load i32, ptr %p, align 4
  ret i32 %r
}

!0 = !{!"Simple C/C++ TBAA"}
!1 = !{!"omnipotent char", !0, i64 0}
!2 = !{!"int", !1, i64 0}
!3 = !{!"float", !1, i64 0}
!4 = !{!"long", !1, i64 0}
!5 = !{!"any pointer", !1, i64 0}
