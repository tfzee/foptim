!7 = !{!"p1 float", !5, i64 0}
!8 = !{!"vtable pointer", !0, i64 0}
!10 = !{!2, !2, i64 0}
!11 = !{!3, !3, i64 0}
!12 = !{!4, !4, i64 0}
