; RUN: %foffcc %s --print-fir --passes "LoopUnroll,LVN,DCE" | FileCheck %s
;
; Unrolled copies keep the type sets but not the scopes. In @types the load is
; forwarded in every copy, in @scopes only in the original body.
@g = global [64 x i32] zeroinitializer
@h = global [64 x float] zeroinitializer

define i32 @types(i32 %x) {
; CHECK-LABEL: func types<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb2(%2{}: i32, %3{}: i32):
; CHECK-NEXT:    %4: i64 = SExt(%2){} NUses:1
; CHECK-NEXT:    %5: i64 = IntMul(%4, 4:i32){NSW; NUW; } NUses:2
; CHECK-NEXT:    %6: ptr = PtrAdd(G(g), %5){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(G(h), %5){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: i32 = Store(%6, %0){} NUses:0
; CHECK-NEXT:    %9: f32 = Store(%7, 3F800000:f32){} NUses:0
; CHECK-NEXT:    %10: i32 = IntAdd(%3, %0){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%2, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, 16:i32){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb3()>(%12){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %14: i32 = Return(%10){} NUses:0
; CHECK-NEXT:  bb1(%15{}: i32, %16{}: i32):
; CHECK-NEXT:    %17: i64 = SExt(%15){} NUses:1
; CHECK-NEXT:    %18: i64 = IntMul(%17, 4:i32){NSW; NUW; } NUses:2
; CHECK-NEXT:    %19: ptr = PtrAdd(G(g), %18){NSW; NUW; } NUses:1
; CHECK-NEXT:    %20: ptr = PtrAdd(G(h), %18){NSW; NUW; } NUses:1
; CHECK-NEXT:    %21: i32 = Store(%19, %0){} NUses:0
; CHECK-NEXT:    %22: f32 = Store(%20, 3F800000:f32){} NUses:0
; CHECK-NEXT:    %23: i32 = IntAdd(%16, %0){} NUses:1
; CHECK-NEXT:    %24: i32 = IntAdd(%15, 1:i32){} NUses:1
; CHECK-NEXT:    %25: () = Branch<bb2(%24, %23)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %p = getelementptr i32, ptr @g, i32 %i
  %q = getelementptr float, ptr @h, i32 %i
  store i32 %x, ptr %p, align 4, !tbaa !10
  store float 1.0, ptr %q, align 4, !tbaa !11
  %v = load i32, ptr %p, align 4, !tbaa !10
  %acc.n = add i32 %acc, %v
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, 16
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

