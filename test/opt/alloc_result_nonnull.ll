; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; A null check of a nonnull noalias result (operator new) folds, the one of
; malloc stays because malloc may return null.
declare noalias ptr @malloc(i64)
declare noalias nonnull ptr @_Znwm(i64)

define i1 @new_not_null(i64 %n) {
; CHECK-LABEL: func new_not_null<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: ptr = Call(_Znwm, %0){extTy: ptr(i64 ); } NUses:0
; CHECK-NEXT:    %2: i1 = Return(0:i1){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @_Znwm(i64 %n)
  %c = icmp eq ptr %p, null
  ret i1 %c
}

define i1 @malloc_may_be_null(i64 %n) {
; CHECK-LABEL: func malloc_may_be_null<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: ptr = Call(malloc, %0){extTy: ptr(i64 ); } NUses:1
; CHECK-NEXT:    %2: i1 = IntEQ(%1, NULL){} NUses:1
; CHECK-NEXT:    %3: i1 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 %n)
  %c = icmp eq ptr %p, null
  ret i1 %c
}
