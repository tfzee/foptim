; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; the alloca address goes through ptrtoint and trunc, this used to hit an IMPL

define i32 @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: ptr = Alloca(256:i32){} NUses:2
; CHECK-NEXT:    %2: i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i8 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: i64 = PTR_INT(%1){} NUses:1
; CHECK-NEXT:    %5: i32 = ITrunc(%4){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  %a = alloca [256 x i8]
  %v = load i8, ptr %p
  store i8 %v, ptr %a
  %i = ptrtoint ptr %a to i64
  %t = trunc i64 %i to i32
  ret i32 %t
}
