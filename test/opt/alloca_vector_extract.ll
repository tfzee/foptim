; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; a vector of pointers holding an alloca that is split again with extractelement
define ptr @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: ptr = Alloca(8:i32){extTy: i64; } NUses:2
; CHECK-NEXT:    %2: 2@i64 = InsertElement(POISON, %1, 0:i32){} NUses:1
; CHECK-NEXT:    %3: 2@i64 = InsertElement(%2, %0, 1:i32){} NUses:0
; CHECK-NEXT:    %4: i64 = Store(%1, 1:i64){} NUses:0
; CHECK-NEXT:    %5: ptr = Return(%0){} NUses:0
; CHECK-NEXT:}
  %a = alloca i64, align 8
  %v0 = insertelement <2 x ptr> poison, ptr %a, i32 0
  %v1 = insertelement <2 x ptr> %v0, ptr %p, i32 1
  %e = extractelement <2 x ptr> %v1, i32 1
  store i64 1, ptr %a
  ret ptr %e
}
