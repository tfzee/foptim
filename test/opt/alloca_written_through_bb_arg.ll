; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,DCE" | FileCheck %s

; An alloca that is only written, also through a block argument, is removed
; with all its stores. No store to a poison pointer is left behind.
define void @f(i1 %c, ptr %out) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: ptr):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2(POISON)>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: () = Branch<bb2(POISON)>(){} NUses:0
; CHECK-NEXT:  bb2(%4{}: ptr):
; CHECK-NEXT:    %5: ptr = Store(%1, NULL){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %slot = alloca ptr, align 8
  br i1 %c, label %then, label %join
then:
  br label %join
join:
  %p = phi ptr [ %slot, %entry ], [ %slot, %then ]
  store ptr null, ptr %p, align 8
  store ptr null, ptr %out, align 8
  ret void
}
