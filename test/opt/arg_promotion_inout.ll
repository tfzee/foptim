; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "ArgPromotion,Mem2Reg,DCE" | FileCheck %s

; A linkonce_odr function that reads and writes a reference parameter of its
; callers takes the value and returns the new one, so the caller can keep the
; value in a register instead of a stack slot.

define linkonce_odr void @work(ptr %r, ptr %a, i32 %v, i64 %n) {
  %i1 = sub i64 %n, 1
  %p1 = getelementptr inbounds i32, ptr %a, i64 %i1
  %x = load i32, ptr %p1
  %p2 = getelementptr inbounds i32, ptr %a, i64 %n
  %y = load i32, ptr %p2
  %d = sdiv i32 %v, %y
  %s = add i32 %x, %d
  %old = load i32, ptr %r
  %new = add i32 %old, %s
  store i32 %new, ptr %r
  ret void
}

define i32 @f(ptr %a, i32 %v, i32 %count) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: ptr = Alloca(4:i32){extTy: i32; } NUses:0
; CHECK-NEXT:    %4: i32 = Call(workMODArgProm1, 0:i32, %0, %1, 1:i64){extTy: i32(i32 ptr i32 i64 ); } NUses:1
; CHECK-NEXT:    %5: () = Branch<bb1(1:i32, %4)>(){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i32, %7{}: i32):
; CHECK-NEXT:    %8: i1 = IntSLT(%6, %2){} NUses:1
; CHECK-NEXT:    %9: () = CondBranch<bb2(), bb3()>(%8){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %10: i64 = SExt(%6){} NUses:1
; CHECK-NEXT:    %11: i32 = Call(workMODArgProm1, %7, %0, %1, %10){extTy: i32(i32 ptr i32 i64 ); } NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%6, 1:i32){} NUses:1
; CHECK-NEXT:    %13: () = Branch<bb1(%12, %11)>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %14: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  %r = alloca i32
  store i32 0, ptr %r
  call void @work(ptr %r, ptr %a, i32 %v, i64 1)
  br label %loop
loop:
  %n = phi i32 [ 1, %entry ], [ %n1, %body ]
  %c = icmp slt i32 %n, %count
  br i1 %c, label %body, label %exit
body:
  %n64 = sext i32 %n to i64
  call void @work(ptr %r, ptr %a, i32 %v, i64 %n64)
  %n1 = add i32 %n, 1
  br label %loop
exit:
  %res = load i32, ptr %r
  ret i32 %res
}
