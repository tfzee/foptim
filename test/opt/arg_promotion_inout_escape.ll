; RUN: %foffcc %s --print-fir --passes "ArgPromotion" | FileCheck %s

; The slot is also passed to another function that may capture it, and the
; callee may see it through the second pointer, so the pointer stays a pointer.

declare void @capture(ptr)

define linkonce_odr void @work(ptr %r, ptr %a) {
; CHECK-LABEL: func work<CC: C, LINK: linkonceODR, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i32 = Load(%1){} NUses:1
; CHECK-NEXT:    %3: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = Store(%0, %4){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  %old = load i32, ptr %r
  %new = add i32 %old, %x
  store i32 %new, ptr %r
  ret void
}

define i32 @f(ptr %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: ptr = Alloca(4:i32){extTy: i32; } NUses:4
; CHECK-NEXT:    %2: i32 = Store(%1, 0:i32){} NUses:0
; CHECK-NEXT:    %3: () = Call(capture, %1){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Call(work, %1, %0){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %5: i32 = Load(%1){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %r = alloca i32
  store i32 0, ptr %r
  call void @capture(ptr %r)
  call void @work(ptr %r, ptr %a)
  %res = load i32, ptr %r
  ret i32 %res
}
