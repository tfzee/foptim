define i64 @umin_then_use(ptr %p, i64 %v) {
; CHECK-LABEL: func umin_then_use<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i64 = Load(%0){ATOMIC; } NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(%2)>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: i64 = IntAdd(%5, 1:i64){} NUses:1
; CHECK-NEXT:    %6: i64 = Return(%4){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %7: i1 = IntULT(%5, %1){} NUses:1
; CHECK-NEXT:    %8: i64 = Select(%7, %5, %1){} NUses:1
; CHECK-NEXT:    %9: i64 = AtomicRMW.CmpXchg(%0, %5, %8){ORDER(Monotone); } NUses:2
; CHECK-NEXT:    %10: i1 = IntEQ(%9, %5){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb2(), bb1(%9)>(%10){} NUses:0
; CHECK-NEXT:}
  %r = atomicrmw umin ptr %p, i64 %v monotonic
  %x = add i64 %r, 1
  ret i64 %x
}

