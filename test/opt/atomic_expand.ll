define i32 @cas_stays(ptr %p, i32 %e, i32 %n) {
; CHECK-LABEL: func cas_stays<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i32 = AtomicRMW.CmpXchg(%0, %1, %2){ORDER(SEQ_CST); } NUses:2
; CHECK-NEXT:    %4: i1 = IntEQ(%3, %1){} NUses:0
; CHECK-NEXT:    %5: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %r = cmpxchg ptr %p, i32 %e, i32 %n seq_cst seq_cst
  %o = extractvalue { i32, i1 } %r, 0
  ret i32 %o
}
