; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "IntrinExpand" | FileCheck %s
; IntrinExpand turns the atomicrmw ops without an x86 instruction into a cmpxchg loop,
; the ones with a lock instruction stay.

define i32 @nand_used(ptr %p, i32 %v) {
; CHECK-LABEL: func nand_used<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Load(%0){ATOMIC; } NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(%2)>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: i32 = Return(%5){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i32 = And(%5, %1){} NUses:1
; CHECK-NEXT:    %7: i32 = Xor(%6, -1:i32){} NUses:1
; CHECK-NEXT:    %8: i32 = AtomicRMW.CmpXchg(%0, %5, %7){ORDER(SEQ_CST); } NUses:2
; CHECK-NEXT:    %9: i1 = IntEQ(%8, %5){} NUses:1
; CHECK-NEXT:    %10: () = CondBranch<bb2(), bb1(%8)>(%9){} NUses:0
; CHECK-NEXT:}
  %r = atomicrmw nand ptr %p, i32 %v seq_cst
  ret i32 %r
}

