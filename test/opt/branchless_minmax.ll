; b + ((a - b) & -(a < b)) and b ^ ((a ^ b) & -(a < b)) are min / max
define i8 @add_smin(i8 %a, i8 %b) {
; CHECK-LABEL: func add_smin<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8):
; CHECK-NEXT:    %2: i1 = IntSLT(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i8 = Select(%2, %0, %1){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %c = icmp slt i8 %a, %b
  %z = zext i1 %c to i8
  %m = sub i8 0, %z
  %d = sub i8 %a, %b
  %x = and i8 %d, %m
  %r = add i8 %x, %b
  ret i8 %r
}

