declare void @sink(i32)

; calling null is undefined, the block ends in unreachable
define i32 @call_null(i32 %x) {
; CHECK-LABEL: func call_null<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Call(sink, %0){extTy: ()(i32 ); } NUses:0
; CHECK-NEXT:    %2: () = unreachable(){} NUses:0
; CHECK-NEXT:}
  call void null(i32 %x)
  call void @sink(i32 %x)
  ret i32 %x
}

define i32 @call_null_result(i32 %x) {
; CHECK-LABEL: func call_null_result<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = unreachable(){} NUses:0
; CHECK-NEXT:}
  %r = call i32 null(i32 %x)
  %s = add i32 %r, 1
  ret i32 %s
}
