; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,InstSimplify,SimplifyCFG,InstSimplify,DCE" | FileCheck %s
; A clamp to the unsigned byte range written with branches (picojpeg) is
; trunc(smax(smin(x, 255), 0)). The joins that only forward block arguments
; are removed, the arms are if converted and the selects become min / max.
define void @clamp_loop(ptr noalias %d, ptr noalias %s, i32 %n) {
; CHECK-LABEL: func clamp_loop<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i32){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i32), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i64 = ZExt(%5){} NUses:2
; CHECK-NEXT:    %7: i64 = IntMul(%6, 2:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){} NUses:1
; CHECK-NEXT:    %9: i16 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i16 = IntAdd(%9, 3:i16){} NUses:1
; CHECK-NEXT:    %11: i16 = INTRIN:SMin(%10, 255:i16){} NUses:1
; CHECK-NEXT:    %12: i16 = INTRIN:SMax(%11, 0:i16){} NUses:1
; CHECK-NEXT:    %13: i8 = ITrunc(%12){} NUses:1
; CHECK-NEXT:    %14: ptr = PtrAdd(%0, %6){} NUses:1
; CHECK-NEXT:    %15: i8 = Store(%14, %13){} NUses:0
; CHECK-NEXT:    %16: i32 = IntAdd(%5, 1:i32){} NUses:2
; CHECK-NEXT:    %17: i1 = IntSLT(%16, %2){} NUses:1
; CHECK-NEXT:    %18: () = CondBranch<bb1(%16), bb2()>(%17){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %19: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp sgt i32 %n, 0
  br i1 %c, label %loop, label %exit
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %join ]
  %idx = zext i32 %i to i64
  %sp = getelementptr i16, ptr %s, i64 %idx
  %v = load i16, ptr %sp
  %x = add i16 %v, 3
  %big = icmp ugt i16 %x, 255
  br i1 %big, label %hi, label %ok
hi:
  %neg = icmp slt i16 %x, 0
  br i1 %neg, label %zero, label %chk
chk:
  %gt = icmp sgt i16 %x, 255
  br i1 %gt, label %sat, label %ok
zero:
  br label %zjoin
sat:
  br label %zjoin
zjoin:
  %clamped = phi i8 [ 0, %zero ], [ -1, %sat ]
  br label %join
ok:
  %t = trunc i16 %x to i8
  br label %join
join:
  %r = phi i8 [ %clamped, %zjoin ], [ %t, %ok ]
  %dp = getelementptr i8, ptr %d, i64 %idx
  store i8 %r, ptr %dp
  %i.next = add i32 %i, 1
  %more = icmp slt i32 %i.next, %n
  br i1 %more, label %loop, label %exit
exit:
  ret void
}

; the same clamp as selects
define i8 @clamp_selects(i16 %x) {
; CHECK-LABEL: func clamp_selects<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i16):
; CHECK-NEXT:    %1: i16 = INTRIN:SMin(%0, 255:i16){} NUses:1
; CHECK-NEXT:    %2: i16 = INTRIN:SMax(%1, 0:i16){} NUses:1
; CHECK-NEXT:    %3: i8 = ITrunc(%2){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %lt = icmp slt i16 %x, 0
  %gt = icmp sgt i16 %x, 255
  %t = trunc i16 %x to i8
  %a = select i1 %gt, i8 -1, i8 %t
  %r = select i1 %lt, i8 0, i8 %a
  ret i8 %r
}

; the bound does not match the truncation, no min
define i8 @clamp_wrong_bound(i16 %x) {
; CHECK-LABEL: func clamp_wrong_bound<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i16):
; CHECK-NEXT:    %1: i1 = IntSGT(%0, 255:i16){} NUses:1
; CHECK-NEXT:    %2: i8 = ITrunc(%0){} NUses:1
; CHECK-NEXT:    %3: i8 = Select(%1, 7:i8, %2){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %gt = icmp sgt i16 %x, 255
  %t = trunc i16 %x to i8
  %r = select i1 %gt, i8 7, i8 %t
  ret i8 %r
}
