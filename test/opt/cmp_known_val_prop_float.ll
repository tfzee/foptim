; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64):
; CHECK-NEXT:    %1: i1 = FloatOEQ(%0, 0:f64){} NUses:1
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: f64 = Return(3FF0000000000000:f64){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %5: f64 = Return(%0){} NUses:0
; CHECK-NEXT:}
entry:
  %c = fcmp oeq double %x, 0.0
  br i1 %c, label %t, label %e
t:
  br label %t2
t2:
  ret double %x
e:
  ret double 1.0
}
