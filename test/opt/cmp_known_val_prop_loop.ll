; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "CmpKnownValProp" | FileCheck %s

; The header is only reachable through the true edge of the latch branch, but it
; recomputes the compare itself, so its branch on the compare must stay.
define void @f(ptr %p, i32 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSGT(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(0:i32), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i32 = IntAdd(%4, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %6: i1 = IntSLT(%5, %1){} NUses:2
; CHECK-NEXT:    %7: () = CondBranch<bb3(), bb4(NULL)>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %9: () = Branch<bb4(%0)>(){} NUses:0
; CHECK-NEXT:  bb4(%10{}: ptr):
; CHECK-NEXT:    %11: ptr = Store(%0, %10){} NUses:0
; CHECK-NEXT:    %12: () = CondBranch<bb1(%5), bb2()>(%6){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i32 %n, 0
  br i1 %g, label %body, label %exit
body:
  %i = phi i32 [ 0, %entry ], [ %i1, %merge ]
  %i1 = add nsw i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %then, label %merge
then:
  br label %merge
merge:
  %s = phi ptr [ null, %body ], [ %p, %then ]
  store ptr %s, ptr %p
  br i1 %c, label %body, label %exit
exit:
  ret void
}
