define i32 @f(i32 %x, i32 %y, i32 %z) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntEQ(%0, 5:i32){} NUses:1
; CHECK-NEXT:    %4: i1 = IntEQ(%1, 3:i32){} NUses:1
; CHECK-NEXT:    %5: i1 = IntEQ(%2, 7:i32){} NUses:1
; CHECK-NEXT:    %6: i1 = And(%4, %5){} NUses:1
; CHECK-NEXT:    %7: i1 = Or(%3, %6){} NUses:1
; CHECK-NEXT:    %8: () = CondBranch<bb1(), bb2()>(%7){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %9: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %10: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %11: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
entry:
  %a = icmp eq i32 %x, 5
  %b = icmp eq i32 %y, 3
  %c = icmp eq i32 %z, 7
  %bc = and i1 %b, %c
  %r = or i1 %a, %bc
  br i1 %r, label %t, label %e
t:
  br label %t2
t2:
  ret i32 %y
e:
  ret i32 0
}

