; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(9:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %m = phi i32 [ 0, %entry ], [ %m1, %loop ]
  %i64 = zext i32 %i to i64
  %p = getelementptr inbounds i32, ptr @tab, i64 %i64
  %v = load i32, ptr %p
  %gt = icmp sgt i32 %v, %m
  %m1 = select i1 %gt, i32 %v, i32 %m
  %i1 = add i32 %i, 1
  %c = icmp ult i32 %i1, 4
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %m1
}

