; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,ConstraintProp,InstSimplify,SimplifyCFG,DCE" | FileCheck %s
; A fact from a dominating branch also holds behind a join of the region it dominates.

declare void @a()
declare void @b()

define i32 @diamond(i32 %v, i1 %p) {
; CHECK-LABEL: func diamond<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i1):
; CHECK-NEXT:    %2: i1 = IntEQ(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: () = CondBranch<bb3(a), bb3(b)>(%1){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb3(%6{}: ptr):
; CHECK-NEXT:    %7: () = Call(%6){extTy: ()(); } NUses:0
; CHECK-NEXT:    %8: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %9: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
entry:
  %c0 = icmp eq i32 %v, 1
  br i1 %c0, label %t, label %out
t:
  br i1 %p, label %l, label %r
l:
  call void @a()
  br label %join
r:
  call void @b()
  br label %join
join:
  %c = icmp eq i32 %v, 1
  %z = zext i1 %c to i32
  ret i32 %z
out:
  ret i32 0
}

; the loop variable is a new value in every iteration, the fact is only used in the iteration it was established
define i32 @loop_same_iteration(i32 %n, i1 %p) {
; CHECK-LABEL: func loop_same_iteration<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i1):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: i1 = IntULT(%3, 10:i32){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb2(), bb3()>(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: () = CondBranch<bb4(a), bb4(b)>(%1){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %7: i32 = Return(%3){} NUses:0
; CHECK-NEXT:  bb4(%8{}: ptr):
; CHECK-NEXT:    %9: () = Call(%8){extTy: ()(); } NUses:0
; CHECK-NEXT:    %10: () = Branch<bb5()>(){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %11: i32 = IntAdd(%3, 1:i32){} NUses:1
; CHECK-NEXT:    %12: () = Branch<bb1(%11)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %h
h:
  %i = phi i32 [ 0, %entry ], [ %inc, %join ]
  %c0 = icmp ult i32 %i, 10
  br i1 %c0, label %body, label %exit
body:
  br i1 %p, label %l, label %r
l:
  call void @a()
  br label %join
r:
  call void @b()
  br label %join
join:
  %c = icmp ult i32 %i, 10
  %z = zext i1 %c to i32
  %inc = add i32 %i, %z
  br label %h
exit:
  ret i32 %i
}

; no fact reaches the latch: it has two predecessors and the header has none
define i32 @loop_no_fact(i32 %n, i1 %p) {
; CHECK-LABEL: func loop_no_fact<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i1):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: i1 = IntEQ(%3, 0:i32){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb2(a), bb2(b)>(%4){} NUses:0
; CHECK-NEXT:  bb2(%6{}: ptr):
; CHECK-NEXT:    %7: () = Call(%6){extTy: ()(); } NUses:0
; CHECK-NEXT:    %8: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %9: i1 = IntEQ(%3, 0:i32){} NUses:1
; CHECK-NEXT:    %10: i32 = ZExt(%9){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntULT(%11, %0){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11), bb4()>(%12){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %14: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  br label %h
h:
  %i = phi i32 [ 0, %entry ], [ %inc, %latch ]
  %c0 = icmp eq i32 %i, 0
  br i1 %c0, label %zero, label %nz
zero:
  call void @a()
  br label %latch
nz:
  call void @b()
  br label %latch
latch:
  %c = icmp eq i32 %i, 0
  %z = zext i1 %c to i32
  %inc = add i32 %i, 1
  %d = icmp ult i32 %inc, %n
  br i1 %d, label %h, label %exit
exit:
  ret i32 %z
}
