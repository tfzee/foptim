; A compare that a dominating branch already guarantees is true, not only the contradicting ones are decided.

define i32 @f(i32 %v) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i1 = IntULT(%0, 10:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = Select(%1, 1:i32, 0:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
entry:
  %c0 = icmp ult i32 %v, 10
  br i1 %c0, label %in, label %out
in:
  %c = icmp ult i32 %v, 10
  br i1 %c, label %x, label %y
out:
  ret i32 0
x:
  ret i32 1
y:
  ret i32 2
}
