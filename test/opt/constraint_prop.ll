; the comparison in the block behind a < b can never be true when a >= b
define i32 @contradiction(i32 %a, i32 %b) {
; CHECK-LABEL: func contradiction<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSLT(%0, %1){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: () = CondBranch<bb3(), bb2()>(0:i1){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %6: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp slt i32 %a, %b
  br i1 %c, label %then, label %end

then:
  %d = icmp sge i32 %a, %b
  br i1 %d, label %never, label %end

never:
  ret i32 1

end:
  ret i32 0
}
