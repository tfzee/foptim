; A case edge knows the value equals the case, the default edge knows it is none of the cases.

declare void @a()
declare void @b()
declare void @c()
declare void @d()

define void @in_case(i32 %v) {
; CHECK-LABEL: func in_case<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Switch<bb1(), bb2(c), bb2(d)>(1:i32, 2:i32, %0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %2: () = Call(a){extTy: ()(); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:  bb2(%4{}: ptr):
; CHECK-NEXT:    %5: () = Call(%4){extTy: ()(); } NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  switch i32 %v, label %other [ i32 1, label %one
                                i32 2, label %two ]
one:
  %c = icmp eq i32 %v, 1
  br i1 %c, label %x, label %y
two:
  call void @c()
  ret void
other:
  call void @d()
  ret void
x:
  call void @a()
  ret void
y:
  call void @b()
  ret void
}

