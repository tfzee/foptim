; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "FuncPropAnnotator,FunctionDedupSame" | FileCheck %s
;
; two identical functions, the first is only called with private objects and
; gets noalias parameters, the second is called with unknown pointers. merging
; them would hand the promises of the first to the calls of the second

define internal void @copy_a(ptr %a, ptr %b) {
; CHECK-LABEL: func copy_a<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; nonnull; nocapture; readonly; }: ptr, %1{noalias; nonnull; nocapture; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  store i32 %x, ptr %b
  ret void
}

define internal void @copy_b(ptr %a, ptr %b) {
; CHECK-LABEL: func copy_b<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; readonly; }: ptr, %1{nocapture; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  store i32 %x, ptr %b
  ret void
}

define void @private_user() {
; CHECK-LABEL: func private_user<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(16:i32){} NUses:1
; CHECK-NEXT:    %1: ptr = Alloca(16:i32){} NUses:1
; CHECK-NEXT:    %2: () = Call(copy_a, %0, %1){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = alloca [16 x i8]
  %q = alloca [16 x i8]
  call void @copy_a(ptr %p, ptr %q)
  ret void
}

define void @unknown_user(ptr %u, ptr %v) {
; CHECK-LABEL: func unknown_user<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; readonly; }: ptr, %1{nocapture; }: ptr):
; CHECK-NEXT:    %2: () = Call(copy_b, %0, %1){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  call void @copy_b(ptr %u, ptr %v)
  ret void
}
