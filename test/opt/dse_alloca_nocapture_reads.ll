; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "LLVMIntrinsicLowering,FuncPropAnnotator,DSE" | FileCheck %s
; A local buffer that is only compared (memcmp) or handed to a function that
; neither keeps nor writes through the pointer does not escape, so DSE removes
; the stores that are overwritten or never read. A callee that keeps the
; pointer, or writes through it, keeps the buffer alive, only a store that a later store overwrites
; before the call is removed there.

@sink = global ptr null

declare i32 @memcmp(ptr, ptr, i64)

define internal i32 @reader(ptr %p) {
; CHECK-LABEL: func reader<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nonnull; nocapture; readonly; }: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %v = load i32, ptr %p
  ret i32 %v
}

define internal void @leaker(ptr %p) {
; CHECK-LABEL: func leaker<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nonnull; }: ptr):
; CHECK-NEXT:    %1: ptr = Store(G(sink), %0){} NUses:0
; CHECK-NEXT:    %2: () = Return(){} NUses:0
; CHECK-NEXT:}
  store ptr %p, ptr @sink
  ret void
}

define internal void @writer(ptr %p) {
; CHECK-LABEL: func writer<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nonnull; nocapture; }: ptr):
; CHECK-NEXT:    %1: i32 = Store(%0, 9:i32){} NUses:0
; CHECK-NEXT:    %2: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 9, ptr %p
  ret void
}

define i32 @cmp_local(ptr %q) {
; CHECK-LABEL: func cmp_local<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; readonly; }: ptr):
; CHECK-NEXT:    %1: ptr = Alloca(16:i32){} NUses:2
; CHECK-NEXT:    %2: i32 = Store(%1, 2:i32){} NUses:0
; CHECK-NEXT:    %3: i32 = INTRIN:MemCmp(%1, %0, 4:i64){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %b = alloca [16 x i8], align 16
  store i32 1, ptr %b
  store i32 2, ptr %b
  %r = call i32 @memcmp(ptr %b, ptr %q, i64 4)
  store i32 3, ptr %b
  ret i32 %r
}

define i32 @read_local() {
; CHECK-LABEL: func read_local<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(4:i32){extTy: i32; } NUses:2
; CHECK-NEXT:    %1: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %2: i32 = Call(reader, %0){extTy: i32(ptr ); } NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %b = alloca i32, align 4
  store i32 1, ptr %b
  store i32 2, ptr %b
  %r = call i32 @reader(ptr %b)
  store i32 3, ptr %b
  ret i32 %r
}

define i32 @leak_local() {
; CHECK-LABEL: func leak_local<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(4:i32){extTy: i32; } NUses:2
; CHECK-NEXT:    %1: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %2: () = Call(leaker, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:}
  %b = alloca i32, align 4
  store i32 1, ptr %b
  store i32 2, ptr %b
  call void @leaker(ptr %b)
  ret i32 0
}

define i32 @write_local() {
; CHECK-LABEL: func write_local<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(4:i32){extTy: i32; } NUses:3
; CHECK-NEXT:    %1: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %2: () = Call(writer, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %b = alloca i32, align 4
  store i32 1, ptr %b
  call void @writer(ptr %b)
  %v = load i32, ptr %b
  ret i32 %v
}
