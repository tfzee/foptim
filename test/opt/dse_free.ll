; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "DSE" | FileCheck %s
; A store into an object that is freed right after, with nothing reading it in
; between, is dead. A read, a volatile store or an escape keeps it.

declare ptr @malloc(i64)
declare void @free(ptr)
declare void @opaque(ptr)

define void @dead_before_free() {
; CHECK-LABEL: func dead_before_free<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:2
; CHECK-NEXT:    %1: i64 = IntMul(8:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){} NUses:0
; CHECK-NEXT:    %3: () = Call(free, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store i32 1, ptr %p
  %q = getelementptr i8, ptr %p, i64 8
  store i64 2, ptr %q
  call void @free(ptr %p)
  ret void
}

define i32 @read_before_free() {
; CHECK-LABEL: func read_before_free<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:3
; CHECK-NEXT:    %1: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: () = Call(free, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %4: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store i32 1, ptr %p
  %v = load i32, ptr %p
  call void @free(ptr %p)
  ret i32 %v
}

define void @volatile_stays() {
; CHECK-LABEL: func volatile_stays<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:2
; CHECK-NEXT:    %1: i32 = Store(%0, 1:i32){VOLATILE; } NUses:0
; CHECK-NEXT:    %2: () = Call(free, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store volatile i32 1, ptr %p
  call void @free(ptr %p)
  ret void
}

define void @escape_stays() {
; CHECK-LABEL: func escape_stays<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:3
; CHECK-NEXT:    %1: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %2: () = Call(opaque, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Call(free, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
