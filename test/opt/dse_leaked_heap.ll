define void @loop_store_leaked(i64 %n) {
; CHECK-LABEL: func loop_store_leaked<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i64):
; CHECK-NEXT:    %3: i64 = IntAdd(%2, 1:i64){} NUses:2
; CHECK-NEXT:    %4: i1 = IntULT(%3, %0){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(%3), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 %n)
  call ptr @__memset_chk(ptr %p, i32 0, i64 %n, i64 -1)
