; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "InstSimplify,DSE,DCE" | FileCheck %s
; A plain declaration of malloc gets a fresh noalias result from the loader. A
; store into a heap object that never escapes and is never read nor freed is
; dead, and so is the allocation. A read or an escape keeps it. A checked memset
; with an unknown object size becomes a plain memset.

declare ptr @malloc(i64)
declare void @opaque(ptr)
declare ptr @__memset_chk(ptr, i32, i64, i64)

define void @leaked_store() {
; CHECK-LABEL: func leaked_store<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store i64 1, ptr %p
  ret void
}

define i64 @read_stays() {
; CHECK-LABEL: func read_stays<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:2
; CHECK-NEXT:    %1: i64 = Store(%0, 1:i64){} NUses:0
; CHECK-NEXT:    %2: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store i64 1, ptr %p
  %v = load i64, ptr %p
  ret i64 %v
}

define void @escape_stays() {
; CHECK-LABEL: func escape_stays<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
