; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "DSE" | FileCheck %s
; A store is dead when every path overwrites the bytes before anything reads
; them or leaves the function, also for memory that is not a local object.
; Each function says whether the first store must stay.

@g = global i32 0

declare void @opaque()

; both branches overwrite: first store is dead
define void @both_paths_overwrite(ptr %p, i1 %c) {
; CHECK-LABEL: func both_paths_overwrite<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Store(%0, 3:i32){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p
  br i1 %c, label %a, label %b
a:
  store i32 2, ptr %p
  ret void
b:
  store i32 3, ptr %p
  ret void
}

; one branch leaves the function without overwriting: first store stays
define void @one_path_escapes(ptr %p, i1 %c) {
; CHECK-LABEL: func one_path_escapes<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p
  br i1 %c, label %a, label %b
a:
  store i32 2, ptr %p
  ret void
b:
  ret void
}

; a load in between: first store stays
define i32 @read_between(ptr %p) {
; CHECK-LABEL: func read_between<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %4: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p
  %v = load i32, ptr %p
  store i32 2, ptr %p
  ret i32 %v
}

; a call may read the global: first store stays
define void @call_between() {
; CHECK-LABEL: func call_between<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Store(G(g), 1:i32){} NUses:0
; CHECK-NEXT:    %1: () = Call(opaque){extTy: ()(); } NUses:0
; CHECK-NEXT:    %2: i32 = Store(G(g), 2:i32){} NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr @g
  call void @opaque()
  store i32 2, ptr @g
  ret void
}

; the load of another offset does not read the stored bytes
define i32 @other_offset(ptr %p) {
; CHECK-LABEL: func other_offset<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = IntMul(4:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: i32 = Load(%2){} NUses:1
; CHECK-NEXT:    %4: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %5: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %p
  %q = getelementptr i8, ptr %p, i64 4
  %v = load i32, ptr %q
  store i32 2, ptr %p
  ret i32 %v
}

; a partial overwrite does not kill the store
define void @partial_overwrite(ptr %p) {
; CHECK-LABEL: func partial_overwrite<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = Store(%0, 1:i64){} NUses:0
; CHECK-NEXT:    %2: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i64 1, ptr %p
  store i32 2, ptr %p
  ret void
}

; the store in the loop is overwritten by the next iteration but the last one
; is visible after the loop
define void @loop_store(ptr %p, i32 %n) {
; CHECK-LABEL: func loop_store<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: i32 = Store(%0, %3){} NUses:0
; CHECK-NEXT:    %5: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %6: i1 = IntSLT(%5, %1){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb1(%5), bb2()>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
  store i32 %i, ptr %p
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %done
done:
  ret void
}

; the address changes every iteration, nothing is killed by the next store
define void @loop_moving_address(ptr %p, i32 %n) {
; CHECK-LABEL: func loop_moving_address<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64):
; CHECK-NEXT:    %4: i64 = IntMul(%3, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: ptr = PtrAdd(%0, %4){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: i32 = Store(%5, 2:i32){} NUses:0
; CHECK-NEXT:    %7: i64 = IntAdd(%3, 1:i64){} NUses:2
; CHECK-NEXT:    %8: i1 = IntSLT(%7, 100:i64){} NUses:1
; CHECK-NEXT:    %9: () = CondBranch<bb1(%7), bb2()>(%8){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %10: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %q = getelementptr i32, ptr %p, i64 %i
  store i32 1, ptr %q
  store i32 2, ptr %q
  %i2 = add i64 %i, 1
  %c = icmp slt i64 %i2, 100
  br i1 %c, label %loop, label %done
done:
  ret void
}

; one store per iteration at a moving address: the next iteration's store is
; another address, every store stays
define void @loop_moving_single(ptr %p) {
; CHECK-LABEL: func loop_moving_single<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i64):
; CHECK-NEXT:    %3: i64 = IntMul(%2, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%0, %3){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: i32 = Store(%4, 1:i32){} NUses:0
; CHECK-NEXT:    %6: i64 = IntAdd(%2, 1:i64){} NUses:2
; CHECK-NEXT:    %7: i1 = IntSLT(%6, 100:i64){} NUses:1
; CHECK-NEXT:    %8: () = CondBranch<bb1(%6), bb2()>(%7){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %q = getelementptr i32, ptr %p, i64 %i
  store i32 1, ptr %q
  %i2 = add i64 %i, 1
  %c = icmp slt i64 %i2, 100
  br i1 %c, label %loop, label %done
done:
  ret void
}
