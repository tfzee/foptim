; RUN: %foffcc %s --print-fir --passes "InstSimplify,EarlySheduler,DCE" | FileCheck %s
; a pointer plus constant used only in its own block moves in front of its first
; use, adds that sit in front of the same use keep their order

declare void @use(ptr)

define i32 @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = IntAdd(%1, 7:i32){} NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%0, 4:i64){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %4: () = Call(use, %3){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %5: ptr = PtrAdd(%0, 8:i64){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %6: () = Call(use, %5){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %7: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %q = getelementptr inbounds i32, ptr %p, i64 1
  %r = getelementptr inbounds i32, ptr %p, i64 2
  %a = load i32, ptr %p
  %b = add i32 %a, 7
  call void @use(ptr %q)
  call void @use(ptr %r)
  ret i32 %b
}

; a non constant offset is left alone
define void @g(ptr %p, i64 %i) {
; CHECK-LABEL: func g<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i64 = IntMul(%1, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%0, %2){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %4: () = Call(use, %3){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:}
  %q = getelementptr inbounds i32, ptr %p, i64 %i
  %a = load i32, ptr %p
  %b = add i32 %a, 7
  call void @use(ptr %q)
  ret void
}
