}

define void @unguarded(i32 %n, i32 %s, ptr %p) {
; CHECK-LABEL: func unguarded<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: ptr):
; CHECK-NEXT:    %3: () = Branch<bb1(%1)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i64 = SExt(%4){} NUses:1
; CHECK-NEXT:    %6: i64 = IntMul(%5, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%2, %6){} NUses:1
; CHECK-NEXT:    %8: i32 = Store(%7, %4){} NUses:0
; CHECK-NEXT:    %9: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %10: i1 = IntSLT(%9, %0){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb1(%9), bb2()>(%10){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %12: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %j = phi i32 [ %s, %entry ], [ %j1, %loop ]
  %a = getelementptr i32, ptr %p, i32 %j
  store i32 %j, ptr %a
  %j1 = add i32 %j, 1
  %c = icmp slt i32 %j1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
