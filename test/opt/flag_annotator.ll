; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,LoopRotate,SimplifyCFG,FlagAnnotator" | FileCheck %s
;
; The counter add of a loop gets nsw (nuw for an unsigned test) when the loop
; is only entered if the start is below the limit, because then every value of
; the counter is below the limit. guarded_signed and guarded_unsigned get the
; flag, unguarded has a start that may be INT_MAX and must stay without.

define void @guarded_signed(i32 %n, i32 %s, ptr %p) {
; CHECK-LABEL: func guarded_signed<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: ptr):
; CHECK-NEXT:    %3: i1 = IntSLT(%1, %0){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(%1), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i64 = SExt(%5){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%2, %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Store(%8, %5){} NUses:0
; CHECK-NEXT:    %10: i32 = IntAdd(%5, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %0){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb1(%10), bb2()>(%11){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp slt i32 %s, %n
  br i1 %g, label %loop, label %exit
loop:
  %j = phi i32 [ %s, %entry ], [ %j1, %loop ]
  %a = getelementptr i32, ptr %p, i32 %j
  store i32 %j, ptr %a
  %j1 = add i32 %j, 1
  %c = icmp slt i32 %j1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

define void @guarded_unsigned(i32 %n, i32 %s, ptr %p) {
; CHECK-LABEL: func guarded_unsigned<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: ptr):
; CHECK-NEXT:    %3: i1 = IntULT(%1, %0){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(%1), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i64 = SExt(%5){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%2, %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Store(%8, %5){} NUses:0
; CHECK-NEXT:    %10: i32 = IntAdd(%5, 1:i32){NUW; } NUses:2
; CHECK-NEXT:    %11: i1 = IntULT(%10, %0){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb1(%10), bb2()>(%11){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp ult i32 %s, %n
  br i1 %g, label %loop, label %exit
loop:
  %j = phi i32 [ %s, %entry ], [ %j1, %loop ]
  %a = getelementptr i32, ptr %p, i32 %j
  store i32 %j, ptr %a
  %j1 = add i32 %j, 1
  %c = icmp ult i32 %j1, %n
  br i1 %c, label %loop, label %exit
