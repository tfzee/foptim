; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "SCCP,InstSimplify,DCE" | FileCheck %s

; f32 constants compare and bitcast by their float value, not their bit pattern
define i1 @cmp_neg() {
; CHECK-LABEL: func cmp_neg<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i1 = Return(0:i1){} NUses:0
; CHECK-NEXT:}
  %c = fcmp ogt float -1.0, 0.0
  ret i1 %c
}

define float @abs_bits() {
; CHECK-LABEL: func abs_bits<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: f32 = Return(3F800000:f32){} NUses:0
; CHECK-NEXT:}
  %b = bitcast float -1.0 to i32
  %a = and i32 %b, 2147483647
  %r = bitcast i32 %a to float
  ret float %r
}
