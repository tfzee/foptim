; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "StackKnownBits,DCE" | FileCheck %s

; llvm.frameaddress of level 0 is the FrameAddress intrinsic (rbp in the
; backend), quickjs uses it for its stack check. The frames of callers are not
; walked, other levels are null as LangRef allows. A pointer derived from it
; points into the frame, so StackKnownBits keeps the alloca it may read.

declare ptr @llvm.frameaddress.p0(i32)

define i64 @frame() {
; CHECK-LABEL: func frame<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = INTRIN:FrameAddress(){} NUses:1
; CHECK-NEXT:    %1: i64 = PTR_INT(%0){} NUses:1
; CHECK-NEXT:    %2: i64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %f = call ptr @llvm.frameaddress.p0(i32 0)
  %i = ptrtoint ptr %f to i64
  ret i64 %i
}

define i64 @caller_frame() {
; CHECK-LABEL: func caller_frame<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i64 = PTR_INT(NULL){} NUses:1
; CHECK-NEXT:    %1: i64 = Return(%0){} NUses:0
; CHECK-NEXT:}
  %f = call ptr @llvm.frameaddress.p0(i32 1)
  %i = ptrtoint ptr %f to i64
  ret i64 %i
}

define i64 @load_below_frame() {
; CHECK-LABEL: func load_below_frame<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(8:i32){extTy: i64; } NUses:2
; CHECK-NEXT:    %1: i64 = Store(%0, 1:i64){} NUses:0
; CHECK-NEXT:    %2: ptr = INTRIN:FrameAddress(){} NUses:1
; CHECK-NEXT:    %3: i64 = IntMul(-8:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%2, %3){} NUses:1
; CHECK-NEXT:    %5: i64 = Load(%4){} NUses:1
; CHECK-NEXT:    %6: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %7: i64 = IntAdd(%5, %6){} NUses:1
; CHECK-NEXT:    %8: i64 = Return(%7){} NUses:0
; CHECK-NEXT:}
  %s = alloca i64
  store i64 1, ptr %s
  %f = call ptr @llvm.frameaddress.p0(i32 0)
  %p = getelementptr i8, ptr %f, i64 -8
  %v = load i64, ptr %p
  %w = load i64, ptr %s
  %r = add i64 %v, %w
  ret i64 %r
}
