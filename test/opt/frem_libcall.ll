; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; frem has no instruction on x86, it is a call of fmod / fmodf. long double is
; f64 in FIR. Constant operands fold with the host libm.
define double @f64(double %a, double %b) {
; CHECK-LABEL: func f64<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64, %1{}: f64):
; CHECK-NEXT:    %2: f64 = Call(fmod, %0, %1){extTy: f64(f64 f64 ); } NUses:1
; CHECK-NEXT:    %3: f64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %r = frem double %a, %b
  ret double %r
}

define float @f32(float %a, float %b) {
; CHECK-LABEL: func f32<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32, %1{}: f32):
; CHECK-NEXT:    %2: f32 = Call(fmodf, %0, %1){extTy: f32(f32 f32 ); } NUses:1
; CHECK-NEXT:    %3: f32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %r = frem float %a, %b
  ret float %r
}

define x86_fp80 @f80(x86_fp80 %a, x86_fp80 %b) {
; CHECK-LABEL: func f80<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64, %1{}: f64):
; CHECK-NEXT:    %2: f64 = Call(fmod, %0, %1){extTy: f64(f64 f64 ); } NUses:1
; CHECK-NEXT:    %3: f64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %r = frem x86_fp80 %a, %b
  ret x86_fp80 %r
}

define double @folded() {
; CHECK-LABEL: func folded<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: f64 = Return(3FF8000000000000:f64){} NUses:0
; CHECK-NEXT:}
  %r = frem double 7.5, 2.0
  ret double %r
}

define float @folded_f32() {
; CHECK-LABEL: func folded_f32<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: f32 = Return(BFC00000:f32){} NUses:0
; CHECK-NEXT:}
  %r = frem float -7.5, 2.0
  ret float %r
}
