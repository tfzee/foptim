; RUN: %foffcc %s --print-fir --passes "GlobalPromotion,InstSimplify,SCCP,InstSimplify,DCE" | FileCheck %s
; an internal global that is never written is constant whatever its size, so loads of it fold
@params = internal global { i32, i32, i32, i32 } { i32 7, i32 9, i32 11, i32 13 }, align 4

define i32 @f() {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(24:i32){} NUses:0
; CHECK-NEXT:}
  %p = getelementptr inbounds { i32, i32, i32, i32 }, ptr @params, i32 0, i32 2
  %v = load i32, ptr %p
  %q = getelementptr inbounds { i32, i32, i32, i32 }, ptr @params, i32 0, i32 3
  %w = load i32, ptr %q
  %r = add i32 %v, %w
  ret i32 %r
}
