; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; An icmp of an and with a vector splat mask must not be narrowed like the
; scalar (x & 1023) == c case, the splat is not a scalar integer constant.

define <4 x i1> @and_splat_icmp(<4 x i64> %x, <4 x i64> %y) {
; CHECK-LABEL: func and_splat_icmp<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: 4@i64, %1{}: 4@i64):
; CHECK-NEXT:    %2: 4@i64 = And(%0, <1023:i64, 1023:i64, 1023:i64, 1023:i64, >:4@i64){} NUses:1
; CHECK-NEXT:    %3: 4@i1 = IntULT(%2, %1){} NUses:1
; CHECK-NEXT:    %4: 4@i1 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %a = and <4 x i64> %x, <i64 1023, i64 1023, i64 1023, i64 1023>
  %c = icmp ult <4 x i64> %a, %y
  ret <4 x i1> %c
}
