; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; operator<=> on pointers (iterators) tested against zero is the plain compare

define i1 @lt(ptr %a, ptr %b) {
; CHECK-LABEL: func lt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i1 = IntULT(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i1 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %lt = icmp ult ptr %a, %b
  %s1 = select i1 %lt, i8 -1, i8 1
  %eq = icmp eq ptr %a, %b
  %s2 = select i1 %eq, i8 0, i8 %s1
  %x = sext i8 %s2 to i32
  %r = icmp slt i32 %x, 0
  ret i1 %r
}

define i1 @ge(i64 %a, i64 %b) {
; CHECK-LABEL: func ge<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSGE(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i1 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %lt = icmp slt i64 %a, %b
  %s1 = select i1 %lt, i8 -1, i8 1
  %eq = icmp eq i64 %a, %b
  %s2 = select i1 %eq, i8 0, i8 %s1
  %x = sext i8 %s2 to i32
  %r = icmp sge i32 %x, 0
  ret i1 %r
}
