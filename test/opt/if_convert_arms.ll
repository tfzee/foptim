; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,DCE" | FileCheck %s
; Triangles and diamonds whose arms are a few instructions that can run on both
; paths become selects. Arms with a load, too many instructions or a
; division keep the branch.

define i32 @triangle(i32 %a, i32 %b) {
; CHECK-LABEL: func triangle<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSLT(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = IntAdd(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = Select(%2, %3, %0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp slt i32 %a, 0
  br i1 %c, label %then, label %join
then:
  %t = add i32 %a, %b
  br label %join
join:
  %r = phi i32 [ %a, %entry ], [ %t, %then ]
  ret i32 %r
}

define i32 @diamond_const(i32 %a) {
; CHECK-LABEL: func diamond_const<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i1 = IntEQ(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = IntAdd(%0, -1:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Select(%1, 16:i32, %2){} NUses:2
; CHECK-NEXT:    %4: i32 = IntMul(%3, 3:i32){} NUses:3
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %3){} NUses:2
; CHECK-NEXT:    %6: i32 = IntMul(%5, %4){} NUses:1
; CHECK-NEXT:    %7: i32 = IntAdd(%6, 7:i32){} NUses:1
; CHECK-NEXT:    %8: i32 = IntMul(%7, %5){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%8, %4){} NUses:1
; CHECK-NEXT:    %10: i32 = Return(%9){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp eq i32 %a, 0
  br i1 %c, label %zero, label %nz
nz:
  %d = add i32 %a, -1
  br label %join
zero:
  br label %join
join:
  %r = phi i32 [ 16, %zero ], [ %d, %nz ]
  %m1 = mul i32 %r, 3
  %m2 = add i32 %m1, %r
  %m3 = mul i32 %m2, %m1
  %m4 = add i32 %m3, 7
  %m5 = mul i32 %m4, %m2
  %m6 = add i32 %m5, %m1
  ret i32 %m6
}

define i32 @diamond_two_arms(i32 %a, i32 %b) {
; CHECK-LABEL: func diamond_two_arms<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSGT(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i32 = IntMul(%0, 2:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntSub(0:i32, %1){} NUses:1
; CHECK-NEXT:    %5: i32 = Select(%2, %3, %4){} NUses:2
; CHECK-NEXT:    %6: i32 = IntMul(%5, 3:i32){} NUses:3
; CHECK-NEXT:    %7: i32 = IntAdd(%6, %5){} NUses:2
; CHECK-NEXT:    %8: i32 = IntMul(%7, %6){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%8, 7:i32){} NUses:1
; CHECK-NEXT:    %10: i32 = IntMul(%9, %7){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%10, %6){} NUses:1
; CHECK-NEXT:    %12: i32 = Return(%11){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp sgt i32 %a, %b
  br i1 %c, label %x, label %y
x:
  %xv = mul i32 %a, 2
  br label %join
y:
  %yv = sub i32 0, %b
  br label %join
join:
  %r = phi i32 [ %xv, %x ], [ %yv, %y ]
  %m1 = mul i32 %r, 3
  %m2 = add i32 %m1, %r
  %m3 = mul i32 %m2, %m1
  %m4 = add i32 %m3, 7
  %m5 = mul i32 %m4, %m2
  %m6 = add i32 %m5, %m1
  ret i32 %m6
}

