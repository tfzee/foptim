; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,DCE" | FileCheck %s
; the if conversion of SimplifyCFG compares the cost of the select against the
; branch (cost_model/branch_cost.cpp)

; a short arm is cheaper to run on both paths than a mispredict
define i32 @short_arm(i1 %c, i32 %a, i32 %b) {
; CHECK-LABEL: func short_arm<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i32 = IntAdd(%1, %2){} NUses:1
; CHECK-NEXT:    %4: i32 = Select(%0, %3, %1){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %then, label %join
then:
  %x = add i32 %a, %b
  br label %join
join:
  %r = phi i32 [ %a, %entry ], [ %x, %then ]
  ret i32 %r
}

; four dependent float divisions cost more on both paths than a mispredict
define double @div_arm(i1 %c, double %a, double %b) {
; CHECK-LABEL: func div_arm<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: f64, %2{}: f64):
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: f64 = FloatDiv(%1, %2){} NUses:1
; CHECK-NEXT:    %5: f64 = FloatDiv(%4, %2){} NUses:1
; CHECK-NEXT:    %6: f64 = FloatDiv(%5, %2){} NUses:1
; CHECK-NEXT:    %7: f64 = FloatDiv(%6, %2){} NUses:1
; CHECK-NEXT:    %8: f64 = Return(%7){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: f64 = Return(%1){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %then, label %join
then:
  %d1 = fdiv double %a, %b
  %d2 = fdiv double %d1, %b
  %d3 = fdiv double %d2, %b
  %d4 = fdiv double %d3, %b
  br label %join
join:
  %r = phi double [ %a, %entry ], [ %d4, %then ]
  ret double %r
}

; a division that is part of a loop carried sum keeps its branch, the select
; would put the division on the recurrence every iteration
define double @carried_div(ptr %p, i32 %n, double %t) {
; CHECK-LABEL: func carried_div<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32, %2{}: f64):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:f64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: f64):
; CHECK-NEXT:    %6: i1 = IntSLT(%4, %1){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb2(), bb3()>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i64 = SExt(%4){} NUses:1
; CHECK-NEXT:    %9: i64 = IntMul(%8, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%0, %9){} NUses:1
; CHECK-NEXT:    %11: f64 = Load(%10){} NUses:2
; CHECK-NEXT:    %12: i1 = FloatOLT(%11, %2){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb4(), bb5()>(%12){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %14: f64 = Return(%5){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %15: f64 = FloatDiv(%5, %11){} NUses:1
; CHECK-NEXT:    %16: i32 = IntAdd(%4, 1:i32){NSW; } NUses:1
; CHECK-NEXT:    %17: () = Branch<bb1(%16, %15)>(){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %18: i32 = IntAdd(%4, 1:i32){NSW; } NUses:1
; CHECK-NEXT:    %19: () = Branch<bb1(%18, %5)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %i = phi i32 [ 0, %entry ], [ %i1, %latch ]
  %acc = phi double [ 0.0, %entry ], [ %acc2, %latch ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %exit
body:
  %idx = sext i32 %i to i64
  %g = getelementptr double, ptr %p, i64 %idx
  %x = load double, ptr %g
  %neg = fcmp olt double %x, %t
  br i1 %neg, label %then, label %latch
then:
  %d = fdiv double %acc, %x
  br label %latch
latch:
  %acc2 = phi double [ %acc, %body ], [ %d, %then ]
  %i1 = add nsw i32 %i, 1
  br label %head
exit:
  ret double %acc
}

; the same short arm in a carried chain is still a select
define i32 @carried_short(ptr %p, i32 %n) {
; CHECK-LABEL: func carried_short<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32, %4{}: i32):
; CHECK-NEXT:    %5: i1 = IntSLT(%3, %1){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i64 = SExt(%3){} NUses:1
; CHECK-NEXT:    %8: i64 = IntMul(%7, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){} NUses:1
; CHECK-NEXT:    %10: i32 = Load(%9){} NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, 0:i32){} NUses:2
; CHECK-NEXT:    %12: i32 = IntAdd(%4, %10){} NUses:1
; CHECK-NEXT:    %13: i32 = IntAdd(%3, 1:i32){NSW; } NUses:1
; CHECK-NEXT:    %14: i32 = IntAdd(%3, 1:i32){NSW; } NUses:1
; CHECK-NEXT:    %15: i32 = Select(%11, %13, %14){} NUses:1
; CHECK-NEXT:    %16: i32 = Select(%11, %12, %4){} NUses:1
; CHECK-NEXT:    %17: () = Branch<bb1(%15, %16)>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %18: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %i = phi i32 [ 0, %entry ], [ %i1, %latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc2, %latch ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %exit
body:
  %idx = sext i32 %i to i64
  %g = getelementptr i32, ptr %p, i64 %idx
  %x = load i32, ptr %g
  %neg = icmp slt i32 %x, 0
  br i1 %neg, label %then, label %latch
then:
  %d = add i32 %acc, %x
  br label %latch
latch:
  %acc2 = phi i32 [ %acc, %body ], [ %d, %then ]
  %i1 = add nsw i32 %i, 1
  br label %head
exit:
  ret i32 %acc
}
