; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Inline" | FileCheck %s
; Inlining copies the asm instruction, both copies refer to the same asm id.

define internal i64 @swap(i64 %x) {
; CHECK-LABEL: func swap<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = INTRIN:InlineAsm(0:i32, %0){} NUses:1
; CHECK-NEXT:    %2: i64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %a = call i64 asm sideeffect "bswapq $0", "=r,0"(i64 %x)
  ret i64 %a
}

define i64 @twice(i64 %x) {
; CHECK-LABEL: func twice<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: () = Branch<bb1(%0)>(){} NUses:0
; CHECK-NEXT:  bb2(%2{}: i64):
; CHECK-NEXT:    %3: () = Branch<bb3(%2)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64):
; CHECK-NEXT:    %5: i64 = INTRIN:InlineAsm(0:i32, %4){} NUses:1
; CHECK-NEXT:    %6: () = Branch<bb2(%5)>(){} NUses:0
; CHECK-NEXT:  bb4(%7{}: i64):
; CHECK-NEXT:    %8: i64 = Return(%7){} NUses:0
; CHECK-NEXT:  bb3(%9{}: i64):
; CHECK-NEXT:    %10: i64 = INTRIN:InlineAsm(0:i32, %9){} NUses:1
; CHECK-NEXT:    %11: () = Branch<bb4(%10)>(){} NUses:0
; CHECK-NEXT:}
  %a = call i64 @swap(i64 %x)
  %b = call i64 @swap(i64 %a)
  ret i64 %b
}
