define { i32, i32 } @rdtsc_like() {
; CHECK-LABEL: func rdtsc_like<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: [i32 i32] = INTRIN:InlineAsm(3:i32){} NUses:2
; CHECK-NEXT:    %1: i32 = Return(%0.0, %0.1){} NUses:0
; CHECK-NEXT:}
  %r = call { i32, i32 } asm sideeffect "rdtsc", "={ax},={dx},~{dirflag},~{fpsr},~{flags}"()
  ret { i32, i32 } %r
}

define i64 @tls(i64 %ofs) {
; CHECK-LABEL: func tls<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: ptr = INT_PTR(%0){} NUses:1
; CHECK-NEXT:    %2: i64 = INTRIN:InlineAsm(4:i32, %1){} NUses:1
; CHECK-NEXT:    %3: i64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p = inttoptr i64 %ofs to ptr
  %r = call i64 asm "movq %fs:$1, $0", "=r,*m,~{dirflag},~{fpsr},~{flags}"(ptr elementtype(i64) %p)
  ret i64 %r
}
