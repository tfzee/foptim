; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "DCE" | FileCheck %s
; The loader turns inline asm into InlineAsm intrinsics, operand 0 is the id of the asm.

define void @pause() {
; CHECK-LABEL: func pause<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = INTRIN:InlineAsm(0:i32){} NUses:0
; CHECK-NEXT:    %1: () = Return(){} NUses:0
; CHECK-NEXT:}
  call void asm sideeffect "pause", "~{dirflag},~{fpsr},~{flags}"()
  ret void
}

define void @barrier() {
; CHECK-LABEL: func barrier<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = INTRIN:InlineAsm(1:i32){} NUses:0
; CHECK-NEXT:    %1: () = Return(){} NUses:0
; CHECK-NEXT:}
  call void asm sideeffect "", "~{memory},~{dirflag},~{fpsr},~{flags}"()
  ret void
}

define i64 @pure_add(i64 %a) {
; CHECK-LABEL: func pure_add<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = INTRIN:InlineAsmPure(2:i32, %0){} NUses:1
; CHECK-NEXT:    %2: i64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = call i64 asm "addq $$1, $0", "=r,0,~{dirflag},~{fpsr},~{flags}"(i64 %a)
  ret i64 %r
}

