define i64 @store_forward_over_pure(ptr %p, i64 %x) {
; CHECK-LABEL: func store_forward_over_pure<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i64 = Store(%0, 5:i64){} NUses:0
; CHECK-NEXT:    %3: i64 = INTRIN:InlineAsmPure(1:i32, %1){} NUses:1
; CHECK-NEXT:    %4: i64 = IntAdd(%3, 5:i64){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store i64 5, ptr %p
  %a = call i64 asm "bswapq $0", "=r,0"(i64 %x)
  %l = load i64, ptr %p
  %r = add i64 %a, %l
  ret i64 %r
}
