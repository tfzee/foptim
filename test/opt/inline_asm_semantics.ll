; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LVN,DCE,InstSimplify" | FileCheck %s
; Inline asm passes: a memory clobber blocks load forwarding, pure asm is never merged,
; unused pure asm is removed, volatile asm stays.

define i64 @barrier_blocks_forwarding(ptr %p) {
; CHECK-LABEL: func barrier_blocks_forwarding<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: () = INTRIN:InlineAsm(0:i32){} NUses:0
; CHECK-NEXT:    %3: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: i64 = IntAdd(%1, %3){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %a = load i64, ptr %p
  call void asm sideeffect "", "~{memory}"()
  %b = load i64, ptr %p
  %r = add i64 %a, %b
  ret i64 %r
}

define i64 @pure_not_merged(i64 %x) {
; CHECK-LABEL: func pure_not_merged<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = INTRIN:InlineAsmPure(1:i32, %0){} NUses:1
; CHECK-NEXT:    %2: i64 = INTRIN:InlineAsmPure(1:i32, %0){} NUses:1
; CHECK-NEXT:    %3: i64 = IntAdd(%1, %2){} NUses:1
; CHECK-NEXT:    %4: i64 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %a = call i64 asm "bswapq $0", "=r,0"(i64 %x)
  %b = call i64 asm "bswapq $0", "=r,0"(i64 %x)
  %r = add i64 %a, %b
  ret i64 %r
}

define void @sideeffect_kept(i64 %x) {
; CHECK-LABEL: func sideeffect_kept<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
