; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "StackKnownBits,DCE" | FileCheck %s
; Inline asm that gets a pointer to a stack object may write it, the stored 0
; must not be forwarded to the load behind it.

define i64 @asm_writes_stack() {
; CHECK-LABEL: func asm_writes_stack<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(8:i32){extTy: i64; } NUses:3
; CHECK-NEXT:    %1: i64 = Store(%0, 0:i64){} NUses:0
; CHECK-NEXT:    %2: () = INTRIN:InlineAsm(0:i32, %0){} NUses:0
; CHECK-NEXT:    %3: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: i64 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %p = alloca i64
  store i64 0, ptr %p
  call void asm sideeffect "movq $$5, $0", "=*m,~{dirflag},~{fpsr},~{flags}"(ptr elementtype(i64) %p)
  %v = load i64, ptr %p
  ret i64 %v
}
