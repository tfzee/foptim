; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Inline" | FileCheck %s

; the callee owns a copy of a byval argument, inlining it copies the object
; (the callee writes to it, the caller's object must stay as it is)

%struct.S = type { i64, i64, i64 }

define internal i64 @take(ptr byval(%struct.S) align 8 %s) {
; CHECK-LABEL: func take<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr):
; CHECK-NEXT:    %1: i64 = IntMul(0:i64, 24:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%2, 0:i32){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %4: i64 = Load(%3){} NUses:1
; CHECK-NEXT:    %5: i64 = IntAdd(%4, 100:i64){} NUses:2
; CHECK-NEXT:    %6: i64 = Store(%3, %5){} NUses:0
; CHECK-NEXT:    %7: i64 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %pa = getelementptr inbounds %struct.S, ptr %s, i32 0, i32 0
  %a = load i64, ptr %pa
  %n = add i64 %a, 100
  store i64 %n, ptr %pa
  ret i64 %n
}

define i64 @caller(ptr %p) {
; CHECK-LABEL: func caller<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: ptr = Alloca(24:i32){} NUses:2
; CHECK-NEXT:    %2: ptr = INTRIN:MemCpy(%1, %0, 24:i64){} NUses:0
; CHECK-NEXT:    %3: () = Branch<bb1(%1)>(){} NUses:0
; CHECK-NEXT:  bb2(%4{}: i64):
; CHECK-NEXT:    %5: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %6: i64 = IntAdd(%4, %5){} NUses:1
; CHECK-NEXT:    %7: i64 = Return(%6){} NUses:0
; CHECK-NEXT:  bb1(%8{}: ptr):
; CHECK-NEXT:    %9: i64 = IntMul(0:i64, 24:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%8, %9){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %11: ptr = PtrAdd(%10, 0:i32){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %12: i64 = Load(%11){} NUses:1
; CHECK-NEXT:    %13: i64 = IntAdd(%12, 100:i64){} NUses:2
; CHECK-NEXT:    %14: i64 = Store(%11, %13){} NUses:0
; CHECK-NEXT:    %15: () = Branch<bb2(%13)>(){} NUses:0
; CHECK-NEXT:}
  %r = call i64 @take(ptr byval(%struct.S) align 8 %p)
  %b = load i64, ptr %p
  %s = add i64 %r, %b
  ret i64 %s
}
