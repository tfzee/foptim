; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Inline" | FileCheck %s

; the copy of a byval argument has to be made before the branch into the inlined body,
; also for a call that is not the first one of its block

%struct.S = type { [250 x i64] }

declare void @sink(ptr)

define internal void @take(ptr byval(%struct.S) align 8 %s, i64 %n) {
; CHECK-LABEL: func take<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{}: i64):
; CHECK-NEXT:    %2: () = Call(sink, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  call void @sink(ptr %s)
  ret void
}

define void @caller(ptr %p, i64 %n) {
; CHECK-LABEL: func caller<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: ptr = Alloca(2000:i32){} NUses:2
; CHECK-NEXT:    %3: ptr = Alloca(2000:i32){} NUses:2
; CHECK-NEXT:    %4: ptr = INTRIN:MemCpy(%3, %0, 2000:i64){} NUses:0
; CHECK-NEXT:    %5: () = Branch<bb1(%3, %1)>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: ptr = INTRIN:MemCpy(%2, %0, 2000:i64){} NUses:0
; CHECK-NEXT:    %7: () = Branch<bb3(%2, %1)>(){} NUses:0
; CHECK-NEXT:  bb1(%8{}: ptr, %9{}: i64):
; CHECK-NEXT:    %10: () = Call(sink, %8){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %11: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %12: () = Return(){} NUses:0
; CHECK-NEXT:  bb3(%13{}: ptr, %14{}: i64):
; CHECK-NEXT:    %15: () = Call(sink, %13){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %16: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:}
entry:
  call void @take(ptr byval(%struct.S) align 8 %p, i64 %n)
  call void @take(ptr byval(%struct.S) align 8 %p, i64 %n)
  ret void
}
