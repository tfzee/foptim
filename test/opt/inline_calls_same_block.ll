; RUN: %foffcc %s --print-fir --passes "Inline,SimplifyCFG,DCE" | FileCheck %s

; Two calls in one block are both inlined in one run, and so is the call that
; comes out of the inlined body of @mid (callees are finished before callers).

define i32 @caller(i32 %x) {
; CHECK-LABEL: func caller<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = IntMul(%0, 7:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = IntAdd(%1, 2:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = IntMul(%2, 7:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, 2:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %a = call i32 @mid(i32 %x)
  %b = call i32 @mid(i32 %a)
  ret i32 %b
}

define i32 @mid(i32 %x) {
; CHECK-LABEL: func mid<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = IntMul(%0, 7:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = IntAdd(%1, 2:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %r = call i32 @leaf(i32 %x)
  %s = add i32 %r, 2
  ret i32 %s
}

define i32 @leaf(i32 %x) {
; CHECK-LABEL: func leaf<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = IntMul(%0, 7:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %s = mul i32 %x, 7
  ret i32 %s
}
