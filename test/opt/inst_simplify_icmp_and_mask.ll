; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "InstSimplify,DCE" | FileCheck %s
; Comparing the low bits of x with y is only the same as comparing x & mask
; with y when y has no bits above the mask (this was folded to a compare of
; the truncated values, so the unsigned multiply overflow flag was always 0).

define i1 @low_vs_full(i64 %x) {
; CHECK-LABEL: func low_vs_full<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = And(%0, 4294967295:i64){} NUses:1
; CHECK-NEXT:    %2: i1 = IntNE(%1, %0){} NUses:1
; CHECK-NEXT:    %3: i1 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %t = trunc i64 %x to i32
  %z = zext i32 %t to i64
  %c = icmp ne i64 %z, %x
  ret i1 %c
}

; y fits the mask: still a compare of the low bits
define i1 @low_vs_small(i64 %x, i32 %y) {
; CHECK-LABEL: func low_vs_small<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i32):
; CHECK-NEXT:    %2: i32 = ITrunc(%0){} NUses:1
; CHECK-NEXT:    %3: i1 = IntNE(%2, %1){} NUses:1
; CHECK-NEXT:    %4: i1 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %t = trunc i64 %x to i32
  %z = zext i32 %t to i64
  %w = zext i32 %y to i64
  %c = icmp ne i64 %z, %w
  ret i1 %c
}
