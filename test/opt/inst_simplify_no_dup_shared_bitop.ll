; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; A shift or extension is only pushed through a bitwise op that has no other user, otherwise the op is
; duplicated and chains like xorshift grow exponentially.

define i64 @xorshift(i64 %a) {
; CHECK-LABEL: func xorshift<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = Shl(%0, 13:i64){} NUses:1
; CHECK-NEXT:    %2: i64 = Xor(%1, %0){} NUses:2
; CHECK-NEXT:    %3: i64 = LShR(%2, 7:i64){} NUses:1
; CHECK-NEXT:    %4: i64 = Xor(%3, %2){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %x = shl i64 %a, 13
  %y = xor i64 %x, %a
  %s = lshr i64 %y, 7
  %t = xor i64 %s, %y
  ret i64 %t
}

define i128 @ext_shared(i64 %a, i64 %b) {
; CHECK-LABEL: func ext_shared<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64):
; CHECK-NEXT:    %2: i64 = Xor(%0, %1){} NUses:2
; CHECK-NEXT:    %3: i128 = ZExt(%2){} NUses:1
; CHECK-NEXT:    %4: i128 = ZExt(%2){} NUses:1
; CHECK-NEXT:    %5: i128 = IntAdd(%3, %4){} NUses:1
; CHECK-NEXT:    %6: i128 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %y = xor i64 %a, %b
  %z = zext i64 %y to i128
  %w = zext i64 %y to i128
  %r = add i128 %z, %w
  ret i128 %r
}
