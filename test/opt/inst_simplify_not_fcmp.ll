; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "InstSimplify,DCE,InstSimplify" | FileCheck %s
; The negation of a float compare: a NaN makes an ordered compare false, so its negation has to be true for NaN,
; that is the unordered predicate of the opposite relation (!(a > b) is ule, not ole).

define i1 @not_ogt(double %a, double %b) {
; CHECK-LABEL: func not_ogt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64, %1{}: f64):
; CHECK-NEXT:    %2: i1 = FloatOGT(%0, %1){} NUses:0
; CHECK-NEXT:    %3: i1 = FloatULE(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i1 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %c = fcmp ogt double %a, %b
  %n = xor i1 %c, true
  ret i1 %n
}

