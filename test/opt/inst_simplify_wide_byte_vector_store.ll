; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; A store of a 16 byte vector must not become a store of a bitcast to a vector
; of wider integers (the bitcast changed the size). Stores of 4 and 8 bytes
; become one integer store.
define void @store16(ptr %p, ptr %q) {
; CHECK-LABEL: func store16<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: 16@i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: 16@i8 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %v = load <16 x i8>, ptr %p
  store <16 x i8> %v, ptr %q
  ret void
}

define void @store8(ptr %p, ptr %q) {
; CHECK-LABEL: func store8<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: 8@i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i64 = BITCAST(%2){} NUses:1
; CHECK-NEXT:    %4: i64 = Store(%1, %3){} NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:}
  %v = load <8 x i8>, ptr %p
  store <8 x i8> %v, ptr %q
  ret void
}
