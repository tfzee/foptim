; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s

; shared terms cancel even when they are spread over a longer add / sub chain
define i32 @shared_term(i32 %a, i32 %b, i32 %m, i32 %r) {
; CHECK-LABEL: func shared_term<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32, %3{}: i32):
; CHECK-NEXT:    %4: i32 = IntMul(%0, 2:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %3){} NUses:1
; CHECK-NEXT:    %6: i32 = IntMul(%1, 2:i32){} NUses:1
; CHECK-NEXT:    %7: i32 = IntSub(%5, %6){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
  %am = add i32 %a, %m
  %bm = add i32 %b, %m
  %t = add i32 %r, %am
  %u = sub i32 %t, %bm
  %v = add i32 %u, %am
  %w = sub i32 %v, %bm
  ret i32 %w
}

; coefficients are summed through multiplications and shifts by constants
define i32 @scaled(i32 %a, i32 %b) {
; CHECK-LABEL: func scaled<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %a3 = mul i32 %a, 3
  %a2 = shl i32 %a, 1
  %x = sub i32 %a3, %a2
  %y = sub i32 %x, %a
  %z = add i32 %y, %b
  ret i32 %z
}

; only negative terms
define i32 @negative(i32 %a, i32 %b) {
; CHECK-LABEL: func negative<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntSub(0:i32, %0){} NUses:1
; CHECK-NEXT:    %3: i32 = IntSub(%2, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = IntSub(%3, %0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %x = sub i32 0, %a
  %y = sub i32 %x, %b
  %z = sub i32 %y, %a
  ret i32 %z
}

; several constants fold together
define i32 @constants(i32 %a, i32 %b) {
; CHECK-LABEL: func constants<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntAdd(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i32 = IntSub(%2, 4:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %x = add i32 %a, 5
  %y = add i32 %x, %b
  %z = sub i32 %y, 9
  ret i32 %z
}

; narrow types wrap
define i8 @narrow(i8 %a, i8 %b) {
; CHECK-LABEL: func narrow<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8):
; CHECK-NEXT:    %2: i8 = Return(%0){} NUses:0
; CHECK-NEXT:}
  %x = add i8 %a, %b
  %y = add i8 %x, %a
  %z = sub i8 %y, %b
  %w = sub i8 %z, %a
  ret i8 %w
}

; a node with a user outside of the tree stays and is not duplicated
define i32 @shared_outside(i32 %a, i32 %b, i32 %c, ptr %p) {
; CHECK-LABEL: func shared_outside<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32, %3{}: ptr):
; CHECK-NEXT:    %4: i32 = IntAdd(%0, %1){} NUses:2
; CHECK-NEXT:    %5: i32 = Store(%3, %4){} NUses:0
; CHECK-NEXT:    %6: i32 = IntAdd(%4, %2){} NUses:1
; CHECK-NEXT:    %7: i32 = IntAdd(%6, %0){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
  %t = add i32 %a, %b
  store i32 %t, ptr %p
  %u = add i32 %t, %c
  %v = add i32 %u, %a
  ret i32 %v
}

; the loop carried value is added last so the loop is a plain reduction
define i32 @carried(i32 %n, ptr %p) {
; CHECK-LABEL: func carried<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: ptr):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32, %4{}: i32):
; CHECK-NEXT:    %5: i64 = SExt(%3){} NUses:1
; CHECK-NEXT:    %6: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%1, %6){} NUses:1
; CHECK-NEXT:    %8: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = IntMul(%8, 2:i32){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%4, %9){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %0){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb2()>(%12){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %14: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc2, %loop ]
  %g = getelementptr i32, ptr %p, i32 %i
  %x = load i32, ptr %g
  %t = add i32 %acc, %x
  %acc2 = add i32 %t, %x
  %i1 = add i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc2
}
