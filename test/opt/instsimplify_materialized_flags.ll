; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,InstSimplify" | FileCheck %s
; The known bits analysis behind the abs simplification proves that the add can
; not wrap and sets nsw/nuw on it, which is all this pass changes here. It has
; to report that (assert builds abort when a pass returns "nothing changed" for
; a function it changed).

declare i64 @llvm.abs.i64(i64, i1)

define i64 @f(i64 %x, i64 %y) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64):
; CHECK-NEXT:    %2: i64 = And(%0, 255:i64){} NUses:1
; CHECK-NEXT:    %3: i64 = IntAdd(%2, 1:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: i64 = Xor(%3, %1){} NUses:1
; CHECK-NEXT:    %5: i64 = INTRIN:ABS(%4){} NUses:1
; CHECK-NEXT:    %6: i64 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %a = and i64 %x, 255
  %add = add i64 %a, 1
  %v = xor i64 %add, %y
  %r = call i64 @llvm.abs.i64(i64 %v, i1 false)
  ret i64 %r
}
