; x + x and (x + y) + y on vectors become a multiply by a splat of the element type
define <8 x i32> @dbl(<8 x i32> %x) {
; CHECK-LABEL: func dbl<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: 8@i32):
; CHECK-NEXT:    %1: 8@i32 = IntAdd(%0, %0){} NUses:1
; CHECK-NEXT:    %2: 8@i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = add <8 x i32> %x, %x
  ret <8 x i32> %r
}

define <4 x i32> @dbl_inner(<4 x i32> %x, <4 x i32> %y) {
; CHECK-LABEL: func dbl_inner<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: 4@i32, %1{}: 4@i32):
; CHECK-NEXT:    %2: 4@i32 = IntMul(%1, <2:i32, 2:i32, 2:i32, 2:i32, >:4@i32){} NUses:1
; CHECK-NEXT:    %3: 4@i32 = IntAdd(%0, %2){} NUses:1
; CHECK-NEXT:    %4: 4@i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %t = add <4 x i32> %x, %y
  %r = add <4 x i32> %t, %y
  ret <4 x i32> %r
}
