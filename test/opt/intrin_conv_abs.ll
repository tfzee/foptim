; (x + m) ^ m
define i32 @bits_add_xor(i32 %x) {
; CHECK-LABEL: func bits_add_xor<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %m = ashr i32 %x, 31
  %a = add i32 %x, %m
  %r = xor i32 %a, %m
  ret i32 %r
}

; (x ^ m) - m
define i64 @bits_xor_sub(i64 %x) {
