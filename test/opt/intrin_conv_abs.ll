; select forms of abs
define i32 @sel_lt(i32 %x) {
; CHECK-LABEL: func sel_lt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = icmp slt i32 %x, 0
  %n = sub i32 0, %x
  %r = select i1 %c, i32 %n, i32 %x
  ret i32 %r
}

define i32 @sel_ge(i32 %x) {
; CHECK-LABEL: func sel_ge<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = icmp sge i32 %x, 0
  %n = sub i32 0, %x
  %r = select i1 %c, i32 %x, i32 %n
  ret i32 %r
}

