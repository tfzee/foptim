; the compare of a narrow value is done on the sign extended value
define i8 @sel_i8(i8 %x) {
; CHECK-LABEL: func sel_i8<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i8 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i8 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %e = sext i8 %x to i32
  %c = icmp slt i32 %e, 0
  %n = sub i8 0, %x
  %r = select i1 %c, i8 %n, i8 %x
  ret i8 %r
}

; without nsz and nonans -x is not fabs(x)
define float @fsel_lt(float %x) {
; CHECK-LABEL: func fsel_lt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: i1 = FloatOLT(%0, 0:f32){} NUses:1
; CHECK-NEXT:    %2: f32 = FloatNeg(%0){} NUses:1
; CHECK-NEXT:    %3: f32 = Select(%1, %2, %0){} NUses:1
; CHECK-NEXT:    %4: f32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %c = fcmp olt float %x, 0.0
  %n = fneg float %x
  %r = select i1 %c, float %n, float %x
  ret float %r
}

