; (x ^ m) + (m & 1)
define i32 @bits_xor_add_and(i32 %x) {
; CHECK-LABEL: func bits_xor_add_and<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %m = ashr i32 %x, 31
  %a = xor i32 %x, %m
  %b = and i32 %m, 1
  %r = add i32 %a, %b
  ret i32 %r
}

; narrow values are shifted as i32
define i16 @bits_i16(i16 %x) {
; CHECK-LABEL: func bits_i16<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i16):
; CHECK-NEXT:    %1: i16 = INTRIN:ABS(%0){} NUses:1
; CHECK-NEXT:    %2: i16 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %e = sext i16 %x to i32
  %s = ashr i32 %e, 15
  %m = trunc i32 %s to i16
  %a = xor i16 %x, %m
  %r = sub i16 %a, %m
  ret i16 %r
}

; clearing the sign bit
define float @and_mask_f32(float %x) {
; CHECK-LABEL: func and_mask_f32<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: f32 = INTRIN:FABS(%0){} NUses:1
; CHECK-NEXT:    %2: f32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %b = bitcast float %x to i32
  %a = and i32 %b, 2147483647
  %r = bitcast i32 %a to float
  ret float %r
}

