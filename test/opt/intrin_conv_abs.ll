; x > 0 is x, everything else is the cleared sign bit
define float @gt_and_mask(float %x) {
; CHECK-LABEL: func gt_and_mask<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: f32 = INTRIN:FABS(%0){} NUses:1
; CHECK-NEXT:    %2: f32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = fcmp ogt float %x, 0.0
  %b = bitcast float %x to i32
  %a = and i32 %b, 2147483647
  %f = bitcast i32 %a to float
  %r = select i1 %c, float %x, float %f
  ret float %r
}

