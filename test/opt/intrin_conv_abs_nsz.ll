; RUN: %foffcc %s --print-fir --cconffile %S/nsz_nonans.toml --passes "Mem2Reg,InstSimplify,DCE,IntrinConv,DCE" | FileCheck %s

; -x is only fabs(x) without signed zeros and NaNs, see intrin_conv_abs.ll
define float @fsel_lt(float %x) {
; CHECK-LABEL: func fsel_lt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: f32 = INTRIN:FABS(%0){} NUses:1
; CHECK-NEXT:    %2: f32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = fcmp olt float %x, 0.0
  %n = fneg float %x
  %r = select i1 %c, float %n, float %x
  ret float %r
}

define double @fsel_ge(double %x) {
; CHECK-LABEL: func fsel_ge<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64):
; CHECK-NEXT:    %1: f64 = INTRIN:FABS(%0){} NUses:1
; CHECK-NEXT:    %2: f64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = fcmp oge double %x, 0.0
  %n = fneg double %x
  %r = select i1 %c, double %x, double %n
  ret double %r
}

define float @fsel_gt_sub(float %x) {
; CHECK-LABEL: func fsel_gt_sub<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: f32 = INTRIN:FABS(%0){} NUses:1
; CHECK-NEXT:    %2: f32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %c = fcmp ogt float %x, 0.0
  %n = fsub float 0.0, %x
  %r = select i1 %c, float %x, float %n
  ret float %r
}
