; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "IntrinConv" | FileCheck %s
; the count of memset/memcpy is in elements, not bytes

define void @fill(ptr %p) {
; CHECK-LABEL: func fill<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i64):
; CHECK-NEXT:    %3: i64 = IntMul(%2, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%0, %3){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: i64 = IntAdd(%2, 1:i64){} NUses:1
; CHECK-NEXT:    %6: i1 = IntULT(%5, 16:i64){} NUses:0
; CHECK-NEXT:    %7: () = INTRIN:MemSet(%4, 7:i32, 16:i64){} NUses:0
; CHECK-NEXT:    %8: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %n, %loop ]
  %a = getelementptr i32, ptr %p, i64 %i
  store i32 7, ptr %a
  %n = add i64 %i, 1
  %c = icmp ult i64 %n, 16
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

define void @copy(ptr %d, ptr %s) {
; CHECK-LABEL: func copy<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64):
; CHECK-NEXT:    %4: i64 = IntMul(%3, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: ptr = PtrAdd(%1, %4){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: i64 = IntMul(%3, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: i64 = IntAdd(%3, 1:i64){} NUses:1
; CHECK-NEXT:    %9: i1 = IntULT(%8, 16:i64){} NUses:0
; CHECK-NEXT:    %10: () = INTRIN:MemCpy(%7, %5, 16:i64){extTy: i32; } NUses:0
; CHECK-NEXT:    %11: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %12: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %n, %loop ]
  %sa = getelementptr i32, ptr %s, i64 %i
  %da = getelementptr i32, ptr %d, i64 %i
  %v = load i32, ptr %sa
  store i32 %v, ptr %da
  %n = add i64 %i, 1
  %c = icmp ult i64 %n, 16
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
