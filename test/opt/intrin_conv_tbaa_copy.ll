; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "IntrinConv" | FileCheck %s
; The copy loop reads from p + 32 and writes p, the regions may overlap and the
; loop stays. When the type tags of the load and the store are disjoint they
; cannot overlap and it is a memcpy.

define void @untagged(ptr %p) {
; CHECK-LABEL: func untagged<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = IntMul(32:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64):
; CHECK-NEXT:    %5: i64 = IntMul(%4, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%2, %5){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%4, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%6){} NUses:1
; CHECK-NEXT:    %10: i32 = Store(%8, %9){} NUses:0
; CHECK-NEXT:    %11: i64 = IntAdd(%4, 1:i64){} NUses:2
; CHECK-NEXT:    %12: i1 = IntULT(%11, 16:i64){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11), bb2()>(%12){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %14: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %s = getelementptr i8, ptr %p, i64 32
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %n, %loop ]
  %sa = getelementptr i32, ptr %s, i64 %i
  %da = getelementptr i32, ptr %p, i64 %i
  %v = load i32, ptr %sa
  store i32 %v, ptr %da
  %n = add i64 %i, 1
  %c = icmp ult i64 %n, 16
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

define void @tagged(ptr %p) {
; CHECK-LABEL: func tagged<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = IntMul(32:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64):
; CHECK-NEXT:    %5: i64 = IntMul(%4, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%2, %5){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%4, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i64 = IntAdd(%4, 1:i64){} NUses:1
; CHECK-NEXT:    %10: i1 = IntULT(%9, 16:i64){} NUses:0
; CHECK-NEXT:    %11: () = INTRIN:MemCpy(%8, %6, 16:i64){extTy: i32; } NUses:0
; CHECK-NEXT:    %12: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: () = Return(){} NUses:0
