entry:
  %s = getelementptr i8, ptr %p, i64 32
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %n, %loop ]
  %sa = getelementptr i32, ptr %s, i64 %i
  %da = getelementptr i32, ptr %p, i64 %i
  %v = load i32, ptr %sa, !tbaa !0
  store i32 %v, ptr %da, !tbaa !1
  %n = add i64 %i, 1
  %c = icmp ult i64 %n, 16
