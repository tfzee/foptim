; CHECK-NEXT:  bb1(%2{}: i64):
; CHECK-NEXT:    %3: i64 = IntMul(%2, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%0, %3){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: i64 = IntAdd(%2, 1:i64){} NUses:1
; CHECK-NEXT:    %6: i1 = IntULT(%5, 8:i64){} NUses:0
; CHECK-NEXT:    %7: () = Branch<bb2(%4, 0:i64)>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %9: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2(%10{}: ptr, %11{}: i64):
; CHECK-NEXT:    %12: i64 = Store(%10, 5:i64){} NUses:0
; CHECK-NEXT:    %13: ptr = PtrAdd(%10, 8:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %14: i64 = IntAdd(%11, 1:i64){} NUses:2
; CHECK-NEXT:    %15: i1 = IntULT(%14, 8:i64){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb2(%13, %14), bb4()>(%15){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %n, %loop ]
  %a = getelementptr i64, ptr %p, i64 %i
  store i64 5, ptr %a
  %n = add i64 %i, 1
  %c = icmp ult i64 %n, 8
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

