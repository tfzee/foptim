; CHECK-NEXT:    %7: ptr = PtrAdd(%1, 3:i64){} NUses:1
; CHECK-NEXT:    %8: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = Xor(%6, %8){} NUses:1
; CHECK-NEXT:    %10: i32 = Or(%4, %9){} NUses:1
; CHECK-NEXT:    %11: i1 = IntNE(%10, 0:i32){} NUses:1
; CHECK-NEXT:    %12: i32 = ZExt(%11){} NUses:1
