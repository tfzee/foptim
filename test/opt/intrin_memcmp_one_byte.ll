; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,IntrinSimplify,DCE" | FileCheck %s
; One byte keeps the sign, it is the difference of the unsigned bytes.
declare i32 @memcmp(ptr, ptr, i64)

define i32 @one(ptr %a, ptr %b) {
; CHECK-LABEL: func one<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = ZExt(%2){} NUses:1
; CHECK-NEXT:    %4: i8 = Load(%1){} NUses:1
; CHECK-NEXT:    %5: i32 = ZExt(%4){} NUses:1
; CHECK-NEXT:    %6: i32 = IntSub(%3, %5){} NUses:1
; CHECK-NEXT:    %7: i32 = Return(%6){} NUses:0
; CHECK-NEXT:}
  %r = call i32 @memcmp(ptr %a, ptr %b, i64 1)
  ret i32 %r
}
