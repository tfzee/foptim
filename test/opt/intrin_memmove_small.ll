; A small constant memmove reads everything before it writes, so overlapping
; regions stay correct.
declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)

define void @small(ptr %d, ptr %s) {
; CHECK-LABEL: func small<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: i64 = Load(%1){} NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%1, 8:i64){} NUses:1
; CHECK-NEXT:    %4: i32 = Load(%3){} NUses:1
; CHECK-NEXT:    %5: i64 = Store(%0, %2){} NUses:0
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, 8:i64){} NUses:1
; CHECK-NEXT:    %7: i32 = Store(%6, %4){} NUses:0
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:}
  call void @llvm.memmove.p0.p0.i64(ptr %d, ptr %s, i64 12, i1 false)
  ret void
}
