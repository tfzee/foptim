; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "IPCP,ArgPromotion" | FileCheck %s
; A function whose address is stored in a global initializer has callers that are
; not visible, so unused or constant arguments must stay (sqlite calls its
; aggregate step functions through such a table).

@table = internal global [1 x ptr] [ptr @step], align 8

define internal void @step(ptr %ctx, i32 %argc, ptr %argv) {
; CHECK-LABEL: func step<CC: C, LINK: internal, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32, %2{}: ptr):
; CHECK-NEXT:    %3: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 1, ptr %ctx, align 4
  ret void
}

define internal void @direct(ptr %ctx, i32 %argc, ptr %argv) {
; CHECK-LABEL: func direct<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %2: () = Return(){} NUses:0
; CHECK-NEXT:}
  store i32 2, ptr %ctx, align 4
  ret void
}

define ptr @get(ptr %ctx) {
; CHECK-LABEL: func get<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: () = Call(direct, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %2: ptr = Return(G(table)){} NUses:0
; CHECK-NEXT:}
  call void @direct(ptr %ctx, i32 7, ptr null)
  ret ptr @table
}
