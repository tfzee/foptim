; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "IPCP,DCE" | FileCheck %s
; Results of a multi result function: one result is a constant on every
; return, one is never read, two return the same value.

declare void @use(i64)
declare i64 @get()

define internal { i64, i64 } @const_second(i64 %a, i1 %c) {
; CHECK-LABEL: func const_second<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i1):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: i64 = IntAdd(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %4: i64 = Return(%3){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i64 = IntMul(%0, 3:i64){} NUses:1
; CHECK-NEXT:    %6: i64 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %l, label %r
l:
  %x = add i64 %a, 1
  %r0 = insertvalue { i64, i64 } poison, i64 %x, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 7, 1
  ret { i64, i64 } %r1
r:
  %y = mul i64 %a, 3
  %s0 = insertvalue { i64, i64 } poison, i64 %y, 0
  %s1 = insertvalue { i64, i64 } %s0, i64 7, 1
  ret { i64, i64 } %s1
}

define internal { i64, i64 } @dup(i64 %a) {
; CHECK-LABEL: func dup<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = IntAdd(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %2: i64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %x = add i64 %a, 1
  %r0 = insertvalue { i64, i64 } poison, i64 %x, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 %x, 1
  ret { i64, i64 } %r1
}

define internal { i64, i64 } @unread_first(i64 %a) {
; CHECK-LABEL: func unread_first<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = IntAdd(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %2: i64 = IntMul(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %x = add i64 %a, 1
  %y = mul i64 %a, %x
  %r0 = insertvalue { i64, i64 } poison, i64 %x, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 %y, 1
  ret { i64, i64 } %r1
}

define internal { i64, i64 } @rec(i64 %n) {
; CHECK-LABEL: func rec<CC: C, LINK: internal, > Uses: 2
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i1 = IntEQ(%0, 0:i64){} NUses:1
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: i64 = IntSub(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %5: () = Call(rec, %4){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %z = icmp eq i64 %n, 0
  br i1 %z, label %base, label %step
base:
  %r0 = insertvalue { i64, i64 } poison, i64 4, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 5, 1
  ret { i64, i64 } %r1
step:
  %m = sub i64 %n, 1
  %r = call { i64, i64 } @rec(i64 %m)
  ret { i64, i64 } %r
}

; the argument has another value in every recursive call, the result is not
; the argument of the outer call
define internal i64 @acc(i64 %n, i64 %m) {
; CHECK-LABEL: func acc<CC: C, LINK: internal, > Uses: 2
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntEQ(%0, 0:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: i64 = Return(%1){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i64 = IntSub(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %6: i64 = IntAdd(%1, %0){} NUses:1
; CHECK-NEXT:    %7: i64 = Call(acc, %5, %6){extTy: i64(i64 i64 ); } NUses:1
; CHECK-NEXT:    %8: i64 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  %z = icmp eq i64 %n, 0
  br i1 %z, label %base, label %step
base:
  ret i64 %m
step:
  %n1 = sub i64 %n, 1
  %m1 = add i64 %m, %n
  %r = call i64 @acc(i64 %n1, i64 %m1)
  ret i64 %r
}

define void @caller(i1 %c) {
; CHECK-LABEL: func caller<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1):
; CHECK-NEXT:    %1: i64 = Call(acc, 10:i64, 0:i64){extTy: i64(i64 i64 ); } NUses:1
; CHECK-NEXT:    %2: () = Call(use, %1){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %3: () = Call(rec, 10:i64){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %4: () = Call(use, 4:i64){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %5: () = Call(use, 5:i64){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %6: i64 = Call(get){extTy: i64(); } NUses:3
; CHECK-NEXT:    %7: i64 = Call(const_second, %6, %0){extTy: i64(i64 i1 ); } NUses:1
; CHECK-NEXT:    %8: () = Call(use, %7){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %9: () = Call(use, 7:i64){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %10: i64 = Call(dup, %6){extTy: i64(i64 ); } NUses:2
; CHECK-NEXT:    %11: () = Call(use, %10){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %12: () = Call(use, %10){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %13: i64 = Call(unread_first, %6){extTy: i64(i64 ); } NUses:1
; CHECK-NEXT:    %14: () = Call(use, %13){extTy: ()(i64 ); } NUses:0
; CHECK-NEXT:    %15: () = Return(){} NUses:0
; CHECK-NEXT:}
  %acc = call i64 @acc(i64 10, i64 0)
  call void @use(i64 %acc)
  %e = call { i64, i64 } @rec(i64 10)
  %e0 = extractvalue { i64, i64 } %e, 0
  %e1 = extractvalue { i64, i64 } %e, 1
  call void @use(i64 %e0)
  call void @use(i64 %e1)
  %n = call i64 @get()
  %a = call { i64, i64 } @const_second(i64 %n, i1 %c)
  %a0 = extractvalue { i64, i64 } %a, 0
  %a1 = extractvalue { i64, i64 } %a, 1
  call void @use(i64 %a0)
  call void @use(i64 %a1)
  %b = call { i64, i64 } @dup(i64 %n)
  %b0 = extractvalue { i64, i64 } %b, 0
  %b1 = extractvalue { i64, i64 } %b, 1
  call void @use(i64 %b0)
  call void @use(i64 %b1)
  %d = call { i64, i64 } @unread_first(i64 %n)
  %d1 = extractvalue { i64, i64 } %d, 1
  call void @use(i64 %d1)
  ret void
}
