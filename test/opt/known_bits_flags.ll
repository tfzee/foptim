declare void @use(i32)

; nneg of zext when the sign bit of the operand is known zero
define i1 @zext_nneg(i32 %a, i64 %k) {
; CHECK-LABEL: func zext_nneg<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i64):
; CHECK-NEXT:    %2: i32 = And(%0, 127:i32){} NUses:2
; CHECK-NEXT:    %3: () = Call(use, %2){extTy: ()(i32 ); } NUses:0
; CHECK-NEXT:    %4: i64 = ZExt(%2){NNeg; } NUses:1
; CHECK-NEXT:    %5: i1 = IntEQ(%4, %1){} NUses:1
; CHECK-NEXT:    %6: i1 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %m = and i32 %a, 127
  call void @use(i32 %m)
  %r = zext i32 %m to i64
  %c = icmp eq i64 %r, %k
  ret i1 %c
}

