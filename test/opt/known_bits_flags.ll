; Flags derived from the known bits of the operands: disjoint of or, nuw / nsw
; of sub, mul and shl by a constant, exact of right shifts. Known bits are
; only computed for values something asks about, so every result is compared.

define i1 @or_disjoint(i8 %a, i8 %b, i32 %k) {
; CHECK-LABEL: func or_disjoint<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8, %2{}: i32):
; CHECK-NEXT:    %3: i32 = ZExt(%0){} NUses:1
; CHECK-NEXT:    %4: i32 = Shl(%3, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: i32 = ZExt(%1){} NUses:1
; CHECK-NEXT:    %6: i32 = Or(%4, %5){Disjoint; } NUses:1
; CHECK-NEXT:    %7: i1 = IntEQ(%6, %2){} NUses:1
; CHECK-NEXT:    %8: i1 = Return(%7){} NUses:0
; CHECK-NEXT:}
  %x = zext i8 %a to i32
  %s = shl i32 %x, 8
  %z = zext i8 %b to i32
  %r = or i32 %s, %z
  %c = icmp eq i32 %r, %k
  ret i1 %c
}

