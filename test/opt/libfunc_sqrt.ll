; sqrt and sqrtf calls become FloatSqrt, a nobuiltin call or a wrong signature keeps the call
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,DCE" | FileCheck %s
declare double @sqrt(double)
declare float @sqrtf(float)

define double @d(double %x) {
; CHECK-LABEL: func d<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64):
; CHECK-NEXT:    %1: f64 = FloatSqrt(%0){} NUses:1
; CHECK-NEXT:    %2: f64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = call double @sqrt(double %x)
  ret double %r
}
define float @f(float %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f32):
; CHECK-NEXT:    %1: f32 = FloatSqrt(%0){} NUses:1
; CHECK-NEXT:    %2: f32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = call float @sqrtf(float %x)
  ret float %r
}
