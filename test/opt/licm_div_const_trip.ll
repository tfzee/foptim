; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LICM" | FileCheck %s

; the loop always runs at least once but sits behind a guard, so the division
; moves into a new block on the entry edge instead of in front of the guard
define i32 @f(i32 %a, i32 %d, i32 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntSLT(0:i32, %2){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb3(%5{}: i32, %6{}: i32):
; CHECK-NEXT:    %7: i1 = IntSLT(%5, 8000:i32){} NUses:1
; CHECK-NEXT:    %8: () = CondBranch<bb4(), bb5()>(%7){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %10: i32 = IntAdd(%6, %11){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%5, 1:i32){} NUses:1
; CHECK-NEXT:    %13: () = Branch<bb3(%12, %10)>(){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %14: i32 = Return(%6){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %11: i32 = IntSDiv(%0, %1){} NUses:1
; CHECK-NEXT:    %15: () = Branch<bb3(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp slt i32 0, %n
  br i1 %g, label %head, label %exit
head:
  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
  %s = phi i32 [ 0, %entry ], [ %s.next, %body ]
  %c = icmp slt i32 %i, 8000
  br i1 %c, label %body, label %done
body:
  %q = sdiv i32 %a, %d
  %s.next = add i32 %s, %q
  %i.next = add i32 %i, 1
  br label %head
done:
  ret i32 %s
exit:
  ret i32 0
}
