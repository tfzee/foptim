; RUN: %foffcc %s --print-fir --passes "LICM" | FileCheck %s

; the division is guarded by the zero check inside the loop and must not be hoisted
define i32 @f(i32 %a, i32 %d, i32 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntEQ(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %4: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%3){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i32 = IntAdd(%5, 1:i32){} NUses:3
; CHECK-NEXT:    %8: i1 = IntSLT(%7, %2){} NUses:1
; CHECK-NEXT:    %9: () = CondBranch<bb1(%7), bb4()>(%8){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %10: i32 = IntSDiv(%0, %1){} NUses:0
; CHECK-NEXT:    %11: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %12: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %next ]
  %z = icmp eq i32 %d, 0
  br i1 %z, label %next, label %div
div:
  %q = sdiv i32 %a, %d
  br label %next
next:
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i2
}
