; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,LICM" | FileCheck %s
; A latch whose switch has two edges to the header listed it twice as loop tail,
; LICM then hoisted the same instruction twice and destroyed it twice.
define i32 @f(i32 %n, i32 %a, i32 %b) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i1 = IntSLT(%4, %0){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i32 = IntMul(%1, %2){} NUses:1
; CHECK-NEXT:    %8: i32 = IntAdd(%7, %1){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%4, %8){} NUses:4
; CHECK-NEXT:    %10: () = Switch<bb1(%9), bb1(%9), bb1(%9)>(1:i32, 2:i32, %9){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %11: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %i = phi i32 [ 0, %entry ], [ %i2, %latch ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %latch, label %exit
latch:
  %x = mul i32 %a, %b
  %y = add i32 %x, %a
  %i2 = add i32 %i, %y
  switch i32 %i2, label %head [ i32 1, label %head
                                i32 2, label %head ]
exit:
  ret i32 %i
}
