; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "FuncPropAnnotator,Mem2Reg,LICM" | FileCheck %s
; A call to a function that only reads memory leaves the loop when it runs on
; every entry and nothing in the loop writes what it reads. hoisted_call hoists,
; the others must keep the call in the loop: the loop stores to the global
; (store_in_loop), the call is behind a condition (guarded_call) or the callee
; writes memory (writer).

@g = global i64 0, align 8

define internal i64 @reader(i64 %x) noinline {
; CHECK-LABEL: func reader<CC: C, LINK: internal, > Uses: 3
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = Load(G(g)){} NUses:1
; CHECK-NEXT:    %2: i64 = IntAdd(%1, %0){} NUses:1
; CHECK-NEXT:    %3: i64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %v = load i64, ptr @g, align 8
  %r = add i64 %v, %x
  ret i64 %r
}

define internal i64 @writer(i64 %x) noinline {
; CHECK-LABEL: func writer<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = Store(G(g), %0){} NUses:0
; CHECK-NEXT:    %2: i64 = Return(%0){} NUses:0
; CHECK-NEXT:}
  store i64 %x, ptr @g, align 8
  ret i64 %x
}

define i64 @hoisted_call(i64 %n) {
; CHECK-LABEL: func hoisted_call<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = Call(reader, 5:i64){extTy: i64(i64 ); } NUses:1
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64, 0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64, %4{}: i64):
; CHECK-NEXT:    %5: i64 = IntAdd(%4, %1){} NUses:2
; CHECK-NEXT:    %6: i64 = IntAdd(%3, 1:i64){} NUses:2
; CHECK-NEXT:    %7: i1 = IntSLT(%6, %0){} NUses:1
; CHECK-NEXT:    %8: () = CondBranch<bb1(%6, %5), bb2()>(%7){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: i64 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc2, %loop ]
  %c = call i64 @reader(i64 5)
  %acc2 = add i64 %acc, %c
  %i2 = add i64 %i, 1
  %done = icmp slt i64 %i2, %n
  br i1 %done, label %loop, label %exit
exit:
  ret i64 %acc2
}

