; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s

; Equality of two sums drops what both sides share. Inside a loop this lets the
; sum behind the loop cancel, even though the check after the loop used the two
; halves of the difference directly.

define i1 @shared_term(i32 %a, i32 %b, i32 %m) {
; CHECK-LABEL: func shared_term<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntEQ(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i1 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %x = add i32 %a, %m
  %y = add i32 %b, %m
  %c = icmp eq i32 %x, %y
  ret i1 %c
}

define i1 @all_cancels(i32 %a, i32 %m) {
; CHECK-LABEL: func all_cancels<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = Return(0:i1){} NUses:0
; CHECK-NEXT:}
  %m2 = mul i32 %m, 3
  %x = add i32 %a, %m2
  %y = add i32 %m2, %a
  %c = icmp ne i32 %x, %y
  ret i1 %c
}

define i1 @loop_check(ptr %p, i8 %v, i32 %n) {
; CHECK-LABEL: func loop_check<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i8, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:i8)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: i8):
; CHECK-NEXT:    %6: i64 = SExt(%4){} NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; NUW; InBounds; } NUses:1
; CHECK-NEXT:    %8: i8 = Load(%7){} NUses:2
; CHECK-NEXT:    %9: i8 = IntSub(%8, %1){} NUses:1
; CHECK-NEXT:    %10: i8 = IntAdd(%9, %5){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %2){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb2()>(%12){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %14: i8 = IntAdd(%8, %5){} NUses:1
; CHECK-NEXT:    %15: i1 = IntEQ(%14, %1){} NUses:1
; CHECK-NEXT:    %16: i1 = Return(%15){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i8 [ 0, %entry ], [ %acc1, %loop ]
  %q = getelementptr inbounds i8, ptr %p, i32 %i
  %x = load i8, ptr %q
  %xv = sdiv i8 %v, %x
  %pos = add i8 %x, %xv
  %neg = add i8 %xv, %v
  %d = sub i8 %pos, %neg
  %acc1 = add i8 %acc, %d
  %i1 = add i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  %z = icmp eq i8 %acc1, 0
  ret i1 %z
}
