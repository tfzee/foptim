; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; a coefficient shared by all terms is applied once: 8a - 8b is (a - b) * 8
define i32 @pow2(i32 %a, i32 %b) {
; CHECK-LABEL: func pow2<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntSub(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i32 = IntMul(%2, 8:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %x = mul i32 %a, 8
  %y = mul i32 %b, 8
  %r = sub i32 %x, %y
  ret i32 %r
}
define i32 @odd(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: func odd<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i32 = IntAdd(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = IntMul(%4, 5:i32){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %x = mul i32 %a, 5
  %y = mul i32 %b, 5
  %z = mul i32 %c, 5
  %s = add i32 %x, %y
  %r = add i32 %s, %z
  ret i32 %r
}
; the difference is factored on its own, the add of c stays outside
define i32 @mixed(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: func mixed<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i32 = IntSub(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = IntMul(%3, 8:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %2){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %x = mul i32 %a, 8
  %y = mul i32 %b, 8
  %s = sub i32 %x, %y
  %r = add i32 %s, %c
  ret i32 %r
}
