; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; the i32 sums only matter mod 2^8, so the shared term x cancels across the truncs
define i8 @f(i8 %a, i8 %b, i8 %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8, %2{}: i8):
; CHECK-NEXT:    %3: i8 = IntSub(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i8 = IntMul(%3, 6:i8){} NUses:1
; CHECK-NEXT:    %5: i8 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %xz = zext i8 %x to i32
  %x2 = mul nsw i32 %xz, 2
  %az = zext i8 %a to i32
  %bz = zext i8 %b to i32
  %s1 = add nsw i32 %az, %x2
  %s2 = add nsw i32 %bz, %x2
  %t1 = trunc i32 %s1 to i8
  %t2 = trunc i32 %s2 to i8
  %m1 = mul i8 %t1, 6
  %m2 = mul i8 %t2, 6
  %r = sub i8 %m1, %m2
  ret i8 %r
}
