declare void @llvm.prefetch.p0(ptr, i32, i32, i32)
declare ptr @llvm.invariant.start.p0(i64, ptr)
declare void @llvm.invariant.end.p0(ptr, i64, ptr)

define i32 @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
