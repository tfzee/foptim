; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  call void @llvm.prefetch.p0(ptr %p, i32 0, i32 3, i32 1)
  %t = call ptr @llvm.invariant.start.p0(i64 4, ptr %p)
  %v = load i32, ptr %p
  call void @llvm.invariant.end.p0(ptr %t, i64 4, ptr %p)
  ret i32 %v
}
