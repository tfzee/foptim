; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering" | FileCheck %s
; scalar math intrinsics become calls of the libm function of their width
declare double @llvm.log.f64(double)
declare float @llvm.log2.f32(float)
declare float @llvm.exp.f32(float)
declare double @llvm.pow.f64(double, double)

define double @f(double %x, float %y, double %z) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64, %1{}: f32, %2{}: f64):
; CHECK-NEXT:    %3: f64 = Call(log, %0){extTy: f64(f64 ); } NUses:1
; CHECK-NEXT:    %4: f32 = Call(log2f, %1){extTy: f32(f32 ); } NUses:1
; CHECK-NEXT:    %5: f32 = Call(expf, %1){extTy: f32(f32 ); } NUses:1
; CHECK-NEXT:    %6: f64 = Call(pow, %0, %2){extTy: f64(f64 f64 ); } NUses:1
; CHECK-NEXT:    %7: f64 = FP_EXT(%4){} NUses:1
; CHECK-NEXT:    %8: f64 = FP_EXT(%5){} NUses:1
; CHECK-NEXT:    %9: f64 = FloatAdd(%3, %7){} NUses:1
; CHECK-NEXT:    %10: f64 = FloatAdd(%9, %8){} NUses:1
; CHECK-NEXT:    %11: f64 = FloatAdd(%10, %6){} NUses:1
; CHECK-NEXT:    %12: f64 = Return(%11){} NUses:0
; CHECK-NEXT:}
  %a = call double @llvm.log.f64(double %x)
  %b = call float @llvm.log2.f32(float %y)
  %c = call float @llvm.exp.f32(float %y)
  %d = call double @llvm.pow.f64(double %x, double %z)
  %e = fpext float %b to double
  %g = fpext float %c to double
  %s = fadd double %a, %e
  %t = fadd double %s, %g
  %u = fadd double %t, %d
  ret double %u
}
