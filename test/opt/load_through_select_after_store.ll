; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; The select of the two stack slots sits in front of the stores, the loads that replace the
; load of the select have to stay behind the stores.
define i32 @f(i32 %a, i32 %b, i1 %c) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i1):
; CHECK-NEXT:    %3: ptr = Alloca(4:i32){extTy: i32; } NUses:2
; CHECK-NEXT:    %4: ptr = Alloca(4:i32){extTy: i32; } NUses:2
; CHECK-NEXT:    %5: i32 = Store(%3, %0){} NUses:0
; CHECK-NEXT:    %6: i32 = Store(%4, %1){} NUses:0
; CHECK-NEXT:    %7: i32 = Load(%3){} NUses:1
; CHECK-NEXT:    %8: i32 = Load(%4){} NUses:1
; CHECK-NEXT:    %9: i32 = Select(%2, %7, %8){} NUses:1
; CHECK-NEXT:    %10: i32 = Return(%9){} NUses:0
; CHECK-NEXT:}
  %x = alloca i32
  %y = alloca i32
  %p = select i1 %c, ptr %x, ptr %y
  store i32 %a, ptr %x
  store i32 %b, ptr %y
  %v = load i32, ptr %p
  ret i32 %v
}
