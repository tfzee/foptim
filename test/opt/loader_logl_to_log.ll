; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "DCE" | FileCheck %s
; long double is f64 in FIR, so logl has to call the double libm function

declare x86_fp80 @logl(x86_fp80)

define x86_fp80 @f(x86_fp80 %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64):
; CHECK-NEXT:    %1: f64 = Call(log, %0){extTy: f64(f64 ); } NUses:1
; CHECK-NEXT:    %2: f64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = call x86_fp80 @logl(x86_fp80 %x)
  ret x86_fp80 %r
}
