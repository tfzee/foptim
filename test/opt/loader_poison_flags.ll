; RUN: %foffcc %s --print-fir --passes "DCE" | FileCheck %s
; The loader keeps every poison generating flag of LLVM IR (nsw / nuw of sub,
; shl and trunc, exact, disjoint, nneg, samesign) on the FIR instruction.

define i32 @f(i32 %a, i32 %b) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntSub(%0, %1){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: i32 = Shl(%2, 2:i32){NUW; } NUses:1
; CHECK-NEXT:    %4: i32 = IntUDiv(%3, %1){Exact; } NUses:1
; CHECK-NEXT:    %5: i32 = LShR(%4, 1:i32){Exact; } NUses:1
; CHECK-NEXT:    %6: i32 = Or(%5, 1:i32){Disjoint; } NUses:2
; CHECK-NEXT:    %7: i16 = ITrunc(%6){NSW; } NUses:1
; CHECK-NEXT:    %8: i32 = ZExt(%7){NNeg; } NUses:2
; CHECK-NEXT:    %9: i1 = IntULT(%8, %0){SameSign; } NUses:1
; CHECK-NEXT:    %10: i32 = Select(%9, %8, %6){} NUses:1
; CHECK-NEXT:    %11: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
  %s = sub nsw nuw i32 %a, %b
  %h = shl nuw i32 %s, 2
  %x = udiv exact i32 %h, %b
  %y = lshr exact i32 %x, 1
  %o = or disjoint i32 %y, 1
  %tr = trunc nsw i32 %o to i16
  %z = zext nneg i16 %tr to i32
  %cm = icmp samesign ult i32 %z, %a
  %r = select i1 %cm, i32 %z, i32 %o
  ret i32 %r
}
