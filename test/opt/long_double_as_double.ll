; CHECK-NEXT:    %4: f64 = FloatAdd(%3, %2){} NUses:1
; CHECK-NEXT:    %5: f64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %r = call x86_fp80 @llvm.fmuladd.f80(x86_fp80 %a, x86_fp80 %b, x86_fp80 %c)
  ret x86_fp80 %r
}
declare x86_fp80 @llvm.fmuladd.f80(x86_fp80, x86_fp80, x86_fp80)
