; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,InstSimplify,DCE" | FileCheck %s
; long double is f64 in FIR. A conversion between x86_fp80 and double is no
; conversion, and the f80 overloads of intrinsics are the f64 ones.
define double @trunc_const() {
; CHECK-LABEL: func trunc_const<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: f64 = Return(4004000000000000:f64){} NUses:0
; CHECK-NEXT:}
  %e = fpext double 2.5 to x86_fp80
  %t = fptrunc x86_fp80 %e to double
  ret double %t
}

define double @trunc_arg(x86_fp80 %x) {
; CHECK-LABEL: func trunc_arg<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64):
; CHECK-NEXT:    %1: f64 = Return(%0){} NUses:0
; CHECK-NEXT:}
  %t = fptrunc x86_fp80 %x to double
  ret double %t
}

define x86_fp80 @ext_arg(double %x) {
