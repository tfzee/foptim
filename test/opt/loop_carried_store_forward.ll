; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; A load in the loop header that reads what a store of the previous iteration wrote becomes a header argument: the load address of iteration k + 1 is the store address of iteration k. The first iteration gets the load in front of the loop, which the forwarder then takes from the store before the loop.
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,LVN,DCE" | FileCheck %s

; expected: no load left in the loop. The header gets one more argument that is 7 on the first iteration (the store in front of the loop) and the counter on every other one.
define i32 @forward_stride_4(ptr noalias %buf, i32 %n) {
; CHECK-LABEL: func forward_stride_4<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Store(%0, 7:i32){} NUses:0
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, %0, 0:i32, 7:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: ptr, %6{}: i32, %7{}: i32):
; CHECK-NEXT:    %8: i32 = IntAdd(%6, %7){} NUses:2
; CHECK-NEXT:    %9: i64 = IntMul(4:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%5, %9){} NUses:2
; CHECK-NEXT:    %11: i32 = Store(%10, %4){} NUses:0
; CHECK-NEXT:    %12: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %1){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%12, %10, %8, %4), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %15: i32 = Return(%8){} NUses:0
; CHECK-NEXT:}
entry:
  store i32 7, ptr %buf
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %p = phi ptr [ %buf, %entry ], [ %q, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %v = load i32, ptr %p
  %acc.next = add i32 %acc, %v
  %q = getelementptr i8, ptr %p, i64 4
  store i32 %i, ptr %q
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.next
}

