entry:
  %buf = call ptr @calloc(i64 1, i64 1000)
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %p = phi ptr [ %buf, %entry ], [ %q, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %v = load i8, ptr %p
  %z = zext i8 %v to i32
  %acc.next = add i32 %acc, %z
  %q = getelementptr i8, ptr %p, i64 6
  store i8 0, ptr %q
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
