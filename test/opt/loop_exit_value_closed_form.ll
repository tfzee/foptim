; CHECK-NEXT:    %9: i32 = Return(%8){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ %n, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 3
  %i.n = add nuw i32 %i, -1
  %c = icmp ne i32 %i.n, 0
