; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,InstSimplify,SimplifyCFG,DCE" | FileCheck %s
; Exit values of induction variables are computed from a closed form trip count.

define i32 @up() {
; CHECK-LABEL: func up<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(25500000:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 255
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, 100000
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

define i32 @down() {
; CHECK-LABEL: func down<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(25500000:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ 100000, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 255
  %i.n = add nsw i32 %i, -1
  %c = icmp sgt i32 %i.n, 0
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

