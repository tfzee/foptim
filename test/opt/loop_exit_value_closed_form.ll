define i32 @unsigned_header_exit() {
; CHECK-LABEL: func unsigned_header_exit<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(53:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 5, %entry ], [ %i.n, %body ]
  %c = icmp ult i32 %i, 50
