  br label %loop
exit:
  ret i32 %i
}

; the i8 counter wraps before the compare fails, must not be folded
define i8 @wraps() {
; CHECK-LABEL: func wraps<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = Branch<bb1(0:i8)>(){} NUses:0
; CHECK-NEXT:  bb1(%1{}: i8):
; CHECK-NEXT:    %2: i8 = IntAdd(%1, 100:i8){} NUses:2
; CHECK-NEXT:    %3: i1 = IntSLT(%2, 120:i8){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(%2), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i8 = IntAdd(%1, 100:i8){} NUses:1
; CHECK-NEXT:    %6: i8 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i8 [ 0, %entry ], [ %i.n, %loop ]
  %i.n = add i8 %i, 100
  %c = icmp slt i8 %i.n, 120
  br i1 %c, label %loop, label %exit
exit:
  ret i8 %i.n
}
