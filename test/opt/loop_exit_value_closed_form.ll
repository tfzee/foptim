; the i8 counter wraps before the compare fails, must not be folded
define i8 @wraps() {
; CHECK-LABEL: func wraps<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = Branch<bb1(0:i8)>(){} NUses:0
; CHECK-NEXT:  bb1(%1{}: i8):
; CHECK-NEXT:    %2: i8 = IntAdd(%1, 100:i8){} NUses:2
; CHECK-NEXT:    %3: i1 = IntSLT(%2, 120:i8){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(%2), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i8 = IntAdd(%1, 100:i8){} NUses:1
; CHECK-NEXT:    %6: i8 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i8 [ 0, %entry ], [ %i.n, %loop ]
  %i.n = add i8 %i, 100
  %c = icmp slt i8 %i.n, 120
  br i1 %c, label %loop, label %exit
exit:
  ret i8 %i.n
}

; A symbolic != exit stepping by one counts like < when the step add must not
; wrap (nsw: signed, nuw: unsigned), the loop folds to its closed form.
define i32 @ne_sym_nsw(i32 %n) {
; CHECK-LABEL: func ne_sym_nsw<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:SMax(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = IntMul(%1, 3:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 3
  %i.n = add nsw i32 %i, 1
  %c = icmp ne i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

