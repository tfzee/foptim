; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,InstSimplify,SimplifyCFG,DCE" | FileCheck %s
; Exit tests that are polynomials of the iteration number (not affine) are
; solved exactly with a monotone search as long as nothing wraps on the way.

; (k+1)^2 < 2^30 exits when k + 1 = 32768
define i32 @square() {
; CHECK-LABEL: func square<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(32767:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %k = phi i32 [ 0, %entry ], [ %k.n, %loop ]
  %k.n = add i32 %k, 1
  %sq = mul nsw i32 %k.n, %k.n
  %wide = sext i32 %sq to i64
  %c = icmp slt i64 %wide, 1073741824
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %k
}

; cube, other accumulated values come from their own recurrences
define i32 @cube() {
; CHECK-LABEL: func cube<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(200:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %k = phi i32 [ 0, %entry ], [ %k.n, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %k.n = add i32 %k, 1
  %acc.n = add i32 %acc, 2
  %sq = mul i32 %k.n, %k.n
  %cu = mul i32 %sq, %k.n
  %c = icmp slt i32 %cu, 1000000
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

; unsigned compare
define i32 @unsigned_square() {
; CHECK-LABEL: func unsigned_square<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(99:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %k = phi i32 [ 0, %entry ], [ %k.n, %loop ]
  %k.n = add i32 %k, 1
  %sq = mul i32 %k.n, %k.n
  %c = icmp ult i32 %sq, 10000
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %k
}

; NEGATIVE: the square wraps in 32 bit before it can reach the limit
define i32 @neg_wraps() {
; CHECK-LABEL: func neg_wraps<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%1{}: i32):
; CHECK-NEXT:    %2: i32 = IntAdd(%1, 1:i32){} NUses:3
; CHECK-NEXT:    %3: i32 = IntMul(%2, %2){} NUses:1
; CHECK-NEXT:    %4: i1 = IntSLT(%3, 2147483647:i32){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(%2), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %k = phi i32 [ 0, %entry ], [ %k.n, %loop ]
  %k.n = add i32 %k, 1
  %sq = mul i32 %k.n, %k.n
  %c = icmp slt i32 %sq, 2147483647
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %k
}
