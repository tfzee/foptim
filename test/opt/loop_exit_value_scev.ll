; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,LoopSimplify,InstSimplify,SimplifyCFG,DCE" | FileCheck %s
; Exit values of everything ScalarEvo can evaluate, not only induction variables.

; non affine value (i * i) and an affine one (4 * i + 3) of the last iteration
define i32 @mul_and_affine() {
; CHECK-LABEL: func mul_and_affine<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(120:i32){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %sq = mul i32 %i, %i
  %m = mul i32 %i, 4
  %aff = add i32 %m, 3
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, 10
  br i1 %c, label %loop, label %exit
exit:
  %r = add i32 %sq, %aff
  ret i32 %r
}

; sign extended induction variable, start of 100 and a negative step
define i64 @sext_iv() {
; CHECK-LABEL: func sext_iv<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i64 = Return(-47:i64){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 100, %entry ], [ %i.n, %loop ]
  %w = sext i32 %i to i64
  %i.n = sub i32 %i, 7
  %c = icmp sgt i32 %i.n, -50
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %w
}

; two induction variables of different width starting at the same value
define i64 @two_widths(ptr %p, i64 %n) {
; CHECK-LABEL: func two_widths<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64):
; CHECK-NEXT:    %4: i32 = ITrunc(%3){} NUses:1
; CHECK-NEXT:    %5: i64 = IntMul(%3, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, %5){} NUses:1
; CHECK-NEXT:    %7: i32 = Store(%6, %4){} NUses:0
; CHECK-NEXT:    %8: i64 = IntAdd(%3, 1:i64){} NUses:2
; CHECK-NEXT:    %9: i1 = IntULT(%8, %1){} NUses:1
; CHECK-NEXT:    %10: () = CondBranch<bb1(%8), bb2()>(%9){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %11: i64 = IntAdd(%3, 1:i64){} NUses:1
; CHECK-NEXT:    %12: i64 = Return(%11){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %j = phi i64 [ 0, %entry ], [ %j.n, %loop ]
  %q = getelementptr i32, ptr %p, i64 %j
  store i32 %i, ptr %q
  %i.n = add i32 %i, 1
  %j.n = add i64 %j, 1
  %c = icmp ult i64 %j.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %j.n
}
