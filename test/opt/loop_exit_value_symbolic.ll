; CHECK-LABEL: func neg_signed_start<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(%1)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: i32 = IntAdd(%3, 1:i32){NSW; } NUses:3
; CHECK-NEXT:    %5: i1 = IntSLT(%4, %0){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb1(%4), bb2()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ %start, %entry ], [ %i.n, %loop ]
  %i.n = add nsw i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i.n
}

