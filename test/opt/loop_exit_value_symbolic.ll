; RUN: %foffcc %s --print-fir --passes "LoopSimplify,InstSimplify,SimplifyCFG,DCE,LoopSimplify,InstSimplify,SimplifyCFG,DCE,LoopSimplify,InstSimplify,SimplifyCFG,DCE,LVN,InstSimplify,DCE" | FileCheck %s
; Exit values and trip counts that depend on loop invariant values (arguments)
; are computed in front of the loop: k = max(limit, start) - start for counting
; up, max(start, limit) - limit for counting down.

; i from 0 up to %n, executes at least once
define i32 @up(i32 %n) {
; CHECK-LABEL: func up<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = INTRIN:SMax(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = IntMul(%1, 3:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 3
  %i.n = add nsw i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

; counting down to a constant, start is symbolic
define i32 @down(i32 %n) {
; CHECK-LABEL: func down<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = IntAdd(%0, -1:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = INTRIN:SMax(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = IntMul(%2, 5:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, 5:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ %n, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, 5
  %i.n = add nsw i32 %i, -1
  %c = icmp sgt i32 %i.n, 0
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

; the accumulated step is symbolic too
define i32 @symbolic_step(i32 %n, i32 %s) {
; CHECK-LABEL: func symbolic_step<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = INTRIN:SMax(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = IntAdd(%2, -1:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntMul(%3, %1){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %1){} NUses:1
; CHECK-NEXT:    %6: i32 = IntAdd(%5, 7:i32){} NUses:1
; CHECK-NEXT:    %7: i32 = Return(%6){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %acc = phi i32 [ 7, %entry ], [ %acc.n, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc.n = add i32 %acc, %s
  %i.n = add nsw i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}

; unsigned compare, no sign requirement on the start
define i32 @unsigned_up(i32 %n, i32 %start) {
; CHECK-LABEL: func unsigned_up<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntAdd(%1, 1:i32){} NUses:2
; CHECK-NEXT:    %3: i32 = INTRIN:UMax(%0, %2){} NUses:1
; CHECK-NEXT:    %4: i32 = IntSub(%3, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %1){} NUses:1
; CHECK-NEXT:    %6: i32 = IntAdd(%5, 1:i32){} NUses:1
; CHECK-NEXT:    %7: i32 = Return(%6){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ %start, %entry ], [ %i.n, %loop ]
  %i.n = add i32 %i, 1
  %c = icmp ult i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i.n
}

; two nested loops collapse completely (the inner loop first)
define i32 @nested(i32 %n, i32 %m) {
; CHECK-LABEL: func nested<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = INTRIN:SMax(%1, 1:i32){} NUses:2
; CHECK-NEXT:    %3: i32 = INTRIN:SMax(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, -1:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = IntMul(%4, %2){} NUses:1
; CHECK-NEXT:    %6: i32 = IntAdd(%2, %5){} NUses:1
; CHECK-NEXT:    %7: i32 = Return(%6){} NUses:0
; CHECK-NEXT:}
entry:
  br label %outer
outer:
  %i = phi i32 [ 0, %entry ], [ %i.n, %outer.latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.in, %outer.latch ]
  br label %inner
inner:
  %j = phi i32 [ 0, %outer ], [ %j.n, %inner ]
  %a = phi i32 [ %acc, %outer ], [ %a.n, %inner ]
  %a.n = add i32 %a, 1
  %j.n = add nsw i32 %j, 1
  %ic = icmp slt i32 %j.n, %m
  br i1 %ic, label %inner, label %outer.latch
outer.latch:
  %acc.in = phi i32 [ %a.n, %inner ]
  %i.n = add nsw i32 %i, 1
  %oc = icmp slt i32 %i.n, %n
  br i1 %oc, label %outer, label %done
done:
  ret i32 %acc.in
}

; NEGATIVE: a signed compare with a start that may be negative could overflow
