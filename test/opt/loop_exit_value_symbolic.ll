; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: i32 = Store(%0, %3){} NUses:0
