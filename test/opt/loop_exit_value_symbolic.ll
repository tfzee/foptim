; three nested loops with different bounds. The inner loops are only entered if
; their bound is positive, so the value after them is a select on that
; condition, which is a (conditional) invariant step of the loop around it.
define i32 @nested3_guarded(i32 %n, i32 %m, i32 %l) {
; CHECK-LABEL: func nested3_guarded<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntSGT(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %4: i1 = IntSGT(%1, 0:i32){} NUses:3
; CHECK-NEXT:    %5: i1 = IntSGT(%2, 0:i32){} NUses:3
; CHECK-NEXT:    %6: i32 = INTRIN:SMax(%2, 1:i32){} NUses:1
; CHECK-NEXT:    %7: i32 = IntMul(%6, 2:i32){} NUses:2
; CHECK-NEXT:    %8: i32 = IntAdd(%1, -1:i32){} NUses:1
; CHECK-NEXT:    %9: i32 = INTRIN:SMax(%8, 0:i32){} NUses:1
; CHECK-NEXT:    %10: i32 = Select(%5, %7, 0:i32){} NUses:1
; CHECK-NEXT:    %11: i32 = IntMul(%9, %10){} NUses:3
; CHECK-NEXT:    %12: i32 = IntAdd(%7, %11){} NUses:2
; CHECK-NEXT:    %13: i32 = INTRIN:SMax(%0, 1:i32){} NUses:1
; CHECK-NEXT:    %14: i32 = IntAdd(%13, -1:i32){} NUses:1
; CHECK-NEXT:    %15: i32 = Select(%5, %12, %11){} NUses:1
; CHECK-NEXT:    %16: i32 = Select(%4, %15, 0:i32){} NUses:1
; CHECK-NEXT:    %17: i32 = IntMul(%14, %16){} NUses:3
; CHECK-NEXT:    %18: i32 = IntAdd(%12, %17){} NUses:1
; CHECK-NEXT:    %19: i32 = IntAdd(%11, %17){} NUses:1
; CHECK-NEXT:    %20: i32 = Select(%5, %18, %19){} NUses:1
; CHECK-NEXT:    %21: i32 = Select(%4, %20, %17){} NUses:1
; CHECK-NEXT:    %22: () = CondBranch<bb1(), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %23: () = CondBranch<bb3(), bb4()>(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %24: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %25: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %26: i32 = Return(%21){} NUses:0
; CHECK-NEXT:}
entry:
  %g0 = icmp sgt i32 %n, 0
  br i1 %g0, label %o.body, label %done
o.body:
  %i = phi i32 [ 0, %entry ], [ %i.n, %o.latch ]
  %acc0 = phi i32 [ 0, %entry ], [ %acc.o, %o.latch ]
  %g1 = icmp sgt i32 %m, 0
  br i1 %g1, label %m.body, label %o.latch
m.body:
  %j = phi i32 [ %m, %o.body ], [ %j.n, %m.latch ]
  %acc1 = phi i32 [ %acc0, %o.body ], [ %acc.m, %m.latch ]
  %g2 = icmp sgt i32 %l, 0
  br i1 %g2, label %i.body, label %m.latch
i.body:
  %k = phi i32 [ 0, %m.body ], [ %k.n, %i.body ]
  %acc2 = phi i32 [ %acc1, %m.body ], [ %acc2.n, %i.body ]
  %acc2.n = add i32 %acc2, 2
  %k.n = add nsw i32 %k, 1
  %c2 = icmp slt i32 %k.n, %l
  br i1 %c2, label %i.body, label %m.latch
m.latch:
  %acc.m = phi i32 [ %acc1, %m.body ], [ %acc2.n, %i.body ]
  %j.n = add nsw i32 %j, -1
  %c1 = icmp sgt i32 %j.n, 0
  br i1 %c1, label %m.body, label %o.latch
o.latch:
  %acc.o = phi i32 [ %acc0, %o.body ], [ %acc.m, %m.latch ]
  %i.n = add nsw i32 %i, 1
  %c0 = icmp slt i32 %i.n, %n
  br i1 %c0, label %o.body, label %done
done:
  %r = phi i32 [ 0, %entry ], [ %acc.o, %o.latch ]
  ret i32 %r
}

; the loop also produces a value that is not affine (a sum of the counter):
; only the counter itself has a closed form, the loop stays
define i32 @neg_quadratic_sum(i32 %n) {
; CHECK-LABEL: func neg_quadratic_sum<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i32, %3{}: i32):
; CHECK-NEXT:    %4: i32 = IntAdd(%3, %2){} NUses:2
; CHECK-NEXT:    %5: i32 = IntAdd(%2, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %6: i1 = IntSLT(%5, %0){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb1(%5, %4), bb2()>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.n, %loop ]
  %acc.n = add i32 %acc, %i
  %i.n = add nsw i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.n
}
