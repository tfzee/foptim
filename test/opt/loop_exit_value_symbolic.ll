; CHECK-NEXT:    %6: i1 = IntSLT(%5, %1){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb1(%5), bb2()>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:}
