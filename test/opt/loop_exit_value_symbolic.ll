; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i32):
; CHECK-NEXT:    %3: i32 = IntAdd(%2, 2:i32){NSW; } NUses:3
; CHECK-NEXT:    %4: i1 = IntSLT(%3, %0){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(%3), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.n, %loop ]
  %i.n = add nsw i32 %i, 2
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %i.n
}

; NEGATIVE: the loop writes memory, it has to stay
define void @neg_store(ptr %p, i32 %n) {
; CHECK-LABEL: func neg_store<CC: C, LINK: external, > Uses: 0
