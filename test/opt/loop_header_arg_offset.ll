; j and prev = j - 4 are two header arguments that always differ by a
; constant (inner loop of an insertion sort), the loop keeps one pointer.
define void @f(ptr %begin, ptr %start, i32 %tmp) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i32):
; CHECK-NEXT:    %3: i64 = IntMul(-1:i64, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%1, %3){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %5: () = Branch<bb1(%1, %4)>(){} NUses:0
; CHECK-NEXT:  bb1(%6{}: ptr, %7{}: ptr):
; CHECK-NEXT:    %8: ptr = PtrAdd(%7, 4:i64){} NUses:1
; CHECK-NEXT:    %9: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %10: i32 = Store(%8, %9){} NUses:0
; CHECK-NEXT:    %11: i64 = IntMul(-1:i64, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %12: ptr = PtrAdd(%7, %11){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %13: i1 = IntNE(%7, %0){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%7, %12), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %15: i32 = Store(%7, %2){} NUses:0
; CHECK-NEXT:    %16: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %p0 = getelementptr inbounds i32, ptr %start, i64 -1
  br label %loop
loop:
  %j = phi ptr [ %start, %entry ], [ %p, %loop ]
  %p = phi ptr [ %p0, %entry ], [ %pn, %loop ]
  %v = load i32, ptr %p
  store i32 %v, ptr %j
  %pn = getelementptr inbounds i32, ptr %p, i64 -1
  %c = icmp ne ptr %p, %begin
  br i1 %c, label %loop, label %exit
exit:
  store i32 %tmp, ptr %p
  ret void
}
