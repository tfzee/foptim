; the inner loop writes memory
define i32 @keep_inner_store(i32 %rep, i32 %n) {
; CHECK-LABEL: func keep_inner_store<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32):
; CHECK-NEXT:    %4: () = Branch<bb2(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb2(%5{}: i32):
; CHECK-NEXT:    %6: i64 = ZExt(%5){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(G(out), %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Store(%8, %5){} NUses:0
; CHECK-NEXT:    %10: i32 = IntAdd(%5, 1:i32){} NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %1){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb2(%10), bb3()>(%11){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %13: i32 = IntAdd(%3, 1:i32){} NUses:3
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %0){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13), bb4()>(%14){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %16: i32 = Return(%13){} NUses:0
; CHECK-NEXT:}
entry:
  br label %outer
outer:
  %r = phi i32 [ 0, %entry ], [ %r.n, %outer.latch ]
  br label %inner
inner:
  %i = phi i32 [ 0, %outer ], [ %i.n, %inner ]
  %ix = zext i32 %i to i64
  %p = getelementptr i32, ptr @out, i64 %ix
  store i32 %i, ptr %p
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %inner, label %outer.latch
outer.latch:
  %r.n = add i32 %r, 1
  %rc = icmp slt i32 %r.n, %rep
  br i1 %rc, label %outer, label %exit
exit:
  ret i32 %r.n
}

; something with an effect runs before the inner loop in each iteration
