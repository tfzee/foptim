; RUN: %foffcc %s --print-fir --passes "LoopHoist" | FileCheck %s

@arr = global [8 x i32] zeroinitializer
@out = global [8 x i32] zeroinitializer
declare void @sideeffect()

; the inner loop reads memory the outer loop does not write and only uses
; values from before the outer loop, so it runs once in front of it
define i32 @hoist_sum(i32 %rep, i32 %n) {
; CHECK-LABEL: func hoist_sum<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb2(%3{}: i32, %4{}: i32):
; CHECK-NEXT:    %5: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %6: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %7: i32 = IntAdd(%4, %8){} NUses:2
; CHECK-NEXT:    %9: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %10: i1 = IntSLT(%9, %0){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb2(%9, %7), bb5()>(%10){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %12: i32 = Return(%7){} NUses:0
; CHECK-NEXT:  bb6():
; CHECK-NEXT:    %13: () = Branch<bb2(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%14{}: i32, %15{}: i32):
; CHECK-NEXT:    %16: i64 = ZExt(%14){} NUses:1
; CHECK-NEXT:    %17: i64 = IntMul(%16, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %18: ptr = PtrAdd(G(arr), %17){} NUses:1
; CHECK-NEXT:    %19: i32 = Load(%18){} NUses:1
; CHECK-NEXT:    %8: i32 = IntAdd(%15, %19){} NUses:2
; CHECK-NEXT:    %20: i32 = IntAdd(%14, 1:i32){} NUses:2
; CHECK-NEXT:    %21: i1 = IntSLT(%20, %1){} NUses:1
; CHECK-NEXT:    %22: () = CondBranch<bb1(%20, %8), bb6()>(%21){} NUses:0
; CHECK-NEXT:}
entry:
  br label %outer
outer:
  %r = phi i32 [ 0, %entry ], [ %r.n, %outer.latch ]
  %t = phi i32 [ 0, %entry ], [ %t.n, %outer.latch ]
  br label %inner.pre
inner.pre:
  br label %inner
inner:
  %i = phi i32 [ 0, %inner.pre ], [ %i.n, %inner ]
  %s = phi i32 [ 0, %inner.pre ], [ %s.n, %inner ]
  %ix = zext i32 %i to i64
  %p = getelementptr i32, ptr @arr, i64 %ix
  %v = load i32, ptr %p
  %s.n = add i32 %s, %v
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %inner, label %outer.latch
outer.latch:
  %t.n = add i32 %t, %s.n
  %r.n = add i32 %r, 1
  %rc = icmp slt i32 %r.n, %rep
  br i1 %rc, label %outer, label %exit
exit:
  ret i32 %t.n
}

; two edges leave the inner loop, to the same block
define i32 @hoist_two_exits(i32 %rep, i32 %n, i32 %key) {
; CHECK-LABEL: func hoist_two_exits<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb2(%4{}: i32, %5{}: i32):
; CHECK-NEXT:    %6: () = Branch<bb3(%7)>(){} NUses:0
; CHECK-NEXT:  bb3(%8{}: i32):
; CHECK-NEXT:    %9: i32 = IntAdd(%5, %8){} NUses:2
; CHECK-NEXT:    %10: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %0){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb2(%10, %9), bb4()>(%11){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %13: i32 = Return(%9){} NUses:0
; CHECK-NEXT:  bb5(%7{}: i32):
; CHECK-NEXT:    %14: () = Branch<bb2(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb6():
; CHECK-NEXT:    %15: i32 = IntAdd(%16, 1:i32){} NUses:2
; CHECK-NEXT:    %17: i1 = IntSLT(%15, %1){} NUses:1
; CHECK-NEXT:    %18: () = CondBranch<bb1(%15), bb5(-1:i32)>(%17){} NUses:0
; CHECK-NEXT:  bb1(%16{}: i32):
; CHECK-NEXT:    %19: i64 = ZExt(%16){} NUses:1
; CHECK-NEXT:    %20: i64 = IntMul(%19, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %21: ptr = PtrAdd(G(arr), %20){} NUses:1
; CHECK-NEXT:    %22: i32 = Load(%21){} NUses:1
; CHECK-NEXT:    %23: i1 = IntEQ(%22, %2){} NUses:1
; CHECK-NEXT:    %24: () = CondBranch<bb5(%16), bb6()>(%23){} NUses:0
; CHECK-NEXT:}
entry:
  br label %outer
outer:
  %r = phi i32 [ 0, %entry ], [ %r.n, %outer.latch ]
  %t = phi i32 [ 0, %entry ], [ %t.n, %outer.latch ]
  br label %inner
inner:
  %i = phi i32 [ 0, %outer ], [ %i.n, %inner.body ]
  %ix = zext i32 %i to i64
  %p = getelementptr i32, ptr @arr, i64 %ix
  %v = load i32, ptr %p
  %hit = icmp eq i32 %v, %key
  br i1 %hit, label %outer.latch, label %inner.body
inner.body:
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %inner, label %outer.latch
outer.latch:
  %found = phi i32 [ %i, %inner ], [ -1, %inner.body ]
  %t.n = add i32 %t, %found
  %r.n = add i32 %r, 1
  %rc = icmp slt i32 %r.n, %rep
  br i1 %rc, label %outer, label %exit
exit:
  ret i32 %t.n
}

; the outer loop writes the memory the inner loop reads
