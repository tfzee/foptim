; CHECK-NEXT:    %5: () = Branch<bb2(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb2(%6{}: i32, %7{}: i32):
; CHECK-NEXT:    %8: i64 = ZExt(%6){} NUses:1
; CHECK-NEXT:    %9: i64 = IntMul(%8, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(G(arr), %9){} NUses:1
; CHECK-NEXT:    %11: i32 = Load(%10){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%7, %11){} NUses:2
; CHECK-NEXT:    %13: i32 = IntAdd(%6, 1:i32){} NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %1){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb2(%13, %12), bb3()>(%14){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %16: i32 = IntAdd(%4, %12){} NUses:3
; CHECK-NEXT:    %17: i32 = Store(G(arr), %16){} NUses:0
; CHECK-NEXT:    %18: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %19: i1 = IntSLT(%18, %0){} NUses:1
; CHECK-NEXT:    %20: () = CondBranch<bb1(%18, %16), bb4()>(%19){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %21: i32 = Return(%16){} NUses:0
; CHECK-NEXT:}
entry:
  br label %outer
outer:
  %r = phi i32 [ 0, %entry ], [ %r.n, %outer.latch ]
  %t = phi i32 [ 0, %entry ], [ %t.n, %outer.latch ]
  br label %inner
inner:
  %i = phi i32 [ 0, %outer ], [ %i.n, %inner ]
  %s = phi i32 [ 0, %outer ], [ %s.n, %inner ]
  %ix = zext i32 %i to i64
  %p = getelementptr i32, ptr @arr, i64 %ix
  %v = load i32, ptr %p
  %s.n = add i32 %s, %v
  %i.n = add i32 %i, 1
  %c = icmp slt i32 %i.n, %n
  br i1 %c, label %inner, label %outer.latch
outer.latch:
  %t.n = add i32 %t, %s.n
  store i32 %t.n, ptr @arr
  %r.n = add i32 %r, 1
  %rc = icmp slt i32 %r.n, %rep
  br i1 %rc, label %outer, label %exit
exit:
  ret i32 %t.n
}

