; the argmin pointer of std::min_element is stepped by a select, the load through
; it becomes a value argument so the load leaves the loop carried chain
define i8 @min_elem(ptr %f, i64 %n) {
; CHECK-LABEL: func min_elem<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i64 = IntMul(%1, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%0, %2){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %4: i64 = IntMul(1:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: ptr = PtrAdd(%0, %4){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %6: i1 = IntEQ(%5, %3){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb1(%0), bb2()>(%6){} NUses:0
; CHECK-NEXT:  bb1(%8{}: ptr):
; CHECK-NEXT:    %9: i8 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i8 = Return(%9){} NUses:0
; CHECK-NEXT:  bb3(%11{}: ptr, %12{}: ptr, %13{}: i8):
; CHECK-NEXT:    %14: i8 = Load(%12){} NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %13){} NUses:2
; CHECK-NEXT:    %16: i8 = Select(%15, %14, %13){} NUses:1
; CHECK-NEXT:    %17: ptr = Select(%15, %12, %11){} NUses:2
; CHECK-NEXT:    %18: i64 = IntMul(1:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %19: ptr = PtrAdd(%12, %18){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %20: i1 = IntEQ(%19, %3){} NUses:1
; CHECK-NEXT:    %21: () = CondBranch<bb1(%17), bb3(%17, %19, %16)>(%20){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %22: i8 = Load(%0){} NUses:1
; CHECK-NEXT:    %23: () = Branch<bb3(%0, %5, %22)>(){} NUses:0
; CHECK-NEXT:}
entry:
  %e = getelementptr inbounds i8, ptr %f, i64 %n
  %first = getelementptr inbounds i8, ptr %f, i64 1
  %emp = icmp eq ptr %first, %e
  br i1 %emp, label %exit, label %loop

loop:
  %best = phi ptr [ %f, %entry ], [ %nb, %loop ]
  %cur = phi ptr [ %first, %entry ], [ %next, %loop ]
  %cv = load i8, ptr %cur
  %bv = load i8, ptr %best
  %lt = icmp slt i8 %cv, %bv
  %nb = select i1 %lt, ptr %cur, ptr %best
  %next = getelementptr inbounds i8, ptr %cur, i64 1
  %done = icmp eq ptr %next, %e
  br i1 %done, label %exit, label %loop

exit:
  %r = phi ptr [ %f, %entry ], [ %nb, %loop ]
  %v = load i8, ptr %r
  ret i8 %v
}

