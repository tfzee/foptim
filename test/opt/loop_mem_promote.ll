; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LoopRotate,LoopSimplify,DCE" | FileCheck %s
; the load of the accumulator in memory becomes a loop argument, the store stays

define void @acc(ptr nocapture %a, ptr nocapture %s, i32 %n) {
; CHECK-LABEL: func acc<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; }: ptr, %1{nocapture; }: ptr, %2{}: i32):
; CHECK-NEXT:    %3: f64 = Load(%1){} NUses:1
; CHECK-NEXT:    %4: () = Branch<bb1(0:i32, %3)>(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32, %6{}: f64):
; CHECK-NEXT:    %7: i64 = ZExt(%5){} NUses:1
; CHECK-NEXT:    %8: i64 = IntMul(%7, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %10: f64 = Load(%9){} NUses:1
; CHECK-NEXT:    %11: f64 = FloatAdd(%6, %10){} NUses:2
; CHECK-NEXT:    %12: f64 = Store(%1, %11){} NUses:0
; CHECK-NEXT:    %13: i32 = IntAdd(%5, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %2){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13, %11), bb2()>(%14){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %16: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %idx = zext i32 %i to i64
  %p = getelementptr inbounds double, ptr %a, i64 %idx
  %x = load double, ptr %p
  %old = load double, ptr %s
  %new = fadd double %old, %x
  store double %new, ptr %s
  %i1 = add nsw i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

; a second store to a pointer that may alias keeps the load
