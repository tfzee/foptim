; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LoopRotate,SimplifyCFG,LoopSimplify,DCE" | FileCheck %s
; the rotated loop is entered through a guard, so the initial loads of the
; accumulators go on a block of the entry edge instead of in front of the guard

define void @guarded(ptr nocapture %s, i32 %n) {
; CHECK-LABEL: func guarded<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; }: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i64 = IntMul(1:i64, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%0, %2){} NUses:2
; CHECK-NEXT:    %4: i1 = IntSLT(0:i32, %1){} NUses:1
; CHECK-NEXT:    %5: i1 = Not(%4){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb1(), bb2()>(%5){} NUses:0
; CHECK-NEXT:  bb3(%7{}: i32, %8{}: i64, %9{}: i64):
; CHECK-NEXT:    %10: i64 = IntAdd(%8, 2:i64){} NUses:1
; CHECK-NEXT:    %11: i64 = IntAdd(%9, 3:i64){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%7, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %1){} NUses:1
; CHECK-NEXT:    %14: i1 = Not(%13){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb4(), bb3(%12, %10, %11)>(%14){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %16: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %17: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %18: i64 = Load(%3){} NUses:1
; CHECK-NEXT:    %19: () = Branch<bb3(0:i32, %17, %18)>(){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %20: i64 = IntAdd(%8, 2:i64){} NUses:1
; CHECK-NEXT:    %21: i64 = Store(%0, %20){} NUses:0
; CHECK-NEXT:    %22: () = Branch<bb1()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %23: i64 = IntAdd(%9, 3:i64){} NUses:1
; CHECK-NEXT:    %24: i64 = Store(%3, %23){} NUses:0
; CHECK-NEXT:    %25: () = Branch<bb5()>(){} NUses:0
; CHECK-NEXT:}
entry:
  %s1 = getelementptr i64, ptr %s, i64 1
  br label %cond

cond:
  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %exit

body:
  %a = load i64, ptr %s
  %a.n = add i64 %a, 2
  store i64 %a.n, ptr %s
  %b = load i64, ptr %s1
  %b.n = add i64 %b, 3
  store i64 %b.n, ptr %s1
  %i.next = add nsw i32 %i, 1
  br label %cond

exit:
  ret void
}
