; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LoopRotate,LoopSimplify,DCE" | FileCheck %s
; the int store in the loop cannot alias the double accumulator by TBAA, so the
; accumulator load is promoted. Without the tags (@no_tbaa) it stays.

define void @tbaa(ptr nocapture %a, ptr nocapture %s, ptr %q, i32 %n) {
; CHECK-LABEL: func tbaa<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; }: ptr, %1{nocapture; }: ptr, %2{}: ptr, %3{}: i32):
; CHECK-NEXT:    %4: f64 = Load(%1){} NUses:1
; CHECK-NEXT:    %5: () = Branch<bb1(0:i32, %4)>(){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i32, %7{}: f64):
; CHECK-NEXT:    %8: i64 = ZExt(%6){} NUses:1
; CHECK-NEXT:    %9: i64 = IntMul(%8, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%0, %9){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %11: f64 = Load(%10){} NUses:1
; CHECK-NEXT:    %12: f64 = FloatAdd(%7, %11){} NUses:2
; CHECK-NEXT:    %13: f64 = Store(%1, %12){} NUses:0
; CHECK-NEXT:    %14: i32 = IntAdd(%6, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %3){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb1(%14, %12), bb2()>(%15){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %17: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %18: i32 = Store(%2, %6){} NUses:0
; CHECK-NEXT:    %19: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %idx = zext i32 %i to i64
  %p = getelementptr inbounds double, ptr %a, i64 %idx
  %x = load double, ptr %p, !tbaa !2
  %old = load double, ptr %s, !tbaa !2
  %new = fadd double %old, %x
  store double %new, ptr %s, !tbaa !2
  store i32 %i, ptr %q, !tbaa !6
  %i1 = add nsw i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

define void @no_tbaa(ptr nocapture %a, ptr nocapture %s, ptr %q, i32 %n) {
; CHECK-LABEL: func no_tbaa<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; }: ptr, %1{nocapture; }: ptr, %2{}: ptr, %3{}: i32):
; CHECK-NEXT:    %4: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i64 = ZExt(%5){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %9: f64 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: f64 = Load(%1){} NUses:1
; CHECK-NEXT:    %11: f64 = FloatAdd(%10, %9){} NUses:1
; CHECK-NEXT:    %12: f64 = Store(%1, %11){} NUses:0
; CHECK-NEXT:    %13: i32 = Store(%2, %5){} NUses:0
; CHECK-NEXT:    %14: i32 = IntAdd(%5, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %3){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb1(%14), bb2()>(%15){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %17: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %idx = zext i32 %i to i64
  %p = getelementptr inbounds double, ptr %a, i64 %idx
  %x = load double, ptr %p
  %old = load double, ptr %s
  %new = fadd double %old, %x
  store double %new, ptr %s
  store i32 %i, ptr %q
  %i1 = add nsw i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

!0 = !{!"root"}
!1 = !{!"omnipotent char", !0}
!2 = !{!3, !3, i64 0}
!3 = !{!"double", !1, i64 0}
!6 = !{!7, !7, i64 0}
!7 = !{!"int", !1, i64 0}
