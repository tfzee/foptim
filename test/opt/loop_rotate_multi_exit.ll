; insertion sort inner loop: the header tests j != begin and the body leaves
; when tmp >= *prev. Both exits go to one block, j is used there.
define i32 @f(ptr %begin, ptr %start, i32 %tmp) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntEQ(%1, %0){} NUses:1
; CHECK-NEXT:    %4: i1 = Not(%3){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(%1), bb2(%1)>(%4){} NUses:0
; CHECK-NEXT:  bb1(%6{}: ptr):
; CHECK-NEXT:    %7: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2(%8{}: ptr):
; CHECK-NEXT:    %9: i32 = Store(%8, %2){} NUses:0
; CHECK-NEXT:    %10: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %11: i64 = IntMul(-1:i64, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %12: ptr = PtrAdd(%6, %11){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %13: i32 = Load(%12){} NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%2, %13){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb4(), bb2(%6)>(%14){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %16: i32 = Store(%6, %13){} NUses:0
; CHECK-NEXT:    %17: i64 = IntMul(-1:i64, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %18: ptr = PtrAdd(%6, %17){NSW; InBounds; } NUses:3
; CHECK-NEXT:    %19: i1 = IntEQ(%18, %0){} NUses:1
; CHECK-NEXT:    %20: i1 = Not(%19){} NUses:1
; CHECK-NEXT:    %21: () = CondBranch<bb1(%18), bb2(%18)>(%20){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %j = phi ptr [ %start, %entry ], [ %jn, %latch ]
  %c = icmp eq ptr %j, %begin
  br i1 %c, label %exit, label %body
body:
  %prev = getelementptr inbounds i32, ptr %j, i64 -1
  %v = load i32, ptr %prev
  %lt = icmp slt i32 %tmp, %v
  br i1 %lt, label %latch, label %exit
latch:
  store i32 %v, ptr %j
  %jn = getelementptr inbounds i32, ptr %j, i64 -1
  br label %head
exit:
  %r = phi ptr [ %j, %head ], [ %j, %body ]
  store i32 %tmp, ptr %r
  ret i32 0
}

; the exit uses the header argument and a header instruction directly
