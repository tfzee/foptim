; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LoopRotate" | FileCheck %s
; The only exit of the loop is a switch in the header, LoopRotate only handles conditional branches and must leave it alone.

define i32 @f(i32 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i32, %3{}: i32):
; CHECK-NEXT:    %4: () = Switch<bb2(), bb3()>(100:i32, %2){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %5: i32 = IntAdd(%3, %0){} NUses:1
; CHECK-NEXT:    %6: i32 = IntAdd(%2, 1:i32){} NUses:1
; CHECK-NEXT:    %7: () = Branch<bb1(%6, %5)>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head

head:
  %i = phi i32 [ 0, %entry ], [ %inc, %body ]
  %s = phi i32 [ 0, %entry ], [ %add, %body ]
  switch i32 %i, label %body [
    i32 100, label %exit
  ]

body:
  %add = add i32 %s, %n
  %inc = add i32 %i, 1
  br label %head

exit:
  ret i32 %s
}
