; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,LoopRotate,SimplifyCFG" | FileCheck %s
; A loop with two back edges (the two arms of the if both jump to the header): LoopRotate merges them into one block first, so the rotated loop has a single latch with a single copy of the exit test, and SimplifyCFG must not copy that latch back into the two arms.

define i32 @f(ptr %a, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSLT(0:i64, %1){} NUses:1
; CHECK-NEXT:    %3: i1 = Not(%2){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i32), bb2(0:i64, 0:i32)>(%3){} NUses:0
; CHECK-NEXT:  bb2(%5{}: i64, %6{}: i32):
; CHECK-NEXT:    %7: i64 = IntMul(%5, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:2
; CHECK-NEXT:    %10: i1 = IntSGT(%9, 0:i32){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb3(), bb4()>(%10){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %12: i32 = IntAdd(%6, %9){} NUses:1
; CHECK-NEXT:    %13: i64 = IntAdd(%5, 1:i64){} NUses:1
; CHECK-NEXT:    %14: () = Branch<bb5(%13, %12)>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %15: i64 = IntAdd(%5, 1:i64){} NUses:1
; CHECK-NEXT:    %16: () = Branch<bb5(%15, %6)>(){} NUses:0
; CHECK-NEXT:  bb5(%17{}: i64, %18{}: i32):
; CHECK-NEXT:    %19: i1 = IntSLT(%17, %1){} NUses:1
; CHECK-NEXT:    %20: i1 = Not(%19){} NUses:1
; CHECK-NEXT:    %21: () = CondBranch<bb1(%18), bb2(%17, %18)>(%20){} NUses:0
; CHECK-NEXT:  bb1(%22{}: i32):
; CHECK-NEXT:    %23: i32 = Return(%22){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %i = phi i64 [ 0, %entry ], [ %i1, %then ], [ %i2, %else ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %then ], [ %acc, %else ]
  %c = icmp slt i64 %i, %n
  br i1 %c, label %body, label %exit
body:
  %p = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %p
  %t = icmp sgt i32 %x, 0
  br i1 %t, label %then, label %else
then:
  %acc1 = add i32 %acc, %x
  %i1 = add i64 %i, 1
  br label %head
else:
  %i2 = add i64 %i, 1
  br label %head
exit:
  ret i32 %acc
}
