; RUN: %foffcc %s --print-fir --passes "LoopRotate,VerifyFunc" | FileCheck %s

; The second loop is entered from the guard that skips the first loop and from
; the exit of the first loop. Both edges are merged into one new preheader,
; which gets the only copy of the header, so the second loop is rotated too.

define void @two_loops(ptr noalias %a, ptr noalias %b, i32 %n, i32 %m) {
; CHECK-LABEL: func two_loops<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i32, %3{}: i32):
; CHECK-NEXT:    %4: i1 = IntSGT(%2, 0:i32){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i32), bb2(0:i32)>(%4){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i32):
; CHECK-NEXT:    %7: i64 = SExt(%6){} NUses:1
; CHECK-NEXT:    %8: i64 = IntMul(%7, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %10: i32 = Store(%9, %6){} NUses:0
; CHECK-NEXT:    %11: i32 = IntAdd(%6, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %2){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11), bb2(0:i32)>(%12){} NUses:0
; CHECK-NEXT:  bb3(%14{}: i32):
; CHECK-NEXT:    %15: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %16: i64 = SExt(%14){} NUses:1
; CHECK-NEXT:    %17: i64 = IntMul(%16, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %18: ptr = PtrAdd(%1, %17){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %19: i32 = Store(%18, %14){} NUses:0
; CHECK-NEXT:    %20: i32 = IntAdd(%14, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %21: i1 = IntSLT(%20, %3){} NUses:1
; CHECK-NEXT:    %22: i1 = Not(%21){} NUses:1
; CHECK-NEXT:    %23: () = CondBranch<bb5(), bb3(%20)>(%22){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %24: () = Return(){} NUses:0
; CHECK-NEXT:  bb2(%25{}: i32):
; CHECK-NEXT:    %26: i1 = IntSLT(%25, %3){} NUses:1
; CHECK-NEXT:    %27: i1 = Not(%26){} NUses:1
; CHECK-NEXT:    %28: () = CondBranch<bb5(), bb3(%25)>(%27){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i32 %n, 0
  br i1 %g, label %first, label %second

first:
  %i = phi i32 [ 0, %entry ], [ %i.next, %first ]
  %is = sext i32 %i to i64
  %pa = getelementptr inbounds i32, ptr %a, i64 %is
  store i32 %i, ptr %pa
  %i.next = add nsw i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %first, label %second

second:
  %k = phi i32 [ 0, %entry ], [ 0, %first ], [ %k.next, %body ]
  %c2 = icmp slt i32 %k, %m
  br i1 %c2, label %body, label %exit

body:
  %ks = sext i32 %k to i64
  %pb = getelementptr inbounds i32, ptr %b, i64 %ks
  store i32 %k, ptr %pb
  %k.next = add nsw i32 %k, 1
  br label %second

exit:
  ret void
}
