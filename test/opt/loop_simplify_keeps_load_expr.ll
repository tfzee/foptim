; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,LoopSimplify,DCE" | FileCheck %s

; the value behind the loop depends on a load of the loop, it is not copied
; behind the loop (that would keep the load of the last iteration alive there)
define i32 @f(ptr %a, i32 %v) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32, %4{}: i32):
; CHECK-NEXT:    %5: i64 = SExt(%3){} NUses:1
; CHECK-NEXT:    %6: i64 = IntMul(%5, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; NUW; InBounds; } NUses:1
; CHECK-NEXT:    %8: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%8, %1){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%9, %4){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%3, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, 8000:i32){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb2()>(%12){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %14: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  br label %body
body:
  %i = phi i32 [ 0, %entry ], [ %inc, %body ]
  %r = phi i32 [ 0, %entry ], [ %add2, %body ]
  %idx = sext i32 %i to i64
  %p = getelementptr inbounds i32, ptr %a, i64 %idx
  %x = load i32, ptr %p
  %add = add i32 %x, %v
  %add2 = add i32 %add, %r
  %inc = add i32 %i, 1
  %c = icmp slt i32 %inc, 8000
  br i1 %c, label %body, label %end
end:
  ret i32 %add2
}
