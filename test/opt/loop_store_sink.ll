; RUN: %foffcc %s --print-fir --passes "Mem2Reg,LoopRotate,LoopSimplify,DCE" | FileCheck %s
; a store to an invariant address that nothing else in the loop touches moves to
; the exit. @sink_alias has a load that may alias it, the store stays.

define void @sink(ptr nocapture %a, ptr noalias nocapture %s, i32 %n) {
; CHECK-LABEL: func sink<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nocapture; }: ptr, %1{noalias; nocapture; }: ptr, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i64 = ZExt(%4){} NUses:1
; CHECK-NEXT:    %6: i64 = IntMul(%5, 8:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %8: f64 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%4, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %10: i1 = IntSLT(%9, %2){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb1(%9), bb2()>(%10){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %12: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: f64 = Store(%1, %8){} NUses:0
; CHECK-NEXT:    %14: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %idx = zext i32 %i to i64
  %p = getelementptr inbounds double, ptr %a, i64 %idx
  %x = load double, ptr %p
  store double %x, ptr %s
  %i1 = add nsw i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

