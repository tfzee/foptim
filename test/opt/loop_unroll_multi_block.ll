entry:
  br label %head
head:
  %i = phi i32 [ 0, %entry ], [ %i.n, %latch ]
  %s = phi i32 [ 0, %entry ], [ %s.n, %latch ]
  %ix = zext i32 %i to i64
  %p = getelementptr i32, ptr @arr, i64 %ix
  %v = load i32, ptr %p
  %c = icmp sgt i32 %v, 3
  br i1 %c, label %then, label %latch
then:
  %t = add i32 %s, %v
  br label %latch
latch:
  %s.n = phi i32 [ %s, %head ], [ %t, %then ]
  %i.n = add i32 %i, 1
  %lc = icmp slt i32 %i.n, 4
  br i1 %lc, label %head, label %exit
exit:
