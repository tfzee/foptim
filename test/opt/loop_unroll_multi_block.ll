; CHECK-NEXT:    %4: i32 = Load(%28){} NUses:2
; CHECK-NEXT:    %29: i1 = IntSGT(%4, 3:i32){} NUses:1
; CHECK-NEXT:    %30: () = CondBranch<bb3(), bb4(%5)>(%29){} NUses:0
; CHECK-NEXT:  bb7():
; CHECK-NEXT:    %31: i32 = IntAdd(%22, %17){} NUses:2
