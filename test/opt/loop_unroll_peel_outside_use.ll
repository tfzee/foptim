; RUN: %foffcc %s --print-fir --passes "LoopUnroll" | FileCheck %s
; Peeling the first iteration for the i == 0 test would need a merge of the
; peeled and the original value behind the loop, so the loop stays as it is.

define i32 @f(ptr %p, i32 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i32, %4{}: i32):
; CHECK-NEXT:    %5: i1 = IntEQ(%3, 0:i32){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: () = Branch<bb4(7:i32)>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %8: i64 = SExt(%3){} NUses:1
; CHECK-NEXT:    %9: i64 = IntMul(%8, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%0, %9){} NUses:1
; CHECK-NEXT:    %11: i32 = Load(%10){} NUses:1
; CHECK-NEXT:    %12: () = Branch<bb4(%11)>(){} NUses:0
; CHECK-NEXT:  bb4(%13{}: i32):
; CHECK-NEXT:    %14: i32 = IntAdd(%4, %13){} NUses:3
; CHECK-NEXT:    %15: i32 = IntAdd(%3, 1:i32){} NUses:1
; CHECK-NEXT:    %16: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %17: i1 = IntNE(%16, %14){} NUses:1
; CHECK-NEXT:    %18: () = CondBranch<bb1(%15, %14), bb5()>(%17){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %19: i32 = Return(%14){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %latch ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %latch ]
  %z = icmp eq i32 %i, 0
  br i1 %z, label %first, label %rest
first:
  br label %latch
rest:
  %addr = getelementptr i32, ptr %p, i32 %i
  %v = load i32, ptr %addr
  br label %latch
latch:
  %x = phi i32 [ 7, %first ], [ %v, %rest ]
  %acc.next = add i32 %acc, %x
  %i.next = add i32 %i, 1
  %w = load i32, ptr %p
  %c = icmp ne i32 %w, %acc.next
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %acc.next
}
