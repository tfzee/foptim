; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LoopSimplify,LoopUnroll,SimplifyCFG,InstSimplify,DCE" | FileCheck %s
; a loop that runs exactly once loses its back edge
define i32 @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %n, %loop ]
  %a = phi i32 [ 0, %entry ], [ %s, %loop ]
  %q = getelementptr i32, ptr %p, i32 %i
  %v = load i32, ptr %q
  %s = add i32 %a, %v
  %n = add i32 %i, 1
  %c = icmp slt i32 %n, 1
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %s
}
