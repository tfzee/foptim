; CHECK-NEXT:  bb2(%5{}: i32, %6{}: f32):
; CHECK-NEXT:    %7: f32 = SI_FP(%5){} NUses:2
; CHECK-NEXT:    %8: f32 = FloatDiv(%7, %2){} NUses:2
; CHECK-NEXT:    %9: f32 = FloatDiv(%7, %3){} NUses:0
; CHECK-NEXT:    %10: f32 = FloatAdd(%6, %8){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%5, 1:i32){} NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %1){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb2(%11, %10), bb3(%8, %10)>(%12){} NUses:0
; CHECK-NEXT:  bb3(%14{}: f32, %15{}: f32):
; CHECK-NEXT:    %16: f32 = FloatAdd(%15, %14){} NUses:1
; CHECK-NEXT:    %17: f32 = Return(%16){} NUses:0
; CHECK-NEXT:  bb4(%18{}: i32, %19{}: f32):
; CHECK-NEXT:    %20: f32 = SI_FP(%18){} NUses:2
; CHECK-NEXT:    %21: f32 = FloatDiv(%20, %2){} NUses:0
; CHECK-NEXT:    %22: f32 = FloatDiv(%20, %3){} NUses:2
; CHECK-NEXT:    %23: f32 = FloatAdd(%19, %22){} NUses:2
; CHECK-NEXT:    %24: i32 = IntAdd(%18, 1:i32){} NUses:2
; CHECK-NEXT:    %25: i1 = IntSLT(%24, %1){} NUses:1
; CHECK-NEXT:    %26: () = CondBranch<bb4(%24, %23), bb3(%22, %23)>(%25){} NUses:0
; CHECK-NEXT:  bb1(%27{}: i32, %28{}: f32):
; CHECK-NEXT:    %29: () = CondBranch<bb2(%27, %28), bb4(%27, %28)>(%0){} NUses:0
; CHECK-NEXT:}
entry:
  br label %body
body:
  %i = phi i32 [ 0, %entry ], [ %i.next, %body ]
  %acc = phi float [ 0.0, %entry ], [ %acc.next, %body ]
  %fi = sitofp i32 %i to float
  %x = fdiv float %fi, %a
  %y = fdiv float %fi, %b
  %s = select i1 %c, float %x, float %y
  %acc.next = fadd float %acc, %s
  %i.next = add i32 %i, 1
  %cmp = icmp slt i32 %i.next, %n
  br i1 %cmp, label %body, label %exit
exit:
  %r = fadd float %acc.next, %s
  ret float %r
}
