define float @f(i1 %c, i32 %n, float %a, float %b) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i32, %2{}: f32, %3{}: f32):
