; a value that is a pure function of one i8 becomes a load from a constant
; table, whatever the expression looks like (ranges, equality chain, selects)

define i1 @is_word_char(i8 %c) {
; CHECK-LABEL: func is_word_char<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i1 = IntEQ(%0, 35:i8){} NUses:1
; CHECK-NEXT:    %2: i8 = IntSub(%0, 48:i8){} NUses:1
; CHECK-NEXT:    %3: i1 = IntULT(%2, 10:i8){} NUses:1
; CHECK-NEXT:    %4: i1 = Or(%1, %3){} NUses:1
; CHECK-NEXT:    %5: i8 = IntSub(%0, 64:i8){} NUses:2
; CHECK-NEXT:    %6: i1 = IntULT(%5, 63:i8){} NUses:1
; CHECK-NEXT:    %7: i64 = ZExt(%5){} NUses:1
; CHECK-NEXT:    %8: i64 = And(%7, 63:i64){} NUses:1
; CHECK-NEXT:    %9: i64 = LShR(5188146762275094527:i64, %8){} NUses:1
; CHECK-NEXT:    %10: i1 = ITrunc(%9){} NUses:1
; CHECK-NEXT:    %11: i1 = And(%6, %10){} NUses:1
; CHECK-NEXT:    %12: i1 = Or(%4, %11){} NUses:1
; CHECK-NEXT:    %13: i1 = Return(%12){} NUses:0
; CHECK-NEXT:}
  %d = sub i8 %c, 48
  %is_digit = icmp ult i8 %d, 10
  %l = sub i8 %c, 97
  %is_lower = icmp ult i8 %l, 26
  %u = sub i8 %c, 65
  %is_upper = icmp ult i8 %u, 26
  %e1 = icmp eq i8 %c, 64
  %e2 = icmp eq i8 %c, 35
  %e3 = icmp eq i8 %c, 126
  %o1 = or i1 %is_digit, %is_lower
  %o2 = or i1 %o1, %is_upper
  %o3 = or i1 %o2, %e1
  %o4 = or i1 %o3, %e2
  %o5 = or i1 %o4, %e3
  ret i1 %o5
}

; an i32 result takes one 4 byte entry per input
define i32 @classify(i8 %c) {
; CHECK-LABEL: func classify<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i64 = ZExt(%0){} NUses:1
; CHECK-NEXT:    %2: i64 = IntMul(%1, 4:i64){} NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(G(lookup_table_classify_0), %2){} NUses:1
; CHECK-NEXT:    %4: i32 = Load(%3){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %a = icmp ult i8 %c, 32
  %b = icmp eq i8 %c, 127
  %ctl = or i1 %a, %b
  %d = sub i8 %c, 48
  %dig = icmp ult i8 %d, 10
  %w = zext i8 %c to i32
  %x = xor i32 %w, 5
  %r1 = select i1 %dig, i32 100, i32 %x
  %r2 = select i1 %ctl, i32 -1, i32 %r1
  ret i32 %r2
}

