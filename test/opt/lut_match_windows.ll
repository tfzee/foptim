; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LUTMatch,DCE" | FileCheck %s
; An i1 whose true inputs fit in two windows of at most 64 values is a range
; check and a shift of a constant mask per window, or'd together, no table load
; (outside of a loop the table is cold, so a dependent load costs more than the
; windows). The same for an or of equality checks of a value too wide for a
; table, where the alternative is a switch.

; true inputs 33 to 62 and 97 to 126
define zeroext i1 @two_windows_i8(i8 %a) {
; CHECK-LABEL: func two_windows_i8<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i8 = IntSub(%0, 33:i8){} NUses:2
; CHECK-NEXT:    %2: i1 = IntULT(%1, 30:i8){} NUses:1
; CHECK-NEXT:    %3: i64 = ZExt(%1){} NUses:1
; CHECK-NEXT:    %4: i64 = And(%3, 63:i64){} NUses:1
; CHECK-NEXT:    %5: i64 = LShR(672137733:i64, %4){} NUses:1
; CHECK-NEXT:    %6: i1 = ITrunc(%5){} NUses:1
; CHECK-NEXT:    %7: i1 = And(%2, %6){} NUses:1
; CHECK-NEXT:    %8: i8 = IntSub(%0, 97:i8){} NUses:2
; CHECK-NEXT:    %9: i1 = IntULT(%8, 30:i8){} NUses:1
; CHECK-NEXT:    %10: i64 = ZExt(%8){} NUses:1
; CHECK-NEXT:    %11: i64 = And(%10, 63:i64){} NUses:1
; CHECK-NEXT:    %12: i64 = LShR(536870913:i64, %11){} NUses:1
; CHECK-NEXT:    %13: i1 = ITrunc(%12){} NUses:1
; CHECK-NEXT:    %14: i1 = And(%9, %13){} NUses:1
; CHECK-NEXT:    %15: i1 = Or(%7, %14){} NUses:1
; CHECK-NEXT:    %16: i1 = Return(%15){} NUses:0
; CHECK-NEXT:}
  %c0 = icmp eq i8 %a, 33
  %c1 = icmp eq i8 %a, 35
  %c2 = icmp eq i8 %a, 42
  %c3 = icmp eq i8 %a, 53
  %c4 = icmp eq i8 %a, 60
  %c5 = icmp eq i8 %a, 62
  %c6 = icmp eq i8 %a, 97
  %c7 = icmp eq i8 %a, 126
  %o0 = or i1 %c0, %c1
  %o1 = or i1 %o0, %c2
  %o2 = or i1 %o1, %c3
  %o3 = or i1 %o2, %c4
  %o4 = or i1 %o3, %c5
  %o5 = or i1 %o4, %c6
  %o6 = or i1 %o5, %c7
  ret i1 %o6
}

; the same on an i32 (too wide to tabulate), no switch either
