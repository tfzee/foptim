; RUN: %foffcc %s --print-fir --passes "LUTMatch,DCE" | FileCheck %s
; The cost model keeps the table where it is the cheaper way. In a loop the
; table stays in L1 and one load is fewer uops than the range checks, shifts and
; ors of the windows (the iterations overlap, so throughput counts), also for a
; single window. A result of more than one bit is never a window form.

; one window (true inputs 33 to 62) in a loop
define i64 @loop_one_window(ptr %p, i64 %n) {
; CHECK-LABEL: func loop_one_window<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64, 0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64, %4{}: i64):
; CHECK-NEXT:    %5: i1 = IntEQ(%3, %1){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i64 = Return(%4){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %8: i64 = IntMul(%3, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){} NUses:1
; CHECK-NEXT:    %10: i8 = Load(%9){} NUses:1
; CHECK-NEXT:    %11: i64 = ZExt(%10){} NUses:1
; CHECK-NEXT:    %12: ptr = PtrAdd(G(lookup_table_loop_one_window_0), %11){} NUses:1
; CHECK-NEXT:    %13: i8 = Load(%12){} NUses:1
; CHECK-NEXT:    %14: i1 = ITrunc(%13){} NUses:1
; CHECK-NEXT:    %15: i64 = ZExt(%14){} NUses:1
; CHECK-NEXT:    %16: i64 = IntAdd(%4, %15){} NUses:1
; CHECK-NEXT:    %17: i64 = IntAdd(%3, 1:i64){} NUses:1
; CHECK-NEXT:    %18: () = Branch<bb1(%17, %16)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %head
head:
  %i = phi i64 [ 0, %entry ], [ %i.next, %body ]
  %acc = phi i64 [ 0, %entry ], [ %acc.next, %body ]
  %done = icmp eq i64 %i, %n
  br i1 %done, label %exit, label %body
body:
  %q = getelementptr i8, ptr %p, i64 %i
  %ch = load i8, ptr %q
  %c0 = icmp eq i8 %ch, 33
  %c1 = icmp eq i8 %ch, 35
  %c2 = icmp eq i8 %ch, 42
  %c3 = icmp eq i8 %ch, 53
  %c4 = icmp eq i8 %ch, 60
  %c5 = icmp eq i8 %ch, 62
  %o0 = or i1 %c0, %c1
  %o1 = or i1 %o0, %c2
  %o2 = or i1 %o1, %c3
  %o3 = or i1 %o2, %c4
  %o4 = or i1 %o3, %c5
  %z = zext i1 %o4 to i64
  %acc.next = add i64 %acc, %z
  %i.next = add i64 %i, 1
  br label %head
exit:
  ret i64 %acc
}


