; a non i1 result stays a table
define i8 @select_two_ranges(i8 %a) {
; CHECK-LABEL: func select_two_ranges<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i64 = ZExt(%0){} NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(G(lookup_table_select_two_ranges_0), %1){} NUses:1
; CHECK-NEXT:    %3: i8 = Load(%2){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %lo = icmp ult i8 %a, 10
  %hi = icmp ugt i8 %a, 200
  %o = or i1 %lo, %hi
  %m = and i8 %a, 7
  %x = xor i8 %m, 5
  %s = select i1 %o, i8 %x, i8 3
  %r = add i8 %s, %m
  ret i8 %r
}
