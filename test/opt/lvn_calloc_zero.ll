; CHECK-NEXT:    %2: i32 = Store(%1, %0){} NUses:0
; CHECK-NEXT:    %3: i32 = IntAdd(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @calloc(i64 16, i64 4)
  store i32 %x, ptr %p
  %q = getelementptr i8, ptr %p, i64 4
  %a = load i32, ptr %p
  %b = load i32, ptr %q
