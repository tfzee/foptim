; A load of memory that nothing wrote since calloc is zero.
; RUN: %foffcc %s --print-fir --passes "LVN,DCE" | FileCheck %s

declare ptr @calloc(i64, i64)
declare void @ext(ptr)

; expected: returns 0 for the first and the third element, the loads are gone
define i32 @load_zero(i32 %n) {
; CHECK-LABEL: func load_zero<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: ptr = Call(calloc, 16:i64, 4:i64){extTy: ptr(i64 i64 ); } NUses:0
; CHECK-NEXT:    %2: i32 = IntAdd(0:i32, 0:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @calloc(i64 16, i64 4)
  %a = load i32, ptr %p
  %q = getelementptr i8, ptr %p, i64 8
  %b = load i32, ptr %q
  %s = add i32 %a, %b
  ret i32 %s
}

; expected: a pointer and a double read as null and 0.0
define double @load_zero_float(i32 %n) {
; CHECK-LABEL: func load_zero_float<CC: C, LINK: external, > Uses: 0
