; CHECK-NEXT:    %2: f64 = Return(0:f64){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @calloc(i64 4, i64 8)
  %a = load double, ptr %p
  ret double %a
}

; expected: the store is forwarded, the load of the other element is 0
define i32 @store_then_load(i32 %x) {
