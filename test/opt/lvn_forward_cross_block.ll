; RUN: %foffcc %s --print-fir --passes "LVN,DCE" | FileCheck %s
; Store to load and load to load forwarding over the memory SSA, across blocks.
; Functions named forward_* must lose the load, keep_* must keep it.
declare void @ext(ptr)

; the store dominates the load and nothing in the diamond writes p
define i32 @forward_over_diamond(ptr %p, ptr noalias %q, i1 %c) {
; CHECK-LABEL: func forward_over_diamond<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{noalias; }: ptr, %2{}: i1):
; CHECK-NEXT:    %3: i32 = Store(%0, 7:i32){} NUses:0
; CHECK-NEXT:    %4: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i32 = Store(%1, 1:i32){} NUses:0
; CHECK-NEXT:    %6: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %8: i32 = Return(7:i32){} NUses:0
; CHECK-NEXT:}
entry:
  store i32 7, ptr %p
  br i1 %c, label %a, label %b
a:
  store i32 1, ptr %q
  br label %join
b:
  br label %join
join:
  %r = load i32, ptr %p
  ret i32 %r
}

; one arm calls an unknown function
define i32 @keep_call_in_one_arm(ptr %p, i1 %c) {
; CHECK-LABEL: func keep_call_in_one_arm<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: i32 = Store(%0, 7:i32){} NUses:0
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: () = Call(ext, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %5: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %7: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  store i32 7, ptr %p
  br i1 %c, label %a, label %b
a:
  call void @ext(ptr %p)
  br label %join
b:
  br label %join
join:
  %r = load i32, ptr %p
  ret i32 %r
}

; the arms store different values, the load depends on the phi
define i32 @keep_different_stores(ptr %p, i1 %c) {
; CHECK-LABEL: func keep_different_stores<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: i32 = Store(%0, 1:i32){} NUses:0
; CHECK-NEXT:    %4: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Store(%0, 2:i32){} NUses:0
; CHECK-NEXT:    %6: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %7: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %a, label %b
a:
  store i32 1, ptr %p
  br label %join
b:
  store i32 2, ptr %p
  br label %join
join:
  %r = load i32, ptr %p
  ret i32 %r
}

; two loads of the same address in different blocks
define i32 @forward_load_load(ptr %p, i1 %c) {
; CHECK-LABEL: func forward_load_load<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:3
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: i32 = IntAdd(%2, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
entry:
  %x = load i32, ptr %p
  br i1 %c, label %a, label %b
a:
  %y = load i32, ptr %p
  %s = add i32 %x, %y
  ret i32 %s
b:
  ret i32 %x
}

; a store in between to the same address
define i32 @keep_load_load_store_between(ptr %p, i1 %c) {
; CHECK-LABEL: func keep_load_load_store_between<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i1):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: i32 = Store(%0, 5:i32){} NUses:0
; CHECK-NEXT:    %5: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %7: i32 = IntAdd(%2, %6){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  %x = load i32, ptr %p
  br i1 %c, label %a, label %b
a:
  store i32 5, ptr %p
  br label %b
b:
  %y = load i32, ptr %p
  %s = add i32 %x, %y
  ret i32 %s
}

; the loop only writes q, the load of p in the loop is the one before it
define i32 @forward_loop_invariant(ptr noalias %p, ptr noalias %q, i32 %n) {
; CHECK-LABEL: func forward_loop_invariant<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i32):
; CHECK-NEXT:    %3: i32 = Load(%0){} NUses:3
; CHECK-NEXT:    %4: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i32):
; CHECK-NEXT:    %6: i32 = Store(%1, %3){} NUses:0
; CHECK-NEXT:    %7: i32 = IntAdd(%5, 1:i32){} NUses:2
; CHECK-NEXT:    %8: i1 = IntSLT(%7, %2){} NUses:1
; CHECK-NEXT:    %9: () = CondBranch<bb1(%7), bb2()>(%8){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %10: i32 = IntAdd(%3, %3){} NUses:1
; CHECK-NEXT:    %11: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  %x = load i32, ptr %p
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
  %y = load i32, ptr %p
  store i32 %y, ptr %q
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %exit
exit:
  %r = add i32 %x, %y
  ret i32 %r
}

; the loop writes p
define i32 @keep_loop_store(ptr %p, i32 %n) {
; CHECK-LABEL: func keep_loop_store<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i32 = Load(%0){} NUses:2
; CHECK-NEXT:    %6: i32 = IntAdd(%5, 1:i32){} NUses:1
; CHECK-NEXT:    %7: i32 = Store(%0, %6){} NUses:0
; CHECK-NEXT:    %8: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %9: i1 = IntSLT(%8, %1){} NUses:1
; CHECK-NEXT:    %10: () = CondBranch<bb1(%8), bb2()>(%9){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %11: i32 = IntAdd(%2, %5){} NUses:1
; CHECK-NEXT:    %12: i32 = Return(%11){} NUses:0
; CHECK-NEXT:}
entry:
  %x = load i32, ptr %p
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i2, %loop ]
  %y = load i32, ptr %p
  %z = add i32 %y, 1
  store i32 %z, ptr %p
  %i2 = add i32 %i, 1
  %c = icmp slt i32 %i2, %n
  br i1 %c, label %loop, label %exit
exit:
  %r = add i32 %x, %y
  ret i32 %r
}

; two stores of half the size tile the load, in different blocks
define i32 @forward_tiled(ptr %p, i16 %lo, i16 %hi) {
; CHECK-LABEL: func forward_tiled<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i16, %2{}: i16):
; CHECK-NEXT:    %3: i16 = Store(%0, %1){} NUses:0
; CHECK-NEXT:    %4: () = Branch<bb1()>(){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i64 = IntMul(2:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, %5){} NUses:1
; CHECK-NEXT:    %7: i16 = Store(%6, %2){} NUses:0
; CHECK-NEXT:    %8: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: i32 = ZExt(%2){} NUses:1
; CHECK-NEXT:    %10: i32 = Shl(%9, 16:i32){} NUses:1
; CHECK-NEXT:    %11: i32 = ZExt(%1){} NUses:1
; CHECK-NEXT:    %12: i32 = Or(%10, %11){} NUses:1
; CHECK-NEXT:    %13: i32 = Return(%12){} NUses:0
; CHECK-NEXT:}
entry:
  store i16 %lo, ptr %p
  br label %next
next:
  %q = getelementptr i8, ptr %p, i64 2
  store i16 %hi, ptr %q
  br label %end
end:
  %r = load i32, ptr %p
  ret i32 %r
}

; a volatile load is never forwarded
define i32 @keep_volatile(ptr %p) {
; CHECK-LABEL: func keep_volatile<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i32 = Store(%0, 7:i32){} NUses:0
; CHECK-NEXT:    %2: () = Branch<bb1()>(){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: i32 = Load(%0){VOLATILE; } NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
entry:
  store i32 7, ptr %p
  br label %next
next:
  %r = load volatile i32, ptr %p
  ret i32 %r
}
