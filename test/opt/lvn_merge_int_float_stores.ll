; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,LVN,DCE" | FileCheck %s
; An i32 store next to an adjacent f32 constant store must not be merged as two integer
; constants: the float constant was zero extended, which lost the value (x264 f_rf_constant).

target triple = "x86_64-unknown-linux-gnu"

define void @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: ptr = PtrAdd(%0, 4:i64){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, 8:i64){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, 0:i32){} NUses:0
; CHECK-NEXT:    %4: f32 = Store(%2, 41B80000:f32){} NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:}
  %a = getelementptr inbounds i8, ptr %p, i64 4
  %b = getelementptr inbounds i8, ptr %p, i64 8
  store i32 0, ptr %a, align 4
  store float 2.300000e+01, ptr %b, align 4
  ret void
}
