; CHECK-NEXT:    %3: i32 = IntAdd(%2, %2){} NUses:1
; CHECK-NEXT:    %4: i32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %a = sub nsw i32 %x, %y
  %b = sub i32 %x, %y
  %c = add i32 %a, %b
  ret i32 %c
}

define i32 @g(i32 %x, i32 %y) {
