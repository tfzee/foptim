; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,LVN" | FileCheck %s
; A scalar load at a negative offset of a vector store's address is not a lane
; of the stored vector and must stay a load.
define i64 @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: 2@i64 = Store(%0, <0:i64, 0:i64, >:2@i64){} NUses:0
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, -16:i64){} NUses:1
; CHECK-NEXT:    %3: i64 = Load(%2){} NUses:1
; CHECK-NEXT:    %4: i64 = Return(%3){} NUses:0
; CHECK-NEXT:}
  store <2 x i64> zeroinitializer, ptr %p
  %q = getelementptr i8, ptr %p, i64 -16
  %v = load i64, ptr %q
  ret i64 %v
}
