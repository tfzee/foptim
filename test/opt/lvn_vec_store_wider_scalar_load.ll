; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LVN" | FileCheck %s

; A scalar load wider than a lane of the vector stored to the same address
; reads several lanes, so it is lane 0 of the vector bitcast to wider lanes.
define i64 @f(ptr %p, <4 x i32> %v) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: 4@i32):
; CHECK-NEXT:    %2: 4@i32 = Store(%0, %1){} NUses:0
; CHECK-NEXT:    %3: 2@i64 = BITCAST(%1){} NUses:1
; CHECK-NEXT:    %4: i64 = ExtractValue(%3, 0:i32){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  store <4 x i32> %v, ptr %p, align 16
  %x = load i64, ptr %p, align 16
  ret i64 %x
}
