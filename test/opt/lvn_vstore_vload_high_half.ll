; RUN: %foffcc %s --print-fir --passes "InstSimplify,LVN,DCE" | FileCheck %s
; Loading the upper half of a stored vector must not be forwarded as the lower half.
define <2 x float> @high(ptr %p, <4 x float> %v) {
; CHECK-LABEL: func high<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: 4@f32):
; CHECK-NEXT:    %2: 4@f32 = Store(%0, %1){} NUses:0
; CHECK-NEXT:    %3: 2@f32 = V.ExtractHigh(%1){} NUses:1
; CHECK-NEXT:    %4: 2@f32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  store <4 x float> %v, ptr %p, align 16
  %q = getelementptr inbounds i8, ptr %p, i64 8
  %r = load <2 x float>, ptr %q, align 8
  ret <2 x float> %r
}

define <2 x float> @low(ptr %p, <4 x float> %v) {
; CHECK-LABEL: func low<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: 4@f32):
; CHECK-NEXT:    %2: 4@f32 = Store(%0, %1){} NUses:0
; CHECK-NEXT:    %3: 2@f32 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: 2@f32 = Return(%3){} NUses:0
; CHECK-NEXT:}
  store <4 x float> %v, ptr %p, align 16
  %r = load <2 x float>, ptr %p, align 8
  ret <2 x float> %r
}
