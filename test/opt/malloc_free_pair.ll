; An allocation whose only use is the free of it is removed together with the
; stores into it. Any other use keeps both calls.

declare ptr @malloc(i64)
declare void @free(ptr)
declare void @opaque(ptr)

define void @pair_removed() {
; CHECK-LABEL: func pair_removed<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call ptr @malloc(i64 16)
  store i32 1, ptr %p
  call void @free(ptr %p)
  ret void
}

define i32 @loaded_stays() {
