; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,DCE" | FileCheck %s
; llvm.masked.load / store become the MaskedLoad / MaskedStore intrinsics (the alignment operand is dropped).

declare <4 x i32> @llvm.masked.load.v4i32.p0(ptr, i32, <4 x i1>, <4 x i32>)
declare void @llvm.masked.store.v4i32.p0(<4 x i32>, ptr, i32, <4 x i1>)

define void @f(ptr %a, ptr %b, <4 x i32> %t, <4 x i32> %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: 4@i32, %3{}: 4@i32):
; CHECK-NEXT:    %4: 4@i1 = IntSGT(%2, <0:i32, 0:i32, 0:i32, 0:i32, >:4@i32){} NUses:2
; CHECK-NEXT:    %5: 4@i32 = INTRIN:MaskedLoad(%1, %4, %3){} NUses:1
; CHECK-NEXT:    %6: () = INTRIN:MaskedStore(%0, %4, %5){} NUses:0
; CHECK-NEXT:    %7: () = Return(){} NUses:0
; CHECK-NEXT:}
  %m = icmp sgt <4 x i32> %t, zeroinitializer
  %v = call <4 x i32> @llvm.masked.load.v4i32.p0(ptr %b, i32 4, <4 x i1> %m, <4 x i32> %p)
  call void @llvm.masked.store.v4i32.p0(<4 x i32> %v, ptr %a, i32 4, <4 x i1> %m)
  ret void
}
