; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,DCE" | FileCheck %s
; A vector variable that is not stored on one path gets a zero vector as the incoming value, not an integer
; constant with a vector type (that one broke the instruction selection of the branch argument).

target triple = "x86_64-unknown-linux-gnu"

define <4 x float> @f(i1 %c, <4 x float> %v) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: 4@f32):
; CHECK-NEXT:    %2: ptr = Alloca(16:i32){extTy: 4@f32; } NUses:0
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2(<0:f32, 0:f32, 0:f32, 0:f32, >:4@f32)>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: () = Branch<bb2(%1)>(){} NUses:0
; CHECK-NEXT:  bb2(%5{}: 4@f32):
; CHECK-NEXT:    %6: 4@f32 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  %a = alloca <4 x float>, align 8
  br i1 %c, label %t, label %j
t:
  store <4 x float> %v, ptr %a, align 8
  br label %j
j:
  %r = load <4 x float>, ptr %a, align 8
  ret <4 x float> %r
}
