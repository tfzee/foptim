; CHECK-NEXT:    %2: i64 = Return(%0, %1){} NUses:0
; CHECK-NEXT:}
  %x = insertvalue { i64, i64 } poison, i64 %a, 0
  %y = insertvalue { i64, i64 } %x, i64 %b, 1
