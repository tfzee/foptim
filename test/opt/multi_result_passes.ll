; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "Mem2Reg,LVN,LoopSimplify,SimplifyCFG,SLPVectorizer,DCE" | FileCheck %s
; Passes must not assume a single result for calls that return a flattened struct.

declare { ptr, i64 } @get_buf(i64)
declare { i64, i64 } @get_pair(i64)
declare { i64, i64 } @fill(ptr)

; a result used as store address (LVN merges stores through the same base)
define void @store_through_result(i64 %n) {
; CHECK-LABEL: func store_through_result<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: [ptr i64] = Call(get_buf, %0){extTy: [ptr i64](i64 ); } NUses:2
; CHECK-NEXT:    %2: i64 = IntMul(4:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%1.0, %2){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: i32 = Store(%1.0, 1:i32){} NUses:0
; CHECK-NEXT:    %5: i32 = Store(%3, 2:i32){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  %r = call { ptr, i64 } @get_buf(i64 %n)
  %p = extractvalue { ptr, i64 } %r, 0
  %q = getelementptr i8, ptr %p, i64 4
  store i32 1, ptr %p
  store i32 2, ptr %q
  ret void
}

; both results are summed (reduction seeds)
define i64 @sum_results(i64 %n) {
; CHECK-LABEL: func sum_results<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: [i64 i64] = Call(get_pair, %0){extTy: [i64 i64](i64 ); } NUses:2
; CHECK-NEXT:    %2: i64 = IntAdd(%1.0, %1.1){} NUses:1
; CHECK-NEXT:    %3: i64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %r = call { i64, i64 } @get_pair(i64 %n)
  %a = extractvalue { i64, i64 } %r, 0
  %b = extractvalue { i64, i64 } %r, 1
  %s = add i64 %a, %b
  ret i64 %s
}

; a call in a loop whose results are used after the loop
define i64 @loop_results(i64 %n) {
; CHECK-LABEL: func loop_results<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%2{}: i64):
; CHECK-NEXT:    %3: [i64 i64] = Call(get_pair, %2){extTy: [i64 i64](i64 ); } NUses:2
; CHECK-NEXT:    %4: i64 = IntAdd(%2, 1:i64){} NUses:2
; CHECK-NEXT:    %5: i1 = IntSLT(%4, %0){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb1(%4), bb2()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i64 = IntSub(%3.0, %3.1){} NUses:1
; CHECK-NEXT:    %8: i64 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %r = call { i64, i64 } @get_pair(i64 %i)
  %i.next = add i64 %i, 1
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  %a = extractvalue { i64, i64 } %r, 0
  %b = extractvalue { i64, i64 } %r, 1
  %s = sub i64 %a, %b
  ret i64 %s
}

; an alloca passed to a call that returns two results
define i64 @alloca_arg() {
; CHECK-LABEL: func alloca_arg<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(8:i32){extTy: i64; } NUses:3
; CHECK-NEXT:    %1: i64 = Store(%0, 5:i64){} NUses:0
; CHECK-NEXT:    %2: [i64 i64] = Call(fill, %0){extTy: [i64 i64](ptr ); } NUses:1
; CHECK-NEXT:    %3: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: i64 = IntAdd(%2.1, %3){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %buf = alloca i64
  store i64 5, ptr %buf
  %r = call { i64, i64 } @fill(ptr %buf)
  %a = extractvalue { i64, i64 } %r, 1
  %v = load i64, ptr %buf
  %s = add i64 %a, %v
  ret i64 %s
}
