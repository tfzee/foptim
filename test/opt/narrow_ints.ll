; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "NarrowInts,DCE" | FileCheck %s
; Demanded bits narrowing. A sum of sign extended bytes that is only used
; truncated is computed in i8, also around the loop. A wide value that is
; stored too and a sum of loaded i32 (the truncs would cost more than they
; save) stay wide.

define i8 @sum_loop(ptr %p, i64 %n) {
; CHECK-LABEL: func sum_loop<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: () = Branch<bb1(0:i64, 0:i8)>(){} NUses:0
; CHECK-NEXT:  bb1(%3{}: i64, %4{}: i8):
; CHECK-NEXT:    %5: i64 = IntMul(%3, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, %5){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %7: i8 = Load(%6){} NUses:1
; CHECK-NEXT:    %8: i8 = IntAdd(%4, %7){} NUses:2
; CHECK-NEXT:    %9: i64 = IntAdd(%3, 1:i64){} NUses:2
; CHECK-NEXT:    %10: i1 = IntSLT(%9, %1){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb1(%9, %8), bb2()>(%10){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %12: i8 = Return(%8){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s.next, %loop ]
  %g = getelementptr inbounds i8, ptr %p, i64 %i
  %v = load i8, ptr %g
  %e = sext i8 %v to i32
  %s.next = add i32 %s, %e
  %i.next = add i64 %i, 1
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  %t = trunc i32 %s.next to i8
  ret i8 %t
}

define i8 @straight(i8 %a, i8 %b) {
; CHECK-LABEL: func straight<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8):
; CHECK-NEXT:    %2: i8 = IntMul(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i8 = Xor(%2, 5:i8){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %x = sext i8 %a to i32
  %y = zext i8 %b to i32
  %m = mul i32 %x, %y
  %z = xor i32 %m, 5
  %t = trunc i32 %z to i8
  ret i8 %t
}

define i32 @wide_used(i8 %a, i8 %b, ptr %q) {
; CHECK-LABEL: func wide_used<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8, %2{}: ptr):
; CHECK-NEXT:    %3: i32 = SExt(%0){} NUses:1
; CHECK-NEXT:    %4: i32 = SExt(%1){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%3, %4){} NUses:2
; CHECK-NEXT:    %6: i32 = Store(%2, %5){} NUses:0
; CHECK-NEXT:    %7: i8 = ITrunc(%5){} NUses:1
; CHECK-NEXT:    %8: i32 = ZExt(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = Return(%8){} NUses:0
; CHECK-NEXT:}
  %x = sext i8 %a to i32
  %y = sext i8 %b to i32
  %m = add i32 %x, %y
  store i32 %m, ptr %q
  %t = trunc i32 %m to i8
  %r = zext i8 %t to i32
  ret i32 %r
}

