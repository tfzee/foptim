; given to an unknown function, which may keep it
define void @kept_by_external() {
; CHECK-LABEL: func kept_by_external<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(16:i32){} NUses:2
; CHECK-NEXT:    %1: () = Call(ext, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %2: () = Call(external_user, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = alloca [16 x i8]
  call void @ext(ptr %p)
  call void @external_user(ptr %p)
  ret void
