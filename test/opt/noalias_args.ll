; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "LLVMIntrinsicLowering,FuncPropAnnotator" | FileCheck %s
;
; a parameter of an internal function becomes noalias when every call passes a
; fresh object (alloca or noalias result of a call) that is only dereferenced,
; passed to nocapture parameters or freed, and no other pointer operand of the
; call is based on it

declare noalias ptr @malloc(i64)
declare void @free(ptr)
declare void @ext(ptr)
@g = global ptr null

define internal void @kernel(ptr %a, ptr %b) {
; CHECK-LABEL: func kernel<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; nocapture; readonly; }: ptr, %1{noalias; nocapture; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  store i32 %x, ptr %b
  ret void
}

; both objects are private: a and b are noalias in kernel
define void @private_objects() {
; CHECK-LABEL: func private_objects<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:2
; CHECK-NEXT:    %1: ptr = Call(malloc, 16:i64){extTy: ptr(i64 ); } NUses:2
; CHECK-NEXT:    %2: () = Call(kernel, %0, %1){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %3: () = Call(free, %0){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Call(free, %1){extTy: ()(ptr ); } NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = call noalias ptr @malloc(i64 16)
  %q = call noalias ptr @malloc(i64 16)
  call void @kernel(ptr %p, ptr %q)
  call void @free(ptr %p) #0
  call void @free(ptr %q) #0
  ret void
}

define internal void @same_object(ptr %a, ptr %b) {
; CHECK-LABEL: func same_object<CC: C, LINK: internal, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nonnull; nocapture; readonly; }: ptr, %1{nocapture; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  store i32 %x, ptr %b
  ret void
}

; the same object twice: neither parameter may be noalias
define void @aliasing_call() {
; CHECK-LABEL: func aliasing_call<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(16:i32){} NUses:2
; CHECK-NEXT:    %1: i64 = IntMul(4:i64, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, %1){} NUses:1
; CHECK-NEXT:    %3: () = Call(same_object, %0, %2){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = alloca [16 x i8]
  %q = getelementptr i8, ptr %p, i64 4
  call void @same_object(ptr %p, ptr %q)
  ret void
}

define internal void @escaping(ptr %a, ptr %b) {
