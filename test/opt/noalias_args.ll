; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{nonnull; nocapture; readonly; }: ptr, %1{noalias; nonnull; nocapture; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Store(%1, %2){} NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %x = load i32, ptr %a
  store i32 %x, ptr %b
  ret void
}

; the address is also stored to a global, the callee may reach it there
define void @escaping_call() {
; CHECK-LABEL: func escaping_call<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = Alloca(16:i32){} NUses:2
; CHECK-NEXT:    %1: ptr = Alloca(16:i32){} NUses:1
; CHECK-NEXT:    %2: ptr = Store(G(g), %0){} NUses:0
; CHECK-NEXT:    %3: () = Call(escaping, %0, %1){extTy: ()(ptr ptr ); } NUses:0
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p = alloca [16 x i8]
  %q = alloca [16 x i8]
  store ptr %p, ptr @g
  call void @escaping(ptr %p, ptr %q)
  ret void
}

