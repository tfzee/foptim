; CHECK-NEXT:    %15: i1 = And(%13, %14){} NUses:1
; CHECK-NEXT:    %16: i1 = Return(%15){} NUses:0
; CHECK-NEXT:}
  %x = alloca i32
  %e = getelementptr inbounds i32, ptr @g, i64 2
  %a = call i1 @all_known(ptr %x)
  %b = call i1 @all_known(ptr %e)
  %c = call i1 @mid(ptr %x)
  %d = call i1 @one_unknown(ptr %x)
  %f = call i1 @one_unknown(ptr %ext)
  %g = call i1 @one_null(ptr %x)
  %h = call i1 @one_null(ptr null)
  %r1 = and i1 %a, %b
  %r2 = and i1 %c, %d
  %r3 = and i1 %f, %g
  %r4 = and i1 %r1, %r2
  %r5 = and i1 %r3, %h
  %r = and i1 %r4, %r5
  ret i1 %r
