; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "InstSimplify,DCE" | FileCheck %s

; A struct of two i32 passed as one i64 is repacked after every lane
; operation (zext, shl, or) and split again right away (lshr, trunc). The
; round trip has to fold away, so the second round of adds works directly on
; the results of the first round and the first pack is dead.

define i64 @add_lanes(i64 %a, i64 %b) {
; CHECK-LABEL: func add_lanes<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64):
; CHECK-NEXT:    %2: i32 = ITrunc(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = ITrunc(%1){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%2, %3){} NUses:1
; CHECK-NEXT:    %5: i64 = LShR(%0, 32:i64){} NUses:1
; CHECK-NEXT:    %6: i32 = ITrunc(%5){} NUses:1
; CHECK-NEXT:    %7: i64 = LShR(%1, 32:i64){} NUses:1
; CHECK-NEXT:    %8: i32 = ITrunc(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%6, %8){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%4, 1:i32){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%9, 2:i32){} NUses:1
; CHECK-NEXT:    %12: i64 = ZExt(%11){} NUses:1
; CHECK-NEXT:    %13: i64 = Shl(%12, 32:i64){NUW; } NUses:1
; CHECK-NEXT:    %14: i64 = ZExt(%10){} NUses:1
; CHECK-NEXT:    %15: i64 = Or(%13, %14){} NUses:1
; CHECK-NEXT:    %16: i64 = Return(%15){} NUses:0
; CHECK-NEXT:}
  %a.lo = trunc i64 %a to i32
  %b.lo = trunc i64 %b to i32
  %lo = add i32 %a.lo, %b.lo
  %a.hi.s = lshr i64 %a, 32
  %a.hi = trunc i64 %a.hi.s to i32
  %b.hi.s = lshr i64 %b, 32
  %b.hi = trunc i64 %b.hi.s to i32
  %hi = add i32 %a.hi, %b.hi
  %hi.z = zext i32 %hi to i64
  %hi.sh = shl i64 %hi.z, 32
  %lo.z = zext i32 %lo to i64
  %p1 = or i64 %hi.sh, %lo.z
  ; second round, takes the packed value apart again
  %p1.lo = trunc i64 %p1 to i32
  %p1.hi.s = lshr i64 %p1, 32
  %p1.hi = trunc i64 %p1.hi.s to i32
  %lo2 = add i32 %p1.lo, 1
  %hi2 = add i32 %p1.hi, 2
  %hi2.z = zext i32 %hi2 to i64
  %hi2.sh = shl i64 %hi2.z, 32
  %lo2.z = zext i32 %lo2 to i64
  %p2 = or i64 %hi2.sh, %lo2.z
  ret i64 %p2
}
