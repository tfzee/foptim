; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,DCE" | FileCheck %s
; a phi edge from a block that is not reachable from the entry is dropped
declare void @croak() noreturn

define i32 @f(i1 %c, i32 %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i32):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2(0:i32)>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: () = Call(croak){extTy: ()(); } NUses:0
; CHECK-NEXT:    %4: () = unreachable(){} NUses:0
; CHECK-NEXT:  bb2(%5{}: i32):
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %a, label %b
a:
  call void @croak()
  unreachable
dead:
  %d = add i32 %x, 1
  br label %b
b:
  %p = phi i32 [ 0, %entry ], [ %d, %dead ]
  ret i32 %p
}
