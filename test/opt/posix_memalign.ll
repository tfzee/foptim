; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "DCE" | FileCheck %s
; The loader turns posix_memalign into a call of the foptim.posix_memalign
; helper that returns the pointer and the error code. The out pointer gets the
; new pointer only on success and keeps its old value otherwise, like
; posix_memalign. The helper result is noalias, which a pointer that comes back
; through memory cannot be.
declare i32 @posix_memalign(ptr, i64, i64)

define ptr @alloc(i64 %n) {
; CHECK-LABEL: func alloc<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: ptr = Alloca(8:i32){extTy: ptr; } NUses:4
; CHECK-NEXT:    %2: ptr = Store(%1, NULL){} NUses:0
; CHECK-NEXT:    %3: ptr = Load(%1){} NUses:1
; CHECK-NEXT:    %4: [ptr i32] = Call(foptim.posix_memalign, 64:i64, %0){extTy: [ptr i32](i64 i64 ); } NUses:2
; CHECK-NEXT:    %5: i1 = IntEQ(%4.1, 0:i32){} NUses:1
; CHECK-NEXT:    %6: ptr = Select(%5, %4.0, %3){} NUses:1
; CHECK-NEXT:    %7: ptr = Store(%1, %6){} NUses:0
; CHECK-NEXT:    %8: ptr = Load(%1){} NUses:1
; CHECK-NEXT:    %9: ptr = Return(%8){} NUses:0
; CHECK-NEXT:}
  %slot = alloca ptr, align 8
  store ptr null, ptr %slot, align 8
  %err = call i32 @posix_memalign(ptr %slot, i64 64, i64 %n)
  %p = load ptr, ptr %slot, align 8
  ret ptr %p
}
