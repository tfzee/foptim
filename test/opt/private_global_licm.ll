; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "GlobalPromotion,LICM" | FileCheck %s
; a store through an unknown pointer cannot write an internal global whose
; address never leaves loads, stores and pointer arithmetic, so its load leaves
; the loop. An external global, one whose address is passed to a call, stored
; into memory or kept in the initializer of another global can be written
; through the pointer. A call may write even the private one (a callee of the
; module can name it), so its load stays in the loop.

@priv = internal global [8 x i32] zeroinitializer, align 4
@ext = global [8 x i32] zeroinitializer, align 4
@passed = internal global [8 x i32] zeroinitializer, align 4
@stored = internal global [8 x i32] zeroinitializer, align 4
@held = internal global [8 x i32] zeroinitializer, align 4
@holder = internal global ptr @held, align 8
@slot = global ptr null, align 8

declare i32 @unknown(i32)
declare void @take(ptr)

define i32 @use_priv(ptr %p, i32 %n) {
; CHECK-LABEL: func use_priv<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Load(G(priv)){} NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: i32):
; CHECK-NEXT:    %6: i32 = Store(%0, %4){} NUses:0
; CHECK-NEXT:    %7: i32 = IntAdd(%5, %2){} NUses:2
; CHECK-NEXT:    %8: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %9: i1 = IntEQ(%8, %1){} NUses:1
; CHECK-NEXT:    %10: () = CondBranch<bb2(), bb1(%8, %7)>(%9){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %11: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %v = load i32, ptr @priv, align 4
  store i32 %i, ptr %p, align 4
  %acc.next = add i32 %acc, %v
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %acc.next
}

