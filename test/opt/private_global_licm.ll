; a callee of the module writes the private global by name
define void @bump() noinline {
; CHECK-LABEL: func bump<CC: C, LINK: external, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Load(G(priv)){} NUses:1
; CHECK-NEXT:    %1: i32 = IntAdd(%0, 1:i32){} NUses:1
