; a chain of constant ptradds is one ptradd, so the load of the constant global folds
@pad = internal global { i8, i8, { i16, i16 }, i16 } { i8 0, i8 0, { i16, i16 } { i16 5, i16 6 }, i16 8 }, align 2

define i32 @f() {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(6:i32){} NUses:0
; CHECK-NEXT:}
  %a = getelementptr inbounds { i8, i8, { i16, i16 }, i16 }, ptr @pad, i32 0, i32 2
  %b = getelementptr inbounds { i16, i16 }, ptr %a, i32 0, i32 1
  %v = load i16, ptr %b
  %e = sext i16 %v to i32
  ret i32 %e
}
