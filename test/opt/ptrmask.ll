; RUN: %foffcc %s --print-fir --passes "Mem2Reg,DCE" | FileCheck %s
; llvm.ptrmask is the address and the mask
declare ptr @llvm.ptrmask.p0.i64(ptr, i64)

define ptr @f(ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = PTR_INT(%0){} NUses:1
; CHECK-NEXT:    %2: i64 = And(%1, -16:i64){} NUses:1
; CHECK-NEXT:    %3: ptr = INT_PTR(%2){} NUses:1
; CHECK-NEXT:    %4: ptr = Return(%3){} NUses:0
; CHECK-NEXT:}
  %r = call ptr @llvm.ptrmask.p0.i64(ptr %p, i64 -16)
  ret ptr %r
}
