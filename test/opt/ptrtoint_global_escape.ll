; RUN: %foffcc %s --print-fir | FileCheck %s
; a ptrtoint of a global is an escape for the access analysis, not a TODO
@g = internal global [4 x i64] zeroinitializer

define i64 @f(i64 %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64):
; CHECK-NEXT:    %1: i64 = PTR_INT(G(g)){} NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(G(g), 8:i64){} NUses:1
; CHECK-NEXT:    %3: i64 = Store(%2, %0){} NUses:0
; CHECK-NEXT:    %4: i64 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %a = ptrtoint ptr @g to i64
  %p = getelementptr i8, ptr @g, i64 8
  store i64 %x, ptr %p
  ret i64 %a
}
