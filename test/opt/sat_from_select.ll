; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,Mem2Reg,InstFold,InstSimplify,SCCP,DCE" | FileCheck %s
; Compare and select forms of the unsigned saturating add and subtract.
define i8 @uadd(i8 %a, i8 %b) {
; CHECK-LABEL: func uadd<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8):
; CHECK-NEXT:    %2: i8 = INTRIN:UAddSat(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i8 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %s = add i8 %a, %b
  %ov = icmp ult i8 %s, %a
  %r = select i1 %ov, i8 -1, i8 %s
  ret i8 %r
}

define i32 @usub_lt(i32 %a, i32 %b) {
; CHECK-LABEL: func usub_lt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = INTRIN:USubSat(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i32 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %d = sub i32 %a, %b
  %lt = icmp ult i32 %a, %b
  %r = select i1 %lt, i32 0, i32 %d
  ret i32 %r
}

define i16 @usub_gt(i16 %a, i16 %b) {
; CHECK-LABEL: func usub_gt<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i16, %1{}: i16):
; CHECK-NEXT:    %2: i16 = INTRIN:USubSat(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i16 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %d = sub i16 %a, %b
  %gt = icmp ugt i16 %a, %b
  %r = select i1 %gt, i16 %d, i16 0
  ret i16 %r
}

define i16 @usub_swapped(i16 %a, i16 %b) {
; CHECK-LABEL: func usub_swapped<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i16, %1{}: i16):
; CHECK-NEXT:    %2: i16 = INTRIN:USubSat(%1, %0){} NUses:1
; CHECK-NEXT:    %3: i16 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %d = sub i16 %b, %a
  %lt = icmp ult i16 %a, %b
  %r = select i1 %lt, i16 %d, i16 0
  ret i16 %r
}

; not a saturation, the compare is on other values
define i8 @not_sat(i8 %a, i8 %b, i8 %c) {
; CHECK-LABEL: func not_sat<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8, %1{}: i8, %2{}: i8):
; CHECK-NEXT:    %3: i8 = IntAdd(%0, %1){} NUses:2
; CHECK-NEXT:    %4: i1 = IntULT(%3, %2){} NUses:1
; CHECK-NEXT:    %5: i8 = Select(%4, -1:i8, %3){} NUses:1
; CHECK-NEXT:    %6: i8 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %s = add i8 %a, %b
  %ov = icmp ult i8 %s, %c
  %r = select i1 %ov, i8 -1, i8 %s
  ret i8 %r
}

; signed compare, not a saturation
define i32 @not_sat_signed(i32 %a, i32 %b) {
; CHECK-LABEL: func not_sat_signed<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntSub(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i1 = IntSLT(%0, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = Select(%3, 0:i32, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %d = sub i32 %a, %b
  %lt = icmp slt i32 %a, %b
  %r = select i1 %lt, i32 0, i32 %d
  ret i32 %r
}

declare i32 @llvm.usub.sat.i32(i32, i32)
; folds to a constant
define i32 @fold() {
; CHECK-LABEL: func fold<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:}
  %r = call i32 @llvm.usub.sat.i32(i32 3, i32 10)
  ret i32 %r
}
