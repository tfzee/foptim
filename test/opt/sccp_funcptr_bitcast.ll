; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SCCP,DCE" | FileCheck %s
; a conversion of a function address is not a known constant, it must not fold to 0.

declare void @callee()

define i64 @f() {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i64 = BITCAST(callee){} NUses:1
; CHECK-NEXT:    %1: i64 = Return(%0){} NUses:0
; CHECK-NEXT:}
  %p = alloca ptr
  store ptr @callee, ptr %p
  %v = load i64, ptr %p
  ret i64 %v
}

define i64 @g() {
; CHECK-LABEL: func g<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i64 = PTR_INT(callee){} NUses:1
; CHECK-NEXT:    %1: i64 = Return(%0){} NUses:0
; CHECK-NEXT:}
  ret i64 ptrtoint (ptr @callee to i64)
}
