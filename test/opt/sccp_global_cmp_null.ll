; RUN: %foffcc %s --print-fir --passes "SCCP" | FileCheck %s

; The address of a global is not a known number, SCCP used to compare the
; global pointer slot with 0 and folded the compare to true.


@a1 = global [64 x i64] zeroinitializer, align 16

define i1 @f() {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: i1 = IntEQ(G(a1), NULL){} NUses:1
; CHECK-NEXT:    %1: i1 = Return(%0){} NUses:0
; CHECK-NEXT:}
  %c = icmp eq ptr @a1, null
  ret i1 %c
}
