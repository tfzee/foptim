; INT_MIN is not a positive power of two
define i8 @sdiv_int_min(i8 %x) {
; CHECK-LABEL: func sdiv_int_min<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i8 = IntSDiv(%0, -128:i8){} NUses:1
; CHECK-NEXT:    %2: i8 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = sdiv i8 %x, -128
  ret i8 %r
}
