; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; Division by a power of two is a shift so the vectorizer and the loop analyses
; see shifts. The signed one adds 2^k - 1 to negative dividends first, an exact
; one is a plain arithmetic shift.

define i32 @sdiv16(i32 %x) {
; CHECK-LABEL: func sdiv16<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = AShR(%0, 31:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = LShR(%1, 28:i32){} NUses:1
; CHECK-NEXT:    %3: i32 = IntAdd(%0, %2){} NUses:1
; CHECK-NEXT:    %4: i32 = AShR(%3, 4:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %r = sdiv i32 %x, 16
  ret i32 %r
}

define i32 @sdiv16_exact(i32 %x) {
; CHECK-LABEL: func sdiv16_exact<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = AShR(%0, 4:i32){Exact; } NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %r = sdiv exact i32 %x, 16
  ret i32 %r
}

