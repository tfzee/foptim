; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; select of two ops sharing an operand becomes op(a, select), compare of a sext with a fitting constant is done narrow.

define i8 @sel_add(i1 %c, i8 %a) {
; CHECK-LABEL: func sel_add<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i8):
; CHECK-NEXT:    %2: i8 = Select(%0, 10:i8, 99:i8){} NUses:1
; CHECK-NEXT:    %3: i8 = IntAdd(%1, %2){} NUses:1
; CHECK-NEXT:    %4: i8 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %p = add i8 %a, 10
  %q = add i8 %a, 99
  %r = select i1 %c, i8 %p, i8 %q
  ret i8 %r
}

define i1 @sext_eq(i8 %x) {
; CHECK-LABEL: func sext_eq<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i1 = IntEQ(%0, 2:i8){} NUses:1
; CHECK-NEXT:    %2: i1 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %s = sext i8 %x to i32
  %c = icmp eq i32 %s, 2
  ret i1 %c
}

define i1 @sext_big(i8 %x) {
; CHECK-LABEL: func sext_big<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i8):
; CHECK-NEXT:    %1: i32 = SExt(%0){} NUses:1
; CHECK-NEXT:    %2: i1 = IntEQ(%1, 300:i32){} NUses:1
; CHECK-NEXT:    %3: i1 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %s = sext i8 %x to i32
  %c = icmp eq i32 %s, 300
  ret i1 %c
}
