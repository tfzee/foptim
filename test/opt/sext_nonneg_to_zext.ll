; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "InstSimplify" | FileCheck %s

; A sext of a value with a known zero sign bit is a zext nneg, a sext of a value
; with an unknown sign stays.

declare void @use(i32)

define i64 @sext_nonneg(i32 %a, i64 %k) {
; CHECK-LABEL: func sext_nonneg<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i64):
; CHECK-NEXT:    %2: i32 = And(%0, 127:i32){} NUses:2
; CHECK-NEXT:    %3: () = Call(use, %2){extTy: ()(i32 ); } NUses:0
; CHECK-NEXT:    %4: i64 = ZExt(%2){NNeg; } NUses:1
; CHECK-NEXT:    %5: i64 = IntAdd(%4, %1){} NUses:1
; CHECK-NEXT:    %6: i64 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %m = and i32 %a, 127
  call void @use(i32 %m)
  %s = sext i32 %m to i64
  %r = add i64 %s, %k
  ret i64 %r
}

define i64 @sext_unknown_sign(i32 %a, i64 %k) {
; CHECK-LABEL: func sext_unknown_sign<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i64):
; CHECK-NEXT:    %2: () = Call(use, %0){extTy: ()(i32 ); } NUses:0
; CHECK-NEXT:    %3: i64 = SExt(%0){} NUses:1
; CHECK-NEXT:    %4: i64 = IntAdd(%3, %1){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  call void @use(i32 %a)
  %s = sext i32 %a to i64
  %r = add i64 %s, %k
  ret i64 %r
}
