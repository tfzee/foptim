; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; sext of a sub that cannot wrap is the sub of the extended operands, which is
; what makes a[i - 2] a unit stride access for the loop analyses. Without the
; flag the sub is on the narrow type.

define i64 @nsw(i32 %x, i32 %y) {
; CHECK-LABEL: func nsw<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i64 = SExt(%0){} NUses:1
; CHECK-NEXT:    %3: i64 = SExt(%1){} NUses:1
; CHECK-NEXT:    %4: i64 = IntSub(%2, %3){} NUses:1
; CHECK-NEXT:    %5: i32 = IntSub(%0, %1){NSW; } NUses:0
; CHECK-NEXT:    %6: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %s = sub nsw i32 %x, %y
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @plain(i32 %x, i32 %y) {
; CHECK-LABEL: func plain<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntSub(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i64 = SExt(%2){} NUses:1
; CHECK-NEXT:    %4: i64 = Return(%3){} NUses:0
; CHECK-NEXT:}
  %s = sub i32 %x, %y
  %e = sext i32 %s to i64
  ret i64 %e
}

define i64 @zext_nuw(i32 %x, i32 %y) {
; CHECK-LABEL: func zext_nuw<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i64 = ZExt(%0){} NUses:1
; CHECK-NEXT:    %3: i64 = ZExt(%1){} NUses:1
; CHECK-NEXT:    %4: i64 = IntSub(%2, %3){} NUses:1
; CHECK-NEXT:    %5: i32 = IntSub(%0, %1){NUW; } NUses:0
; CHECK-NEXT:    %6: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %s = sub nuw i32 %x, %y
  %e = zext i32 %s to i64
  ret i64 %e
}
