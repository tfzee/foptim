; RUN: %foffcc %s --print-fir --passes "InstSimplify,DCE" | FileCheck %s
; chained shifts of the same kind with constant amounts are one shift, an overshift is 0 (ashr keeps the sign)

define i32 @lshr_chain(i32 %x) {
; CHECK-LABEL: func lshr_chain<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = LShR(%0, 7:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %a = lshr i32 %x, 3
  %b = lshr i32 %a, 4
  ret i32 %b
}

define i32 @shl_chain(i32 %x) {
; CHECK-LABEL: func shl_chain<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = Shl(%0, 16:i32){} NUses:1
; CHECK-NEXT:    %2: i32 = Return(%1){} NUses:0
; CHECK-NEXT:}
  %a = shl i32 %x, 7
  %b = shl i32 %a, 9
  ret i32 %b
}

