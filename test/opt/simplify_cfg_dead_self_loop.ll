; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,SimplifyCFG,InstSimplify" | FileCheck %s

; The branch in the entry block is constant, so once InstSimplify folded it the
; loop is unreachable and its only predecessor is itself. SimplifyCFG has to
; remove the whole loop: if it stays, its block arguments (only incoming values
; are the back edge ones) get replaced by those, which makes `%i.next = add
; %i.next, 1`, and InstSimplify then reassociates that self referencing chain
; forever (it ran out of memory).
define i32 @f(i32 %x) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i32 = Return(%0){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 true, label %out, label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %i.next = add i32 %i, 1
  %acc.next = add i32 %acc, %i
  %c = icmp slt i32 %i.next, 10
  br i1 %c, label %loop, label %out
out:
  %r = phi i32 [ %x, %entry ], [ %acc.next, %loop ]
  ret i32 %r
}
