; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "SimplifyCFG" | FileCheck %s
; Two blocks that only differ in the lane they extract are not merged into one block with the lane as a block
; argument, the lane index of an extract has to stay a constant.

target triple = "x86_64-unknown-linux-gnu"

define i32 @f(i1 %c, ptr %p) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: ptr):
; CHECK-NEXT:    %2: 4@i32 = Load(%1){} NUses:2
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: i32 = ExtractElement(%2, 1:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, 7:i32){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i32 = ExtractElement(%2, 2:i32){} NUses:1
; CHECK-NEXT:    %8: i32 = IntAdd(%7, 7:i32){} NUses:1
; CHECK-NEXT:    %9: i32 = Return(%8){} NUses:0
; CHECK-NEXT:}
entry:
  %v = load <4 x i32>, ptr %p, align 16
  br i1 %c, label %a, label %b
a:
  %x = extractelement <4 x i32> %v, i32 1
  %xs = add i32 %x, 7
  br label %m
b:
  %y = extractelement <4 x i32> %v, i32 2
  %ys = add i32 %y, 7
  br label %m
m:
  %r = phi i32 [ %xs, %a ], [ %ys, %b ]
  ret i32 %r
}
