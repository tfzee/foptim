; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "SimplifyCFG" | FileCheck %s

; The two return blocks have the same shape but compare an i32 and an i64, so
; they must not be merged into one block with block arguments of one type.
define i32 @f(i32 %x, i64 %a, i64 %b, i1 %c) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i64, %2{}: i64, %3{}: i1):
; CHECK-NEXT:    %4: () = CondBranch<bb1(), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i1 = IntSLT(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %6: i32 = ZExt(%5){} NUses:1
; CHECK-NEXT:    %7: i32 = Return(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i1 = IntSLT(%1, %2){} NUses:1
; CHECK-NEXT:    %9: i32 = ZExt(%8){} NUses:1
; CHECK-NEXT:    %10: i32 = Return(%9){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %l, label %r
l:
  %c1 = icmp slt i32 %x, 0
  %z1 = zext i1 %c1 to i32
  ret i32 %z1
r:
  %c2 = icmp slt i64 %a, %b
  %z2 = zext i1 %c2 to i32
  ret i32 %z2
}
