; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "SimplifyCFG" | FileCheck %s

; both empty blocks jump to the join block directly, the join block still has
; two predecessors so it is kept
define i32 @forward(i1 %c, i32 %a, i32 %b) {
; CHECK-LABEL: func forward<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i32 = Select(%0, %1, %2){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%3, 1:i32){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %left, label %right

left:
  br label %join

right:
  br label %join

join:
  %p = phi i32 [ %a, %left ], [ %b, %right ]
  %r = add i32 %p, 1
  ret i32 %r
}
