; RUN: %foffcc %s --print-fir --passes "SimplifyCFG,DCE" | FileCheck %s
; the arms start with the same extension of the same value, it moves in front of the branch and then the divisions with
; different dividends are sunk into the join as one division of a select. A division first in both arms is not
; hoisted, it could trap.

define i32 @div(i1 %c, i8 %x) {
; CHECK-LABEL: func div<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i8):
; CHECK-NEXT:    %2: i32 = SExt(%1){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(20:i32), bb1(99:i32)>(%0){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: i32 = IntSDiv(%4, %2){} NUses:1
; CHECK-NEXT:    %6: i8 = ITrunc(%5){} NUses:1
; CHECK-NEXT:    %7: i32 = SExt(%6){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %t, label %e
t:
  %a = sext i8 %x to i32
  %d1 = sdiv i32 20, %a
  %t1 = trunc i32 %d1 to i8
  br label %join
e:
  %b = sext i8 %x to i32
  %d2 = sdiv i32 99, %b
  %t2 = trunc i32 %d2 to i8
  br label %join
join:
  %r = phi i8 [ %t1, %t ], [ %t2, %e ]
  %s = sext i8 %r to i32
  ret i32 %s
}

