; RUN: %foffcc %s --print-fir --passes "SimplifyCFG" | FileCheck %s

; a chain of blocks that are only entered by the branch of the previous one
; becomes a single block
define i32 @chain(i32 %a, i32 %b) {
; CHECK-LABEL: func chain<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i32 = IntAdd(%0, %1){} NUses:1
; CHECK-NEXT:    %3: i32 = IntMul(%2, %1){} NUses:1
; CHECK-NEXT:    %4: i32 = IntSub(%3, %0){} NUses:1
; CHECK-NEXT:    %5: i32 = Return(%4){} NUses:0
; CHECK-NEXT:}
entry:
  %x = add i32 %a, %b
  br label %b1

b1:
  %y = mul i32 %x, %b
  br label %b2

b2:
  %z = sub i32 %y, %a
  br label %b3

b3:
  ret i32 %z
}
