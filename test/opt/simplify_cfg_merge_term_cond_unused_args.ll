; RUN: %foffcc %s --print-fir | FileCheck %s
; merge_term_cond merges a block with block arguments into its predecessor even when nothing outside the block uses
; the arguments (reduced from ExportCbYCrYQuantum of ImageMagick, needs the whole pipeline to show up).
target triple = "x86_64-unknown-linux-gnu"

define void @ExportCbYCrYQuantum(i1 %0, i64 %1) {
; CHECK-LABEL: func ExportCbYCrYQuantum<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i64):
; CHECK-NEXT:    %2: () = Return(){} NUses:0
; CHECK-NEXT:}
  br i1 %0, label %3, label %common.ret

3:                                                ; preds = %8, %2
  %4 = phi i64 [ 0, %8 ], [ 0, %2 ]
  %5 = phi i64 [ %1, %8 ], [ 0, %2 ]
  %6 = icmp slt i64 %5, 0
  br i1 %6, label %7, label %common.ret

7:                                                ; preds = %7, %3
  br i1 true, label %7, label %8

8:                                                ; preds = %7
  br label %3

common.ret:                                       ; preds = %3, %2
  ret void
}
