; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %4: [i64 f64] = Call(ext, %1){extTy: [i64 f64](i64 ); } NUses:2
; CHECK-NEXT:    %5: i64 = Return(%4.0, %4.1){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: [i64 f64] = Call(ext, %2){extTy: [i64 f64](i64 ); } NUses:2
; CHECK-NEXT:    %7: i64 = Return(%6.0, %6.1){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %a, label %b
a:
  %r = call { i64, double } @ext(i64 %x)
  ret { i64, double } %r
b:
  %s = call { i64, double } @ext(i64 %y)
  ret { i64, double } %s
}

define void @join(i1 %c, i64 %x) {
; CHECK-LABEL: func join<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i64):
; CHECK-NEXT:    %2: () = CondBranch<bb1(), bb2()>(%0){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %3: [i64 f64] = Call(ext, %1){extTy: [i64 f64](i64 ); } NUses:2
; CHECK-NEXT:    %4: () = Call(use, %3.0, %3.1){extTy: ()(i64 f64 ); } NUses:0
; CHECK-NEXT:    %5: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: [i64 f64] = Call(ext, 1:i64){extTy: [i64 f64](i64 ); } NUses:2
; CHECK-NEXT:    %7: () = Call(use, %6.0, %6.1){extTy: ()(i64 f64 ); } NUses:0
; CHECK-NEXT:    %8: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br i1 %c, label %a, label %b
a:
  %r = call { i64, double } @ext(i64 %x)
  br label %j
b:
  %s = call { i64, double } @ext(i64 1)
  br label %j
j:
  %p = phi { i64, double } [ %r, %a ], [ %s, %b ]
  %p0 = extractvalue { i64, double } %p, 0
  %p1 = extractvalue { i64, double } %p, 1
