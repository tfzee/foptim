; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify,SORA,Mem2Reg,InstSimplify,DCE" | FileCheck %s
; a float vector store next to scalar accesses and an overlapping vector load of a stack object is split into lanes so the object is promoted
define double @f(double %x, double %y, double %z) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: f64, %1{}: f64, %2{}: f64):
; CHECK-NEXT:    %3: 2@f64 = InsertElement(POISON, %1, 0:i32){} NUses:1
; CHECK-NEXT:    %4: f64 = ExtractElement(%3, 0:i32){} NUses:1
; CHECK-NEXT:    %5: 2@f64 = InsertElement(<0:f64, 0:f64, >:2@f64, %0, 0:i32){} NUses:1
; CHECK-NEXT:    %6: f64 = ExtractElement(%5, 0:i32){} NUses:1
; CHECK-NEXT:    %7: f64 = FloatAdd(%6, %4){} NUses:1
; CHECK-NEXT:    %8: f64 = FloatAdd(%7, %2){} NUses:1
; CHECK-NEXT:    %9: f64 = Return(%8){} NUses:0
; CHECK-NEXT:}
  %a = alloca [3 x double], align 8
  %p1 = getelementptr inbounds i8, ptr %a, i64 8
  store double %x, ptr %a
  %v = insertelement <2 x double> poison, double %y, i32 0
  %v2 = insertelement <2 x double> %v, double %z, i32 1
  store <2 x double> %v2, ptr %p1, align 8
  %l = load <2 x double>, ptr %a, align 8
  %e0 = extractelement <2 x double> %l, i32 0
  %e1 = extractelement <2 x double> %l, i32 1
  %p2 = getelementptr inbounds i8, ptr %a, i64 16
  %s = load double, ptr %p2
  %r = fadd double %e0, %e1
  %r2 = fadd double %r, %s
  ret double %r2
}
