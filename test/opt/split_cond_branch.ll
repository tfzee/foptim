; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "SplitCondBranch" | FileCheck %s
;
; and / or of single use compares become a chain of branches, a compare with
; another use keeps the and, a load only feeding the second compare moves along

target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i32 @and2(i32 %a, i32 %b) {
; CHECK-LABEL: func and2<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSGT(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %4: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %6: i1 = IntSGT(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb3(), bb2()>(%6){} NUses:0
; CHECK-NEXT:}
  %c1 = icmp sgt i32 %a, 0
  %c2 = icmp sgt i32 %b, 0
  %c = and i1 %c1, %c2
  br i1 %c, label %t, label %f
t:
  ret i32 1
f:
  ret i32 0
}

define i32 @or3_load(i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: func or3_load<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32, %2{}: ptr):
; CHECK-NEXT:    %3: i1 = IntSGT(%0, 0:i32){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i32 = Return(1:i32){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %6: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %7: i32 = Load(%2){} NUses:1
; CHECK-NEXT:    %8: i1 = IntSLT(%7, 7:i32){} NUses:1
; CHECK-NEXT:    %9: () = CondBranch<bb1(), bb3()>(%8){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %10: i1 = IntEQ(%1, 3:i32){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb1(), bb4()>(%10){} NUses:0
; CHECK-NEXT:}
  %c1 = icmp sgt i32 %a, 0
  %c2 = icmp eq i32 %b, 3
  %l = load i32, ptr %p
  %c3 = icmp slt i32 %l, 7
  %o1 = or i1 %c1, %c2
  %o2 = or i1 %o1, %c3
  br i1 %o2, label %t, label %f
t:
  ret i32 1
f:
  ret i32 0
}

define i32 @multi_use(i32 %a, i32 %b) {
; CHECK-LABEL: func multi_use<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32, %1{}: i32):
; CHECK-NEXT:    %2: i1 = IntSGT(%0, 0:i32){} NUses:2
; CHECK-NEXT:    %3: i1 = IntSGT(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %4: i1 = And(%2, %3){} NUses:1
; CHECK-NEXT:    %5: i32 = ZExt(%2){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb1(), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %7: i32 = Return(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i32 = Return(0:i32){} NUses:0
; CHECK-NEXT:}
  %c1 = icmp sgt i32 %a, 0
  %c2 = icmp sgt i32 %b, 0
  %c = and i1 %c1, %c2
  %z = zext i1 %c1 to i32
  br i1 %c, label %t, label %f
t:
  ret i32 %z
f:
  ret i32 0
}
