; CHECK-NEXT:    %2: ptr = Alloca(4:i32){} NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32):
; CHECK-NEXT:    %5: () = INTRIN:MemCpy(%1, G(a), 4:i64){extTy: i8; } NUses:0
; CHECK-NEXT:    %6: () = INTRIN:MemCpy(%2, G(b), 4:i64){extTy: i8; } NUses:0
; CHECK-NEXT:    %7: ptr = Load(G(g)){} NUses:2
; CHECK-NEXT:    %8: ptr = Store(%7, %7){} NUses:0
; CHECK-NEXT:    %9: i32 = IntAdd(%4, 1:i32){} NUses:2
; CHECK-NEXT:    %10: i1 = IntULT(%9, %0){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb1(%9), bb2()>(%10){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %12: i32 = Return(-1:i32){} NUses:0
; CHECK-NEXT:}
entry:
  %x = alloca [4 x i8]
  %y = alloca [4 x i8]
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  call void @llvm.memcpy.p0.p0.i64(ptr %x, ptr @a, i64 4, i1 false)
  call void @llvm.memcpy.p0.p0.i64(ptr %y, ptr @b, i64 4, i1 false)
  %p = load ptr, ptr @g
  store ptr %p, ptr %p
  %i1 = add i32 %i, 1
  %c = icmp ult i32 %i1, %n
  br i1 %c, label %loop, label %exit
