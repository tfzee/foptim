@a = private unnamed_addr constant [4 x i8] c"abc\00"
@b = private unnamed_addr constant [4 x i8] c"abd\00"
@g = global ptr null

declare i32 @strcmp(ptr, ptr)
declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)

define i32 @cmp_loop(i32 %n) {
