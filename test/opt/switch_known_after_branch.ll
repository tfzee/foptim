; CHECK-NEXT:    %3: i1 = IntEQ(%0, 3:i32){} NUses:1
; CHECK-NEXT:    %4: ptr = Select(%3, a, b){} NUses:1
; CHECK-NEXT:    %5: () = Call(%4){extTy: ()(); } NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %c = icmp eq i32 %v, 3
  br i1 %c, label %t, label %e
t:
  switch i32 %v, label %d [ i32 3, label %x ]
x:
  call void @a()
  ret void
d:
  call void @b()
  ret void
e:
