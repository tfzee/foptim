; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %13: () = Switch<bb3(), bb4(), bb5(), bb6(), bb3(), bb2()>(0:i64, 1:i64, 2:i64, 3:i64, 4:i64, %2){} NUses:0
; CHECK-NEXT:}
entry:
  switch i32 %v, label %dead [
    i32 0, label %la
    i32 1, label %lb
    i32 2, label %lc
    i32 3, label %ld
    i32 4, label %la
  ]
