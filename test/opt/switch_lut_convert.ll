; Switches that become a table load (one run), the types of the table entries,
; and the switches that must stay as they are.

; A switch whose cases go to one block with different constant arguments
; becomes a range check and a load from a constant table. Cases to other blocks
; stay in a smaller switch in front. A hole inside the range is only fine if no
; value can reach it (unreachable default), otherwise the cases are split into
; runs.

declare void @side()
@g1 = global i32 0
@g2 = global i32 0

; dense cases, the default is its own block
define i32 @dense(i32 %v) {
; CHECK-LABEL: func dense<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i32):
; CHECK-NEXT:    %1: i64 = SExt(%0){} NUses:2
; CHECK-NEXT:    %2: i1 = IntULT(%1, 4:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: i32 = Return(-1:i32){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i64 = IntMul(%1, 4:i64){} NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(G(lookup_table_dense_0), %5){} NUses:1
; CHECK-NEXT:    %7: i32 = Load(%6){} NUses:1
; CHECK-NEXT:    %8: i32 = Return(%7){} NUses:0
; CHECK-NEXT:}
entry:
  switch i32 %v, label %d [ i32 0, label %a  i32 1, label %b  i32 2, label %c  i32 3, label %e ]
a: br label %j
b: br label %j
c: br label %j
e: br label %j
d: ret i32 -1
j:
  %r = phi i32 [10, %a], [21, %b], [32, %c], [43, %e]
  ret i32 %r
}

