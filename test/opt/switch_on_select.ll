; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "InstSimplify" | FileCheck %s
; switch on a select of two constants is a conditional branch

define i32 @switch_select(i1 %c, i32 %x) {
; CHECK-LABEL: func switch_select<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i1, %1{}: i32):
; CHECK-NEXT:    %2: i32 = Select(%0, 2:i32, 0:i32){} NUses:0
; CHECK-NEXT:    %3: () = CondBranch<bb1(), bb2()>(%0){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %4: () = unreachable(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %5: i32 = Return(%1){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %6: i32 = IntAdd(%1, 1:i32){} NUses:1
; CHECK-NEXT:    %7: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %8: i32 = Return(%6){} NUses:0
; CHECK-NEXT:}
entry:
  %s = select i1 %c, i32 2, i32 0
  switch i32 %s, label %dead [
    i32 0, label %exit
    i32 2, label %loop
  ]
loop:
  %y = add i32 %x, 1
  br label %exit2
exit:
  ret i32 %x
exit2:
  ret i32 %y
dead:
  unreachable
}
