; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --no-reorder-funcs --passes "TailRecElim" | FileCheck %s
; A self call whose results are returned as they are is a loop, also with
; several results.

define { i64, double } @f(i64 %n, i64 %a, double %d) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64, %2{}: f64):
; CHECK-NEXT:    %3: () = Branch<bb1(%0, %1, %2)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: i64, %6{}: f64):
; CHECK-NEXT:    %7: i1 = IntEQ(%4, 0:i64){} NUses:1
; CHECK-NEXT:    %8: () = CondBranch<bb2(), bb3()>(%7){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %9: i64 = Return(%5, %6){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %10: i64 = IntSub(%4, 1:i64){} NUses:1
; CHECK-NEXT:    %11: i64 = IntAdd(%5, %4){} NUses:1
; CHECK-NEXT:    %12: f64 = FloatAdd(%6, 3FF0000000000000:f64){} NUses:1
; CHECK-NEXT:    %13: () = Branch<bb1(%10, %11, %12)>(){} NUses:0
; CHECK-NEXT:}
entry:
  %z = icmp eq i64 %n, 0
  br i1 %z, label %base, label %step
base:
  %r0 = insertvalue { i64, double } poison, i64 %a, 0
  %r1 = insertvalue { i64, double } %r0, double %d, 1
  ret { i64, double } %r1
step:
  %m = sub i64 %n, 1
  %a2 = add i64 %a, %n
  %d2 = fadd double %d, 1.0
  %r = call { i64, double } @f(i64 %m, i64 %a2, double %d2)
  ret { i64, double } %r
}

; swapped results are not a tail call
define { i64, i64 } @g(i64 %n, i64 %a, i64 %b) {
; CHECK-LABEL: func g<CC: C, LINK: external, > Uses: 1
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: i64, %1{}: i64, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntEQ(%0, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %5: i64 = Return(%1, %2){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %6: i64 = IntSub(%0, 1:i64){} NUses:1
; CHECK-NEXT:    %7: [i64 i64] = Call(g, %6, %2, %1){extTy: [i64 i64](i64 i64 i64 ); } NUses:2
; CHECK-NEXT:    %8: i64 = Return(%7.1, %7.0){} NUses:0
; CHECK-NEXT:}
entry:
  %z = icmp eq i64 %n, 0
  br i1 %z, label %base, label %step
base:
  %r0 = insertvalue { i64, i64 } poison, i64 %a, 0
  %r1 = insertvalue { i64, i64 } %r0, i64 %b, 1
  ret { i64, i64 } %r1
step:
  %m = sub i64 %n, 1
  %r = call { i64, i64 } @g(i64 %m, i64 %b, i64 %a)
  %x = extractvalue { i64, i64 } %r, 0
  %y = extractvalue { i64, i64 } %r, 1
  %s0 = insertvalue { i64, i64 } poison, i64 %y, 0
  %s1 = insertvalue { i64, i64 } %s0, i64 %x, 1
  ret { i64, i64 } %s1
}
