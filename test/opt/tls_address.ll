; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,LVN,DCE" | FileCheck %s
; llvm.threadlocal.address of a thread local global becomes TlsAddress, equal ones
; merge, a plain global keeps its address
@tl = thread_local global i32 5
@plain = global i32 7
declare ptr @llvm.threadlocal.address.p0(ptr)

define i32 @f() {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0():
; CHECK-NEXT:    %0: ptr = INTRIN:TlsAddress(G(tl)){} NUses:2
; CHECK-NEXT:    %1: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = Load(G(plain)){} NUses:1
; CHECK-NEXT:    %4: i32 = IntAdd(%1, %2){} NUses:1
; CHECK-NEXT:    %5: i32 = IntAdd(%4, %3){} NUses:1
; CHECK-NEXT:    %6: i32 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %a = call ptr @llvm.threadlocal.address.p0(ptr @tl)
  %b = call ptr @llvm.threadlocal.address.p0(ptr @tl)
  %c = call ptr @llvm.threadlocal.address.p0(ptr @plain)
  %x = load i32, ptr %a
  %y = load i32, ptr %b
  %z = load i32, ptr %c
  %s = add i32 %x, %y
  %t = add i32 %s, %z
  ret i32 %t
}
