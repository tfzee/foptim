; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" --cconffile %S/config/loops_off.toml | FileCheck %s
; loops = false turns the loop vectorizer off, the loop stays scalar.

define void @f(ptr noalias %a, ptr noalias %b, float %s, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: f32, %3{}: i64):
; CHECK-NEXT:    %4: i1 = IntSGT(%3, 0:i64){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i64), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){} NUses:1
; CHECK-NEXT:    %9: f32 = Load(%8){} NUses:2
; CHECK-NEXT:    %10: f32 = FloatMul(%9, %2){} NUses:1
; CHECK-NEXT:    %11: f32 = FloatAdd(%10, %9){} NUses:1
; CHECK-NEXT:    %12: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %13: f32 = Store(%12, %11){} NUses:0
; CHECK-NEXT:    %14: i64 = IntAdd(%6, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %3){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb1(%14), bb2()>(%15){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %17: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]

  %pb = getelementptr float, ptr %b, i64 %i
  %x = load float, ptr %pb
  %m = fmul float %x, %s
  %r = fadd float %m, %x
  %pa = getelementptr float, ptr %a, i64 %i
  store float %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
