; CHECK-NEXT:    %12: () = CondBranch<bb1(%10), bb2()>(%11){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %13: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pb
  %r = add i32 %x, 1
  %pa = getelementptr i32, ptr %a, i64 %i
  store i32 %r, ptr %pa
