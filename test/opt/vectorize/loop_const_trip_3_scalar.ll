; CHECK-NEXT:    %6: i32 = Load(%5){} NUses:1
; CHECK-NEXT:    %7: i32 = IntAdd(%6, 1:i32){} NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %4){} NUses:1
; CHECK-NEXT:    %9: i32 = Store(%8, %7){} NUses:0
