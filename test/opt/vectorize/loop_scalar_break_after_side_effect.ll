; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Store before the early exit: lanes after the first match must not store, stays scalar unless masked per lane.

define i64 @f(ptr %a, ptr %b, i32 %x, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i32, %3{}: i64):
; CHECK-NEXT:    %4: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %6: i1 = IntSLT(%5, %3){} NUses:1
; CHECK-NEXT:    %7: () = CondBranch<bb2(), bb3()>(%6){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %8: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%1, %8){NSW; NUW; } NUses:1
; CHECK-NEXT:    %11: i32 = Load(%9){} NUses:2
; CHECK-NEXT:    %12: i32 = Store(%10, %11){} NUses:0
; CHECK-NEXT:    %13: i1 = IntEQ(%11, %2){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb4(), bb5()>(%13){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %15: i64 = Return(%3){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %16: i64 = Return(%5){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %17: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %18: () = Branch<bb1(%17)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %latch ]
  %cn = icmp slt i64 %i, %n
  br i1 %cn, label %body, label %notfound
body:
  %p = getelementptr i32, ptr %a, i64 %i
  %pb = getelementptr i32, ptr %b, i64 %i
  %v = load i32, ptr %p
  store i32 %v, ptr %pb
  %z = icmp eq i32 %v, %x
  br i1 %z, label %found, label %latch
latch:
  %i1 = add nuw nsw i64 %i, 1
  br label %loop
found:
  ret i64 %i
notfound:
  ret i64 %n
}
