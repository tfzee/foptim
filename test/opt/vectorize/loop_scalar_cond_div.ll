; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Stays scalar: the division only runs where c[i] != 0, in a vector it would also run in the other lanes and trap.

define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{noalias; }: ptr, %3{}: i64):
; CHECK-NEXT:    %4: i1 = IntSGT(%3, 0:i64){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i64), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){NSW; NUW; } NUses:3
; CHECK-NEXT:    %8: ptr = PtrAdd(%2, %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:2
; CHECK-NEXT:    %10: i1 = IntNE(%9, 0:i32){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb3(), bb4()>(%10){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %12: () = Return(){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %13: ptr = PtrAdd(%1, %7){} NUses:1
; CHECK-NEXT:    %14: i32 = Load(%13){} NUses:1
; CHECK-NEXT:    %15: i32 = IntSDiv(%14, %9){} NUses:1
; CHECK-NEXT:    %16: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %17: i32 = Store(%16, %15){} NUses:0
; CHECK-NEXT:    %18: () = Branch<bb4()>(){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %19: i64 = IntAdd(%6, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %20: i1 = IntSLT(%19, %3){} NUses:1
; CHECK-NEXT:    %21: () = CondBranch<bb1(%19), bb2()>(%20){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %latch ]
  %pc = getelementptr i32, ptr %c, i64 %i
  %y = load i32, ptr %pc
  %t = icmp ne i32 %y, 0
  br i1 %t, label %then, label %latch
then:
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pb
  %d = sdiv i32 %x, %y
  %pa = getelementptr i32, ptr %a, i64 %i
  store i32 %d, ptr %pa
  br label %latch
latch:
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
