; CHECK-NEXT:    %6: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){} NUses:1
; CHECK-NEXT:    %8: i64 = IntAdd(%6, 4:i64){} NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){} NUses:1
; CHECK-NEXT:    %10: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%10, 1:i32){} NUses:1
; CHECK-NEXT:    %12: i32 = Store(%9, %11){} NUses:0
; CHECK-NEXT:    %13: i1 = IntSLT(%5, %1){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%5), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %15: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]

  %ip = add i64 %i, 1
  %pa = getelementptr i32, ptr %a, i64 %i
  %pb = getelementptr i32, ptr %a, i64 %ip
  %x = load i32, ptr %pa
  %r = add i32 %x, 1
  store i32 %r, ptr %pb
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:

  ret void
}
