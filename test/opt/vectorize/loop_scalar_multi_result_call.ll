; a pure call with two results in the loop body, the loop vectorizer must reject the loop
; (it asserted on result() of a multi result instruction)

declare { i32, i32 } @pair(i32) memory(none) nounwind willreturn

define void @f(ptr noalias %a, ptr noalias %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i64):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64):
; CHECK-NEXT:    %5: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, %5){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %7: i32 = Load(%6){} NUses:1
; CHECK-NEXT:    %8: [i32 i32] = Call(pair, %7){extTy: [i32 i32](i32 ); } NUses:2
; CHECK-NEXT:    %9: i32 = IntAdd(%8.0, %8.1){} NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%1, %5){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %11: i32 = Store(%10, %9){} NUses:0
; CHECK-NEXT:    %12: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %13: i1 = IntULT(%12, %2){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%12), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %15: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %pa = getelementptr inbounds i32, ptr %a, i64 %i
  %x = load i32, ptr %pa
  %r = call { i32, i32 } @pair(i32 %x)
  %r0 = extractvalue { i32, i32 } %r, 0
  %r1 = extractvalue { i32, i32 } %r, 1
  %s = add i32 %r0, %r1
  %pb = getelementptr inbounds i32, ptr %b, i64 %i
  store i32 %s, ptr %pb
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp ult i64 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
