entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %latch ]
  %cn = icmp slt i64 %i, %n
  br i1 %cn, label %body, label %exit
body:
  %pb = getelementptr i32, ptr %b, i64 %i
  %pa = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %pb
  %t = icmp eq i32 %x, 0
