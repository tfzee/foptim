; CHECK-NEXT:  bb1(%5{}: i64, %6{}: i32):
; CHECK-NEXT:    %7: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %11: i32 = Store(%10, %6){} NUses:0
; CHECK-NEXT:    %12: i32 = IntAdd(%9, %6){} NUses:1
; CHECK-NEXT:    %13: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %2){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13, %12), bb2()>(%14){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %16: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %s = phi i32 [ 0, %entry ], [ %s1, %loop ]
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pb
  %pa = getelementptr i32, ptr %a, i64 %i
  store i32 %s, ptr %pa
  %s1 = add i32 %s, %x
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
