; x = x * 3 + b[i] is a recurrence that is stored, not an add reduction. Has to stay scalar.

define void @f(ptr noalias %a, ptr noalias %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64, 1:i32), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64, %6{}: i32):
; CHECK-NEXT:    %7: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i32 = IntMul(%6, 3:i32){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%10, %9){} NUses:2
; CHECK-NEXT:    %12: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %13: i32 = Store(%12, %11){} NUses:0
; CHECK-NEXT:    %14: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %2){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb1(%14, %11), bb2()>(%15){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %17: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %s = phi i32 [ 1, %entry ], [ %s2, %loop ]
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pb
  %s1 = mul i32 %s, 3
  %s2 = add i32 %s1, %x
  %pa = getelementptr i32, ptr %a, i64 %i
  store i32 %s2, ptr %pa
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
