entry:
  %g = icmp slt i64 %off, %n
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ %off, %entry ], [ %i.next, %loop ]
  %ps = getelementptr inbounds i32, ptr %s, i64 %i
