; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Neither pointer is noalias, the int and the float accesses are apart by their
; TBAA types, so the loop vectorizer may run several iterations at once.

define void @f(ptr %a, ptr %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i64){} NUses:1
; CHECK-NEXT:    %4: i64 = INTRIN:SMax(%2, 1:i64){} NUses:2
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i64), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb3(%6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %9: ptr = PtrAdd(%1, %7){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %10: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %11: f32 = Load(%9){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%10, 1:i32){} NUses:1
; CHECK-NEXT:    %13: f32 = FloatAdd(%11, 3F800000:f32){} NUses:1
; CHECK-NEXT:    %14: i32 = Store(%8, %12){} NUses:0
; CHECK-NEXT:    %15: f32 = Store(%9, %13){} NUses:0
; CHECK-NEXT:    %16: i64 = IntAdd(%6, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %17: i1 = IntSLT(%16, %2){} NUses:1
; CHECK-NEXT:    %18: () = CondBranch<bb3(%16), bb2()>(%17){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %19: () = Return(){} NUses:0
; CHECK-NEXT:  bb1(%20{}: i64):
; CHECK-NEXT:    %21: i64 = And(%4, -8:i64){} NUses:3
; CHECK-NEXT:    %22: i64 = IntAdd(%21, %20){NSW; } NUses:1
; CHECK-NEXT:    %23: i1 = IntEQ(%21, 0:i64){} NUses:1
; CHECK-NEXT:    %24: 8@i32 = V.Broadcast(1:i32){} NUses:1
; CHECK-NEXT:    %25: 8@f32 = V.Broadcast(3F800000:f32){} NUses:1
; CHECK-NEXT:    %26: () = CondBranch<bb3(%20), bb4(%20)>(%23){} NUses:0
; CHECK-NEXT:  bb4(%27{}: i64):
; CHECK-NEXT:    %28: i64 = IntMul(%27, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %29: ptr = PtrAdd(%0, %28){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %30: ptr = PtrAdd(%1, %28){NSW; InBounds; } NUses:2
; CHECK-NEXT:    %31: 8@i32 = Load(%29){} NUses:1
; CHECK-NEXT:    %32: 8@f32 = Load(%30){} NUses:1
; CHECK-NEXT:    %33: 8@i32 = IntAdd(%31, %24){} NUses:1
; CHECK-NEXT:    %34: 8@f32 = FloatAdd(%32, %25){} NUses:1
; CHECK-NEXT:    %35: 8@i32 = Store(%29, %33){} NUses:0
; CHECK-NEXT:    %36: 8@f32 = Store(%30, %34){} NUses:0
; CHECK-NEXT:    %37: i64 = IntAdd(%27, 8:i64){} NUses:3
; CHECK-NEXT:    %38: i1 = IntNE(%37, %22){} NUses:1
; CHECK-NEXT:    %39: () = CondBranch<bb4(%37), bb5(%37)>(%38){} NUses:0
; CHECK-NEXT:  bb5(%40{}: i64):
; CHECK-NEXT:    %41: i1 = IntEQ(%21, %4){} NUses:1
; CHECK-NEXT:    %42: () = CondBranch<bb2(), bb3(%40)>(%41){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %pa = getelementptr inbounds i32, ptr %a, i64 %i
  %pb = getelementptr inbounds float, ptr %b, i64 %i
  %x = load i32, ptr %pa, align 4, !tbaa !10
  %y = load float, ptr %pb, align 4, !tbaa !11
  %x1 = add i32 %x, 1
  %y1 = fadd float %y, 1.0
  store i32 %x1, ptr %pa, align 4, !tbaa !10
  store float %y1, ptr %pb, align 4, !tbaa !11
  %i.next = add nuw nsw i64 %i, 1
  %c = icmp slt i64 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

!0 = !{!"Simple C/C++ TBAA"}
!1 = !{!"omnipotent char", !0, i64 0}
!2 = !{!"int", !1, i64 0}
!3 = !{!"float", !1, i64 0}
!10 = !{!2, !2, i64 0}
!11 = !{!3, !3, i64 0}
