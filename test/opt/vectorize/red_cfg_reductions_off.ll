; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" --cconffile %S/config/reductions_off.toml | FileCheck %s
; reductions = false turns the straight line reductions off: the fast fadd of four values stays scalar (red_fadd_fast_f32x4.ll is the same input with the default config).

define float @f(ptr %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: f32 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, 4:i64){} NUses:1
; CHECK-NEXT:    %3: f32 = Load(%2){} NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%0, 8:i64){} NUses:1
; CHECK-NEXT:    %5: f32 = Load(%4){} NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, 12:i64){} NUses:1
; CHECK-NEXT:    %7: f32 = Load(%6){} NUses:1
; CHECK-NEXT:    %8: f32 = FloatAdd(%1, %3){} NUses:1
; CHECK-NEXT:    %9: f32 = FloatAdd(%8, %5){} NUses:1
; CHECK-NEXT:    %10: f32 = FloatAdd(%9, %7){} NUses:1
; CHECK-NEXT:    %11: f32 = Return(%10){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr float, ptr %a, i64 0
  %x0 = load float, ptr %p0
  %p1 = getelementptr float, ptr %a, i64 1
  %x1 = load float, ptr %p1
  %p2 = getelementptr float, ptr %a, i64 2
  %x2 = load float, ptr %p2
  %p3 = getelementptr float, ptr %a, i64 3
  %x3 = load float, ptr %p3
  %s1 = fadd fast float %x0, %x1
  %s2 = fadd fast float %s1, %x2
  %s3 = fadd fast float %s2, %x3
  ret float %s3
}
