; Horizontal fast fadd of two adjacent f64.

define double @f(ptr %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: 2@i64 = V.Broadcast(%0){} NUses:1
; CHECK-NEXT:    %2: 2@i64 = Load(G(const_legalizeVec_f_0)){} NUses:1
; CHECK-NEXT:    %3: 2@i64 = PtrAdd(%1, %2){} NUses:1
; CHECK-NEXT:    %4: 2@f64 = Load(%3){} NUses:1
; CHECK-NEXT:    %5: f64 = Reduce.Add(%4){} NUses:1
; CHECK-NEXT:    %6: f64 = Return(%5){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr double, ptr %a, i64 0
  %x0 = load double, ptr %p0
  %p1 = getelementptr double, ptr %a, i64 1
  %x1 = load double, ptr %p1
  %s1 = fadd fast double %x0, %x1
  ret double %s1
}
