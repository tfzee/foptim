; Horizontal fast fadd of four adjacent f64.

define double @f(ptr %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: 4@f64 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: f64 = Reduce.Add(%1){} NUses:1
; CHECK-NEXT:    %3: f64 = Return(%2){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr double, ptr %a, i64 0
  %x0 = load double, ptr %p0
  %p1 = getelementptr double, ptr %a, i64 1
  %x1 = load double, ptr %p1
  %p2 = getelementptr double, ptr %a, i64 2
  %x2 = load double, ptr %p2
  %p3 = getelementptr double, ptr %a, i64 3
  %x3 = load double, ptr %p3
  %s1 = fadd fast double %x0, %x1
  %s2 = fadd fast double %s1, %x2
  %s3 = fadd fast double %s2, %x3
  ret double %s3
}
