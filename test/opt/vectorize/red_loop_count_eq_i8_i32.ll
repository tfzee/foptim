entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %x = phi i32 [ 0, %entry ], [ %x1, %loop ]
  %pa = getelementptr i8, ptr %a, i64 %i
  %va = load i8, ptr %pa
  %ca = icmp eq i8 %va, 120
  %za = zext i1 %ca to i32
  %x1 = add i32 %x, %za
  %i1 = add nuw nsw i64 %i, 1
  %c = icmp slt i64 %i1, %n
  br i1 %c, label %loop, label %exit
