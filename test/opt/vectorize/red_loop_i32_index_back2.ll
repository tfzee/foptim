entry:
  br label %head

head:
  %i = phi i32 [ 1, %entry ], [ %i1, %body ]
  %r = phi i8 [ 0, %entry ], [ %r1, %body ]
  %c = icmp slt i32 %i, %n
  br i1 %c, label %body, label %exit

body:
  %im = sub i32 %i, 1
  %im64 = sext i32 %im to i64
  %p0 = getelementptr i8, ptr %a, i64 %im64
  %v0 = load i8, ptr %p0
  %i64 = sext i32 %i to i64
  %p1 = getelementptr i8, ptr %a, i64 %i64
  %v1 = load i8, ptr %p1
  %d = sub i8 %v0, %v1
  %r1 = add i8 %r, %d
  %i1 = add i32 %i, 1
  br label %head

exit:
  ret i8 %r
}
