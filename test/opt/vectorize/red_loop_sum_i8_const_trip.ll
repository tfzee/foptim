entry:
  br label %body
body:
  %i = phi i32 [ 0, %entry ], [ %inc, %body ]
  %r = phi i8 [ 0, %entry ], [ %add2, %body ]
  %idx = sext i32 %i to i64
  %p = getelementptr inbounds i8, ptr %a, i64 %idx
  %x = load i8, ptr %p
  %add = add i8 %x, %v
  %add2 = add i8 %add, %r
  %inc = add i32 %i, 1
  %c = icmp slt i32 %inc, 8000
  br i1 %c, label %body, label %end
end:
  ret i8 %add2
}
