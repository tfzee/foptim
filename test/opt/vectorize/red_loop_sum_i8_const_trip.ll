; CHECK-NEXT:    %8: i32 = IntAdd(%7, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: 32@i8 = V.Broadcast(0:i8){} NUses:1
; CHECK-NEXT:    %10: 32@i8 = V.Broadcast(%1){} NUses:1
; CHECK-NEXT:    %11: () = Branch<bb3(%5, %9)>(){} NUses:0
; CHECK-NEXT:  bb3(%12{}: i32, %13{}: 32@i8):
; CHECK-NEXT:    %14: i64 = SExt(%12){} NUses:1
; CHECK-NEXT:    %15: ptr = PtrAdd(%0, %14){NSW; NUW; InBounds; } NUses:1
; CHECK-NEXT:    %16: 32@i8 = Load(%15){} NUses:1
; CHECK-NEXT:    %17: 32@i8 = IntAdd(%16, %10){} NUses:1
; CHECK-NEXT:    %18: 32@i8 = IntAdd(%17, %13){} NUses:2
; CHECK-NEXT:    %19: i32 = IntAdd(%12, 32:i32){} NUses:3
; CHECK-NEXT:    %20: i1 = IntNE(%19, %8){} NUses:1
; CHECK-NEXT:    %21: () = CondBranch<bb3(%19, %18), bb4(%19, %18)>(%20){} NUses:0
; CHECK-NEXT:  bb4(%22{}: i32, %23{}: 32@i8):
