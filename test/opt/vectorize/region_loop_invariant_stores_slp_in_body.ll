; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; The loop stores to the same four adjacent addresses every iteration, so the loop vectorizer has to reject it. The straight line vectorizer still widens the four stores in the body, the loop itself stays scalar.

define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{noalias; }: ptr, %3{}: i64):
; CHECK-NEXT:    %4: i1 = IntSGT(%3, 0:i64){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i64), bb2()>(%4){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:2
; CHECK-NEXT:    %10: 4@i32 = V.Broadcast(%9){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%9, 1:i32){} NUses:1
; CHECK-NEXT:    %12: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %13: i32 = Store(%12, %11){} NUses:0
; CHECK-NEXT:    %14: 4@i32 = Store(%2, %10){} NUses:0
; CHECK-NEXT:    %15: i64 = IntAdd(%6, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %16: i1 = IntSLT(%15, %3){} NUses:1
; CHECK-NEXT:    %17: () = CondBranch<bb1(%15), bb2()>(%16){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %18: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pb
  %r = add i32 %x, 1
  %pa = getelementptr i32, ptr %a, i64 %i
  store i32 %r, ptr %pa
  %c0 = getelementptr i32, ptr %c, i64 0
  %c1 = getelementptr i32, ptr %c, i64 1
  %c2 = getelementptr i32, ptr %c, i64 2
  %c3 = getelementptr i32, ptr %c, i64 3
  store i32 %x, ptr %c0
  store i32 %x, ptr %c1
  store i32 %x, ptr %c2
  store i32 %x, ptr %c3
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
