; Loop whose body handles four adjacent elements per iteration (stride 4, base pointer plus constant offsets): the loop vectorizer cannot take it, the straight line vectorizer vectorizes the body.

define void @f(ptr noalias %a, ptr noalias %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %6: i64 = Shl(%5, 2:i64){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%1, %7){} NUses:1
; CHECK-NEXT:    %9: 4@i64 = V.Broadcast(%8){} NUses:1
; CHECK-NEXT:    %10: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %11: 4@i64 = Load(G(const_legalizeVec_f_0)){} NUses:1
; CHECK-NEXT:    %12: 4@i64 = PtrAdd(%9, %11){} NUses:1
; CHECK-NEXT:    %13: 4@i32 = Load(%12){} NUses:1
; CHECK-NEXT:    %14: 4@i32 = V.Broadcast(9:i32){} NUses:1
; CHECK-NEXT:    %15: 4@i32 = IntAdd(%13, %14){} NUses:1
; CHECK-NEXT:    %16: 4@i32 = Store(%10, %15){} NUses:0
; CHECK-NEXT:    %17: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %18: i1 = IntSLT(%17, %2){} NUses:1
; CHECK-NEXT:    %19: () = CondBranch<bb1(%17), bb2()>(%18){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %20: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %k = shl i64 %i, 2
  %pbase = getelementptr i32, ptr %b, i64 %k
  %abase = getelementptr i32, ptr %a, i64 %k
  %pb0 = getelementptr i32, ptr %pbase, i64 0
  %x0 = load i32, ptr %pb0
  %pb1 = getelementptr i32, ptr %pbase, i64 1
  %x1 = load i32, ptr %pb1
  %pb2 = getelementptr i32, ptr %pbase, i64 2
  %x2 = load i32, ptr %pb2
  %pb3 = getelementptr i32, ptr %pbase, i64 3
  %x3 = load i32, ptr %pb3
  %r0 = add i32 %x0, 9
  %r1 = add i32 %x1, 9
  %r2 = add i32 %x2, 9
  %r3 = add i32 %x3, 9
  %pa0 = getelementptr i32, ptr %abase, i64 0
  store i32 %r0, ptr %pa0
  %pa1 = getelementptr i32, ptr %abase, i64 1
  store i32 %r1, ptr %pa1
  %pa2 = getelementptr i32, ptr %abase, i64 2
  store i32 %r2, ptr %pa2
  %pa3 = getelementptr i32, ptr %abase, i64 3
  store i32 %r3, ptr %pa3
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  ret void
}
