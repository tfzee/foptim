; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; A chain that inserts the same scalar into every lane is a broadcast.

define void @f(ptr noalias %o, i32 %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{}: i32):
; CHECK-NEXT:    %2: 4@i32 = V.Broadcast(%1){} NUses:1
; CHECK-NEXT:    %3: 4@i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %4: 4@i32 = IntAdd(%2, %3){} NUses:1
; CHECK-NEXT:    %5: 4@i32 = Store(%0, %4){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  %v0 = insertelement <4 x i32> poison, i32 %a, i32 0
  %v1 = insertelement <4 x i32> %v0, i32 %a, i32 1
  %v2 = insertelement <4 x i32> %v1, i32 %a, i32 2
  %v3 = insertelement <4 x i32> %v2, i32 %a, i32 3
  %w = load <4 x i32>, ptr %o
  %r = add <4 x i32> %v3, %w
  store <4 x i32> %r, ptr %o
  ret void
}
