; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; A shuffle of a chain only permutes the lanes: lane 0 is the last load, so the loads are reversed and become a vector load plus a shuffle.

define void @f(ptr noalias %a, ptr noalias %o) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr):
; CHECK-NEXT:    %2: 4@i32 = Load(%0){} NUses:2
; CHECK-NEXT:    %3: 4@i32 = V.Shuffle(%2, %2, <3:i32, 2:i32, 1:i32, 0:i32, >:4@i32){} NUses:1
; CHECK-NEXT:    %4: 4@i32 = Load(%1){} NUses:1
; CHECK-NEXT:    %5: 4@i32 = IntAdd(%3, %4){} NUses:1
; CHECK-NEXT:    %6: 4@i32 = Store(%1, %5){} NUses:0
; CHECK-NEXT:    %7: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p1 = getelementptr i32, ptr %a, i64 1
  %p2 = getelementptr i32, ptr %a, i64 2
  %p3 = getelementptr i32, ptr %a, i64 3
  %x0 = load i32, ptr %a
  %x1 = load i32, ptr %p1
  %x2 = load i32, ptr %p2
  %x3 = load i32, ptr %p3
  %v0 = insertelement <4 x i32> poison, i32 %x0, i32 0
  %v1 = insertelement <4 x i32> %v0, i32 %x1, i32 1
  %v2 = insertelement <4 x i32> %v1, i32 %x2, i32 2
  %v3 = insertelement <4 x i32> %v2, i32 %x3, i32 3
  %r = shufflevector <4 x i32> %v3, <4 x i32> poison, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
  %w = load <4 x i32>, ptr %o
  %s = add <4 x i32> %r, %w
  store <4 x i32> %s, ptr %o
  ret void
}
