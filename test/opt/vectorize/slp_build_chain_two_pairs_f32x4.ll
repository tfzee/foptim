; CHECK-NEXT:    %5: 4@f32 = Load(%4){} NUses:1
; CHECK-NEXT:    %6: 4@f32 = Load(%1){} NUses:1
; CHECK-NEXT:    %7: 4@f32 = FloatMul(%5, %6){} NUses:1
; CHECK-NEXT:    %8: 4@f32 = Store(%1, %7){} NUses:0
; CHECK-NEXT:    %9: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p1 = getelementptr float, ptr %a, i64 1
  %p2 = getelementptr float, ptr %a, i64 2
  %p3 = getelementptr float, ptr %a, i64 3
  %x0 = load float, ptr %a
  %x1 = load float, ptr %p1
  %x2 = load float, ptr %p2
  %x3 = load float, ptr %p3
  %l0 = insertelement <2 x float> poison, float %x0, i32 0
  %l1 = insertelement <2 x float> %l0, float %x1, i32 1
  %h0 = insertelement <2 x float> poison, float %x2, i32 0
  %h1 = insertelement <2 x float> %h0, float %x3, i32 1
