; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr):
; CHECK-NEXT:    %2: i32 = Load(%0){} NUses:1
; CHECK-NEXT:    %3: i32 = IntAdd(%2, 7:i32){} NUses:1
; CHECK-NEXT:    %4: 4@i32 = V.Broadcast(%3){} NUses:1
; CHECK-NEXT:    %5: 4@i32 = Store(%1, %4){} NUses:0
; CHECK-NEXT:    %6: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr i32, ptr %a, i64 0
  %q0 = getelementptr i32, ptr %o, i64 0
  %p1 = getelementptr i32, ptr %a, i64 0
  %q1 = getelementptr i32, ptr %o, i64 1
  %p2 = getelementptr i32, ptr %a, i64 0
  %q2 = getelementptr i32, ptr %o, i64 2
  %p3 = getelementptr i32, ptr %a, i64 0
  %q3 = getelementptr i32, ptr %o, i64 3
  %x0 = load i32, ptr %p0
  %x1 = load i32, ptr %p1
  %x2 = load i32, ptr %p2
  %x3 = load i32, ptr %p3
  %y0 = add i32 %x0, 7
  %y1 = add i32 %x1, 7
  %y2 = add i32 %x2, 7
  %y3 = add i32 %x3, 7
  store i32 %y0, ptr %q0
  store i32 %y1, ptr %q1
  store i32 %y2, ptr %q2
  store i32 %y3, ptr %q3
  ret void
}
