; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Two reversed 64 bit lanes are one vector load and a single source shuffle.

define void @f(ptr noalias %a, ptr noalias %o) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr):
; CHECK-NEXT:    %2: 2@i64 = Load(%0){} NUses:2
; CHECK-NEXT:    %3: 2@i64 = V.Shuffle(%2, %2, <1:i32, 0:i32, >:2@i32){} NUses:1
; CHECK-NEXT:    %4: 2@i64 = V.Broadcast(7:i64){} NUses:1
; CHECK-NEXT:    %5: 2@i64 = IntAdd(%3, %4){} NUses:1
; CHECK-NEXT:    %6: 2@i64 = Store(%1, %5){} NUses:0
; CHECK-NEXT:    %7: () = Return(){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr i64, ptr %a, i64 1
  %p1 = getelementptr i64, ptr %a, i64 0
  %q1 = getelementptr i64, ptr %o, i64 1
  %x0 = load i64, ptr %p0
  %x1 = load i64, ptr %p1
  %y0 = add i64 %x0, 7
  %y1 = add i64 %x1, 7
  store i64 %y0, ptr %o
  store i64 %y1, ptr %q1
  ret void
}
