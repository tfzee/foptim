; The lanes extracted in another block than the stores are the whole vector.
define void @f(ptr %p, ptr %q, i1 %c) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i1):
; CHECK-NEXT:    %3: 4@i64 = Load(%0){} NUses:5
; CHECK-NEXT:    %4: i64 = ExtractElement(%3, 0:i32){} NUses:0
; CHECK-NEXT:    %5: i64 = ExtractElement(%3, 1:i32){} NUses:0
; CHECK-NEXT:    %6: i64 = ExtractElement(%3, 2:i32){} NUses:0
; CHECK-NEXT:    %7: i64 = ExtractElement(%3, 3:i32){} NUses:0
; CHECK-NEXT:    %8: () = CondBranch<bb1(), bb2()>(%2){} NUses:0
; CHECK-NEXT:  bb1():
; CHECK-NEXT:    %9: ptr = PtrAdd(%1, 8:i64){NSW; InBounds; } NUses:0
; CHECK-NEXT:    %10: ptr = PtrAdd(%1, 16:i64){NSW; InBounds; } NUses:0
; CHECK-NEXT:    %11: ptr = PtrAdd(%1, 24:i64){NSW; InBounds; } NUses:0
; CHECK-NEXT:    %12: 4@i64 = Store(%1, %3){} NUses:0
; CHECK-NEXT:    %13: () = Branch<bb2()>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %14: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %v = load <4 x i64>, ptr %p, align 8
  %e0 = extractelement <4 x i64> %v, i32 0
  %e1 = extractelement <4 x i64> %v, i32 1
  %e2 = extractelement <4 x i64> %v, i32 2
  %e3 = extractelement <4 x i64> %v, i32 3
  br i1 %c, label %a, label %b
a:
  store i64 %e0, ptr %q, align 8
  %q1 = getelementptr inbounds i8, ptr %q, i64 8
  store i64 %e1, ptr %q1, align 8
  %q2 = getelementptr inbounds i8, ptr %q, i64 16
  store i64 %e2, ptr %q2, align 8
  %q3 = getelementptr inbounds i8, ptr %q, i64 24
  store i64 %e3, ptr %q3, align 8
  br label %b
b:
  ret void
}

