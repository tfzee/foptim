  %pa0 = getelementptr i32, ptr %a, i64 0
  %pb1 = getelementptr i32, ptr %b, i64 1
  %pc1 = getelementptr i32, ptr %c, i64 1
  %pa1 = getelementptr i32, ptr %a, i64 1
