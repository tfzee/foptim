; a[i] = abs(b[i]) via select: single block, only needs vector select.

define void @f(ptr %a, ptr %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %6: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %7: ptr = PtrAdd(%1, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %10: i32 = INTRIN:ABS(%9){} NUses:1
; CHECK-NEXT:    %11: i32 = Store(%8, %10){} NUses:0
; CHECK-NEXT:    %12: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %2){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%12), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %15: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]

  %pb = getelementptr i32, ptr %b, i64 %i
  %pa = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %pb
  %t = icmp slt i32 %x, 0
  %neg = sub i32 0, %x
  %r = select i1 %t, i32 %neg, i32 %x
  store i32 %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:

  ret void
}
