entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]

  %pb = getelementptr i8, ptr %b, i64 %i
  %pc = getelementptr i8, ptr %c, i64 %i
  %pa = getelementptr i8, ptr %a, i64 %i
  %x = load i8, ptr %pb
  %y = load i8, ptr %pc
  %r = add i8 %x, %y
  store i8 %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
