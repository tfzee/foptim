; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,LoopUnroll,SimplifyCFG,InstSimplify,LVN,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Small constant trip count: LoopUnroll only unrolls x2 here and the SLP vectorizer does not pack the copies. Should end up as 2 vector add/stores (never reaches a loop vectorizer).

define void @f(ptr noalias %a, ptr noalias %b, ptr noalias %c) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{noalias; }: ptr, %2{noalias; }: ptr):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %4: () = Return(){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %6: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:4
; CHECK-NEXT:    %7: ptr = PtrAdd(%1, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%2, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %11: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%10, %11){} NUses:1
; CHECK-NEXT:    %13: i32 = Store(%9, %12){} NUses:0
; CHECK-NEXT:    %14: i64 = IntAdd(%6, 4:i64){} NUses:3
; CHECK-NEXT:    %15: ptr = PtrAdd(%1, %14){NSW; NUW; } NUses:1
; CHECK-NEXT:    %16: ptr = PtrAdd(%2, %14){NSW; NUW; } NUses:1
; CHECK-NEXT:    %17: ptr = PtrAdd(%0, %14){NSW; NUW; } NUses:1
; CHECK-NEXT:    %18: i32 = Load(%15){} NUses:1
; CHECK-NEXT:    %19: i32 = Load(%16){} NUses:1
; CHECK-NEXT:    %20: i32 = IntAdd(%18, %19){} NUses:1
; CHECK-NEXT:    %21: i32 = Store(%17, %20){} NUses:0
; CHECK-NEXT:    %22: i64 = IntAdd(%5, 2:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %23: i1 = IntULT(%22, 8:i64){} NUses:1
; CHECK-NEXT:    %24: () = CondBranch<bb1(%22), bb2()>(%23){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %pb = getelementptr i32, ptr %b, i64 %i
  %pc = getelementptr i32, ptr %c, i64 %i
  %pa = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %pb
  %y = load i32, ptr %pc
  %r = add i32 %x, %y
  store i32 %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1
  %cc = icmp ult i64 %i1, 8
  br i1 %cc, label %loop, label %exit
exit:
  ret void
}
