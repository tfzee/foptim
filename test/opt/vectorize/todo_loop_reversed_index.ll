; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64), bb2()>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64):
; CHECK-NEXT:    %6: i64 = IntSub(%2, %5){} NUses:1
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i64){} NUses:1
; CHECK-NEXT:    %8: i64 = IntSub(%7, 4:i64){} NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%1, %8){} NUses:1
; CHECK-NEXT:    %10: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %11: ptr = PtrAdd(%0, %10){} NUses:1
; CHECK-NEXT:    %12: i32 = Load(%9){} NUses:1
; CHECK-NEXT:    %13: i32 = IntAdd(%12, 1:i32){} NUses:1
; CHECK-NEXT:    %14: i32 = Store(%11, %13){} NUses:0
; CHECK-NEXT:    %15: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %16: i1 = IntSLT(%15, %2){} NUses:1
; CHECK-NEXT:    %17: () = CondBranch<bb1(%15), bb2()>(%16){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %18: () = Return(){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]

  %j = sub i64 %n, %i
  %jm = sub i64 %j, 1
  %pb = getelementptr i32, ptr %b, i64 %jm
  %pa = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %pb
  %r = add i32 %x, 1
  store i32 %r, ptr %pa
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:

  ret void
}
