; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Not vectorized (output is scalar): horizontal add of two adjacent i64, integer add reductions use the associative search which never finds a chain (see todo_red_fadd_assoc_config_f32x4.ll). Should be.

define i64 @f(ptr %a) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr):
; CHECK-NEXT:    %1: i64 = Load(%0){} NUses:1
; CHECK-NEXT:    %2: ptr = PtrAdd(%0, 8:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: i64 = Load(%2){} NUses:1
; CHECK-NEXT:    %4: i64 = IntAdd(%1, %3){} NUses:1
; CHECK-NEXT:    %5: i64 = Return(%4){} NUses:0
; CHECK-NEXT:}
  %p0 = getelementptr i64, ptr %a, i64 0
  %x0 = load i64, ptr %p0
  %p1 = getelementptr i64, ptr %a, i64 1
  %x1 = load i64, ptr %p1
  %s1 = add i64 %x0, %x1
  ret i64 %s1
}
