; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; select-cmp reduction (argmax), needs the select-cmp recurrence kind (milestone 6).

define i64 @f(ptr %a, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(0:i64, -2147483648:i32, 0:i64), bb2(0:i64)>(%2){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: i32, %6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:2
; CHECK-NEXT:    %10: i1 = IntSGT(%9, %5){} NUses:1
; CHECK-NEXT:    %11: i32 = INTRIN:SMax(%9, %5){} NUses:1
; CHECK-NEXT:    %12: i64 = Select(%10, %4, %6){} NUses:2
; CHECK-NEXT:    %13: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %1){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13, %11, %12), bb2(%12)>(%14){} NUses:0
; CHECK-NEXT:  bb2(%16{}: i64):
; CHECK-NEXT:    %17: i64 = Return(%16){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %best = phi i32 [ -2147483648, %entry ], [ %best1, %loop ]
  %idx = phi i64 [ 0, %entry ], [ %idx1, %loop ]
  %p = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %p
  %t = icmp sgt i32 %x, %best
  %best1 = select i1 %t, i32 %x, i32 %best
  %idx1 = select i1 %t, i64 %i, i64 %idx
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi i64 [ 0, %entry ], [ %idx1, %loop ]

  ret i64 %res
}
