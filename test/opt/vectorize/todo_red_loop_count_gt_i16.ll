; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,IntrinConv,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; count of elements above a threshold, zext of a i16 compare mask to i64 into the accumulator.

define i64 @f(ptr %a, i64 %n, i16 %t) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64, %2{}: i16):
; CHECK-NEXT:    %3: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64, 0:i64), bb2(0:i64)>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64, %6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%5, 2:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %9: i16 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i1 = IntSGT(%9, %2){} NUses:1
; CHECK-NEXT:    %11: i64 = ZExt(%10){} NUses:1
; CHECK-NEXT:    %12: i64 = IntAdd(%11, %6){} NUses:2
; CHECK-NEXT:    %13: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %1){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13, %12), bb2(%12)>(%14){} NUses:0
; CHECK-NEXT:  bb2(%16{}: i64):
; CHECK-NEXT:    %17: i64 = Return(%16){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc1, %loop ]
  %p = getelementptr i16, ptr %a, i64 %i
  %x = load i16, ptr %p
  %c = icmp sgt i16 %x, %t
  %z = zext i1 %c to i64
  %acc1 = add i64 %acc, %z
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi i64 [ 0, %entry ], [ %acc1, %loop ]
  ret i64 %res
}
