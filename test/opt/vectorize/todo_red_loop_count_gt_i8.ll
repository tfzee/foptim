; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "LLVMIntrinsicLowering,Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,IntrinConv,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; count of elements above a threshold, zext of a i8 compare mask to i64 into the accumulator.

define i64 @f(ptr %a, i64 %n, i8 %t) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64, %2{}: i8):
; CHECK-NEXT:    %3: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64, 0:i64), bb2(0:i64)>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64, %6{}: i64):
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %5){} NUses:1
; CHECK-NEXT:    %8: i8 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i1 = IntSGT(%8, %2){} NUses:1
; CHECK-NEXT:    %10: i64 = ZExt(%9){} NUses:1
; CHECK-NEXT:    %11: i64 = IntAdd(%10, %6){} NUses:2
; CHECK-NEXT:    %12: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %1){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%12, %11), bb2(%11)>(%13){} NUses:0
; CHECK-NEXT:  bb2(%15{}: i64):
; CHECK-NEXT:    %16: i64 = Return(%15){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc1, %loop ]
  %p = getelementptr i8, ptr %a, i64 %i
  %x = load i8, ptr %p
  %c = icmp sgt i8 %x, %t
  %z = zext i1 %c to i64
  %acc1 = add i64 %acc, %z
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi i64 [ 0, %entry ], [ %acc1, %loop ]
  ret i64 %res
}
