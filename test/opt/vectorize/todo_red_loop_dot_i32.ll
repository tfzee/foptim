define i32 @f(ptr %a, ptr %b, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr, %2{}: i64):
; CHECK-NEXT:    %3: i1 = IntSGT(%2, 0:i64){} NUses:1
; CHECK-NEXT:    %4: () = CondBranch<bb1(0:i64, 0:i32), bb2(0:i32)>(%3){} NUses:0
; CHECK-NEXT:  bb1(%5{}: i64, %6{}: i32):
; CHECK-NEXT:    %7: i64 = IntMul(%5, 4:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%1, %7){NSW; NUW; } NUses:1
; CHECK-NEXT:    %10: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %11: i32 = Load(%9){} NUses:1
; CHECK-NEXT:    %12: i32 = IntMul(%10, %11){} NUses:1
; CHECK-NEXT:    %13: i32 = IntAdd(%12, %6){} NUses:2
; CHECK-NEXT:    %14: i64 = IntAdd(%5, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %15: i1 = IntSLT(%14, %2){} NUses:1
; CHECK-NEXT:    %16: () = CondBranch<bb1(%14, %13), bb2(%13)>(%15){} NUses:0
; CHECK-NEXT:  bb2(%17{}: i32):
; CHECK-NEXT:    %18: i32 = Return(%17){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %loop ]
  %pa = getelementptr i32, ptr %a, i64 %i
  %pb = getelementptr i32, ptr %b, i64 %i
  %x = load i32, ptr %pa
  %y = load i32, ptr %pb
  %m = mul i32 %x, %y
  %acc1 = add i32 %acc, %m
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi i32 [ 0, %entry ], [ %acc1, %loop ]

  ret i32 %res
}
