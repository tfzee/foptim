; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Rotate of bytes by a variable amount (CppPerformanceBenchmarks/rotate_bits
; "variable" rows, clang is 10 to 40 times faster). The shifts are i32 shifts
; of the zero extended byte, they cannot be narrowed (an i8 shift by 8 or more
; is poison, the i32 one is defined), so the loop needs a truncation of
; several vector registers feeding an or, which the mixed width loops reject
; (a trunc may only feed stores).

define i8 @f(ptr noalias %a, i32 %n, i32 %s) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{noalias; }: ptr, %1{}: i32, %2{}: i32):
; CHECK-NEXT:    %3: i1 = IntSGT(%1, 0:i32){} NUses:1
; CHECK-NEXT:    %4: i32 = IntSub(8:i32, %2){} NUses:1
; CHECK-NEXT:    %5: () = CondBranch<bb1(0:i32, 0:i8), bb2(0:i8)>(%3){} NUses:0
; CHECK-NEXT:  bb1(%6{}: i32, %7{}: i8):
; CHECK-NEXT:    %8: i64 = SExt(%6){} NUses:1
; CHECK-NEXT:    %9: ptr = PtrAdd(%0, %8){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %10: i8 = Load(%9){} NUses:1
; CHECK-NEXT:    %11: i32 = ZExt(%10){} NUses:2
; CHECK-NEXT:    %12: i32 = LShR(%11, %2){} NUses:1
; CHECK-NEXT:    %13: i32 = Shl(%11, %4){} NUses:1
; CHECK-NEXT:    %14: i8 = ITrunc(%12){} NUses:1
; CHECK-NEXT:    %15: i8 = ITrunc(%13){} NUses:1
; CHECK-NEXT:    %16: i8 = Or(%14, %15){} NUses:1
; CHECK-NEXT:    %17: i8 = IntAdd(%16, %7){} NUses:2
; CHECK-NEXT:    %18: i32 = IntAdd(%6, 1:i32){NSW; } NUses:2
; CHECK-NEXT:    %19: i1 = IntSLT(%18, %1){} NUses:1
; CHECK-NEXT:    %20: () = CondBranch<bb1(%18, %17), bb2(%17)>(%19){} NUses:0
; CHECK-NEXT:  bb2(%21{}: i8):
; CHECK-NEXT:    %22: i8 = Return(%21){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i32 %n, 0
  %back = sub i32 8, %s
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %r = phi i8 [ 0, %entry ], [ %r1, %loop ]
  %i64 = sext i32 %i to i64
  %p = getelementptr inbounds i8, ptr %a, i64 %i64
  %v = load i8, ptr %p
  %z = zext i8 %v to i32
  %sr = lshr i32 %z, %s
  %sl = shl i32 %z, %back
  %srt = trunc i32 %sr to i8
  %slt = trunc i32 %sl to i8
  %o = or i8 %srt, %slt
  %r1 = add i8 %r, %o
  %i1 = add nsw i32 %i, 1
  %cnd = icmp slt i32 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi i8 [ 0, %entry ], [ %r1, %loop ]
  ret i8 %res
}
