; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; fast flag on the fadd: reassociation allowed.

define float @f(ptr %a, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(0:i64, 0:f32), bb2(0:f32)>(%2){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: f32):
; CHECK-NEXT:    %6: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){} NUses:1
; CHECK-NEXT:    %8: f32 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: f32 = FloatAdd(%8, %5){} NUses:2
; CHECK-NEXT:    %10: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %1){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb1(%10, %9), bb2(%9)>(%11){} NUses:0
; CHECK-NEXT:  bb2(%13{}: f32):
; CHECK-NEXT:    %14: f32 = Return(%13){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi float [ 0.0, %entry ], [ %acc1, %loop ]
  %p = getelementptr float, ptr %a, i64 %i
  %x = load float, ptr %p
  %acc1 = fadd fast float %acc, %x
  %i1 = add nuw nsw i64 %i, 1

  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi float [ 0.0, %entry ], [ %acc1, %loop ]

  ret float %res
}
