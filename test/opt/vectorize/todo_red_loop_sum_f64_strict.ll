; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; Not vectorized (output is scalar), and correctly so without associative math. Should become a vector loop only with fast math.

define double @f(ptr %a, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(0:i64, 0:f64), bb2(0:f64)>(%2){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: f64):
; CHECK-NEXT:    %6: i64 = IntMul(%4, 8:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: f64 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: f64 = FloatAdd(%8, %5){} NUses:2
; CHECK-NEXT:    %10: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %11: i1 = IntSLT(%10, %1){} NUses:1
; CHECK-NEXT:    %12: () = CondBranch<bb1(%10, %9), bb2(%9)>(%11){} NUses:0
; CHECK-NEXT:  bb2(%13{}: f64):
; CHECK-NEXT:    %14: f64 = Return(%13){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi double [ 0.0, %entry ], [ %acc1, %loop ]
  %p = getelementptr double, ptr %a, i64 %i
  %x = load double, ptr %p
  %acc1 = fadd double %acc, %x
  %i1 = add nuw nsw i64 %i, 1
  %cnd = icmp slt i64 %i1, %n
  br i1 %cnd, label %loop, label %exit
exit:
  %res = phi double [ 0.0, %entry ], [ %acc1, %loop ]
  ret double %res
}
