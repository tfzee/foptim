; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; acc += a[i] + 1 is reassociated to (acc + a[i]) + 1, the reduction matcher only accepts acc op x directly.

define i32 @f(ptr %a, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64):
; CHECK-NEXT:    %2: i1 = IntSGT(%1, 0:i64){} NUses:1
; CHECK-NEXT:    %3: () = CondBranch<bb1(0:i64, 0:i32), bb2(0:i32)>(%2){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: i32):
; CHECK-NEXT:    %6: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){} NUses:1
; CHECK-NEXT:    %8: i32 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = IntAdd(%8, %5){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%9, 1:i32){} NUses:2
; CHECK-NEXT:    %11: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:2
; CHECK-NEXT:    %12: i1 = IntSLT(%11, %1){} NUses:1
; CHECK-NEXT:    %13: () = CondBranch<bb1(%11, %10), bb2(%10)>(%12){} NUses:0
; CHECK-NEXT:  bb2(%14{}: i32):
; CHECK-NEXT:    %15: i32 = Return(%14){} NUses:0
; CHECK-NEXT:}
entry:
  %g = icmp sgt i64 %n, 0
  br i1 %g, label %loop, label %exit
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %loop ]
  %p = getelementptr i32, ptr %a, i64 %i
  %x = load i32, ptr %p
  %y = add i32 %x, 1
  %acc1 = add i32 %acc, %y
  %i1 = add nuw nsw i64 %i, 1
  %c = icmp slt i64 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  %r = phi i32 [ 0, %entry ], [ %acc1, %loop ]
  ret i32 %r
}
