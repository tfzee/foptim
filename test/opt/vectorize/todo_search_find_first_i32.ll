; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SORA,InstSimplify,LVN,SCCP,SimplifyCFG,DCE,LICM,LoopRotate,SimplifyCFG,LoopSimplify,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s
; find first a[i] == x with a counted bound, early return of the index.

define i64 @f(ptr %a, i32 %x, i64 %n) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32, %2{}: i64):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64):
; CHECK-NEXT:    %5: i1 = IntSLT(%4, %2){} NUses:1
; CHECK-NEXT:    %6: () = CondBranch<bb2(), bb3()>(%5){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %7: i64 = IntMul(%4, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){} NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i1 = IntEQ(%9, %1){} NUses:1
; CHECK-NEXT:    %11: () = CondBranch<bb4(), bb5()>(%10){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %12: i64 = Return(%2){} NUses:0
; CHECK-NEXT:  bb4():
; CHECK-NEXT:    %13: i64 = Return(%4){} NUses:0
; CHECK-NEXT:  bb5():
; CHECK-NEXT:    %14: i64 = IntAdd(%4, 1:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %15: () = Branch<bb1(%14)>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %latch ]
  %cn = icmp slt i64 %i, %n
  br i1 %cn, label %body, label %notfound
body:
  %p = getelementptr i32, ptr %a, i64 %i
  %v = load i32, ptr %p
  %z = icmp eq i32 %v, %x
  br i1 %z, label %found, label %latch
latch:
  %i1 = add nuw nsw i64 %i, 1
  br label %loop
found:
  ret i64 %i
notfound:
  ret i64 %n
}
