; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s

; Vector conversions are not supported by the backend (known-issues.md), so the conversions stay scalar (the stores may be packed partially). Should vectorize once the backend supports vector conversions.
define void @f(ptr %a, ptr %b) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: ptr = PtrAdd(%1, 4:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%1, 8:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%1, 12:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: ptr = PtrAdd(%0, 4:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, 8:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, 12:ptr){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: f32 = Load(%1){} NUses:1
; CHECK-NEXT:    %9: f32 = Load(%2){} NUses:1
; CHECK-NEXT:    %10: f32 = Load(%3){} NUses:1
; CHECK-NEXT:    %11: f32 = Load(%4){} NUses:1
; CHECK-NEXT:    %12: i32 = FP_SI(%8){} NUses:1
; CHECK-NEXT:    %13: i32 = FP_SI(%9){} NUses:1
; CHECK-NEXT:    %14: i32 = FP_SI(%10){} NUses:1
; CHECK-NEXT:    %15: i32 = FP_SI(%11){} NUses:1
; CHECK-NEXT:    %16: i32 = Store(%0, %12){} NUses:0
; CHECK-NEXT:    %17: i32 = Store(%5, %13){} NUses:0
; CHECK-NEXT:    %18: i32 = Store(%6, %14){} NUses:0
; CHECK-NEXT:    %19: i32 = Store(%7, %15){} NUses:0
; CHECK-NEXT:    %20: () = Return(){} NUses:0
; CHECK-NEXT:}
  %b1 = getelementptr float, ptr %b, i64 1
  %b2 = getelementptr float, ptr %b, i64 2
  %b3 = getelementptr float, ptr %b, i64 3
  %a1 = getelementptr i32, ptr %a, i64 1
  %a2 = getelementptr i32, ptr %a, i64 2
  %a3 = getelementptr i32, ptr %a, i64 3
  %x0 = load float, ptr %b
  %x1 = load float, ptr %b1
  %x2 = load float, ptr %b2
  %x3 = load float, ptr %b3
  %z0 = fptosi float %x0 to i32
  %z1 = fptosi float %x1 to i32
  %z2 = fptosi float %x2 to i32
  %z3 = fptosi float %x3 to i32
  store i32 %z0, ptr %a
  store i32 %z1, ptr %a1
  store i32 %z2, ptr %a2
  store i32 %z3, ptr %a3
  ret void
}
