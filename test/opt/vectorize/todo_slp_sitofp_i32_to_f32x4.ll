; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "Mem2Reg,InstSimplify,LVN,SCCP,DCE,SLPVectorizer,LegalizeVecs,InstSimplify,DCE" | FileCheck %s

; Vector conversions are not supported by the backend (known-issues.md), so the conversions stay scalar (the stores may be packed partially). Should vectorize once the backend supports vector conversions.
define void @f(ptr %a, ptr %b) {
; CHECK-LABEL: func f<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: ptr):
; CHECK-NEXT:    %2: ptr = PtrAdd(%1, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %3: ptr = PtrAdd(%1, 8:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %4: ptr = PtrAdd(%1, 12:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %5: ptr = PtrAdd(%0, 4:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %6: ptr = PtrAdd(%0, 12:i64){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: i32 = Load(%1){} NUses:1
; CHECK-NEXT:    %8: i32 = Load(%2){} NUses:1
; CHECK-NEXT:    %9: i32 = Load(%3){} NUses:1
; CHECK-NEXT:    %10: i32 = Load(%4){} NUses:1
; CHECK-NEXT:    %11: f32 = SI_FP(%7){} NUses:1
; CHECK-NEXT:    %12: f32 = SI_FP(%8){} NUses:1
; CHECK-NEXT:    %13: f32 = SI_FP(%9){} NUses:1
; CHECK-NEXT:    %14: f32 = SI_FP(%10){} NUses:1
; CHECK-NEXT:    %15: f32 = Store(%0, %11){} NUses:0
; CHECK-NEXT:    %16: 2@f32 = InsertElement(POISON, %12, 0:i32){} NUses:1
; CHECK-NEXT:    %17: 2@f32 = InsertElement(%16, %13, 1:i32){} NUses:1
; CHECK-NEXT:    %18: 2@f32 = Store(%5, %17){} NUses:0
; CHECK-NEXT:    %19: f32 = Store(%6, %14){} NUses:0
; CHECK-NEXT:    %20: () = Return(){} NUses:0
; CHECK-NEXT:}
  %b1 = getelementptr i32, ptr %b, i64 1
  %b2 = getelementptr i32, ptr %b, i64 2
  %b3 = getelementptr i32, ptr %b, i64 3
  %a1 = getelementptr float, ptr %a, i64 1
  %a2 = getelementptr float, ptr %a, i64 2
  %a3 = getelementptr float, ptr %a, i64 3
  %x0 = load i32, ptr %b
  %x1 = load i32, ptr %b1
  %x2 = load i32, ptr %b2
  %x3 = load i32, ptr %b3
  %z0 = sitofp i32 %x0 to float
  %z1 = sitofp i32 %x1 to float
  %z2 = sitofp i32 %x2 to float
  %z3 = sitofp i32 %x3 to float
  store float %z0, ptr %a
  store float %z1, ptr %a1
  store float %z2, ptr %a2
  store float %z3, ptr %a3
  ret void
}
