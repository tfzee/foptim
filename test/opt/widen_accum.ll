; A byte accumulator of a single block loop that adds truncated wide values is
; carried wide and truncated behind the loop, only its low bits matter.

define i8 @sum_trunc(ptr %p, i64 %n, i32 %s) {
; CHECK-LABEL: func sum_trunc<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: i32):
; CHECK-NEXT:    %6: i64 = IntMul(%4, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %8: i8 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = ZExt(%8){} NUses:1
; CHECK-NEXT:    %10: i32 = AShR(%9, %2){} NUses:1
; CHECK-NEXT:    %11: i32 = IntAdd(%5, %10){} NUses:2
; CHECK-NEXT:    %12: i64 = IntAdd(%4, 1:i64){NSW; } NUses:2
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %1){} NUses:1
; CHECK-NEXT:    %14: () = CondBranch<bb1(%12, %11), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %15: i8 = Return(%16){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %16: i8 = ITrunc(%11){} NUses:1
; CHECK-NEXT:    %17: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i8 [ 0, %entry ], [ %acc1, %loop ]
  %g = getelementptr inbounds i8, ptr %p, i64 %i
  %b = load i8, ptr %g
  %z = zext i8 %b to i32
  %sh = ashr i32 %z, %s
  %t = trunc i32 %sh to i8
  %acc1 = add i8 %acc, %t
  %i1 = add nsw i64 %i, 1
  %c = icmp slt i64 %i1, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i8 %acc1
}

