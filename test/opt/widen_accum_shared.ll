; RUN: %foffcc %s --print-fir --passes "Mem2Reg,SimplifyCFG,DCE,WidenAccum" | FileCheck %s
; The added value is an op whose two operands are the same value. Killing the
; old narrow tree must not touch that operand twice.

define i8 @sum_shared(ptr %p, i64 %n, i32 %s) {
; CHECK-LABEL: func sum_shared<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i64, %2{}: i32):
; CHECK-NEXT:    %3: () = Branch<bb1(0:i64, 0:i32)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i64, %5{}: i32):
; CHECK-NEXT:    %6: i64 = IntMul(%4, 1:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %7: ptr = PtrAdd(%0, %6){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %8: i8 = Load(%7){} NUses:1
; CHECK-NEXT:    %9: i32 = ZExt(%8){} NUses:1
; CHECK-NEXT:    %10: i32 = AShR(%9, %2){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%10, %10){} NUses:1
; CHECK-NEXT:    %12: i32 = IntAdd(%5, %11){} NUses:2
; CHECK-NEXT:    %13: i64 = IntAdd(%4, 1:i64){NSW; } NUses:2
; CHECK-NEXT:    %14: i1 = IntSLT(%13, %1){} NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%13, %12), bb2()>(%14){} NUses:0
; CHECK-NEXT:  bb3():
; CHECK-NEXT:    %16: i8 = Return(%17){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %17: i8 = ITrunc(%12){} NUses:1
; CHECK-NEXT:    %18: () = Branch<bb3()>(){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i8 [ 0, %entry ], [ %acc1, %loop ]
  %g = getelementptr inbounds i8, ptr %p, i64 %i
  %b = load i8, ptr %g
  %z = zext i8 %b to i32
  %sh = ashr i32 %z, %s
  %t = trunc i32 %sh to i8
  %d = add i8 %t, %t
  %acc1 = add i8 %acc, %d
  %i1 = add nsw i64 %i, 1
  %c = icmp slt i64 %i1, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i8 %acc1
}
