; NOTE: Assertions have been autogenerated by utils/update_fir_tests.py UTC_ARGS: --version 6
; RUN: %foffcc %s --print-fir --passes "WidenIV,DCE" | FileCheck %s
; the int counter is sign extended for the index and the exit test proves it does not wrap, so it is carried as i64
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu"

define i32 @sum(ptr %p, i32 %n) {
; CHECK-LABEL: func sum<CC: C, LINK: external, > Uses: 0
; CHECK-NEXT:{
; CHECK-NEXT:  bb0(%0{}: ptr, %1{}: i32):
; CHECK-NEXT:    %2: i64 = SExt(%1){} NUses:1
; CHECK-NEXT:    %3: () = Branch<bb1(0:i32, 0:i32, 0:i64)>(){} NUses:0
; CHECK-NEXT:  bb1(%4{}: i32, %5{}: i32, %6{}: i64):
; CHECK-NEXT:    %7: i64 = IntMul(%6, 4:i32){NSW; NUW; } NUses:1
; CHECK-NEXT:    %8: ptr = PtrAdd(%0, %7){NSW; InBounds; } NUses:1
; CHECK-NEXT:    %9: i32 = Load(%8){} NUses:1
; CHECK-NEXT:    %10: i32 = IntAdd(%5, %9){} NUses:2
; CHECK-NEXT:    %11: i32 = IntAdd(%4, 1:i32){NSW; } NUses:1
; CHECK-NEXT:    %12: i64 = IntAdd(%6, 1:i64){NSW; } NUses:1
; CHECK-NEXT:    %13: i1 = IntSLT(%12, %2){} NUses:1
; CHECK-NEXT:    %14: i64 = IntAdd(%6, 1:i64){NSW; } NUses:1
; CHECK-NEXT:    %15: () = CondBranch<bb1(%11, %10, %14), bb2()>(%13){} NUses:0
; CHECK-NEXT:  bb2():
; CHECK-NEXT:    %16: i32 = Return(%10){} NUses:0
; CHECK-NEXT:}
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %add, %loop ]
  %idx = sext i32 %i to i64
  %g = getelementptr inbounds i32, ptr %p, i64 %idx
  %v = load i32, ptr %g
  %add = add i32 %acc, %v
  %i.next = add nsw i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %add
}
